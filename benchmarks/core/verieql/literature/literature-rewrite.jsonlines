{"benchmark":"conditional-fkPennTR","name":"fkPennTR","index":5,"schema":{"DEPTS":{"DNAME":"INT","DPROJ":"INT"},"TEAMS":{"TMEMBER":"INT","TPROJ":"INT"},"PAYROLL":{"EMPL":"INT","PDEPT":"INT"}},"constraint":[{"foreign":[{"value":"TEAMS__TMEMBER"},{"value":"PAYROLL__EMPL"}]},{"primary":[{"value":"PAYROLL__EMPL"}]}],"has-symbolic-predicates":false,"pair":["SELECT T.TMEMBER FROM DEPTS D, TEAMS T WHERE D.DPROJ = T.TPROJ AND D.DNAME = 'SECURITY'","SELECT V1.E FROM (SELECT D.DNAME AS D, D.DPROJ AS P, P.EMPL AS E FROM DEPTS D, PAYROLL P WHERE D.DNAME = P.PDEPT) V1, (SELECT T.TMEMBER AS E, P.PDEPT AS D, T.TPROJ AS P FROM TEAMS T, PAYROLL P WHERE T.TMEMBER = P.EMPL) V2 WHERE V1.D = 'SECURITY' AND V1.P = V2.P AND V1.E = V2.E AND V1.D = V2.D"]}
