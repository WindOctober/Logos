def input_manifest_record(
    run_dir: Path,
    available_cases: list[BenchmarkCase],
    selected_cases: list[BenchmarkCase],
) -> tuple[dict[str, Any], dict[str, dict[str, Any]]]:
    try:
        record, files = FULL_RUNNER["input_manifest_record"](
            run_dir,
            available_cases,
            selected_cases,
            frozen=False,
            resume=False,
        )
    except BaseRunnerError as error:
        raise RunnerError(str(error)) from error
    if record.get("algorithm") != INPUT_MANIFEST_ALGORITHM:
        raise RunnerError("transform runner requires the metadata-bound Logos manifest")
    return record, files


