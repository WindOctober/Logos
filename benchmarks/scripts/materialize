#!/usr/bin/env python3
import argparse
import subprocess
import sys
from pathlib import Path


LOGOS_ROOT = Path(__file__).resolve().parents[2]
DEFAULT_OUTPUT_ROOT = "benchmarks/core/.generated"


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Materialize benchmark-derived generated inputs from one benchmark entrypoint. "
            "Generated files are written under benchmarks/core/.generated by default."
        )
    )
    parser.add_argument(
        "--tool",
        choices=("logos", "sqlsolver", "qed", "cosette"),
        default="sqlsolver",
        help=(
            "Generated profile to materialize. Logos is the independent "
            "PostgreSQL/Calcite authority profile."
        ),
    )
    parser.add_argument(
        "--target",
        choices=("all", "wetune", "nonwetune"),
        default="all",
        help="Benchmark subset to materialize.",
    )
    parser.add_argument(
        "--output-root",
        default=DEFAULT_OUTPUT_ROOT,
        help=(
            "Generated output root. For Logos, SQLSolver, QED, and Cosette, the script writes "
            "<output-root>/<tool>/{wetune-issues,nonwetune-flat}."
        ),
    )
    parser.add_argument("--force", action="store_true", help="Overwrite existing generated outputs.")
    parser.add_argument(
        "--benchmark",
        action="append",
        help="Forwarded to non-WeTune materialization. May be repeated.",
    )
    parser.add_argument(
        "--case",
        action="append",
        help="Case-id regex. Forwarded to the selected materializers. May be repeated.",
    )
    parser.add_argument(
        "--limit",
        type=int,
        help="Forwarded to non-WeTune materialization.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print commands without executing them.",
    )
    parser.add_argument(
        "--skip-parser",
        action="store_true",
        help="For QED only: write qed.sql without invoking LOGOS_QED_PARSER.",
    )
    parser.add_argument(
        "--verify-non-rbot-baseline",
        action="store_true",
        help=(
            "For Logos only: verify all 1,320 generated non-R-Bot files against "
            "the supervisor-owned campaign baseline."
        ),
    )
    args = parser.parse_args()

    output_root = resolve(args.output_root)
    commands = build_commands(args, output_root)
    for command in commands:
        print("+ " + " ".join(shell_quote(part) for part in command), file=sys.stderr)
        if args.dry_run:
            continue
        completed = subprocess.run(command, cwd=LOGOS_ROOT)
        if completed.returncode != 0:
            return completed.returncode
    return 0


def resolve(path: str | Path) -> Path:
    candidate = Path(path)
    if candidate.is_absolute():
        return candidate
    parts = candidate.parts
    if parts and parts[0] == LOGOS_ROOT.name:
        return LOGOS_ROOT / Path(*parts[1:])
    return LOGOS_ROOT / candidate


def build_commands(args: argparse.Namespace, output_root: Path) -> list[list[str]]:
    if args.tool == "logos":
        command = [
            sys.executable,
            str(LOGOS_ROOT / "benchmarks/adapters/materializers/materialize_logos.py"),
            "--output-dir",
            str(output_root / "logos"),
            "--target",
            args.target,
        ]
        if args.force:
            command.append("--force")
        for benchmark in args.benchmark or []:
            command.extend(["--benchmark", benchmark])
        for case in args.case or []:
            command.extend(["--case", case])
        if args.limit is not None:
            command.extend(["--limit", str(args.limit)])
        if args.verify_non_rbot_baseline:
            command.append("--verify-non-rbot-baseline")
        return [command]

    if args.tool == "cosette":
        if args.target == "wetune":
            input_root = output_root / "sqlsolver/wetune-issues"
            cosette_output = output_root / "cosette/wetune-issues"
        elif args.target == "nonwetune":
            input_root = output_root / "sqlsolver/nonwetune-flat"
            cosette_output = output_root / "cosette/nonwetune-flat"
        else:
            input_root = output_root / "sqlsolver"
            cosette_output = output_root / "cosette"
        command = [
            sys.executable,
            str(LOGOS_ROOT / "benchmarks/adapters/materializers/materialize_cosette.py"),
            "--input-root",
            str(input_root),
            "--output-dir",
            str(cosette_output),
        ]
        if args.force:
            command.append("--force")
        for case in args.case or []:
            command.extend(["--case", case])
        if args.limit is not None:
            command.extend(["--limit", str(args.limit)])
        return [command]

    if args.tool == "qed":
        command = [
            sys.executable,
            str(LOGOS_ROOT / "benchmarks/adapters/materializers/materialize_qed.py"),
            "--output-dir",
            str(output_root / "qed"),
            "--target",
            args.target,
        ]
        if args.force:
            command.append("--force")
        for benchmark in args.benchmark or []:
            command.extend(["--benchmark", benchmark])
        for case in args.case or []:
            command.extend(["--case", case])
        if args.limit is not None:
            command.extend(["--limit", str(args.limit)])
        if args.skip_parser:
            command.append("--skip-parser")
        return [command]

    commands: list[list[str]] = []
    if args.target in ("all", "wetune"):
        command = [
            sys.executable,
            str(LOGOS_ROOT / "benchmarks/adapters/materializers/materialize_wetune_sqlsolver.py"),
            "--output-dir",
            str(output_root / "sqlsolver/wetune-issues"),
        ]
        if args.force:
            command.append("--force")
        for case in args.case or []:
            command.extend(["--case", case])
        commands.append(command)

    if args.target in ("all", "nonwetune"):
        command = [
            sys.executable,
            str(LOGOS_ROOT / "benchmarks/adapters/materializers/materialize_nonwetune_sqlsolver.py"),
            "--output-dir",
            str(output_root / "sqlsolver/nonwetune-flat"),
        ]
        if args.force:
            command.append("--force")
        for benchmark in args.benchmark or []:
            command.extend(["--benchmark", benchmark])
        for case in args.case or []:
            command.extend(["--case", case])
        if args.limit is not None:
            command.extend(["--limit", str(args.limit)])
        commands.append(command)

    return commands


def shell_quote(value: str) -> str:
    if not value:
        return "''"
    safe = set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_+-=/:.,@%")
    if all(char in safe for char in value):
        return value
    return "'" + value.replace("'", "'\"'\"'") + "'"


if __name__ == "__main__":
    raise SystemExit(main())
