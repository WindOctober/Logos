{"benchmark":"cex-benchmarks-csep544_hw3","name":"cex-benchmarks-csep544_hw3_csep544_hw3_q1_1","index":48,"schema":{"MONTHS":{"MID":"INT","MONTH":"INT"},"WEEKDAYS":{"DID":"INT","DAY_OF_WEEK":"INT"},"CARRIERS":{"CID":"INT","NAME":"INT"},"FLIGHTS":{"FID":"INT","ORIGIN_CITY":"INT","DEST_CITY":"INT","ACTUAL_TIME":"INT"}},"constraint":null,"has-symbolic-predicates":false,"pair":["SELECT DISTINCT F.ORIGIN_CITY, F.DEST_CITY, F.ACTUAL_TIME FROM FLIGHTS AS F JOIN (SELECT A.ORIGIN_CITY, MAX(A.ACTUAL_TIME) AS MAX_TIME FROM FLIGHTS AS A GROUP BY A.ORIGIN_CITY) AS X ON F.ORIGIN_CITY = X.ORIGIN_CITY AND F.ACTUAL_TIME = X.MAX_TIME","SELECT S.ORIGIN_CITY, F2.DEST_CITY, MAX(F2.ACTUAL_TIME) FROM (SELECT F1.ORIGIN_CITY, MAX(F1.ACTUAL_TIME) AS MAX_TIME FROM FLIGHTS AS F1 GROUP BY F1.ORIGIN_CITY) AS S JOIN FLIGHTS AS F2 ON S.ORIGIN_CITY = F2.ORIGIN_CITY AND F2.ACTUAL_TIME = S.MAX_TIME GROUP BY S.ORIGIN_CITY, F2.DEST_CITY"]}
{"benchmark":"cex-benchmarks-csep544_hw3","name":"cex-benchmarks-csep544_hw3_csep544_hw3_q1_2","index":49,"schema":{"MONTHS":{"MID":"INT","MONTH":"INT"},"WEEKDAYS":{"DID":"INT","DAY_OF_WEEK":"INT"},"CARRIERS":{"CID":"INT","NAME":"INT"},"FLIGHTS":{"FID":"INT","ORIGIN_CITY":"INT","DEST_CITY":"INT","ACTUAL_TIME":"INT"}},"constraint":null,"has-symbolic-predicates":false,"pair":["SELECT DISTINCT F.ORIGIN_CITY, F.DEST_CITY, F.ACTUAL_TIME FROM FLIGHTS AS F JOIN (SELECT A.ORIGIN_CITY, MAX(A.ACTUAL_TIME) AS MAX_TIME FROM FLIGHTS AS A GROUP BY A.ORIGIN_CITY) AS X ON F.ORIGIN_CITY = X.ORIGIN_CITY AND F.ACTUAL_TIME = X.MAX_TIME","SELECT P.ORIGIN_CITY, P.DEST_CITY, P.ACTUAL_TIME FROM (SELECT F1.ORIGIN_CITY, F1.DEST_CITY, F1.ACTUAL_TIME, MAX(F2.ACTUAL_TIME) AS MAX_ACTUAL_TIME FROM FLIGHTS AS F1 JOIN FLIGHTS AS F2 ON F1.ORIGIN_CITY = F2.ORIGIN_CITY GROUP BY F1.ORIGIN_CITY, F1.DEST_CITY, F1.ACTUAL_TIME) AS P WHERE P.ACTUAL_TIME = P.MAX_ACTUAL_TIME"]}
