        "diagnosticAcceptedRequestCount": 0,
        "diagnosticRejectedSourceAuditCount": 0,
        "diagnosticOtherRejectedRequestCount": 0,
        "diagnosticAcceptedAuditArtifactCount": 0,
        "diagnosticRejectedSourceAuditArtifactCount": 0,
        "diagnosticPreservedArtifactCount": 0,
        "requestedTimeoutSeconds": [],
        "effectiveTimeoutSeconds": [],
        "initialProblemCompileElapsedMs": None,
        "initialProblemCompileTimeoutSeconds": None,
        "initialProblemCompileInvocationCount": 0,
        "initialProblemCompileGenerations": [],
        "finalProofCheckInvocationCount": 0,
        "finalProofCheckElapsedTotalMs": 0,
        "checkerInvocationCount": 0,
        "checkerElapsedMs": 0,
        "finalProofCheckElapsedMs": None,
        "proofSource": {
            "path": workspace_display_path(
                case_dir / "proof-stage/formal-sql/Problem.v"
            ),
            "present": False,
            "sha256": None,
            "bytes": None,
        },
        "staticPromptAndPrimerBytes": None,
        "queryShapeBytes": None,
        "generatedContextBytes": None,
        "contextManifestBytes": None,
    }


def base_result(
    case: BenchmarkCase, config: RunConfig, invocation_index: int | None = None
) -> dict[str, Any]:
    case_dir = config.run_dir / "cases" / case.case_id
    return {
        "caseId": case.case_id,
        "benchmark": case.source_benchmark or case.cohort,
        "inputDir": workspace_display_path(case.input_dir),
        "caseDir": workspace_display_path(case_dir),
        "reportPath": workspace_display_path(case_dir / "report.json"),
        "stdoutPath": workspace_display_path(case_dir / "stdout.log"),
        "stderrPath": workspace_display_path(case_dir / "stderr.log"),
        "inputFiles": config.input_files[case.case_id],
        "effectiveConfiguration": effective_configuration_record(config),
        "reportEvidence": {
            "path": workspace_display_path(case_dir / "report.json"),
            "present": False,
            "sha256": None,
        },
        "proofMetrics": empty_proof_metrics(case_dir),
        **(
            {"sourceInvocation": invocation_index}
            if invocation_index is not None
            else {}
        ),
    }


def resolve_case_artifact(case_dir: Path, value: str, description: str) -> Path:
    candidate = Path(value)
    if not candidate.is_absolute():
        candidate = case_dir / candidate
    resolved = candidate.resolve()
    try:
        resolved.relative_to(case_dir.resolve())
    except ValueError as error:
        raise RunnerError(
            f"{description} escapes the case directory: {value}"
        ) from error
    return resolved


def proof_source_evidence(case_dir: Path) -> dict[str, Any]:
    path = case_dir / "proof-stage/formal-sql/Problem.v"
    record = {
        "path": workspace_display_path(path),
        "present": False,
        "sha256": None,
        "bytes": None,
    }
    if not path.exists():
        return record
    if not path.is_file() or path.is_symlink():
        raise RunnerError(f"proof source is not a regular non-symlink file: {path}")
    record.update(
        {
            "present": True,
            "sha256": sha256_file(path),
            "bytes": path.stat().st_size,
        }
    )
    return record


def nonnegative_integer(value: Any, description: str) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        raise RunnerError(f"{description} must be a nonnegative integer")
    return value


def diagnostic_elapsed_warning(
    *,
    round_number: int,
    sequence: int,
    requested_timeout_seconds: int,
    effective_timeout_seconds: int,
    elapsed_ms: int,
) -> dict[str, Any] | None:
    """Describe scheduler/reap latency without treating it as proof evidence.

    ``elapsedMs`` measures wall time until the checker process and every
    inherited output pipe have been reaped.  A timeout status can therefore be
    recorded correctly while a delayed descendant keeps the host call alive
    beyond the timeout/kill margin.  The overrun is useful telemetry, but it
    does not invalidate independently checked invocation status or a later
    trusted Rocq certificate.
    """

    limit_ms = (
        effective_timeout_seconds * 1000 + DIAGNOSTIC_ELAPSED_KILL_MARGIN_MS
    )
    if elapsed_ms <= limit_ms:
        return None
    return {
        "code": DIAGNOSTIC_ELAPSED_WARNING_CODE,
        "round": round_number,
        "sequence": sequence,
        "requestedTimeoutSeconds": requested_timeout_seconds,
        "effectiveTimeoutSeconds": effective_timeout_seconds,
        "elapsedMs": elapsed_ms,
        "timeoutPlusKillMarginMs": limit_ms,
        "overrunMs": elapsed_ms - limit_ms,
    }


def diagnostic_clock_warning(
    *,
    round_number: int,
    sequence: int,
    prior_estimated_end_unix_ms: int | None,
    started_at_unix_ms: int,
) -> dict[str, Any] | None:
    """Report wall-clock regression without overruling monotonic proof evidence."""
    if (
        prior_estimated_end_unix_ms is None
        or started_at_unix_ms >= prior_estimated_end_unix_ms
    ):
        return None
    return {
        "code": "diagnostic_wall_clock_regressed_or_overlapped",
        "round": round_number,
        "sequence": sequence,
        "startedAtUnixMs": started_at_unix_ms,
        "priorEstimatedEndUnixMs": prior_estimated_end_unix_ms,
        "apparentRegressionMs": prior_estimated_end_unix_ms
        - started_at_unix_ms,
    }


def trusted_elapsed_warning(
    *,
    phase: str,
    timeout_seconds: int,
    elapsed_ms: int,
    workspace_generation: int | None = None,
    round_number: int | None = None,
) -> dict[str, Any] | None:
    limit_ms = timeout_seconds * 1000 + DIAGNOSTIC_ELAPSED_KILL_MARGIN_MS
    if elapsed_ms <= limit_ms:
        return None
    warning: dict[str, Any] = {
        "code": TRUSTED_ELAPSED_WARNING_CODE,
        "phase": phase,
        "timeoutSeconds": timeout_seconds,
        "elapsedMs": elapsed_ms,
        "timeoutPlusKillMarginMs": limit_ms,
        "overrunMs": elapsed_ms - limit_ms,
    }
    if workspace_generation is not None:
        warning["workspaceGeneration"] = workspace_generation
    if round_number is not None:
        warning["round"] = round_number
    return warning


def strip_rocq_comments(text: str) -> str:
    """Replace nested Rocq comments with whitespace while preserving strings."""
    output: list[str] = []
    index = 0
    comment_depth = 0
    in_string = False
    while index < len(text):
        if comment_depth > 0:
            if text.startswith("(*", index):
                comment_depth += 1
                output.append("  ")
                index += 2
            elif text.startswith("*)", index):
                comment_depth -= 1
                output.append("  ")
                index += 2
            else:
                output.append("\n" if text[index] == "\n" else " ")
                index += 1
            continue

        if not in_string and text.startswith("(*", index):
            comment_depth = 1
            output.append("  ")
            index += 2
        elif text[index] == '"':
            output.append(text[index])
            index += 1
            if in_string and index < len(text) and text[index] == '"':
                output.append(text[index])
                index += 1
            else:
                in_string = not in_string
        else:
            output.append(text[index])
            index += 1
    return "".join(output)


def rocq_sentences(text: str) -> list[str]:
    """Split Rocq text at sentence-ending periods outside string literals."""
    sentences: list[str] = []
    start = 0
    index = 0
    in_string = False
    while index < len(text):
        if text[index] == '"':
            if in_string and index + 1 < len(text) and text[index + 1] == '"':
                index += 2
                continue
            in_string = not in_string
        elif (
            not in_string
            and text[index] == "."
            and (
                index + 1 == len(text)
                or text[index + 1] in " \t\n\r\v\f"
            )
        ):
            sentences.append(text[start : index + 1])
            start = index + 1
        index += 1
    if any(not character.isspace() for character in text[start:]):
        sentences.append(text[start:])
    return sentences


def final_theorem_name(verification_mode: str) -> str:
    """Return the generated final theorem required by one verification mode."""
    normalized = verification_mode.replace("-", "_")
    if normalized in {"safe_unconditional", "outcome_unconditional"}:
        return "generated_queries_verified"
    if normalized == "conditional":
        return "generated_queries_equivalent"
    raise RunnerError(f"unknown verification mode {verification_mode!r}")


def problem_declares_final_theorem(text: str, verification_mode: str) -> bool:
    """Recognize this mode's direct final theorem outside Rocq comments."""
    required_name = final_theorem_name(verification_mode)
    uncommented = strip_rocq_comments(text)
    return any(
        re.findall(r"[A-Za-z0-9_]+", sentence)[:2]
        == ["Theorem", required_name]
        for sentence in rocq_sentences(uncommented)
    )


def problem_declares_formal_countermodel_claim(text: str) -> bool:
    """Recognize the one direct, fully-qualified formal-countermodel selector."""
    expected = [
        "Definition",
        "generated_verification_claim",
        "Logos",
        "FormalSQL",
        "VerificationConditions",
        "verification_claim_kind",
        "Logos",
        "FormalSQL",
        "VerificationConditions",
        "VerificationCountermodel",
    ]
    declarations = [
        re.findall(r"[A-Za-z0-9_]+", sentence)
        for sentence in rocq_sentences(strip_rocq_comments(text))
        if re.findall(r"[A-Za-z0-9_]+", sentence)[:2]
        == ["Definition", "generated_verification_claim"]
    ]
    return declarations == [expected]


def problem_declares_equivalence_claim(text: str) -> bool:
    """Recognize the one direct, fully-qualified equivalence selector."""
    expected = [
        "Definition",
        "generated_verification_claim",
        "Logos",
        "FormalSQL",
        "VerificationConditions",
        "verification_claim_kind",
        "Logos",
        "FormalSQL",
        "VerificationConditions",
        "VerificationEquivalence",
    ]
    declarations = [
        re.findall(r"[A-Za-z0-9_]+", sentence)
        for sentence in rocq_sentences(strip_rocq_comments(text))
        if re.findall(r"[A-Za-z0-9_]+", sentence)[:2]
        == ["Definition", "generated_verification_claim"]
    ]
    return declarations == [expected]


def problem_conditional_provenance(
    text: str,
) -> tuple[str, str] | None:
    uncommented = strip_rocq_comments(text)
    sentences = rocq_sentences(uncommented)
    if any(
        re.findall(r"[A-Za-z0-9_]+", sentence)[:2]
        == ["Definition", "generated_verification_claim"]
        for sentence in sentences
    ):
        return None
    source_declarations = [
        re.findall(r"[A-Za-z0-9_]+", sentence)
        for sentence in sentences
        if re.findall(r"[A-Za-z0-9_]+", sentence)[:2]
        == ["Definition", "generated_precondition_source"]
    ]
    prefix = [
        "Definition",
        "generated_precondition_source",
        "Logos",
        "FormalSQL",
        "VerificationConditions",
        "precondition_source",
        "Logos",
        "FormalSQL",
        "VerificationConditions",
    ]
    if len(source_declarations) != 1 or source_declarations[0][:-1] != prefix:
        return None
    constructors = {
        "PreconditionDerived": "derived",
        "PreconditionExternal": "external",
    }
    source = constructors.get(source_declarations[0][-1])
    definitions = [
        sentence.strip()
        for sentence in sentences
        if re.findall(r"[A-Za-z0-9_]+", sentence)[:6]
        == [
            "Definition",
            "generated_precondition",
            "Logos",
            "FormalSQL",
            "VerificationConditions",
            "verification_condition",
        ]
    ]
    if source is None or len(definitions) != 1:
        return None
    return source, definitions[0]


def rocq_declares_direct_theorem(text: str, name: str) -> bool:
    return any(
        re.findall(r"[A-Za-z0-9_]+", sentence)[:2] == ["Theorem", name]
        for sentence in rocq_sentences(strip_rocq_comments(text))
    )


def validate_diagnostic_artifact_binding(
    case_dir: Path,
    value: Any,
    expected_relative_path: str,
    description: str,
) -> Path:
    if not isinstance(value, dict) or set(value) != {"path", "sha256", "bytes"}:
        raise RunnerError(f"{description} binding is malformed")
    if value.get("path") != expected_relative_path:
        raise RunnerError(f"{description} binding path is not canonical")
    digest = value.get("sha256")
    if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
        raise RunnerError(f"{description} binding digest is malformed")
    expected_bytes = nonnegative_integer(value.get("bytes"), f"{description} bytes")
    lexical_path = case_dir / expected_relative_path
    path = resolve_case_artifact(case_dir, expected_relative_path, description)
    if lexical_path.is_symlink() or not path.is_file() or path.is_symlink():
        raise RunnerError(f"{description} is not a regular non-symlink file")
    if path.stat().st_size != expected_bytes or sha256_file(path) != digest:
        raise RunnerError(f"{description} binding drifted")
    return path


def validate_diagnostic_agent_audit(
    value: Any, *, expected_passed: bool, description: str
) -> None:
    if not isinstance(value, dict) or set(value) != {
        "passed",
        "scannedFiles",
        "findings",
    }:
        raise RunnerError(f"{description} is malformed")
    scanned = value.get("scannedFiles")
    findings = value.get("findings")
    if (
        value.get("passed") is not expected_passed
        or not isinstance(scanned, list)
        or any(not isinstance(path, str) or not path for path in scanned)
        or not isinstance(findings, list)
    ):
        raise RunnerError(f"{description} status is malformed")
    for index, finding in enumerate(findings):
        if (
            not isinstance(finding, dict)
            or set(finding) != {"path", "line", "token", "excerpt"}
            or not isinstance(finding.get("path"), str)
            or not finding["path"]
            or not isinstance(finding.get("token"), str)
            or not finding["token"]
            or not isinstance(finding.get("excerpt"), str)
        ):
            raise RunnerError(f"{description} finding {index} is malformed")
        if nonnegative_integer(finding.get("line"), f"{description} finding line") < 1:
            raise RunnerError(f"{description} finding line must be positive")
    if expected_passed and findings:
        raise RunnerError(f"{description} accepted a nonempty finding set")
    if not expected_passed and not findings:
        raise RunnerError(f"{description} rejection has no finding")


DIAGNOSTIC_MODES = {"problem", "module", "scratch"}
DIAGNOSTIC_PURPOSES = {"static-obligation", "semantic-equivalence", "assembly"}
PROOF_MODULE_CANDIDATE_PATTERN = re.compile(
    r"ProofModules/[A-Z][A-Za-z0-9_]*\.v"
)


def validate_diagnostic_checkpoint_dedup(
    mode: str, candidate_sha256: str, active_checkpoint_sha256: str | None
) -> None:
    """A compile-clean Problem checkpoint must not consume another check."""
    if mode == "problem" and candidate_sha256 == active_checkpoint_sha256:
        raise RunnerError(
            "accepted Problem diagnostic duplicates the active compile checkpoint"
        )


def candidate_problem_has_compile_authority(
    candidate_sha256: str,
    active_checkpoint_sha256: str | None,
    invocations: list[dict[str, Any]],
) -> bool:
    """Recognize a current pass or the exact active compile-clean checkpoint."""
    return candidate_sha256 == active_checkpoint_sha256 or any(
        invocation.get("compilePassed") is True
        and invocation.get("problemCompilePassed") is True
        and invocation.get("mode") == "problem"
        and invocation.get("candidatePath") == "Problem.v"
        and invocation.get("compileCheckpointAdvanced") is True
        and invocation.get("candidateSha256") == candidate_sha256
        for invocation in invocations
    )


def validate_diagnostic_identity(
    mode: Any,
    candidate_path: Any,
    purpose: Any,
    candidate_sha256: Any,
    description: str,
) -> None:
    if mode not in DIAGNOSTIC_MODES:
        raise RunnerError(f"{description} mode is invalid")
    if purpose not in DIAGNOSTIC_PURPOSES:
        raise RunnerError(f"{description} purpose is invalid")
    if (
        not isinstance(candidate_sha256, str)
        or re.fullmatch(r"[0-9a-f]{64}", candidate_sha256) is None
    ):
        raise RunnerError(f"{description} candidate digest is invalid")
    if not isinstance(candidate_path, str) or not candidate_path:
        raise RunnerError(f"{description} candidatePath is invalid")
    if mode == "problem":
        if candidate_path != "Problem.v":
            raise RunnerError(
                f"{description} problem candidatePath must be Problem.v"
            )
        return
    if mode == "module":
        if PROOF_MODULE_CANDIDATE_PATTERN.fullmatch(candidate_path) is None:
            raise RunnerError(
                f"{description} module candidatePath must be "
                "ProofModules/<UppercaseRocqIdentifier>.v"
            )
        return
    if (
        "\\" in candidate_path
        or any(
            ord(character) < 32 or 127 <= ord(character) <= 159
            for character in candidate_path
        )
    ):
        raise RunnerError(f"{description} scratch candidatePath is invalid")
    candidate = Path(candidate_path)
    parts = candidate.parts
    if (
        candidate.is_absolute()
        or len(parts) < 2
        or parts[0] != "scratch"
        or any(part in {"", ".", ".."} for part in parts)
        or candidate.as_posix() != candidate_path
        or candidate.suffix != ".v"
    ):
        raise RunnerError(
            f"{description} scratch candidatePath must be normalized scratch/*.v"
        )


def diagnostic_snapshot_candidate_relative_path(
    root: str, mode: str, candidate_path: str
) -> str:
    if mode == "module":
        return f"{root}/checked-workspace/{candidate_path}"
    return f"{root}/checked-workspace/Problem.v"


def validate_diagnostic_request_v2(
    value: Any,
    *,
    mode: str,
    candidate_path: str,
    purpose: str,
    candidate_sha256: str,
    candidate_bytes: int,
    requested_timeout_seconds: int,
    description: str,
) -> None:
    expected_keys = {
        "schemaVersion",
        "nonce",
        "mode",
        "candidatePath",
        "purpose",
        "candidateSha256",
        "candidateBytes",
        "requestedTimeoutSeconds",
    }
    if not isinstance(value, dict) or set(value) != expected_keys:
        raise RunnerError(f"{description} is not strict schemaVersion 2")
    if value.get("schemaVersion") != 2:
        raise RunnerError(f"{description} is not strict schemaVersion 2")
    nonce = value.get("nonce")
    if (
        not isinstance(nonce, str)
        or re.fullmatch(r"[0-9a-f]{64}", nonce) is None
        or value.get("mode") != mode
        or value.get("candidatePath") != candidate_path
        or value.get("purpose") != purpose
        or value.get("candidateSha256") != candidate_sha256
        or value.get("candidateBytes") != candidate_bytes
        or value.get("requestedTimeoutSeconds") != requested_timeout_seconds
    ):
        raise RunnerError(f"{description} identity drifted")
    validate_diagnostic_identity(
        mode, candidate_path, purpose, candidate_sha256, description
    )


def validate_round_diagnostic_broker_evidence(
    case_dir: Path,
    round_index: int,
    round_record: dict[str, Any],
    invocations: list[dict[str, Any]],
) -> dict[str, int]:
    requests_seen = nonnegative_integer(
        round_record.get("diagnosticRequestsSeen"),
        "diagnostic requests seen",
    )
    reserved_timeout = nonnegative_integer(
        round_record.get("diagnosticRequestedTimeoutSecondsReserved"),
        "diagnostic requested timeout seconds reserved",
    )
    accepted_count = nonnegative_integer(
        round_record.get("diagnosticAcceptedCount"),
        "diagnostic accepted count",
    )
    rejected_count = nonnegative_integer(
        round_record.get("diagnosticRejectedSourceAuditCount"),
        "diagnostic rejected source-audit count",
    )
    other_rejected_count = nonnegative_integer(
        round_record.get("diagnosticOtherRejectedRequestCount"),
        "diagnostic other rejected request count",
    )
    accepted_audits = round_record.get("diagnosticAcceptedSourceAudits", [])
    rejected_audits = round_record.get("diagnosticRejectedSourceAudits", [])
    if (
        not isinstance(accepted_audits, list)
        or any(not isinstance(value, dict) for value in accepted_audits)
        or not isinstance(rejected_audits, list)
        or any(not isinstance(value, dict) for value in rejected_audits)
        or accepted_count != len(invocations)
        or accepted_count != len(accepted_audits)
        or rejected_count != len(rejected_audits)
        or requests_seen != accepted_count + rejected_count + other_rejected_count
    ):
        raise RunnerError("diagnostic broker request accounting is incoherent")

    request_ordinals: set[int] = set()
    invoked_candidates = {
        invocation.get("candidateSha256") for invocation in invocations
    }
    classified_reserved_timeout = 0
    previous_ordinal = 0
    for sequence, (invocation, accepted) in enumerate(
        zip(invocations, accepted_audits, strict=True), start=1
    ):
        if set(accepted) != {
            "requestOrdinal",
            "sequence",
            "mode",
            "candidatePath",
            "purpose",
            "candidateSha256",
            "requestedTimeoutSeconds",
            "candidate",
            "audit",
        }:
            raise RunnerError("accepted diagnostic source-audit record is malformed")
        ordinal = nonnegative_integer(
            accepted.get("requestOrdinal"), "accepted diagnostic request ordinal"
        )
        candidate = accepted.get("candidateSha256")
        requested = nonnegative_integer(
            accepted.get("requestedTimeoutSeconds"),
            "accepted diagnostic requested timeout",
        )
        mode = accepted.get("mode")
        candidate_path = accepted.get("candidatePath")
        purpose = accepted.get("purpose")
        validate_diagnostic_identity(
            mode,
            candidate_path,
            purpose,
            candidate,
            "accepted diagnostic",
        )
        if (
            ordinal <= previous_ordinal
            or ordinal > requests_seen
            or ordinal in request_ordinals
            or accepted.get("sequence") != sequence
            or invocation.get("sequence") != sequence
            or invocation.get("mode") != mode
            or invocation.get("candidatePath") != candidate_path
            or invocation.get("purpose") != purpose
            or invocation.get("candidateSha256") != candidate
            or invocation.get("requestedTimeoutSeconds") != requested
            or requested < 1
        ):
            raise RunnerError("accepted diagnostic identity or ordinal drifted")
        previous_ordinal = ordinal
        request_ordinals.add(ordinal)
        root = (
            f"proof-stage/proof-agent/rounds/{round_index:02d}/"
            f"interactive-diagnostics/{sequence:02d}"
        )
        candidate_relative_path = diagnostic_snapshot_candidate_relative_path(
            root, mode, candidate_path
        )
        candidate_file = validate_diagnostic_artifact_binding(
            case_dir,
            accepted.get("candidate"),
            candidate_relative_path,
            "accepted diagnostic candidate",
        )
        audit_path = validate_diagnostic_artifact_binding(
            case_dir,
            accepted.get("audit"),
            f"{root}/audit.json",
            "accepted diagnostic audit",
        )
        if sha256_file(candidate_file) != candidate:
            raise RunnerError("accepted diagnostic candidate identity drifted")
        request_path = case_dir / f"{root}/request.json"
        if request_path.is_symlink() or not request_path.is_file():
            raise RunnerError("accepted diagnostic request artifact is missing")
        validate_diagnostic_request_v2(
            read_json_object(request_path, "accepted diagnostic request"),
            mode=mode,
            candidate_path=candidate_path,
            purpose=purpose,
            candidate_sha256=candidate,
            candidate_bytes=candidate_file.stat().st_size,
            requested_timeout_seconds=requested,
            description="accepted diagnostic request",
        )
        validate_diagnostic_agent_audit(
            read_json_object(audit_path, "accepted diagnostic audit"),
            expected_passed=True,
            description="accepted diagnostic audit",
        )
        classified_reserved_timeout += requested

    previous_ordinal = 0
    for rejected in rejected_audits:
        if set(rejected) != {
            "requestOrdinal",
            "mode",
            "candidatePath",
            "purpose",
            "candidateSha256",
            "requestedTimeoutSeconds",
            "problem",
            "request",
            "audit",
            "feedback",
        }:
            raise RunnerError("rejected diagnostic source-audit record is malformed")
        ordinal = nonnegative_integer(
            rejected.get("requestOrdinal"), "rejected diagnostic request ordinal"
        )
        candidate = rejected.get("candidateSha256")
        requested = nonnegative_integer(
            rejected.get("requestedTimeoutSeconds"),
            "rejected diagnostic requested timeout",
        )
        mode = rejected.get("mode")
        candidate_path = rejected.get("candidatePath")
        purpose = rejected.get("purpose")
        validate_diagnostic_identity(
            mode,
            candidate_path,
            purpose,
            candidate,
            "rejected diagnostic",
        )
        if (
            ordinal <= previous_ordinal
            or ordinal > requests_seen
            or ordinal in request_ordinals
            or candidate in invoked_candidates
            or requested < 1
        ):
            raise RunnerError("rejected diagnostic identity or ordinal drifted")
        previous_ordinal = ordinal
        request_ordinals.add(ordinal)
        root = (
            f"proof-stage/proof-agent/rounds/{round_index:02d}/"
            f"rejected-diagnostic-source-audits/{ordinal:02d}"
        )
        paths = {
            name: validate_diagnostic_artifact_binding(
                case_dir,
                rejected.get(field),
                f"{root}/{name}",
                f"rejected diagnostic {name}",
            )
            for field, name in (
                ("problem", "Problem.v"),
                ("request", "request.json"),
                ("audit", "audit.json"),
                ("feedback", "feedback.txt"),
            )
        }
        if sha256_file(paths["Problem.v"]) != candidate:
            raise RunnerError("rejected diagnostic Problem.v identity drifted")
        validate_diagnostic_request_v2(
            read_json_object(paths["request.json"], "rejected diagnostic request"),
            mode=mode,
            candidate_path=candidate_path,
            purpose=purpose,
            candidate_sha256=candidate,
            candidate_bytes=paths["Problem.v"].stat().st_size,
            requested_timeout_seconds=requested,
            description="rejected diagnostic request",
        )
        validate_diagnostic_agent_audit(
            read_json_object(paths["audit.json"], "rejected diagnostic audit"),
            expected_passed=False,
            description="rejected diagnostic audit",
        )
        try:
            feedback = paths["feedback.txt"].read_text(encoding="utf-8")
        except UnicodeDecodeError as error:
            raise RunnerError("rejected diagnostic feedback is not UTF-8") from error
        if candidate not in feedback or "checker was not executed" not in feedback:
            raise RunnerError("rejected diagnostic no-checker marker drifted")
        classified_reserved_timeout += requested

    if classified_reserved_timeout > reserved_timeout:
        raise RunnerError("classified diagnostic timeout exceeds reserved timeout")
    return {
        "requests": requests_seen,
        "reservedTimeout": reserved_timeout,
        "accepted": accepted_count,
        "rejectedSourceAudit": rejected_count,
        "otherRejected": other_rejected_count,
        "acceptedAuditArtifacts": accepted_count,
        "rejectedSourceAuditArtifacts": rejected_count * 4,
        "preservedArtifacts": accepted_count + rejected_count * 4,
    }


def terminal_round_has_unavailable_session(record: dict[str, Any]) -> bool:
    """Recognize an explicitly unaccounted terminal Codex invocation.

    A failed container export can preserve host-broker proof checkpoints while
    losing the agent event stream that carried ``thread.started``.  Such a
    round is not evidence for a Codex session or token count, but its absence
    must not invalidate independently bound deterministic proof evidence.
    """
    return (
        record.get("success") is False
        and record.get("exitCode") == 2
        and record.get("sessionId") in (None, "")
        and record.get("usageError")
        == "Codex invocation did not emit exactly one thread.started event"
        and isinstance(record.get("error"), str)
        and "did not report the expected valid session UUID" in record["error"]
    )


def round_has_unresumable_session_suffix(record: dict[str, Any]) -> bool:
    return (
        record.get("success") is False
        and isinstance(record.get("error"), str)
        and "proof repair cannot continue because Codex did not report the expected valid session UUID"
        in record["error"]
    )


def round_has_session_telemetry_failure(record: dict[str, Any]) -> bool:
    usage_error = record.get("usageError")
    return isinstance(usage_error, str) and (
        usage_error
        == "Codex invocation did not emit exactly one thread.started event"
        or usage_error.startswith("resumed Codex session changed from ")
        or usage_error.startswith(
            "resumed Codex invocation did not report the expected session UUID "
        )
        or usage_error.startswith(
            "Codex thread.started returned malformed session UUID "
        )
    )


def round_has_counterexample_handoff(record: dict[str, Any]) -> bool:
    handoff = record.get("counterexampleHandoff")
    return (
        record.get("success") is False
        and record.get("candidateClaim") is None
        and record.get("proofCheckExitCode") != 0
        and isinstance(handoff, dict)
        and set(handoff) == {"decision", "reason", "guidance"}
        and handoff.get("decision") == "counterexample_candidate"
        and all(
            isinstance(handoff.get(key), str) and handoff[key].strip()
            for key in ("reason", "guidance")
        )
    )


def terminal_round_has_unavailable_counterexample_handoff(
    record: dict[str, Any],
) -> bool:
    return terminal_round_has_unavailable_session(
        record
    ) and round_has_counterexample_handoff(record)


def report_has_strict_terminal_counterexample_handoff(
    report: dict[str, Any], record: dict[str, Any] | None
) -> bool:
    """Recognize the only proof handoff that terminates the normal full flow.

    In normal verification mode, a manual-review counterexample assessment is
    returned to the proof loop as navigation.  Only an independently validated
    database counterexample returns a terminal report.  Keep this predicate
    shared by backend-state reconstruction and the narrow session-continuity
    exception so the runner cannot silently give a nonterminal handoff terminal
    authority.
    """

    return (
        report.get("outcome") == "not_equivalent"
        and isinstance(report.get("counterexample"), dict)
        and isinstance(record, dict)
        and round_has_counterexample_handoff(record)
    )


def validate_proof_agent_session_sequence(
    rounds: list[dict[str, Any]],
    context: str,
    *,
    allow_terminal_unavailable_session: bool = False,
    workspace_transitions_by_round: dict[int, dict[str, Any]] | None = None,
) -> None:
    """Bind each bounded transcript generation to one fresh Codex session."""
    generation_sessions: dict[int, str] = {}
    seen_sessions: set[str] = set()
    if workspace_transitions_by_round is None:
        # Partial-run usage recovery has no authoritative completed report yet.
        # Retain the legacy bounded-session check for those run.json records.
        for index, record in enumerate(rounds, start=1):
            expected_generation = (
                index - 1
            ) // PROOF_AGENT_SESSION_RESTART_AFTER_FAILED_ROUNDS + 1
            expected_restarted = (
                index > 1
                and (index - 1) % PROOF_AGENT_SESSION_RESTART_AFTER_FAILED_ROUNDS == 0
            )
            if (
                record.get("sessionGeneration") != expected_generation
                or record.get("sessionRestarted") is not expected_restarted
            ):
                raise RunnerError(
                    f"{context}: proof-agent session restart schedule drifted at round {index}"
                )
            session_id = record.get("sessionId")
            if (
                allow_terminal_unavailable_session
                and index == len(rounds)
                and terminal_round_has_unavailable_session(record)
            ):
                continue
            if not isinstance(session_id, str) or not session_id.strip():
                raise RunnerError(f"{context}: proof-agent round {index} has no sessionId")
            active = generation_sessions.get(expected_generation)
            if active is None:
                if session_id in seen_sessions:
                    raise RunnerError(
                        f"{context}: proof-agent session was reused after a bounded restart"
                    )
                generation_sessions[expected_generation] = session_id
                seen_sessions.add(session_id)
            elif active != session_id:
                raise RunnerError(
                    f"{context}: proof-agent session changed inside generation "
                    f"{expected_generation}"
                )
        return

    expected_workspace_generation = 1
    expected_session_generation = 1
    failed_rounds_in_session = 0
    for index, record in enumerate(rounds, start=1):
        if index == 1:
            expected_restarted = False
            expected_restart_reason = None
            expected_checkpoint_transition = "newWorkspaceInitial"
        elif (index - 1) in workspace_transitions_by_round:
            transition = workspace_transitions_by_round[index - 1]
            expected_workspace_generation = transition["toWorkspaceGeneration"]
            expected_session_generation += 1
            expected_restarted = True
            expected_restart_reason = "fixedWitnessReplacement"
            expected_checkpoint_transition = "newWorkspaceInitial"
            failed_rounds_in_session = 0
        elif failed_rounds_in_session >= PROOF_AGENT_SESSION_RESTART_AFTER_FAILED_ROUNDS:
            expected_session_generation += 1
            expected_restarted = True
            expected_restart_reason = "failedRoundLimit"
            expected_checkpoint_transition = "restoredExisting"
            failed_rounds_in_session = 0
        else:
            expected_restarted = False
            expected_restart_reason = None
            expected_checkpoint_transition = "continued"

        restart_reason_present = "sessionRestartReason" in record
        if (
            record.get("workspaceGeneration") != expected_workspace_generation
            or record.get("sessionGeneration") != expected_session_generation
            or record.get("sessionRestarted") is not expected_restarted
            or record.get("checkpointTransition") != expected_checkpoint_transition
            or record.get("compileCheckpointRestored")
            is not (expected_checkpoint_transition == "restoredExisting")
            or (
                expected_restart_reason is None
                and (restart_reason_present or record.get("sessionRestartReason") is not None)
            )
            or (
                expected_restart_reason is not None
                and record.get("sessionRestartReason") != expected_restart_reason
            )
        ):
            raise RunnerError(
                f"{context}: proof-agent session restart schedule drifted at round {index}"
            )
        session_id = record.get("sessionId")
        unavailable_session_is_bound = (
            round_has_unresumable_session_suffix(record)
            and index in workspace_transitions_by_round
        ) or (
            allow_terminal_unavailable_session
            and index == len(rounds)
            and (
                round_has_unresumable_session_suffix(record)
                or (
                    record.get("success") is True
                    and round_has_session_telemetry_failure(record)
                )
            )
        )
        if unavailable_session_is_bound:
            continue
        if not isinstance(session_id, str) or not session_id.strip():
            raise RunnerError(f"{context}: proof-agent round {index} has no sessionId")
        active = generation_sessions.get(expected_session_generation)
        if active is None:
            if session_id in seen_sessions:
                raise RunnerError(
                    f"{context}: proof-agent session was reused after a bounded restart"
                )
            generation_sessions[expected_session_generation] = session_id
            seen_sessions.add(session_id)
        elif active != session_id:
            raise RunnerError(
                f"{context}: proof-agent session changed inside generation "
                f"{expected_session_generation}"
            )
        if record.get("success") is True and index < len(rounds):
            raise RunnerError(f"{context}: successful proof-agent round is not terminal")
        if record.get("success") is not True and index not in workspace_transitions_by_round:
            failed_rounds_in_session += 1


def validate_proof_round_audit(
    round_record: dict[str, Any], description: str
) -> None:
    """Validate one round's audit without requiring failed WIP to be clean.

    Only a successful round may contribute the final certificate.  Earlier
    rounds are intentionally allowed to fail their deterministic source audit;
    retaining those findings is part of the fail-closed repair transcript.
    """
    audit = round_record.get("audit")
    if not isinstance(audit, dict) or not isinstance(audit.get("passed"), bool):
        raise RunnerError(f"{description} deterministic audit is malformed")
    validate_diagnostic_agent_audit(
        audit,
        expected_passed=audit["passed"],
        description=f"{description} deterministic audit",
    )
    if round_record.get("success") is True and audit["passed"] is not True:
        raise RunnerError(
            f"{description} claims success despite a rejected deterministic audit"
        )
    if audit["passed"] is False and (
        round_record.get("proofCheckExitCode") is not None
        or round_record.get("proofCheckElapsedMs") is not None
        or round_record.get("proofCheckTimedOut") is not False
    ):
        raise RunnerError(
            f"{description} ran a final trusted check after a rejected audit"
        )


def validate_failed_round_run_record_binding(
    report_round: dict[str, Any], run_record: dict[str, Any], description: str
) -> None:
    """Bind a terminal report round to run.json plus the host repair suffix."""
    report_without_error = dict(report_round)
    run_without_error = dict(run_record)
    report_error = report_without_error.pop("error", None)
    run_error = run_without_error.pop("error", None)
    if (
        report_without_error != run_without_error
        or not isinstance(run_error, str)
        or not isinstance(report_error, str)
        or not report_error.startswith(run_error + "; ")
    ):
        raise RunnerError(f"{description} differs from its source run record")


def validate_deterministic_tail_recovery(
    proof: dict[str, Any],
    rounds: list[dict[str, Any]],
    case_dir: Path,
    config: RunConfig,
) -> int | None:
    """Validate a host-only final check recovered from a broker checkpoint."""
    value = proof.get("deterministicTailRecovery")
    if value is None:
        return None
    expected_keys = {
        "schemaVersion",
        "status",
        "recoveredAt",
        "claim",
        "sourceFailure",
        "checkpoint",
        "stagingWorkspace",
        "trustedCheck",
        "publishedProblem",
    }
    if not isinstance(value, dict) or set(value) != expected_keys:
        raise RunnerError("deterministic-tail recovery record is malformed")
    if (
        value.get("schemaVersion") != 1
        or value.get("status") != "published"
        or value.get("claim") not in {"equivalence", "formal_countermodel"}
    ):
        raise RunnerError("deterministic-tail recovery status is invalid")
    if not isinstance(value.get("recoveredAt"), str) or not value["recoveredAt"]:
        raise RunnerError("deterministic-tail recovery timestamp is invalid")
    if not rounds:
        raise RunnerError("deterministic-tail recovery has no source agent round")
    if any(
        record.get("success") is True
        or (
            record.get("proofCheckExitCode") == 0
            and record.get("proofCheckTimedOut") is False
        )
        for record in rounds
    ):
        raise RunnerError(
            "deterministic-tail recovery is redundant with an accepted agent round"
        )

    final_round = rounds[-1]
    source = value.get("sourceFailure")
    if not isinstance(source, dict) or set(source) != {
        "round",
        "agentExitCode",
        "agentError",
        "agentUsageError",
        "runRecord",
        "stderr",
    }:
        raise RunnerError("deterministic-tail source-failure binding is malformed")
    round_index = source.get("round")
    if (
        isinstance(round_index, bool)
        or not isinstance(round_index, int)
        or round_index != len(rounds)
        or final_round.get("round") != round_index
        or final_round.get("success") is not False
        or final_round.get("exitCode") != 2
        or source.get("agentExitCode") != final_round.get("exitCode")
        or source.get("agentError") != final_round.get("error")
        or source.get("agentUsageError") != final_round.get("usageError")
        or not terminal_round_has_unavailable_session(final_round)
    ):
        raise RunnerError("deterministic-tail source failure is not the terminal export failure")
    round_root = f"proof-stage/proof-agent/rounds/{round_index:02d}"
    run_record_path = validate_diagnostic_artifact_binding(
        case_dir,
        source.get("runRecord"),
        f"{round_root}/run.json",
        "deterministic-tail source run record",
    )
    source_run_record = read_json_object(
        run_record_path, "deterministic-tail source run record"
    )
    validate_failed_round_run_record_binding(
        final_round, source_run_record, "deterministic-tail source round"
    )
    stderr_path = validate_diagnostic_artifact_binding(
        case_dir,
        source.get("stderr"),
        f"{round_root}/stderr.txt",
        "deterministic-tail source stderr",
    )
    try:
        source_stderr = stderr_path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise RunnerError(f"deterministic-tail source stderr is unreadable: {error}") from error
    if "proof-agent container produced an unsafe or invalid export archive" not in source_stderr:
        raise RunnerError("deterministic-tail source failure is not a Docker export failure")

    checkpoint = value.get("checkpoint")
    if not isinstance(checkpoint, dict) or set(checkpoint) != {
        "round",
        "sequence",
        "problem",
        "request",
        "invocation",
        "audit",
    }:
        raise RunnerError("deterministic-tail checkpoint binding is malformed")
    sequence = checkpoint.get("sequence")
    if (
        checkpoint.get("round") != round_index
        or isinstance(sequence, bool)
        or not isinstance(sequence, int)
        or sequence < 1
    ):
        raise RunnerError("deterministic-tail checkpoint identity is invalid")
    diagnostic_root = f"{round_root}/interactive-diagnostics/{sequence:02d}"
    checkpoint_problem = validate_diagnostic_artifact_binding(
        case_dir,
        checkpoint.get("problem"),
        f"{diagnostic_root}/checked-workspace/Problem.v",
        "deterministic-tail checkpoint Problem.v",
    )
    checkpoint_request = validate_diagnostic_artifact_binding(
        case_dir,
        checkpoint.get("request"),
        f"{diagnostic_root}/request.json",
        "deterministic-tail checkpoint request",
    )
    checkpoint_invocation = validate_diagnostic_artifact_binding(
        case_dir,
        checkpoint.get("invocation"),
        f"{diagnostic_root}/invocation.json",
        "deterministic-tail checkpoint invocation",
    )
    checkpoint_audit = validate_diagnostic_artifact_binding(
        case_dir,
        checkpoint.get("audit"),
        f"{diagnostic_root}/audit.json",
        "deterministic-tail checkpoint audit",
    )
    invocation = read_json_object(
        checkpoint_invocation, "deterministic-tail checkpoint invocation"
    )
    invocations = final_round.get("diagnosticCheckerInvocations")
    if (
        not isinstance(invocations, list)
        or sequence > len(invocations)
        or invocation != invocations[sequence - 1]
        or invocation.get("sequence") != sequence
        or invocation.get("mode") != "problem"
        or invocation.get("candidatePath") != "Problem.v"
        or invocation.get("candidateSha256") != sha256_file(checkpoint_problem)
        or invocation.get("compilePassed") is not True
        or invocation.get("problemCompilePassed") is not True
        or invocation.get("compileCheckpointAdvanced") is not True
        or invocation.get("exitCode") != 0
        or invocation.get("timedOut") is not False
        or final_round.get("updatedProblemCompileCheckpointSha256")
        != invocation.get("candidateSha256")
    ):
        raise RunnerError("deterministic-tail checkpoint was not the retained passing checkpoint")
    request = read_json_object(checkpoint_request, "deterministic-tail checkpoint request")
    validate_diagnostic_request_v2(
        request,
        mode="problem",
        candidate_path="Problem.v",
        purpose=invocation.get("purpose"),
        candidate_sha256=invocation["candidateSha256"],
        candidate_bytes=checkpoint_problem.stat().st_size,
        requested_timeout_seconds=invocation.get("requestedTimeoutSeconds"),
        description="deterministic-tail checkpoint request",
    )
    validate_diagnostic_agent_audit(
        read_json_object(checkpoint_audit, "deterministic-tail checkpoint audit"),
        expected_passed=True,
        description="deterministic-tail checkpoint audit",
    )
    try:
        checkpoint_text = checkpoint_problem.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise RunnerError(f"deterministic-tail checkpoint is unreadable: {error}") from error
    declared_claim = (
        "equivalence"
        if problem_declares_equivalence_claim(checkpoint_text)
        else (
            "formal_countermodel"
            if problem_declares_formal_countermodel_claim(checkpoint_text)
            else None
        )
    )
    if (
        config.verification_mode != "outcome-unconditional"
        or declared_claim != value.get("claim")
        or not problem_declares_final_theorem(
            checkpoint_text, config.verification_mode
        )
    ):
        raise RunnerError("deterministic-tail checkpoint lacks the unique required claim/theorem")

    staging = value.get("stagingWorkspace")
    if not isinstance(staging, dict) or set(staging) != {"path", "manifest"}:
        raise RunnerError("deterministic-tail staging workspace binding is malformed")
    staging_relative = "proof-stage/deterministic-tail-recovery/staging-workspace"
    if staging.get("path") != staging_relative:
        raise RunnerError("deterministic-tail staging workspace path is not canonical")
    staging_root = resolve_case_artifact(
        case_dir, staging_relative, "deterministic-tail staging workspace"
    )
    if not staging_root.is_dir() or staging_root.is_symlink():
        raise RunnerError("deterministic-tail staging workspace is missing")
    manifest_path = validate_diagnostic_artifact_binding(
        case_dir,
        staging.get("manifest"),
        "proof-stage/deterministic-tail-recovery/staging-manifest.json",
        "deterministic-tail staging manifest",
    )
    manifest = read_json_object(manifest_path, "deterministic-tail staging manifest")
    order_binding = manifest.get("proofModuleOrder")
    if not isinstance(order_binding, dict) or set(order_binding) != {
        "path",
        "sha256",
        "bytes",
        "modules",
    }:
        raise RunnerError("deterministic-tail proof-module order binding is malformed")
    modules = order_binding.get("modules")
    if (
        order_binding.get("path") != "proof-module-order.txt"
        or not isinstance(modules, list)
        or len(modules) != len(set(modules))
        or any(
            not isinstance(name, str)
            or re.fullmatch(r"[A-Z][A-Za-z0-9_]*\.v", name) is None
            for name in modules
        )
    ):
        raise RunnerError("deterministic-tail proof-module order is invalid")
    order_path = (
        case_dir / "proof-stage/deterministic-tail-recovery/proof-module-order.txt"
    )
    require_regular_nonsymlink_file(
        order_path, "deterministic-tail proof-module order", allow_empty=True
    )
    if (
        order_binding.get("sha256") != sha256_file(order_path)
        or order_binding.get("bytes") != order_path.stat().st_size
        or order_path.read_text(encoding="utf-8")
        != "".join(f"{name}\n" for name in modules)
    ):
        raise RunnerError("deterministic-tail proof-module order binding drifted")
    expected_names = [
        "Schema.v",
        "Queries.v",
        "Witness.v",
        "Problem.v",
        "Goal.v",
        *(f"ProofModules/{name}" for name in modules),
    ]
    if (
        set(manifest)
        != {"schemaVersion", "checkpointSha256", "proofModuleOrder", "files"}
        or manifest.get("schemaVersion") != 2
        or manifest.get("checkpointSha256") != invocation["candidateSha256"]
        or not isinstance(manifest.get("files"), list)
        or [entry.get("name") for entry in manifest["files"] if isinstance(entry, dict)]
        != expected_names
    ):
        raise RunnerError("deterministic-tail staging manifest is malformed")
    require_real_directory(
        staging_root / "ProofModules",
        "deterministic-tail staging ProofModules",
    )
    expected_staging_root_entries = {
        "Schema.v",
        "Queries.v",
        "Witness.v",
        "Problem.v",
        "Goal.v",
        "ProofModules",
    }
    if {entry.name for entry in staging_root.iterdir()} != expected_staging_root_entries:
        raise RunnerError("deterministic-tail staging workspace contains extra roots")
    if {
        entry.name for entry in (staging_root / "ProofModules").iterdir()
    } != set(modules):
        raise RunnerError("deterministic-tail staging ProofModules differ from order")
    for entry, name in zip(manifest["files"], expected_names, strict=True):
        if not isinstance(entry, dict) or set(entry) != {"name", "sha256", "bytes"}:
            raise RunnerError("deterministic-tail staging file binding is malformed")
        path = staging_root / name
        if not path.is_file() or path.is_symlink():
            raise RunnerError(f"deterministic-tail staging file is invalid: {name}")
        if entry.get("sha256") != sha256_file(path) or entry.get("bytes") != path.stat().st_size:
            raise RunnerError(f"deterministic-tail staging file drifted: {name}")
        expected_source = checkpoint_problem if name == "Problem.v" else (
            case_dir / "proof-stage/formal-sql" / name
        )
        require_regular_nonsymlink_file(
            expected_source, f"deterministic-tail authoritative source {name}"
        )
        if path.read_bytes() != expected_source.read_bytes():
            raise RunnerError(f"deterministic-tail staging source binding drifted: {name}")

    trusted = value.get("trustedCheck")
    if not isinstance(trusted, dict) or set(trusted) != {
        "checker",
        "timeoutSeconds",
        "startedAtUnixMs",
        "elapsedMs",
        "exitCode",
        "timedOut",
        "stdout",
        "stderr",
    }:
        raise RunnerError("deterministic-tail trusted-check binding is malformed")
    validate_diagnostic_artifact_binding(
        case_dir,
        trusted.get("checker"),
        "proof-stage/proof-agent/trusted-launcher/run-trusted-rocq-check.sh",
        "deterministic-tail trusted checker",
    )
    validate_diagnostic_artifact_binding(
        case_dir,
        trusted.get("stdout"),
        "proof-stage/deterministic-tail-recovery/trusted-check.stdout.txt",
        "deterministic-tail trusted-check stdout",
    )
    validate_diagnostic_artifact_binding(
        case_dir,
        trusted.get("stderr"),
        "proof-stage/deterministic-tail-recovery/trusted-check.stderr.txt",
        "deterministic-tail trusted-check stderr",
    )
    trusted_elapsed = nonnegative_integer(
        trusted.get("elapsedMs"), "deterministic-tail trusted-check elapsedMs"
    )
    nonnegative_integer(
        trusted.get("startedAtUnixMs"), "deterministic-tail trusted-check start"
    )
    if (
        trusted.get("timeoutSeconds") != config.proof_check_timeout_seconds
        or trusted.get("exitCode") != 0
        or trusted.get("timedOut") is not False
    ):
        raise RunnerError("deterministic-tail trusted check was not accepted")

    published = validate_diagnostic_artifact_binding(
        case_dir,
        value.get("publishedProblem"),
        "proof-stage/formal-sql/Problem.v",
        "deterministic-tail published Problem.v",
    )
    if (
        sha256_file(published) != invocation["candidateSha256"]
        or published.read_bytes() != checkpoint_problem.read_bytes()
    ):
        raise RunnerError("deterministic-tail published Problem.v differs from checkpoint")
    return trusted_elapsed


def require_regular_nonsymlink_file(
    path: Path, description: str, *, allow_empty: bool = False
) -> None:
    try:
        metadata = path.lstat()
    except OSError as error:
        raise RunnerError(f"{description} is missing: {path}: {error}") from error
    if not stat.S_ISREG(metadata.st_mode) or (not allow_empty and metadata.st_size == 0):
        raise RunnerError(
            f"{description} is not a valid regular non-symlink file: {path}"
        )


def require_real_directory(path: Path, description: str) -> None:
    try:
        metadata = path.lstat()
    except OSError as error:
        raise RunnerError(f"{description} is missing: {path}: {error}") from error
    if not stat.S_ISDIR(metadata.st_mode):
        raise RunnerError(f"{description} is not a real directory: {path}")


def require_real_directory_chain(
    base: Path, path: Path, description: str
) -> None:
    """Reject symlinked/non-directory ancestors beneath a trusted case root."""
    try:
        relative = path.relative_to(base)
    except ValueError as error:
        raise RunnerError(f"{description} escapes its case directory: {path}") from error
    require_real_directory(base, f"{description} case root")
    current = base
    for part in relative.parts:
        current /= part
        require_real_directory(current, description)


def validate_trusted_diagnostic_cache(
    case_dir: Path,
    authority: dict[str, Any],
    *,
    expected_manifest_value: str = (
        "proof-stage/proof-agent/trusted-diagnostic-cache/SHA256SUMS"
    ),
    source_binding_root: Path | None = None,
) -> dict[str, str]:
    """Validate the exact cache accepted by the trusted checker.

    The returned map binds each checked module candidate path to its source
    digest.  Diagnostic telemetry may use it as independent evidence that a
    late wrapper signal happened after an atomic cache publication.
    """
    manifest_value = authority.get(
        "diagnosticCacheManifestPath", authority.get("manifestPath")
    )
    if manifest_value != expected_manifest_value:
        raise RunnerError("trusted diagnostic cache manifest path is invalid")

    cache_dir = case_dir / Path(expected_manifest_value).parent
    manifest_path = cache_dir / "SHA256SUMS"
    require_real_directory(cache_dir, "trusted diagnostic cache")
    require_regular_nonsymlink_file(
        manifest_path, "trusted diagnostic cache manifest"
    )
    manifest_sha256 = authority.get(
        "diagnosticCacheManifestSha256", authority.get("manifestSha256")
    )
    if manifest_sha256 != sha256_file(manifest_path):
        raise RunnerError("trusted diagnostic cache manifest digest drifted")

    proof_modules_dir = cache_dir / "ProofModules"
    require_real_directory(proof_modules_dir, "trusted proof-module cache")
    order_path = proof_modules_dir / "ORDER"
    require_regular_nonsymlink_file(
        order_path, "trusted proof-module order", allow_empty=True
    )
    try:
        order_text = order_path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise RunnerError("trusted proof-module order is not UTF-8 text") from error
    module_names = order_text.splitlines()
    if order_text != "".join(f"{name}\n" for name in module_names):
        raise RunnerError("trusted proof-module order is not canonical")
    if (
        len(module_names) != len(set(module_names))
        or any(
            re.fullmatch(r"[A-Z][A-Za-z0-9_]*\.v", name) is None
            for name in module_names
        )
    ):
        raise RunnerError("trusted proof-module order has invalid or duplicate entries")

    expected_root_entries = set(TRUSTED_DIAGNOSTIC_CACHE_ENTRIES) | {
        "SHA256SUMS",
        "ProofModules",
    }
    actual_root_entries = {entry.name for entry in cache_dir.iterdir()}
    if actual_root_entries != expected_root_entries:
        raise RunnerError("trusted diagnostic cache contains unexpected root entries")

    expected_module_entries = {"ORDER"}
    for name in module_names:
        expected_module_entries.add(name)
        expected_module_entries.add(f"{name[:-2]}.vo")
    actual_module_entries = {entry.name for entry in proof_modules_dir.iterdir()}
    if actual_module_entries != expected_module_entries:
        raise RunnerError(
            "trusted proof-module cache differs from its exact ordered source/object set"
        )

    ordered_manifest_entries = list(TRUSTED_DIAGNOSTIC_CACHE_ENTRIES) + [
        "ProofModules/ORDER"
    ]
    checked_modules: dict[str, str] = {}
    for name in TRUSTED_DIAGNOSTIC_CACHE_ENTRIES:
        require_regular_nonsymlink_file(
            cache_dir / name, f"trusted diagnostic cache entry {name}"
        )
    for name in module_names:
        source_relative = f"ProofModules/{name}"
        object_relative = f"ProofModules/{name[:-2]}.vo"
        require_regular_nonsymlink_file(
            cache_dir / source_relative,
            f"trusted proof-module source {source_relative}",
        )
        require_regular_nonsymlink_file(
            cache_dir / object_relative,
            f"trusted proof-module object {object_relative}",
        )
        ordered_manifest_entries.extend((source_relative, object_relative))
        checked_modules[source_relative] = sha256_file(cache_dir / source_relative)

    expected_manifest = "".join(
        f"{sha256_file(cache_dir / name)}  {name}\n"
        for name in ordered_manifest_entries
    )
    try:
        actual_manifest = manifest_path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise RunnerError("trusted diagnostic cache manifest is not UTF-8 text") from error
    if actual_manifest != expected_manifest:
        raise RunnerError("trusted diagnostic cache manifest is not canonical")

    formal_root = source_binding_root or (case_dir / "proof-stage/formal-sql")
    require_real_directory(formal_root, "cache-bound proof workspace")
    for name in TRUSTED_DIAGNOSTIC_CACHE_SOURCE_ENTRIES:
        final_source = formal_root / name
        require_regular_nonsymlink_file(
            final_source, f"cache-bound generated source {name}"
        )
        if (cache_dir / name).read_bytes() != final_source.read_bytes():
            raise RunnerError("trusted diagnostic cache source binding drifted")

    final_module_root = formal_root / "ProofModules"
    try:
        final_module_metadata = final_module_root.lstat()
    except FileNotFoundError:
        if module_names:
            raise RunnerError("cache-bound workspace is missing checked ProofModules")
    except OSError as error:
        raise RunnerError("cannot inspect final ProofModules workspace") from error
    else:
        if not stat.S_ISDIR(final_module_metadata.st_mode):
            raise RunnerError("cache-bound ProofModules workspace is not a real directory")
        final_entries = {entry.name for entry in final_module_root.iterdir()}
        if final_entries != set(module_names):
            raise RunnerError(
                "cache-bound ProofModules workspace differs from the checked module order"
            )
        for name in module_names:
            final_source = final_module_root / name
            require_regular_nonsymlink_file(
                final_source, f"cache-bound checked proof module {name}"
            )
            if final_source.read_bytes() != (proof_modules_dir / name).read_bytes():
                raise RunnerError(
                    f"final checked proof module differs from trusted cache: {name}"
                )
    return checked_modules


def canonical_json_sha256(value: Any, description: str) -> str:
    try:
        encoded = json.dumps(
            value,
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
            allow_nan=False,
        ).encode("utf-8")
    except (TypeError, ValueError, UnicodeError) as error:
        raise RunnerError(f"{description} is not canonical JSON data") from error
    return hashlib.sha256(encoded).hexdigest()


def validate_generation_preflight(
    case_dir: Path,
    generation: int,
    value: Any,
    config: RunConfig,
) -> tuple[int, dict[str, Any] | None]:
    expected_keys = {"timeoutSeconds", "elapsedMs", "exitCode", "timedOut"}
    if not isinstance(value, dict) or set(value) != expected_keys:
        raise RunnerError(
            f"workspace generation {generation} trusted preflight is malformed"
        )
    elapsed = nonnegative_integer(
        value.get("elapsedMs"),
        f"workspace generation {generation} trusted preflight elapsedMs",
    )
    if (
        value.get("timeoutSeconds") != config.proof_check_timeout_seconds
        or value.get("exitCode") != 0
        or value.get("timedOut") is not False
    ):
        raise RunnerError(
            f"workspace generation {generation} trusted preflight was not accepted"
        )
    root = case_dir / (
        "proof-stage/proof-agent/workspace-generations/"
        f"{generation:04d}/trusted-environment-preflight"
    )
    require_real_directory(
        root, f"workspace generation {generation} trusted preflight evidence"
    )
    if {entry.name for entry in root.iterdir()} != {
        "stdout.txt",
        "stderr.txt",
        "invocation.json",
    }:
        raise RunnerError(
            f"workspace generation {generation} trusted preflight evidence is not exact"
        )
    for name in ("stdout.txt", "stderr.txt"):
        require_regular_nonsymlink_file(
            root / name,
            f"workspace generation {generation} trusted preflight {name}",
            allow_empty=True,
        )
    invocation_path = root / "invocation.json"
    require_regular_nonsymlink_file(
        invocation_path,
        f"workspace generation {generation} trusted preflight invocation",
    )
    if read_json_object(
        invocation_path,
        f"workspace generation {generation} trusted preflight invocation",
    ) != value:
        raise RunnerError(
            f"workspace generation {generation} trusted preflight report/artifact drifted"
        )
    warning = trusted_elapsed_warning(
        phase="trusted_environment_preflight",
        timeout_seconds=config.proof_check_timeout_seconds,
        elapsed_ms=elapsed,
        workspace_generation=generation,
    )
    return elapsed, warning


def validate_generation_initial_checkpoint(
    case_dir: Path,
    generation: int,
    config: RunConfig,
    reported_evidence: Any = None,
) -> dict[str, Any]:
    root_relative = (
        "proof-stage/proof-agent/workspace-generations/"
        f"{generation:04d}/initial-problem-checkpoint"
    )
    root = case_dir / root_relative
    require_real_directory(
        root, f"workspace generation {generation} initial checkpoint"
    )
    if {entry.name for entry in root.iterdir()} != {
        "Problem.v",
        "stdout.txt",
        "stderr.txt",
        "invocation.json",
    }:
        raise RunnerError(
            f"workspace generation {generation} initial checkpoint evidence is not exact"
        )
    problem_path = root / "Problem.v"
    stdout_path = root / "stdout.txt"
    stderr_path = root / "stderr.txt"
    invocation_path = root / "invocation.json"
    require_regular_nonsymlink_file(
        problem_path, f"workspace generation {generation} initial Problem.v"
    )
    for path in (stdout_path, stderr_path):
        require_regular_nonsymlink_file(
            path,
            f"workspace generation {generation} initial checkpoint output",
            allow_empty=True,
        )
    require_regular_nonsymlink_file(
        invocation_path,
        f"workspace generation {generation} initial checkpoint invocation",
    )
    invocation = read_json_object(
        invocation_path,
        f"workspace generation {generation} initial checkpoint invocation",
    )
    required_invocation_keys = {
        "sequence",
        "mode",
        "candidateSha256",
        "candidatePath",
        "purpose",
        "compilePassed",
        "problemCompilePassed",
        "compileCheckpointAdvanced",
        "stdoutSha256",
        "stderrSha256",
        "requestedTimeoutSeconds",
        "effectiveTimeoutSeconds",
        "startedAtUnixMs",
        "elapsedMs",
        "exitCode",
        "timedOut",
    }
    if set(invocation) != required_invocation_keys:
        raise RunnerError(
            f"workspace generation {generation} initial checkpoint invocation is not strict"
        )
    problem_sha256 = sha256_file(problem_path)
    elapsed = nonnegative_integer(
        invocation.get("elapsedMs"),
        f"workspace generation {generation} initial checkpoint elapsedMs",
    )
    nonnegative_integer(
        invocation.get("startedAtUnixMs"),
        f"workspace generation {generation} initial checkpoint start",
    )
    if (
        invocation.get("sequence") != 0
        or invocation.get("mode") != "problem"
        or invocation.get("candidatePath") != "Problem.v"
        or invocation.get("purpose") != "assembly"
        or invocation.get("candidateSha256") != problem_sha256
        or invocation.get("compilePassed") is not True
        or invocation.get("problemCompilePassed") is not True
        or invocation.get("compileCheckpointAdvanced") is not True
        or invocation.get("requestedTimeoutSeconds")
        != config.proof_check_timeout_seconds
        or invocation.get("effectiveTimeoutSeconds")
        != config.proof_check_timeout_seconds
        or invocation.get("exitCode") != 0
        or invocation.get("timedOut") is not False
        or invocation.get("stdoutSha256") != sha256_file(stdout_path)
        or invocation.get("stderrSha256") != sha256_file(stderr_path)
    ):
        raise RunnerError(
            f"workspace generation {generation} initial checkpoint is incoherent"
        )
    evidence = {
        "workspaceGeneration": generation,
        "path": f"{root_relative}/Problem.v",
        "sha256": problem_sha256,
        "round": 0,
        "sequence": 0,
    }
    if reported_evidence is not None and reported_evidence != evidence:
        raise RunnerError(
            f"workspace generation {generation} initial checkpoint binding drifted"
        )
    return {
        **evidence,
        "elapsedMs": elapsed,
        "warning": trusted_elapsed_warning(
            phase="initial_problem_compile",
            timeout_seconds=config.proof_check_timeout_seconds,
            elapsed_ms=elapsed,
            workspace_generation=generation,
        ),
    }


def validate_round_context_snapshots(
    case_dir: Path,
    case: BenchmarkCase,
    rounds: list[dict[str, Any]],
    config: RunConfig,
    static_prompt_and_primer_bytes: int,
) -> dict[int, str]:
    digests: dict[int, str] = {}
    for index, record in enumerate(rounds, start=1):
        generation = nonnegative_integer(
            record.get("workspaceGeneration"),
            f"proof-agent round {index} workspaceGeneration",
        )
        digest = record.get("contextManifestSha256")
        if generation < 1 or not isinstance(digest, str) or re.fullmatch(
            r"[0-9a-f]{64}", digest
        ) is None:
            raise RunnerError(f"proof-agent round {index} context identity is invalid")
        snapshot_root = (
            case_dir
            / f"proof-stage/proof-agent/rounds/{index:02d}/checked-workspace"
        )
        require_real_directory_chain(
            case_dir, snapshot_root, f"proof-agent round {index} checked workspace"
        )
        path = snapshot_root / "context-manifest.json"
        require_regular_nonsymlink_file(
            path, f"proof-agent round {index} context manifest"
        )
        manifest = read_json_object(
            path, f"proof-agent round {index} context manifest"
        )
        if sha256_file(path) != digest:
            raise RunnerError(f"proof-agent round {index} context manifest drifted")
        validate_context_manifest_at_root(
            snapshot_root,
            manifest,
            case,
            config,
            static_prompt_and_primer_bytes,
            f"proof-agent round {index} context",
        )
        digests[index] = digest
    return digests


def validate_proof_workspace_transitions(
    proof: dict[str, Any],
    case: BenchmarkCase,
    rounds: list[dict[str, Any]],
    context: dict[str, Any],
    agent: dict[str, Any],
    case_dir: Path,
    config: RunConfig,
) -> dict[str, Any]:
    transitions = proof.get("proofWorkspaceTransitions", [])
    if not isinstance(transitions, list) or any(
        not isinstance(value, dict) for value in transitions
    ):
        raise RunnerError("proofWorkspaceTransitions must be an array of objects")
    round_contexts = validate_round_context_snapshots(
        case_dir,
        case,
        rounds,
        config,
        nonnegative_integer(
            agent.get("staticPromptAndPrimerBytes"), "staticPromptAndPrimerBytes"
        ),
    )
    preflight_records: list[dict[str, Any]] = []
    checkpoint_records: list[dict[str, Any]] = []
    warnings: list[dict[str, Any]] = []

    initial_preflight = agent.get("trustedEnvironmentPreflight")
    elapsed, warning = validate_generation_preflight(
        case_dir, 1, initial_preflight, config
    )
    preflight_records.append({"workspaceGeneration": 1, "elapsedMs": elapsed})
    if warning is not None:
        warnings.append(warning)
    initial_checkpoint = validate_generation_initial_checkpoint(
        case_dir, 1, config
    )
    checkpoint_records.append(initial_checkpoint)
    if initial_checkpoint["warning"] is not None:
        warnings.append(initial_checkpoint["warning"])

    transition_keys = {
        "afterRound",
        "fromWorkspaceGeneration",
        "toWorkspaceGeneration",
        "reason",
        "triggeringHandoffSha256",
        "fromContextManifestSha256",
        "toContextManifestSha256",
        "fromTrustedDiagnosticCache",
        "newTrustedEnvironmentPreflight",
        "newInitialProblemCompileCheckpoint",
    }
    transitions_by_round: dict[int, dict[str, Any]] = {}
    module_sources_by_generation: dict[int, dict[str, str]] = {}
    current_generation = 1
    final_context_sha256 = round_contexts.get(1, context.get("manifestSha256"))
    previous_after_round = 0
    for transition_index, transition in enumerate(transitions, start=1):
        if set(transition) != transition_keys:
            raise RunnerError(
                f"proof workspace transition {transition_index} is malformed"
            )
        after_round = nonnegative_integer(
            transition.get("afterRound"), "proof workspace transition afterRound"
        )
        from_generation = nonnegative_integer(
            transition.get("fromWorkspaceGeneration"),
            "proof workspace transition from generation",
        )
        to_generation = nonnegative_integer(
            transition.get("toWorkspaceGeneration"),
            "proof workspace transition to generation",
        )
        if (
            after_round < 1
            or after_round > len(rounds)
            or after_round <= previous_after_round
            or after_round in transitions_by_round
            or from_generation != current_generation
            or to_generation != from_generation + 1
            or transition.get("reason") != "fixedWitnessReplacement"
        ):
            raise RunnerError(
                f"proof workspace transition {transition_index} generation/order drifted"
            )
        source_round = rounds[after_round - 1]
        handoff = source_round.get("counterexampleHandoff")
        if (
            not isinstance(handoff, dict)
            or set(handoff) != {"decision", "reason", "guidance"}
            or handoff.get("decision") != "counterexample_candidate"
            or not isinstance(handoff.get("reason"), str)
            or not handoff["reason"]
            or not isinstance(handoff.get("guidance"), str)
            or not handoff["guidance"]
            or transition.get("triggeringHandoffSha256")
            != canonical_json_sha256(handoff, "proof counterexample handoff")
        ):
            raise RunnerError(
                f"proof workspace transition {transition_index} handoff binding drifted"
            )
        from_context = round_contexts[after_round]
        if (
            source_round.get("workspaceGeneration") != from_generation
            or transition.get("fromContextManifestSha256") != from_context
        ):
            raise RunnerError(
                f"proof workspace transition {transition_index} source context drifted"
            )
        archived_cache = transition.get("fromTrustedDiagnosticCache")
        archived_manifest = (
            "proof-stage/proof-agent/workspace-generations/"
            f"{from_generation:04d}/trusted-diagnostic-cache/SHA256SUMS"
        )
        if (
            not isinstance(archived_cache, dict)
            or set(archived_cache)
            != {"workspaceGeneration", "manifestPath", "manifestSha256"}
            or archived_cache.get("workspaceGeneration") != from_generation
            or archived_cache.get("manifestPath") != archived_manifest
        ):
            raise RunnerError(
                f"proof workspace transition {transition_index} retired cache binding is malformed"
            )
        source_snapshot = (
            case_dir
            / f"proof-stage/proof-agent/rounds/{after_round:02d}/checked-workspace"
        )
        module_sources_by_generation[from_generation] = (
            validate_trusted_diagnostic_cache(
                case_dir,
                archived_cache,
                expected_manifest_value=archived_manifest,
                source_binding_root=source_snapshot,
            )
        )
        to_context = transition.get("toContextManifestSha256")
        if not isinstance(to_context, str) or re.fullmatch(
            r"[0-9a-f]{64}", to_context
        ) is None:
            raise RunnerError(
                f"proof workspace transition {transition_index} target context is invalid"
            )
        if after_round < len(rounds):
            next_round = rounds[after_round]
            if (
                next_round.get("workspaceGeneration") != to_generation
                or round_contexts[after_round + 1] != to_context
            ):
                raise RunnerError(
                    f"proof workspace transition {transition_index} target round drifted"
                )
        elapsed, warning = validate_generation_preflight(
            case_dir,
            to_generation,
            transition.get("newTrustedEnvironmentPreflight"),
            config,
        )
        preflight_records.append(
            {"workspaceGeneration": to_generation, "elapsedMs": elapsed}
        )
        if warning is not None:
            warnings.append(warning)
        checkpoint = validate_generation_initial_checkpoint(
            case_dir,
            to_generation,
            config,
            transition.get("newInitialProblemCompileCheckpoint"),
        )
        checkpoint_records.append(checkpoint)
        if checkpoint["warning"] is not None:
            warnings.append(checkpoint["warning"])
        if after_round < len(rounds) and (
            rounds[after_round].get("activeProblemCompileCheckpointSha256")
            != checkpoint["sha256"]
        ):
            raise RunnerError(
                f"proof workspace transition {transition_index} checkpoint was not activated"
            )
        transitions_by_round[after_round] = transition
        current_generation = to_generation
        final_context_sha256 = to_context
        previous_after_round = after_round

    if rounds:
        for index in range(1, len(rounds)):
            prior_generation = rounds[index - 1].get("workspaceGeneration")
            next_generation = rounds[index].get("workspaceGeneration")
            expected_next = (
                transitions_by_round[index]["toWorkspaceGeneration"]
                if index in transitions_by_round
                else prior_generation
            )
            if next_generation != expected_next:
                raise RunnerError(
                    f"proof-agent workspace generation changed without transition after round {index}"
                )
        if len(rounds) not in transitions_by_round:
            final_context_sha256 = round_contexts[len(rounds)]
            current_generation = rounds[-1].get("workspaceGeneration")
    if (
        context.get("manifestSha256") != final_context_sha256
        or current_generation != 1 + len(transitions)
    ):
        raise RunnerError("final proof-agent context differs from workspace transition chain")
    final_source_root = case_dir / "proof-stage/formal-sql"
    if (
        rounds
        and rounds[-1].get("workspaceGeneration") == current_generation
    ):
        final_source_root = (
            case_dir
            / f"proof-stage/proof-agent/rounds/{len(rounds):02d}/checked-workspace"
        )
    module_sources_by_generation[current_generation] = (
        validate_trusted_diagnostic_cache(
            case_dir, agent, source_binding_root=final_source_root
        )
    )
    return {
        "transitionsByRound": transitions_by_round,
        "initialCheckpoints": {
            record["workspaceGeneration"]: record for record in checkpoint_records
        },
        "preflights": preflight_records,
        "checkpoints": checkpoint_records,
        "warnings": warnings,
        "moduleSourcesByGeneration": module_sources_by_generation,
    }


PROOF_CONTEXT_AUTHORITY = (
    "navigation context only; exact SQL is pipeline input and generated Rocq plus "
    "FormalSQL and the Rocq kernel remain authoritative"
)
PROOF_CONTEXT_BINDINGS = {
