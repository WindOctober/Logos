#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
VENV_DIR="$ROOT_DIR/.cache/sqlglot-venv"
PYTHON_BIN="$VENV_DIR/bin/python"

if [[ ! -x "$PYTHON_BIN" ]]; then
  python3 -m venv "$VENV_DIR"
  "$PYTHON_BIN" -m pip install -q -r "$ROOT_DIR/frontend/sqlglot-adapter/requirements.txt"
fi

exec "$PYTHON_BIN" \
  "$ROOT_DIR/frontend/sqlglot-adapter/cosette_calcite_binding.py"
