__DEPTNO"},{"value":"DEPT__DEPTNO"}]},{"primary":[{"value":"EMP_B__EMPNO"}]},{"foreign":[{"value":"EMP_B__DEPTNO"},{"value":"DEPT__DEPTNO"}]}],"pair":["SELECT EMPNO, CASE WHEN TRUE THEN CAST(DEPTNO AS INTEGER) ELSE NULL END IN (SELECT DEPTNO FROM (SELECT EMPNO, CASE WHEN TRUE THEN CAST(DEPTNO AS INTEGER) ELSE NULL END AS DEPTNO FROM EMP) AS t WHERE EMPNO < 20) AS D FROM EMP","SELECT EMP1.EMPNO, CASE WHEN t6.c = 0 THEN FALSE WHEN CASE WHEN TRUE THEN CAST(EMP1.DEPTNO AS INTEGER) ELSE NULL END IS NULL THEN NULL WHEN t11.i IS NOT NULL THEN TRUE WHEN t6.ck < t6.c THEN NULL ELSE FALSE END AS D FROM EMP AS EMP1 CROSS JOIN (SELECT COUNT(*) AS c, COUNT(DEPTNO) AS ck FROM (SELECT EMPNO, CASE WHEN TRUE THEN CAST(DEPTNO AS INTEGER) ELSE NULL END AS DEPTNO FROM EMP) AS t3 WHERE EMPNO < 20) AS t6 LEFT JOIN (SELECT t8.DEPTNO, t9.i FROM (SELECT * FROM (SELECT EMPNO, CASE WHEN TRUE THEN CAST(DEPTNO AS INTEGER) ELSE NULL END AS DEPTNO FROM EMP) AS t7 WHERE EMPNO < 20) AS t8, (VALUES (TRUE)) AS t9 (i) GROUP BY t8.DEPTNO, t9.i) AS t11 ON CASE WHEN TRUE THEN CAST(EMP1.DEPTNO AS INTEGER) ELSE NULL END = t11.DEPTNO"]}
