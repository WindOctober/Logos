{"benchmark":"Calcite-397","index":13,"schema":{"EMP":{"EMPNO":"INT","DEPTNO":"INT","ENAME":"VARCHAR","JOB":"VARCHAR","MGR":"INT","HIREDATE":"DATE","SAL":"INT","COMM":"INT","SLACKER":"BOOLEAN"},"DEPT":{"DEPTNO":"INT","NAME":"VARCHAR"},"BONUS":{"ENAME":"VARCHAR","JOB":"VARCHAR","SAL":"INT","COMM":"INT"},"EMPNULLABLES":{"EMPNO":"INT","DEPTNO":"INT","ENAME":"VARCHAR","JOB":"VARCHAR","MGR":"INT","HIREDATE":"DATE","SAL":"INT","COMM":"INT","SLACKER":"BOOLEAN"},"EMPNULLABLES_20":{"EMPNO":"INT","DEPTNO":"INT","ENAME":"VARCHAR","JOB":"VARCHAR","MGR":"INT","HIREDATE":"DATE","SAL":"INT","COMM":"INT","SLACKER":"BOOLEAN"},"EMP_B":{"EMPNO":"INT","DEPTNO":"INT","ENAME":"VARCHAR","JOB":"VARCHAR","MGR":"INT","HIREDATE":"DATE","SAL":"INT","COMM":"INT","SLACKER":"BOOLEAN","BIRTHDATE":"DATE"}},"constraint":[{"not_null":{"value":"EMP__EMPNO"}},{"not_null":{"value":"EMP__ENAME"}},{"not_null":{"value":"EMP__JOB"}},{"not_null":{"value":"EMP__HIREDATE"}},{"not_null":{"value":"EMP__SAL"}},{"not_null":{"value":"EMP__COMM"}},{"not_null":{"value":"EMP__DEPTNO"}},{"not_null":{"value":"EMP__SLACKER"}},{"not_null":{"value":"DEPT__DEPTNO"}},{"not_null":{"value":"DEPT__NAME"}},{"not_null":{"value":"BONUS__ENAME"}},{"not_null":{"value":"BONUS__JOB"}},{"not_null":{"value":"BONUS__SAL"}},{"not_null":{"value":"BONUS__COMM"}},{"not_null":{"value":"EMP_B__EMPNO"}},{"not_null":{"value":"EMP_B__ENAME"}},{"not_null":{"value":"EMP_B__JOB"}},{"not_null":{"value":"EMP_B__HIREDATE"}},{"not_null":{"value":"EMP_B__SAL"}},{"not_null":{"value":"EMP_B__COMM"}},{"not_null":{"value":"EMP_B__DEPTNO"}},{"not_null":{"value":"EMP_B__SLACKER"}},{"not_null":{"value":"EMP_B__BIRTHDATE"}},{"primary":[{"value":"EMP__EMPNO"}]},{"foreign":[{"value":"EMP__DEPTNO"},{"value":"DEPT__DEPTNO"}]},{"primary":[{"value":"DEPT__DEPTNO"}]},{"primary":[{"value":"EMPNULLABLES__EMPNO"}]},{"foreign":[{"value":"EMPNULLABLES__DEPTNO"},{"value":"DEPT__DEPTNO"}]},{"primary":[{"value":"EMPNULLABLES_20__EMPNO"}]},{"foreign":[{"value":"EMPNULLABLES_20__DEPTNO"},{"value":"DEPT__DEPTNO"}]},{"primary":[{"value":"EMP_B__EMPNO"}]},{"foreign":[{"value":"EMP_B__DEPTNO"},{"value":"DEPT__DEPTNO"}]}],"pair":["SELECT SUM(SAL) AS SUM_SAL, COUNT(DISTINCT CASE WHEN JOB = 'CLERK' THEN DEPTNO ELSE NULL END) AS COUNT_DISTINCT_CLERK, SUM(CASE WHEN DEPTNO = 10 THEN SAL ELSE NULL END) AS SUM_SAL_D10, SUM(CASE WHEN DEPTNO = 20 THEN SAL ELSE 0 END) AS SUM_SAL_D20, SUM(CASE WHEN DEPTNO = 30 THEN 1 ELSE 0 END) AS COUNT_D30, COUNT(CASE WHEN DEPTNO = 40 THEN 'x' ELSE NULL END) AS COUNT_D40, SUM(CASE WHEN DEPTNO = 45 THEN 1 ELSE NULL END) AS COUNT_D45, SUM(CASE WHEN DEPTNO = 50 THEN 1 ELSE NULL END) AS COUNT_D50, SUM(CAST(NULL AS DECIMAL(19, 9))) AS SUM_NULL_D60, SUM(CASE WHEN DEPTNO = 70 THEN NULL ELSE 1 END) AS SUM_NULL_D70, COUNT(CASE WHEN DEPTNO = 20 THEN 1 ELSE NULL END) AS COUNT_D20 FROM EMP","SELECT SUM(SAL) AS SUM_SAL, COUNT(DISTINCT DEPTNO) FILTER (WHERE JOB = 'CLERK') AS COUNT_DISTINCT_CLERK, SUM(SAL) FILTER (WHERE DEPTNO = 10) AS SUM_SAL_D10, SUM(SAL) FILTER (WHERE DEPTNO = 20) AS SUM_SAL_D20, CAST(COUNT(*) FILTER (WHERE DEPTNO = 30) AS INTEGER) AS COUNT_D30, COUNT(*) FILTER (WHERE DEPTNO = 40) AS COUNT_D40, SUM(1) FILTER (WHERE DEPTNO = 45) AS COUNT_D45, SUM(1) FILTER (WHERE DEPTNO = 50) AS COUNT_D50, SUM(CAST(NULL AS DECIMAL(19, 9))) AS SUM_NULL_D60, SUM(1) FILTER (WHERE DEPTNO <> 70) AS SUM_NULL_D70, COUNT(*) FILTER (WHERE DEPTNO = 20) AS COUNT_D20 FROM EMP"]}
