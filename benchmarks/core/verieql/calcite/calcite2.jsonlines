_DEPTNO"},{"value":"DEPT__DEPTNO"}]},{"primary":[{"value":"EMP_B__EMPNO"}]},{"foreign":[{"value":"EMP_B__DEPTNO"},{"value":"DEPT__DEPTNO"}]}],"pair":["SELECT * FROM EMP WHERE EMPNO NOT IN (SELECT EMPNO FROM (SELECT ENAME, EMPNO, SAL AS R FROM EMP) AS t WHERE R > 2 AND EMP.ENAME = ENAME)","SELECT EMP1.EMPNO, EMP1.ENAME, EMP1.JOB, EMP1.MGR, EMP1.HIREDATE, EMP1.SAL, EMP1.COMM, EMP1.DEPTNO, EMP1.SLACKER FROM EMP AS EMP1 LEFT JOIN (SELECT COUNT(*) AS c, COUNT(*) AS ck, ENAME FROM (SELECT ENAME, EMPNO, SAL AS R FROM EMP) AS t4 WHERE R > 2 GROUP BY ENAME) AS t8 ON EMP1.ENAME = t8.ENAME LEFT JOIN (SELECT EMPNO, TRUE AS i, ENAME FROM (SELECT ENAME, EMPNO, SAL AS R FROM EMP) AS t9 WHERE R > 2) AS t11 ON EMP1.EMPNO = t11.EMPNO AND EMP1.ENAME = t11.ENAME WHERE t8.c = 0 OR (t11.i IS NOT NULL OR t8.ck < t8.c) IS NOT TRUE"]}
