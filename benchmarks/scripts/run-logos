class RunnerError(RuntimeError):
    pass


@dataclasses.dataclass(frozen=True)
class BenchmarkCase:
    case_id: str
    cohort: str
    input_dir: Path
    relative_dir: str
    schema: Path
    source: Path
    target: Path
    source_benchmark: str | None
    source_case: str | None
    flat_case_id: str | None

    def aliases(self) -> set[str]:
        values = {
            self.case_id,
            self.relative_dir,
            self.input_dir.name,
        }
        for value in (self.flat_case_id, self.source_case):
            if value:
                values.add(value)
        if self.source_benchmark and self.source_case:
            values.add(f"{self.source_benchmark}__{self.source_case}")
        return values

    def searchable_text(self) -> str:
        return "\n".join(
            sorted(self.aliases() | {self.source_benchmark or "", self.cohort})
        )


@dataclasses.dataclass(frozen=True)
class RunConfig:
    solver_bin: Path
    case_process_bootstrap: Path
    case_process_supervisor: Path
    case_process_isolation: dict[str, Any]
    proof_authority_root: Path
    run_dir: Path
    case_timeout_seconds: float
    termination_grace_seconds: float
    verification_mode: str
    postgres_url: str | None
    sql_time_zone: str
    sql_default_collation: str
    sql_character_classification: str
    sql_locale_provider: str
    sql_server_encoding: str
    solver_args: tuple[str, ...]
    proof_agent_memory_limit_mib: int
    proof_agent_storage_limit_mib: int
    statement_timeout_seconds: int
    max_counterexample_rounds: int
    proof_check_timeout_seconds: int
    proof_docker_image: str
    proof_docker_image_effective: str
    proof_docker_image_identity: dict[str, Any]
    proof_rocq_opam_switch: Path
    allow_framework_source_drift: bool
    framework_source_tree: dict[str, Any]
    input_manifest: dict[str, Any]
    input_files: dict[str, dict[str, Any]]
    solver_binary: dict[str, Any]
    rocq_authority_snapshot: dict[str, Any]
    trusted_stack: dict[str, Any]
    frontend_stack: dict[str, Any]
    codex_provider: dict[str, Any]
    postgres_server_profile: dict[str, Any]
    codex_runtime_home: Path
    cohort16_gate: dict[str, Any] | None
    frozen_benchmark: dict[str, Any] | None
    rbot_authority: dict[str, Any] | None
    model: str = EXPECTED_MODEL
    reasoning_effort: str = EXPECTED_REASONING_EFFORT


class ProcessRegistry:
    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._processes: dict[int, ManagedProcess] = {}

    def register(self, process: subprocess.Popen[bytes]) -> "ManagedProcess":
        managed = ManagedProcess(process)
        with self._lock:
            self._processes[process.pid] = managed
        return managed

    def unregister(self, managed: "ManagedProcess") -> None:
        with self._lock:
            current = self._processes.get(managed.pid)
            if current is managed:
                self._processes.pop(managed.pid, None)
        managed.close()

    def terminate_all(self, grace_seconds: float) -> None:
        with self._lock:
            processes = list(self._processes.values())
        terminate_process_trees(processes, grace_seconds)


class ManagedProcess:
    """Own one unreaped case supervisor and its identity-bound pidfd.

    Worker waits observe the pidfd without reaping.  Reaping and every signal
    are serialized by ``_lock`` so a live cleanup can use the process group for
    one graceful TERM without a check-to-signal PID/PGID reuse window.
    """

    def __init__(self, process: subprocess.Popen[bytes]) -> None:
        self.process = process
        self.pid = process.pid
        self._lock = threading.RLock()
        self._return_code: int | None = None
        self._closed = False
        self._pidfd = pidfd_open(self.pid)
        if self._pidfd is None:
            # A direct child cannot have its PID reused before this parent reaps
            # it.  If pidfd_open nevertheless observes it as gone, reap exactly
            # that Popen and retain an already-finished managed record.
            self._return_code = process.wait()

    def has_exited(self) -> bool:
        with self._lock:
            if self._return_code is not None:
                return True
            descriptor = self._pidfd
        return descriptor is not None and wait_for_pidfd_exit(descriptor, 0.0)

    def _reap_locked(self) -> int:
        if self._return_code is None:
            descriptor = self._pidfd
            if descriptor is None or not wait_for_pidfd_exit(descriptor, 0.0):
                raise RunnerError(
                    f"case process supervisor {self.pid} is not ready to reap"
                )
            try:
                self._return_code = self.process.wait(timeout=1.0)
            except subprocess.TimeoutExpired as error:
                raise RunnerError(
                    f"case process supervisor {self.pid} pidfd reported exit but wait did not"
                ) from error
        return self._return_code

    def wait(self, timeout_seconds: float) -> int:
        with self._lock:
            if self._return_code is not None:
                return self._return_code
            descriptor = self._pidfd
        if descriptor is None or not wait_for_pidfd_exit(descriptor, timeout_seconds):
            raise subprocess.TimeoutExpired(self.process.args, timeout_seconds)
        with self._lock:
            return self._reap_locked()

    def close(self) -> None:
        with self._lock:
            if self._closed:
                return
            if self._return_code is None:
                raise RunnerError(
                    f"refusing to release unreaped case process supervisor {self.pid}"
                )
            if self._pidfd is not None:
                os.close(self._pidfd)
                self._pidfd = None
            self._closed = True


def main() -> int:
    parser = argument_parser()
    args = parser.parse_args()
    try:
        validate_args(args)
        input_root = resolve_path(args.input_root)
        cases = discover_cases(input_root)
        selected = select_cases(cases, args)
        rbot_authority = validate_rbot_input_authority(
            input_root,
            cases,
            selected,
            require_exact_selection=canonical_rbot_selection_requested(args),
        )
        if args.list:
            print_case_list(selected)
            return 0

        validate_frozen_full_launch_request(input_root, cases, selected, args)

        solver_source_bin = resolve_path(args.solver_bin)
        requested_proof_rocq_opam_switch = resolve_path(args.proof_rocq_opam_switch)
        run_dir = prepare_run_dir(args.run_dir, resume=args.resume)
        if not args.resume and not args.no_build:
            build_solver()
        if not args.resume:
            prepare_frontend_stack()
        if not args.resume and (
            not solver_source_bin.is_file()
            or not os.access(solver_source_bin, os.X_OK)
        ):
            raise RunnerError(
                f"solver binary is missing or not executable: {solver_source_bin}; "
                "build it or pass --solver-bin"
            )
        solver_bin = pin_solver_binary(
            solver_source_bin,
            run_dir,
            resume=args.resume,
        )
        case_process_bootstrap = pin_case_process_bootstrap(
            run_dir,
            resume=args.resume,
        )
        case_process_supervisor = pin_case_process_supervisor(
            run_dir,
            resume=args.resume,
        )
        validate_case_process_isolation(
            case_process_bootstrap,
            case_process_supervisor,
        )
        case_process_isolation = case_process_isolation_record(
            case_process_bootstrap,
            case_process_supervisor,
            run_dir,
        )
        framework_source_tree = framework_source_tree_record(
            run_dir,
            resume=args.resume,
            allow_drift=args.allow_framework_source_drift,
        )
        rocq_runtime_snapshot = pin_trusted_rocq_runtime(
            requested_proof_rocq_opam_switch,
            run_dir,
            resume=args.resume,
        )
        proof_rocq_opam_switch = resolve_artifact_path(
            rocq_runtime_snapshot["root"]
        )
        rocq_authority_snapshot = pin_trusted_rocq_authority(
            LOGOS_ROOT,
            run_dir,
            proof_rocq_opam_switch,
            rocq_runtime_snapshot,
            framework_source_tree,
            resume=args.resume,
        )
        proof_authority_root = resolve_artifact_path(
            rocq_authority_snapshot["root"]
        )
        input_manifest, input_files = input_manifest_record(
            run_dir,
            cases,
            selected,
            frozen=input_root.resolve() == LEGACY_FROZEN_INPUT_ROOT.resolve(),
            resume=args.resume,
        )
        solver_binary = solver_binary_record(solver_bin)
        trusted_stack = trusted_stack_record(
            run_dir,
            proof_rocq_opam_switch,
            proof_authority_root,
            rocq_runtime_snapshot,
            rocq_authority_snapshot,
            resume=args.resume,
        )
        frontend_stack = frontend_stack_record(
            run_dir,
            resume=args.resume,
        )
        codex_provider, codex_source_home = codex_provider_record(
            run_dir,
            resume=args.resume,
        )
        frozen_benchmark = frozen_benchmark_record(input_root, cases, selected)
        proof_docker_image_identity = resolve_docker_image_identity(
            args.proof_docker_image
        )
        effective_postgres_url = args.postgres_url or os.environ.get(
            "LOGOS_POSTGRES_URL"
        )
        postgres_server_profile = postgres_server_profile_record(
            run_dir,
            effective_postgres_url,
            require_frozen=is_frozen_full_selection(input_root, cases, selected),
            resume=args.resume,
        )
        cohort16_gate = cohort16_gate_record(
            args.cohort16_gate_summary,
            input_root,
            cases,
            selected,
            input_files,
            input_manifest,
            framework_source_tree,
            solver_binary,
            case_process_bootstrap,
            case_process_supervisor,
            case_process_isolation,
            rocq_authority_snapshot,
            trusted_stack,
            frontend_stack,
            codex_provider,
            postgres_server_profile,
            args,
            proof_docker_image_identity,
            effective_postgres_url,
        )
        codex_runtime_home = stage_codex_runtime_home(
            codex_source_home,
            resolve_artifact_path(codex_provider["configPath"]),
            prepare_codex_runtime_root(),
        )
        config = RunConfig(
            solver_bin=solver_bin,
            case_process_bootstrap=case_process_bootstrap,
            case_process_supervisor=case_process_supervisor,
            case_process_isolation=case_process_isolation,
            proof_authority_root=proof_authority_root,
            run_dir=run_dir,
            case_timeout_seconds=args.case_timeout,
            termination_grace_seconds=args.termination_grace,
            verification_mode=args.verification_mode,
            postgres_url=effective_postgres_url,
            sql_time_zone=args.sql_time_zone,
            sql_default_collation=args.sql_default_collation,
            sql_character_classification=args.sql_character_classification,
            sql_locale_provider=args.sql_locale_provider,
            sql_server_encoding=args.sql_server_encoding,
            solver_args=tuple(args.solver_arg or ()),
            proof_agent_memory_limit_mib=args.proof_agent_memory_limit_mib,
            proof_agent_storage_limit_mib=args.proof_agent_storage_limit_mib,
            statement_timeout_seconds=args.statement_timeout_seconds,
            max_counterexample_rounds=args.max_counterexample_rounds,
            proof_check_timeout_seconds=args.proof_check_timeout_seconds,
            proof_docker_image=args.proof_docker_image,
            proof_docker_image_effective=proof_docker_image_identity[
                "effectiveReference"
            ],
            proof_docker_image_identity=proof_docker_image_identity,
            proof_rocq_opam_switch=proof_rocq_opam_switch,
            allow_framework_source_drift=args.allow_framework_source_drift,
            framework_source_tree=framework_source_tree,
            input_manifest=input_manifest,
            input_files=input_files,
            solver_binary=solver_binary,
            rocq_authority_snapshot=rocq_authority_snapshot,
            trusted_stack=trusted_stack,
            frontend_stack=frontend_stack,
            codex_provider=codex_provider,
            postgres_server_profile=postgres_server_profile,
            codex_runtime_home=codex_runtime_home,
            cohort16_gate=cohort16_gate,
            frozen_benchmark=frozen_benchmark,
            rbot_authority=rbot_authority,
        )
        try:
            preserved_summary = None
            if args.resume:
                preserved_summary = load_and_validate_resume_summary(
                    input_root,
                    selected,
                    config,
                    args.jobs,
                )
            return run_selected_cases(
                input_root,
                selected,
                config,
                args.jobs,
                selection_record(args),
                preserved_summary=preserved_summary,
            )
        finally:
            shutil.rmtree(codex_runtime_home, ignore_errors=True)
    except RunnerError as error:
        parser.error(str(error))
    return 2


def argument_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Run the complete Logos counterexample, lowering, proof-agent, and trusted Rocq "
            "pipeline over generated benchmark cases. With no selectors, all cases run."
        )
    )
    parser.add_argument(
        "--input-root",
        default=str(DEFAULT_INPUT_ROOT),
        help=(
            "Independent Logos case root containing schema.sql, sql1.sql, sql2.sql, "
            "and metadata.json (default: benchmarks/core/.generated/logos)."
        ),
    )
    parser.add_argument(
        "--run-dir",
        help=(
            "Fresh result directory, or the existing interrupted directory with --resume. "
            "The default is a timestamped directory under var/."
        ),
    )
    parser.add_argument(
        "--resume",
        action="store_true",
        help="Continue an existing non-complete run in place after exact config validation.",
    )
    parser.add_argument(
        "--jobs", type=int, default=16, help="Concurrent cases (default: 16)."
    )
    parser.add_argument(
        "--case-timeout",
        type=parse_duration,
        default=DEFAULT_CASE_TIMEOUT_SECONDS,
        metavar="DURATION",
        help="Total wall-clock timeout per case, such as 4200, 70m, or 1h10m (default: 70m).",
    )
    parser.add_argument(
        "--termination-grace",
        type=parse_duration,
        default=DEFAULT_TERMINATION_GRACE_SECONDS,
        metavar="DURATION",
        help="Grace period before timed-out process groups receive SIGKILL (default: 10s).",
    )
    parser.add_argument(
        "--case",
        action="append",
        help="Run one exact case alias. May be repeated.",
    )
    parser.add_argument(
        "--case-file",
        action="append",
        help="Read exact case aliases from a file, one per line. May be repeated.",
    )
    parser.add_argument(
        "--benchmark",
        action="append",
        help="Restrict to an exact source benchmark or cohort. May be repeated.",
    )
    parser.add_argument(
        "--match",
        action="append",
        help="Run cases whose identifiers match a regular expression. May be repeated.",
    )
    parser.add_argument(
        "--limit", type=int, help="Run only the first N selected cases."
    )
    parser.add_argument(
        "--list", action="store_true", help="List selected cases without running."
    )
    parser.add_argument(
        "--solver-bin",
        default=str(DEFAULT_SOLVER_BIN),
        help="logos-solver executable (default: target/debug/logos-solver).",
    )
    parser.add_argument(
        "--no-build",
        action="store_true",
        help="Do not run the incremental Rust build before the benchmark.",
    )
    parser.add_argument(
        "--no-rocq-build",
        action="store_true",
        help=(
            "Compatibility-only flag with no effect: every run still rebuilds the "
            "trusted Rocq authority from bound sources in its private runtime."
        ),
    )
    parser.add_argument(
        "--verification-mode",
        choices=("safe-unconditional", "outcome-unconditional", "conditional"),
        default="outcome-unconditional",
    )
    parser.add_argument(
        "--proof-agent-memory-limit-mib",
        type=int,
        default=DEFAULT_PROOF_AGENT_MEMORY_LIMIT_MIB,
        help=(
            "Proof-agent container memory limit in MiB, passed explicitly to "
            f"logos-solver (default: {DEFAULT_PROOF_AGENT_MEMORY_LIMIT_MIB})."
        ),
    )
    parser.add_argument(
        "--proof-agent-storage-limit-mib",
        type=int,
        default=DEFAULT_PROOF_AGENT_STORAGE_LIMIT_MIB,
        help=(
            "Aggregate writable storage quota for one proof-agent container in MiB "
            f"(default: {DEFAULT_PROOF_AGENT_STORAGE_LIMIT_MIB})."
        ),
    )
    parser.add_argument(
        "--statement-timeout-seconds",
        type=int,
        default=DEFAULT_STATEMENT_TIMEOUT_SECONDS,
        help=(
            "PostgreSQL timeout for each deterministic validation statement "
            f"(default: {DEFAULT_STATEMENT_TIMEOUT_SECONDS}s)."
        ),
    )
    parser.add_argument(
        "--max-counterexample-rounds",
        type=int,
        default=DEFAULT_MAX_COUNTEREXAMPLE_ROUNDS,
        help=(
            "Maximum fresh counterexample-agent attempts before equivalence proof "
            f"search begins (default: {DEFAULT_MAX_COUNTEREXAMPLE_ROUNDS})."
        ),
    )
    parser.add_argument(
        "--proof-check-timeout-seconds",
        type=int,
        default=DEFAULT_PROOF_CHECK_TIMEOUT_SECONDS,
        help=(
            "Host trusted Rocq-check timeout passed explicitly to logos-solver "
            f"(default: {DEFAULT_PROOF_CHECK_TIMEOUT_SECONDS})."
        ),
    )
    parser.add_argument(
        "--proof-docker-image",
        default=DEFAULT_PROOF_DOCKER_IMAGE,
        help=(
            "Proof-agent Docker image reference; its locally resolved immutable ID is "
            "recorded when available."
        ),
    )
    parser.add_argument(
        "--proof-rocq-opam-switch",
        default=str(DEFAULT_ROCQ_OPAM_SWITCH),
        help=(
            "Trusted Rocq opam root containing _opam/bin/rocq; the exact executable "
            "and standard-library objects are bound into the trusted-stack manifest."
        ),
    )
    parser.add_argument(
        "--cohort16-gate-summary",
        help=(
            "Prior complete frozen cohort16 runner-summary.json. "
            "Required before launching the frozen full 389-case run."
        ),
    )
    parser.add_argument(
        "--allow-ungated-full-run",
        action="store_true",
        help=(
            "Explicitly authorize the exact frozen 389-case campaign without a "
            "current-source cohort16 gate. This recorded override requires jobs=32, "
            "case-timeout=4h, outcome-unconditional verification, and PostgreSQL."
        ),
    )
    parser.add_argument(
        "--allow-framework-source-drift",
        action="store_true",
        help=(
            "Record, but do not fail on, changes to the aggregate framework source-tree "
            "digest after launch. Inputs, the run-private solver binary, the trusted Rocq "
            "stack, and the SQL frontend remain strictly verified. Disabled by default."
        ),
    )
    parser.add_argument(
        "--postgres-url", help="Override LOGOS_POSTGRES_URL for each solver case."
    )
    parser.add_argument("--sql-time-zone", default="UTC")
    parser.add_argument("--sql-default-collation", default="C")
    parser.add_argument("--sql-character-classification", default="C")
    parser.add_argument("--sql-locale-provider", default="libc")
    parser.add_argument("--sql-server-encoding", default="UTF8")
    parser.add_argument(
        "--solver-arg",
        action="append",
        help="Append an advanced argument to logos-solver; use --solver-arg=--flag for flags.",
    )
    return parser


def validate_args(args: argparse.Namespace) -> None:
    if args.jobs < 1:
        raise RunnerError("--jobs must be at least 1")
    if args.case_timeout <= 0:
        raise RunnerError("--case-timeout must be positive")
    if args.termination_grace < 0:
        raise RunnerError("--termination-grace cannot be negative")
    if not (
        MIN_PROOF_AGENT_MEMORY_LIMIT_MIB
        <= args.proof_agent_memory_limit_mib
        <= MAX_PROOF_AGENT_MEMORY_LIMIT_MIB
    ):
        raise RunnerError(
            "--proof-agent-memory-limit-mib must be between "
            f"{MIN_PROOF_AGENT_MEMORY_LIMIT_MIB} and "
            f"{MAX_PROOF_AGENT_MEMORY_LIMIT_MIB}"
        )
    if args.proof_check_timeout_seconds < 1:
        raise RunnerError("--proof-check-timeout-seconds must be at least 1")
    if args.proof_agent_storage_limit_mib < 1:
        raise RunnerError("--proof-agent-storage-limit-mib must be at least 1")
    if args.statement_timeout_seconds < 1:
        raise RunnerError("--statement-timeout-seconds must be at least 1")
    if args.max_counterexample_rounds < 1:
        raise RunnerError("--max-counterexample-rounds must be at least 1")
    if not args.proof_docker_image.strip():
        raise RunnerError("--proof-docker-image cannot be empty")
    if args.limit is not None and args.limit < 1:
        raise RunnerError("--limit must be at least 1")
    if args.resume and not args.run_dir:
        raise RunnerError("--resume requires an explicit --run-dir")
    if args.resume and args.list:
        raise RunnerError("--resume cannot be combined with --list")
    if args.allow_ungated_full_run and args.cohort16_gate_summary:
        raise RunnerError(
            "--allow-ungated-full-run cannot be combined with "
            "--cohort16-gate-summary"
        )
    validate_solver_args(tuple(args.solver_arg or ()))


def parse_duration(value: str) -> float:
    text = value.strip().lower()
    if not text:
        raise argparse.ArgumentTypeError("duration cannot be empty")
    if re.fullmatch(r"\d+(?:\.\d+)?", text):
        return float(text)
    pattern = re.compile(r"(\d+(?:\.\d+)?)([hms])")
    position = 0
    seconds = 0.0
    units_seen: set[str] = set()
    factors = {"h": 3600.0, "m": 60.0, "s": 1.0}
    for match in pattern.finditer(text):
        if match.start() != position or match.group(2) in units_seen:
            raise argparse.ArgumentTypeError(f"invalid duration: {value}")
        units_seen.add(match.group(2))
        seconds += float(match.group(1)) * factors[match.group(2)]
        position = match.end()
    if position != len(text) or not units_seen:
        raise argparse.ArgumentTypeError(f"invalid duration: {value}")
    return seconds


def resolve_path(value: str | Path) -> Path:
    path = Path(value).expanduser()
    if path.is_absolute():
        return path.resolve()
    if path.parts and path.parts[0] == LOGOS_ROOT.name:
        path = Path(*path.parts[1:])
    return (LOGOS_ROOT / path).resolve()


def canonical_json_bytes(value: Any) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode(
        "utf-8"
    )


def input_manifest_case(
    case: BenchmarkCase, *, legacy: bool = False
) -> dict[str, str]:
    row = {
        "caseId": case.case_id,
        "schemaSha256": sha256_file(case.schema),
        "sql1Sha256": sha256_file(case.source),
        "sql2Sha256": sha256_file(case.target),
    }
    if not legacy:
        metadata = case.input_dir / "metadata.json"
        if not metadata.is_file() or metadata.is_symlink():
            raise RunnerError(
                f"Logos input metadata is missing, non-regular, or symlinked: {metadata}"
            )
        row["metadataSha256"] = sha256_file(metadata)
    return row


def build_input_manifest(
    cases: Iterable[BenchmarkCase], *, legacy: bool = False
) -> dict[str, Any]:
    rows = sorted(
        (input_manifest_case(case, legacy=legacy) for case in cases),
        key=lambda row: row["caseId"],
    )
    if len(rows) != len({row["caseId"] for row in rows}):
        raise RunnerError("input manifest contains duplicate case IDs")
    return {
        "schemaVersion": 1 if legacy else 2,
        "algorithm": (
            LEGACY_INPUT_MANIFEST_ALGORITHM if legacy else INPUT_MANIFEST_ALGORITHM
        ),
        "caseCount": len(rows),
        "cases": rows,
    }


def semantic_input_authority_case(case: BenchmarkCase) -> dict[str, Any]:
    metadata_path = case.input_dir / "metadata.json"
    require_regular_nonsymlink_file(metadata_path, "semantic case metadata")
    metadata = read_json_object(metadata_path, "semantic case metadata")
    if metadata.get("flatCaseId") != case.flat_case_id or case.flat_case_id is None:
        raise RunnerError("semantic case metadata flatCaseId drifted")
    declared_contract = metadata.get("integrityContract")
    semantic_sidecar = (
        declared_contract.get("semanticSidecar")
        if isinstance(declared_contract, dict)
        else None
    )
    sidecar_sha256 = None
    if semantic_sidecar is not None:
        if not isinstance(semantic_sidecar, str) or not semantic_sidecar:
            raise RunnerError("semantic sidecar declaration is malformed")
        sidecar_path = resolve_path(semantic_sidecar)
        require_regular_nonsymlink_file(sidecar_path, "semantic sidecar authority")
        sidecar_sha256 = sha256_file(sidecar_path)
    return {
        "caseId": case.case_id,
        "flatCaseId": case.flat_case_id,
        "metadataSha256": sha256_file(metadata_path),
        "semanticSidecarPath": semantic_sidecar,
        "semanticSidecarSha256": sidecar_sha256,
    }


def build_semantic_input_authority_manifest(
    cases: Iterable[BenchmarkCase],
) -> dict[str, Any]:
    rows = sorted(
        (semantic_input_authority_case(case) for case in cases),
        key=lambda row: row["caseId"],
    )
    if len(rows) != len({row["caseId"] for row in rows}):
        raise RunnerError("semantic input authority contains duplicate case IDs")
    return {
        "schemaVersion": 1,
        "algorithm": SEMANTIC_INPUT_AUTHORITY_ALGORITHM,
        "caseCount": len(rows),
        "cases": rows,
    }


def input_manifest_sha256(document: dict[str, Any]) -> str:
    return hashlib.sha256(canonical_json_bytes(document)).hexdigest()


def write_or_validate_manifest(
    path: Path,
    document: dict[str, Any],
    *,
    resume: bool,
    description: str,
) -> str:
    encoded = canonical_json_bytes(document)
    digest = hashlib.sha256(encoded).hexdigest()
    if resume and path.is_file():
        if path.read_bytes() != encoded:
            raise RunnerError(
                f"resume {description} differs from the preserved canonical manifest: {path}"
            )
    elif resume:
        raise RunnerError(f"resume {description} does not exist: {path}")
    else:
        atomic_write_bytes(path, encoded)
    if sha256_file(path) != digest:
        raise RunnerError(f"canonical {description} serialization drifted: {path}")
    return digest


def input_manifest_record(
    run_dir: Path,
    available_cases: list[BenchmarkCase],
    selected_cases: list[BenchmarkCase],
    *,
    frozen: bool,
    resume: bool,
) -> tuple[dict[str, Any], dict[str, dict[str, Any]]]:
    full_document = build_input_manifest(available_cases, legacy=frozen)
    selected_document = build_input_manifest(selected_cases, legacy=frozen)
    full_digest = input_manifest_sha256(full_document)
    selected_digest = input_manifest_sha256(selected_document)
    semantic_document = build_semantic_input_authority_manifest(available_cases)
    selected_semantic_document = build_semantic_input_authority_manifest(
        selected_cases
    )
    semantic_digest = input_manifest_sha256(semantic_document)
    selected_semantic_digest = input_manifest_sha256(selected_semantic_document)
    if frozen:
        if full_document["caseCount"] != 389:
            raise RunnerError(
                "frozen input manifest must contain exactly 389 unique cases"
            )
        if full_digest != FROZEN_INPUT_MANIFEST_SHA256:
            raise RunnerError(
                "generated schema/sql1/sql2 inputs drifted from the frozen canonical "
                f"manifest: expected {FROZEN_INPUT_MANIFEST_SHA256}, got {full_digest}"
            )
        if semantic_digest != FROZEN_SEMANTIC_INPUT_AUTHORITY_SHA256:
            raise RunnerError(
                "generated frozen metadata/semantic-sidecar authority drifted: "
                f"expected {FROZEN_SEMANTIC_INPUT_AUTHORITY_SHA256}, got {semantic_digest}"
            )

    full_path = run_dir / "input-manifest.json"
    selected_path = run_dir / "selected-input-manifest.json"
    semantic_path = run_dir / "semantic-input-authority-manifest.json"
    selected_semantic_path = (
        run_dir / "selected-semantic-input-authority-manifest.json"
    )
    written_full_digest = write_or_validate_manifest(
        full_path,
        full_document,
        resume=resume,
        description="input manifest",
    )
    written_selected_digest = write_or_validate_manifest(
        selected_path,
        selected_document,
        resume=resume,
        description="selected input manifest",
    )
    written_semantic_digest = write_or_validate_manifest(
        semantic_path,
        semantic_document,
        resume=resume,
        description="semantic input authority manifest",
    )
    written_selected_semantic_digest = write_or_validate_manifest(
        selected_semantic_path,
        selected_semantic_document,
        resume=resume,
        description="selected semantic input authority manifest",
    )
    if (
        written_full_digest != full_digest
        or written_selected_digest != selected_digest
        or written_semantic_digest != semantic_digest
        or written_selected_semantic_digest != selected_semantic_digest
    ):
        raise RunnerError("input manifest digest reconciliation failed")

    case_rows = {row["caseId"]: row for row in full_document["cases"]}
    input_files = {}
    for case in selected_cases:
        files = {
            "schema": {
                "path": workspace_display_path(case.schema),
                "sha256": case_rows[case.case_id]["schemaSha256"],
            },
            "source": {
                "path": workspace_display_path(case.source),
                "sha256": case_rows[case.case_id]["sql1Sha256"],
            },
            "target": {
                "path": workspace_display_path(case.target),
                "sha256": case_rows[case.case_id]["sql2Sha256"],
            },
        }
        metadata_path = case.input_dir / "metadata.json"
        require_regular_nonsymlink_file(metadata_path, "selected case metadata")
        metadata_sha256 = sha256_file(metadata_path)
        if not frozen and metadata_sha256 != case_rows[case.case_id]["metadataSha256"]:
            raise RunnerError("selected metadata changed while building input authority")
        files["metadata"] = {
            "path": workspace_display_path(metadata_path),
            "sha256": metadata_sha256,
        }
        metadata = read_json_object(metadata_path, "selected case metadata")
        declared_contract = metadata.get("integrityContract")
        semantic_sidecar = (
            declared_contract.get("semanticSidecar")
            if isinstance(declared_contract, dict)
            else None
        )
        if semantic_sidecar is not None:
            if not isinstance(semantic_sidecar, str) or not semantic_sidecar:
                raise RunnerError("selected case semantic sidecar path is malformed")
            semantic_sidecar_path = resolve_path(semantic_sidecar)
            require_regular_nonsymlink_file(
                semantic_sidecar_path, "selected semantic sidecar"
            )
            files["semanticSidecar"] = {
                "path": workspace_display_path(semantic_sidecar_path),
                "sha256": sha256_file(semantic_sidecar_path),
            }
        input_files[case.case_id] = files
    algorithm = (
        LEGACY_INPUT_MANIFEST_ALGORITHM if frozen else INPUT_MANIFEST_ALGORITHM
    )
    return (
        {
            "path": workspace_display_path(full_path),
            "sha256": full_digest,
            "algorithm": algorithm,
            "manifestSchemaVersion": full_document["schemaVersion"],
            "caseCount": full_document["caseCount"],
            "selectedPath": workspace_display_path(selected_path),
            "selectedSha256": selected_digest,
            "selectedCaseCount": selected_document["caseCount"],
            "semanticAuthorityPath": workspace_display_path(semantic_path),
            "semanticAuthoritySha256": semantic_digest,
            "semanticAuthorityAlgorithm": SEMANTIC_INPUT_AUTHORITY_ALGORITHM,
            "selectedSemanticAuthorityPath": workspace_display_path(
                selected_semantic_path
            ),
            "selectedSemanticAuthoritySha256": selected_semantic_digest,
            "expectedFrozenSemanticAuthoritySha256": (
                FROZEN_SEMANTIC_INPUT_AUTHORITY_SHA256 if frozen else None
            ),
            "frozenSemanticAuthorityVerified": frozen,
            "expectedFrozenSha256": FROZEN_INPUT_MANIFEST_SHA256 if frozen else None,
            "frozenVerified": frozen,
        },
        input_files,
    )


def canonical_rbot_selection_requested(args: argparse.Namespace) -> bool:
    return set(args.benchmark or ()) == set(RBOT_BENCHMARK_IDS)


def frozen_rbot_authority() -> tuple[dict[str, Any], dict[str, dict[str, Any]]]:
    if (
        not RBOT_MANIFEST.is_file()
        or RBOT_MANIFEST.is_symlink()
        or sha256_file(RBOT_MANIFEST) != FROZEN_RBOT_MANIFEST_SHA256
    ):
        raise RunnerError(
            "frozen R-Bot manifest is missing, symlinked, or digest-mismatched"
        )
    try:
        document = json.loads(RBOT_MANIFEST.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RunnerError(f"cannot read frozen R-Bot manifest: {error}") from error
    rows = document.get("cases")
    if not isinstance(rows, list) or len(rows) != 59:
        raise RunnerError("frozen R-Bot manifest must contain exactly 59 cases")
    by_case: dict[str, dict[str, Any]] = {}
    for index, row in enumerate(rows):
        if not isinstance(row, dict):
            raise RunnerError(f"frozen R-Bot manifest case {index} is malformed")
        case_id = row.get("case")
        workload = row.get("workload")
        if (
            not isinstance(case_id, str)
            or workload not in FROZEN_RBOT_SCHEMA_SHA256
            or case_id in by_case
            or not case_id.startswith(f"rbot-{workload}__")
        ):
            raise RunnerError(f"frozen R-Bot manifest case {index} has invalid identity")
        for field, digest_field in (
            ("source", "sourceSha256"),
            ("target", "targetSha256"),
        ):
            relative = row.get(field)
            digest = row.get(digest_field)
            if (
                not isinstance(relative, str)
                or not relative
                or Path(relative).is_absolute()
                or ".." in Path(relative).parts
                or not isinstance(digest, str)
                or re.fullmatch(r"[0-9a-f]{64}", digest) is None
            ):
                raise RunnerError(
                    f"frozen R-Bot manifest {case_id}.{field} binding is malformed"
                )
            path = RBOT_ROOT / relative
            if not path.is_file() or path.is_symlink() or sha256_file(path) != digest:
                raise RunnerError(
                    f"frozen R-Bot core input changed: {case_id}.{field}"
                )
        by_case[case_id] = row
    return document, by_case


def validate_rbot_metadata_case(
    case_dir: Path,
    metadata: dict[str, Any],
    manifest: dict[str, Any],
    row: dict[str, Any],
) -> None:
    case_id = row["case"]
    workload = row["workload"]
    benchmark_id = f"rbot-{workload}"
    source_case = case_id.split("__", 1)[1]
    schema_digest = FROZEN_RBOT_SCHEMA_SHA256[workload]
    expected_digests = {
        "schema": schema_digest,
        "source": row["sourceSha256"],
        "target": row["targetSha256"],
    }
    expected_files = {
        "schema": ("schema.sql", f"benchmarks/core/rbot/{workload}/create_tables.sql"),
        "source": ("sql1.sql", f"benchmarks/core/rbot/{row['source']}"),
        "target": ("sql2.sql", f"benchmarks/core/rbot/{row['target']}"),
    }
    for name, (filename, _input_path) in expected_files.items():
        path = case_dir / filename
        if (
            not path.is_file()
            or path.is_symlink()
            or sha256_file(path) != expected_digests[name]
        ):
            raise RunnerError(
                f"R-Bot adjacent {name} input is missing, symlinked, or stale: {case_id}"
            )

    expected_identity = {
        "flatCaseId": case_id,
        "profile": "logos",
        "sourceBenchmark": benchmark_id,
        "sourceCase": source_case,
    }
    for field, expected in expected_identity.items():
        if metadata.get(field) != expected:
            raise RunnerError(f"R-Bot metadata identity changed: {case_id}.{field}")
    expected_source = {
        "directory": source_case,
        "manifestCase": case_id,
        "manifestProfile": manifest.get("profile"),
        "source": f"benchmarks/core/rbot/{workload}",
    }
    if metadata.get("source") != expected_source:
        raise RunnerError(f"R-Bot source identity metadata changed: {case_id}")

    expected_integrity = {
        "authoritativeForLogos": True,
        "ddlComplete": True,
        "ddlLimitation": None,
        "silentDrops": 0,
        "sources": [{"kind": "parser_facing_ddl", "path": "schema.sql"}],
    }
    if metadata.get("integrityContract") != expected_integrity:
        raise RunnerError(f"R-Bot integrity contract changed: {case_id}")
    if metadata.get("constraintScope") != "none" or metadata.get("constraints") != []:
        raise RunnerError(f"R-Bot constraint identity changed: {case_id}")

    expected_inputs = {}
    expected_authority = {}
    for name, (output_path, input_path) in expected_files.items():
        digest = expected_digests[name]
        expected_inputs[name] = {
            "inputPath": input_path,
            "inputSha256": digest,
            "outputPath": output_path,
            "outputSha256": digest,
            "repairs": [],
            "unchanged": True,
        }
        expected_authority[name] = {"path": output_path, "sha256": digest}
    expected_materialization = {
        "inputs": expected_inputs,
        "policy": RBOT_MATERIALIZATION_POLICY,
        "semanticPreservation": {
            "established": True,
            "identifierDelimitersPreserved": True,
            "queryStructurePreserved": True,
            "repairs": [],
        },
        "sourceManifest": "benchmarks/core/rbot/rewrite-pairs.manifest.json",
        "sourceManifestSha256": FROZEN_RBOT_MANIFEST_SHA256,
    }
    if metadata.get("materializationContract") != expected_materialization:
        raise RunnerError(f"R-Bot materialization contract changed: {case_id}")
    if metadata.get("calciteAuthorityInputs") != expected_authority:
        raise RunnerError(f"R-Bot Calcite authority inputs changed: {case_id}")


def validate_rbot_input_authority(
    input_root: Path,
    available_cases: list[BenchmarkCase],
    selected_cases: list[BenchmarkCase],
    *,
    require_exact_selection: bool,
) -> dict[str, Any] | None:
    if input_root.resolve() == LEGACY_FROZEN_INPUT_ROOT.resolve():
        return None

    rbot_directory_pattern = re.compile(r"^rbot-[A-Za-z0-9_.-]+__")
    discovered_rbot_dirs: set[Path] = set()
    for path in input_root.rglob("*"):
        if not rbot_directory_pattern.match(path.name):
            continue
        if path.is_symlink():
            raise RunnerError(f"R-Bot generated case directory is symlinked: {path}")
        if path.is_dir():
            discovered_rbot_dirs.add(path.resolve())
    metadata_marks_rbot = any(
        case.source_benchmark in RBOT_BENCHMARK_IDS
        or bool(case.flat_case_id and case.flat_case_id.startswith("rbot-"))
        for case in available_cases
    )
    applies = (
        input_root.resolve() == DEFAULT_INPUT_ROOT.resolve()
        or bool(discovered_rbot_dirs)
        or metadata_marks_rbot
    )
    if not applies:
        if require_exact_selection:
            raise RunnerError(
                "canonical R-Bot selection requested from an input root with no R-Bot authority"
            )
        return None

    manifest, rows = frozen_rbot_authority()
    schema_records = {}
    for workload, digest in sorted(FROZEN_RBOT_SCHEMA_SHA256.items()):
        schema = RBOT_ROOT / workload / "create_tables.sql"
        if not schema.is_file() or schema.is_symlink() or sha256_file(schema) != digest:
            raise RunnerError(f"frozen R-Bot {workload} schema authority changed")
        schema_records[workload] = {
            "path": workspace_display_path(schema),
            "sha256": digest,
        }

    expected_dirs = {
        (input_root / "nonwetune-flat" / case_id).resolve(): case_id
        for case_id in rows
    }
    if discovered_rbot_dirs != set(expected_dirs):
        raise RunnerError(
            "generated R-Bot case directories differ from the frozen 59-case authority: "
            f"missing={sorted(expected_dirs[path] for path in set(expected_dirs) - discovered_rbot_dirs)[:12]} "
            f"unexpected={sorted(str(path) for path in discovered_rbot_dirs - set(expected_dirs))[:12]}"
        )

    expected_runner_ids = {
        f"nonwetune-flat__{case_id}" for case_id in rows
    }
    authority_cases = {
        case.case_id
        for case in available_cases
        if case.input_dir.resolve() in expected_dirs
        or case.source_benchmark in RBOT_BENCHMARK_IDS
        or bool(case.flat_case_id and case.flat_case_id.startswith("rbot-"))
    }
    if authority_cases != expected_runner_ids:
        raise RunnerError(
            "discovered R-Bot case identities differ from the frozen authority: "
            f"missing={sorted(expected_runner_ids - authority_cases)[:12]} "
            f"unexpected={sorted(authority_cases - expected_runner_ids)[:12]}"
        )

    for case_id, row in sorted(rows.items()):
        case_dir = input_root / "nonwetune-flat" / case_id
        metadata_path = case_dir / "metadata.json"
        if not metadata_path.is_file() or metadata_path.is_symlink():
            raise RunnerError(f"R-Bot metadata is missing or symlinked: {case_id}")
        try:
            metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            raise RunnerError(f"cannot read R-Bot metadata {case_id}: {error}") from error
        if not isinstance(metadata, dict):
            raise RunnerError(f"R-Bot metadata is not an object: {case_id}")
        validate_rbot_metadata_case(case_dir, metadata, manifest, row)

    selected_ids = {case.case_id for case in selected_cases}
    selected_rbot_ids = selected_ids & expected_runner_ids
    if require_exact_selection and selected_ids != expected_runner_ids:
        raise RunnerError(
            "canonical two-benchmark R-Bot selection must contain exactly 59 cases: "
            f"missing={sorted(expected_runner_ids - selected_ids)[:12]} "
            f"unexpected={sorted(selected_ids - expected_runner_ids)[:12]}"
        )
    return {
        "manifestPath": workspace_display_path(RBOT_MANIFEST),
        "manifestSha256": FROZEN_RBOT_MANIFEST_SHA256,
        "caseCount": len(rows),
        "caseSetSha256": sha256_text("\n".join(sorted(rows)) + "\n"),
        "schemas": schema_records,
        "canonicalSelectionRequired": require_exact_selection,
        "selectedRbotCaseCount": len(selected_rbot_ids),
        "selectedRbotCaseSetSha256": sha256_text(
            "\n".join(sorted(selected_rbot_ids)) + ("\n" if selected_rbot_ids else "")
        ),
    }


def executable_record(path: Path, description: str) -> dict[str, Any]:
    resolved = path.resolve()
    if not resolved.is_file() or not os.access(resolved, os.X_OK):
        raise RunnerError(f"{description} is missing or not executable: {resolved}")
    return {
        "path": workspace_display_path(resolved),
        "sha256": sha256_file(resolved),
        "bytes": resolved.stat().st_size,
    }


def solver_binary_record(path: Path) -> dict[str, Any]:
    return executable_record(path, "solver binary")


def command_version(
    command: list[str],
    description: str,
    *,
    environment: dict[str, str] | None = None,
) -> str:
    try:
        completed = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=environment,
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RunnerError(f"cannot query {description}: {error}") from error
    output = completed.stdout.decode("utf-8", errors="replace").strip()
    if completed.returncode != 0 or not output:
        raise RunnerError(
            f"{description} version probe failed with exit code {completed.returncode}"
        )
    return output[:8_192]


def tree_file_records(
    root: Path,
    *,
    include: Any | None = None,
    description: str,
) -> list[dict[str, Any]]:
    root = root.resolve()
    if not root.is_dir():
        raise RunnerError(f"{description} root is missing: {root}")
    records: list[dict[str, Any]] = []
    for path in sorted(root.rglob("*")):
        relative = path.relative_to(root).as_posix()
        if include is not None and not include(path, relative):
            continue
        if path.is_symlink():
            records.append(
                {
                    "path": relative,
                    "kind": "symlink",
                    "target": os.readlink(path),
                }
            )
        elif path.is_file():
            records.append(
                {
                    "path": relative,
                    "kind": "file",
                    "sha256": sha256_file(path),
                    "bytes": path.stat().st_size,
                    "executable": os.access(path, os.X_OK),
                }
            )
    if not records:
        raise RunnerError(f"{description} file closure is empty: {root}")
    return records


def validated_frozen_java_home() -> Path:
    java_home = os.environ.get("JAVA_HOME")
    if not java_home:
        raise RunnerError("JAVA_HOME is unset; run the runner through direnv")
    resolved_java_home = Path(java_home).resolve()
    if resolved_java_home != EXPECTED_JAVA_HOME.resolve():
        raise RunnerError(
            "JAVA_HOME differs from the frozen workspace JDK 17; run through direnv"
        )
    return resolved_java_home


def canonical_frontend_environment(
    *, include_runtime_classpath: bool = False
) -> dict[str, str]:
    environment = dict(FRONTEND_FIXED_ENVIRONMENT_ITEMS)
    environment["JAVA_HOME"] = str(validated_frozen_java_home())
    environment["MAVEN_VERSION"] = MAVEN_VERSION
    if include_runtime_classpath:
        if not CALCITE_CLASSPATH.is_file() or CALCITE_CLASSPATH.is_symlink():
            raise RunnerError("canonical Calcite runtime classpath is missing")
        environment["LOGOS_CALCITE_RUNTIME_CLASSPATH_FILE"] = str(
            CALCITE_CLASSPATH.resolve()
        )
    return environment


def canonical_frontend_launch_command(*arguments: str) -> list[str]:
    return [
        str(FRONTEND_LAUNCH_BASH),
        *FRONTEND_LAUNCH_ARGUMENTS,
        FRONTEND_LAUNCH_COMMAND_BODY,
        str(CANONICAL_FRONTEND_SCRIPT.resolve()),
        *arguments,
    ]


def prepare_frontend_stack() -> None:
    environment = canonical_frontend_environment()
    if not MAVEN_EXECUTABLE.is_file():
        example_root = CALCITE_ROOT / "examples"
        try:
            completed = subprocess.run(
                canonical_frontend_launch_command(
                    "--schema",
                    str(example_root / "schema.sql"),
                    "--sql",
                    str(example_root / "query.sql"),
                ),
                cwd=LOGOS_ROOT,
                env=environment,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                timeout=600,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            raise RunnerError(
                f"cannot bootstrap canonical SQL frontend: {error}"
            ) from error
        if completed.returncode != 0:
            raise RunnerError(
                "canonical SQL frontend bootstrap failed with exit code "
                f"{completed.returncode}"
            )

    java_sources = list((CALCITE_ROOT / "src/main").rglob("*.java"))
    class_files = (
        list(CALCITE_CLASSES.rglob("*.class")) if CALCITE_CLASSES.is_dir() else []
    )
    inputs = [CALCITE_ROOT / "pom.xml", *java_sources]
    latest_input = max(path.stat().st_mtime_ns for path in inputs if path.is_file())
    class_fresh = (
        bool(class_files)
        and min(path.stat().st_mtime_ns for path in class_files) >= latest_input
    )
    classpath_fresh = (
        CALCITE_CLASSPATH.is_file()
        and not CALCITE_CLASSPATH.is_symlink()
        and CALCITE_CLASSPATH.stat().st_mtime_ns >= latest_input
    )
    if class_fresh and classpath_fresh:
        return
    CALCITE_CLASSPATH.parent.mkdir(parents=True, exist_ok=True)
    try:
        CALCITE_CLASSPATH.unlink()
    except FileNotFoundError:
        pass
    try:
        completed = subprocess.run(
            [
                str(MAVEN_EXECUTABLE),
                "-q",
                "-f",
                str(CALCITE_ROOT / "pom.xml"),
                "compile",
                "dependency:build-classpath",
                "-DincludeScope=runtime",
                f"-Dmdep.outputFile={CALCITE_CLASSPATH}",
            ],
            cwd=LOGOS_ROOT,
            env=environment,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=600,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RunnerError(
            f"cannot prepare canonical frontend stack: {error}"
        ) from error
    if completed.returncode != 0:
        raise RunnerError(
            "canonical Calcite compile/classpath preparation failed with exit code "
            f"{completed.returncode}"
        )


def java_runtime_record() -> dict[str, Any]:
    java_home = validated_frozen_java_home()
    java_invocation = java_home / "bin/java"
    java_path = java_invocation.resolve()
    if not java_path.is_file() or not os.access(java_path, os.X_OK):
        raise RunnerError(
            f"configured Java executable is unavailable: {java_invocation}"
        )
    jdk_root = java_path.parent.parent

    def include(_path: Path, relative: str) -> bool:
        return (
            Path(relative).parts[0] in {"bin", "lib", "conf"} or relative == "release"
        )

    return {
        "javaHome": workspace_display_path(java_home),
        "jdkRoot": workspace_display_path(jdk_root),
        "javaInvocationPath": workspace_display_path(java_invocation),
        "javaExecutable": executable_record(java_invocation, "Java executable"),
        "version": command_version(
            [str(java_invocation), "-version"],
            "Java",
            environment=canonical_frontend_environment(),
        ),
        "files": tree_file_records(
            jdk_root, include=include, description="configured JDK runtime"
        ),
    }


def frontend_dependency_records() -> tuple[list[str], list[dict[str, Any]]]:
    if not CALCITE_CLASSPATH.is_file() or CALCITE_CLASSPATH.is_symlink():
        raise RunnerError("canonical Calcite runtime classpath is missing")
    values = [
        Path(value).expanduser().resolve()
        for value in CALCITE_CLASSPATH.read_text(encoding="utf-8")
        .strip()
        .split(os.pathsep)
        if value
    ]
    if not values or len(values) != len(set(values)):
        raise RunnerError("canonical Calcite runtime classpath is empty or duplicated")
    records = []
    for index, path in enumerate(values):
        if not path.is_file() or path.is_symlink() or path.suffix != ".jar":
            raise RunnerError(f"invalid Calcite runtime dependency: {path}")
        records.append(
            {
                "classpathIndex": index,
                "path": workspace_display_path(path),
                "sha256": sha256_file(path),
                "bytes": path.stat().st_size,
            }
        )
    return [workspace_display_path(path) for path in values], records


def frontend_launch_environment_policy_record() -> dict[str, Any]:
    return {
        "schemaVersion": 1,
        "inheritedEnvironmentCleared": True,
        "fixedVariables": [
            f"{name}={value}" for name, value in FRONTEND_FIXED_ENVIRONMENT_ITEMS
        ],
        "hostEnvironmentAllowlist": [],
        "explicitContractVariables": list(FRONTEND_EXPLICIT_ENVIRONMENT_NAMES),
        "unlistedEnvironmentPolicy": ("excluded_by_env_clear_before_process_start"),
        "explicitlyExcludedVariables": list(FRONTEND_LAUNCH_EXCLUDED_VARIABLES),
        "explicitlyExcludedPrefixes": list(TRUSTED_LAUNCH_EXCLUDED_PREFIXES),
    }


def fixed_absolute_tool_record(name: str, path: Path) -> dict[str, Any]:
    if not path.is_absolute() or not os.path.lexists(path) or not path.exists():
        raise RunnerError(f"fixed host tool {name} is unavailable: {path}")
    resolved = path.resolve(strict=True)
    if (
        not resolved.is_file()
        or resolved.is_symlink()
        or resolved.stat().st_size == 0
        or not os.access(resolved, os.X_OK)
    ):
        raise RunnerError(f"fixed host tool {name} is unavailable: {path}")
    with resolved.open("rb") as stream:
        file_format = "elf" if stream.read(4) == b"\x7fELF" else "script"
    if file_format != "elf":
        raise RunnerError(f"fixed host tool {name} is unexpectedly non-ELF: {path}")
    return {
        "name": name,
        "selectedPath": str(path),
        "resolvedPath": workspace_display_path(resolved),
        "selectedPathIsSymlink": path.is_symlink(),
        "selectedPathSymlinkTarget": os.readlink(path) if path.is_symlink() else None,
        "format": file_format,
        "sha256": sha256_file(resolved),
        "bytes": resolved.stat().st_size,
    }


def frontend_launch_tools_record() -> dict[str, Any]:
    paths = dict(FRONTEND_LAUNCH_TOOL_PATHS)
    records = {
        name: fixed_absolute_tool_record(name, path)
        for name, path in FRONTEND_LAUNCH_TOOL_PATHS
    }
    names = tuple(name for name, _path in FRONTEND_LAUNCH_TOOL_PATHS)
    dynamic_linking = dynamic_linking_record(
        paths,
        records,
        names,
        ldd_path=TRUSTED_LDD_PATH,
        readelf_path=Path("/usr/bin/readelf"),
    )
    return {
        "algorithm": FRONTEND_LAUNCH_TOOLS_ALGORITHM,
        "selectionPolicy": "fixed-absolute-paths-v1",
        "shellExecutable": str(FRONTEND_LAUNCH_BASH),
        "shellArguments": list(FRONTEND_LAUNCH_ARGUMENTS),
        "commandBody": FRONTEND_LAUNCH_COMMAND_BODY,
        "scriptArgument": workspace_display_path(CANONICAL_FRONTEND_SCRIPT.resolve()),
        "toolCount": len(names),
        "frozenDirectJavaToolNames": ["bash", "dirname", "readlink"],
        "frontendPreparationToolNames": list(names),
        "tools": [records[name] for name in names],
        "dynamicLinking": dynamic_linking,
    }


def build_frontend_stack_manifest() -> dict[str, Any]:
    command_scripts = (
        CANONICAL_FRONTEND_SCRIPT,
        CALCITE_ROOT / "pom.xml",
    )
    scripts = []
    for path in command_scripts:
        if not path.is_file() or path.is_symlink():
            raise RunnerError(f"canonical frontend component is missing: {path}")
        scripts.append(
            {
                "path": workspace_display_path(path),
                "sha256": sha256_file(path),
                "bytes": path.stat().st_size,
                "executable": os.access(path, os.X_OK),
            }
        )
    if not MAVEN_EXECUTABLE.is_file() or not os.access(MAVEN_EXECUTABLE, os.X_OK):
        raise RunnerError(
            f"canonical Maven executable is unavailable: {MAVEN_EXECUTABLE}"
        )
    classpath, dependencies = frontend_dependency_records()
    class_records = tree_file_records(
        CALCITE_CLASSES,
        include=lambda path, _relative: path.is_symlink() or path.suffix == ".class",
        description="compiled Calcite classes",
    )
    settings = Path(dict(FRONTEND_FIXED_ENVIRONMENT_ITEMS)["HOME"]) / ".m2/settings.xml"
    settings_record: dict[str, Any] = {
        "path": workspace_display_path(settings),
        "present": False,
        "sha256": None,
        "bytes": None,
    }
    if settings.exists():
        if not settings.is_file() or settings.is_symlink():
            raise RunnerError(f"Maven settings is not a regular file: {settings}")
        settings_record.update(
            {
                "present": True,
                "sha256": sha256_file(settings),
                "bytes": settings.stat().st_size,
            }
        )
    return {
        "schemaVersion": FRONTEND_STACK_MANIFEST_SCHEMA_VERSION,
        "algorithm": FRONTEND_STACK_MANIFEST_ALGORITHM,
        "canonicalCommand": CANONICAL_FRONTEND_COMMAND,
        "effectiveCommand": CANONICAL_FRONTEND_COMMAND,
        "executionMode": "direct-java-bound-classpath-v1",
        "sourceSqlTransport": "exact-input-bytes-v1",
        "normalizationLayer": "none",
        "launchEnvironmentAlgorithm": FRONTEND_LAUNCH_ENVIRONMENT_ALGORITHM,
        "launchEnvironment": frontend_launch_environment_policy_record(),
        "launchTools": frontend_launch_tools_record(),
        "commandComponents": scripts,
        "java": java_runtime_record(),
        "maven": {
            "root": workspace_display_path(MAVEN_ROOT),
            "executable": executable_record(MAVEN_EXECUTABLE, "Maven executable"),
            "version": command_version(
                [str(MAVEN_EXECUTABLE), "--version"],
                "Maven",
                environment=canonical_frontend_environment(),
            ),
            "files": tree_file_records(MAVEN_ROOT, description="Maven distribution"),
            "settings": settings_record,
        },
        "calcite": {
            "classesRoot": workspace_display_path(CALCITE_CLASSES),
            "classCount": sum(row.get("kind") == "file" for row in class_records),
            "classes": class_records,
            "classpathPath": workspace_display_path(CALCITE_CLASSPATH),
            "runtimeClasspathEnvironmentVariable": "LOGOS_CALCITE_RUNTIME_CLASSPATH_FILE",
            "classpathSha256": sha256_file(CALCITE_CLASSPATH),
            "classpath": classpath,
            "dependencyCount": len(dependencies),
            "dependencies": dependencies,
        },
    }


def frontend_stack_record(run_dir: Path, *, resume: bool) -> dict[str, Any]:
    document = build_frontend_stack_manifest()
    path = run_dir / "frontend-stack-manifest.json"
    digest = write_or_validate_manifest(
        path,
        document,
        resume=resume,
        description="SQL frontend-stack manifest",
    )
    return {
        "manifestPath": workspace_display_path(path),
        "manifestSha256": digest,
        "manifestSchemaVersion": FRONTEND_STACK_MANIFEST_SCHEMA_VERSION,
        "algorithm": FRONTEND_STACK_MANIFEST_ALGORITHM,
        "canonicalCommand": document["canonicalCommand"],
        "effectiveCommand": document["effectiveCommand"],
        "executionMode": document["executionMode"],
        "sourceSqlTransport": document["sourceSqlTransport"],
        "normalizationLayer": document["normalizationLayer"],
        "launchEnvironmentAlgorithm": document["launchEnvironmentAlgorithm"],
        "launchEnvironmentPolicy": document["launchEnvironment"][
            "unlistedEnvironmentPolicy"
        ],
        "launchEnvironmentVariableCount": len(
            document["launchEnvironment"]["fixedVariables"]
        )
        + len(document["launchEnvironment"]["explicitContractVariables"]),
        "launchToolCount": document["launchTools"]["toolCount"],
        "launchToolDynamicLinkingAlgorithm": document["launchTools"]["dynamicLinking"][
            "algorithm"
        ],
        "launchToolDynamicRuntimeFileCount": document["launchTools"]["dynamicLinking"][
            "fileCount"
        ],
        "javaVersion": document["java"]["version"],
        "mavenVersion": document["maven"]["version"],
        "calciteClassCount": document["calcite"]["classCount"],
        "dependencyCount": document["calcite"]["dependencyCount"],
    }


def toml_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=True)


def sanitized_codex_config() -> tuple[bytes, dict[str, Any], Path]:
    source_home = (
        Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
        .expanduser()
        .resolve()
    )
    source_path = source_home / "config.toml"
    if not source_path.is_file() or source_path.is_symlink():
        raise RunnerError(f"Codex config is missing or symlinked: {source_path}")
    try:
        document = tomllib.loads(source_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise RunnerError(f"cannot parse Codex config: {error}") from error
    provider_id = document.get("model_provider")
    providers = document.get("model_providers")
    provider = providers.get(provider_id) if isinstance(providers, dict) else None
    if (
        document.get("model") != EXPECTED_MODEL
        or document.get("model_reasoning_effort") != EXPECTED_REASONING_EFFORT
        or not isinstance(provider_id, str)
        or re.fullmatch(r"[A-Za-z0-9_.-]+", provider_id) is None
        or not isinstance(provider, dict)
    ):
        raise RunnerError(
            "Codex config does not select the frozen model/provider treatment"
        )
    allowed_provider_keys = {
        "name",
        "base_url",
        "wire_api",
        "supports_websockets",
        "requires_openai_auth",
    }
    if set(provider) != allowed_provider_keys:
        raise RunnerError(
            "selected Codex provider must use only the minimal nonsecret provider fields"
        )
    name = provider.get("name")
    base_url = provider.get("base_url")
    wire_api = provider.get("wire_api")
    supports_websockets = provider.get("supports_websockets")
    requires_openai_auth = provider.get("requires_openai_auth")
    preferred_auth = document.get("preferred_auth_method", "apikey")
    if (
        not isinstance(name, str)
        or not name
        or not isinstance(base_url, str)
        or not base_url
        or wire_api != "responses"
        or not isinstance(supports_websockets, bool)
        or not isinstance(requires_openai_auth, bool)
        or preferred_auth not in {"apikey", "chatgpt"}
    ):
        raise RunnerError("selected Codex provider configuration is malformed")
    endpoint = urlsplit(base_url)
    if (
        endpoint.scheme not in {"http", "https"}
        or not endpoint.hostname
        or endpoint.username is not None
        or endpoint.password is not None
        or endpoint.query
        or endpoint.fragment
    ):
        raise RunnerError("Codex provider base URL is not a nonsecret HTTP(S) endpoint")
    lines = [
        f"model = {toml_string(EXPECTED_MODEL)}",
        f"model_reasoning_effort = {toml_string(EXPECTED_REASONING_EFFORT)}",
        f"model_provider = {toml_string(provider_id)}",
        f"preferred_auth_method = {toml_string(preferred_auth)}",
        "",
        f"[model_providers.{toml_string(provider_id)}]",
        f"name = {toml_string(name)}",
        f"base_url = {toml_string(base_url)}",
        f"wire_api = {toml_string(wire_api)}",
        f"supports_websockets = {'true' if supports_websockets else 'false'}",
        f"requires_openai_auth = {'true' if requires_openai_auth else 'false'}",
        "",
    ]
    encoded = "\n".join(lines).encode("utf-8")
    endpoint_identity = {
        "providerId": provider_id,
        "name": name,
        "baseUrl": base_url,
        "baseUrlSha256": sha256_text(base_url),
        "scheme": endpoint.scheme,
        "host": endpoint.hostname,
        "port": endpoint.port,
        "path": endpoint.path,
        "wireApi": wire_api,
        "supportsWebsockets": supports_websockets,
        "requiresOpenaiAuth": requires_openai_auth,
    }
    return encoded, endpoint_identity, source_home


def write_or_validate_secure_snapshot(path: Path, data: bytes, *, resume: bool) -> str:
    digest = hashlib.sha256(data).hexdigest()
    if resume and path.is_file():
        if path.is_symlink() or path.read_bytes() != data:
            raise RunnerError(
                "resume sanitized Codex config differs from its frozen snapshot"
            )
    elif resume:
        raise RunnerError(f"resume sanitized Codex config is missing: {path}")
    else:
        atomic_write_bytes(path, data)
    path.chmod(0o600)
    if sha256_file(path) != digest:
        raise RunnerError("sanitized Codex config snapshot changed while being written")
    return digest


def lexical_executable_record(path: Path, description: str) -> dict[str, Any]:
    if not path.is_absolute() or not os.path.lexists(path) or not path.exists():
        raise RunnerError(f"{description} lexical path is unavailable: {path}")
    resolved = path.resolve(strict=True)
    if not resolved.is_file() or not os.access(resolved, os.X_OK):
        raise RunnerError(f"{description} lexical target is not executable: {path}")
    return {
        "path": str(path),
        "kind": "symlink" if path.is_symlink() else "file",
        "symlinkTarget": os.readlink(path) if path.is_symlink() else None,
        "resolvedPath": workspace_display_path(resolved),
        "sha256": sha256_file(resolved),
        "bytes": resolved.stat().st_size,
    }


def codex_solver_path_record(
    lexical_codex: dict[str, Any], lexical_node: dict[str, Any] | None
) -> dict[str, Any]:
    candidates: list[tuple[str, Path, str | None]] = [
        (
            "codexLexicalWrapper",
            Path(lexical_codex["path"]).parent,
            lexical_codex["sha256"],
        )
    ]
    if lexical_node is not None:
        candidates.append(
            (
                "nodeLexicalExecutable",
                Path(lexical_node["path"]).parent,
                lexical_node["sha256"],
            )
        )
    candidates.extend(
        (("systemTools", Path("/usr/bin"), None), ("systemTools", Path("/bin"), None))
    )
    directories: list[dict[str, Any]] = []
    seen: set[str] = set()
    for role, path, executable_sha256 in candidates:
        value = str(path)
        if value in seen:
            continue
        seen.add(value)
        directories.append(
            {
                "ordinal": len(directories) + 1,
                "role": role,
                "path": value,
                "boundExecutableSha256": executable_sha256,
            }
        )
    return {
        "algorithm": "logos-codex-solver-path-v1",
        "value": os.pathsep.join(row["path"] for row in directories),
        "directoryCount": len(directories),
        "directories": directories,
    }


def codex_command_environment(path_value: str) -> dict[str, str]:
    return {
        "PATH": path_value,
        "HOME": "/nonexistent",
        "TMPDIR": "/tmp",
        "LC_ALL": "C",
        "LANG": "C",
        "TZ": "UTC",
    }


def command_provider_environment_policy_record() -> dict[str, Any]:
    return {
        "schemaVersion": 1,
        "inheritedEnvironmentCleared": True,
        "fixedVariables": [
            "HOME=/nonexistent",
            "TMPDIR=/tmp",
            "LC_ALL=C",
            "LANG=C",
            "TZ=UTC",
        ],
        "hostEnvironmentAllowlist": [
            "PATH",
            "CODEX_HOME",
            "LOGOS_SOLVER_CODEX_HOME",
            "LOGOS_SOLVER_CODEX_CONFIG",
        ],
        "explicitContractVariables": ["LOGOS_PROPOSAL_JSON"],
        "unlistedEnvironmentPolicy": "excluded_by_env_clear_before_process_start",
        "explicitlyExcludedVariables": list(SOLVER_LAUNCH_EXCLUDED_VARIABLES),
        "explicitlyExcludedPrefixes": list(TRUSTED_LAUNCH_EXCLUDED_PREFIXES),
    }


def codex_cli_record() -> dict[str, Any]:
    lexical = shutil.which("codex")
    if lexical is None:
        raise RunnerError("host Codex CLI is unavailable in PATH")
    lexical_path = Path(lexical).absolute()
    resolved = lexical_path.resolve()
    lexical_record = lexical_executable_record(lexical_path, "host Codex CLI")
    record: dict[str, Any] = {
        "invocationPath": str(lexical_path),
        "lexicalWrapper": lexical_record,
        "executable": executable_record(resolved, "host Codex CLI"),
    }
    try:
        with resolved.open(encoding="utf-8") as stream:
            first_line = stream.readline().strip()
    except (OSError, UnicodeDecodeError):
        first_line = ""
    lexical_node_record: dict[str, Any] | None = None
    if resolved.suffix == ".js" or "node" in first_line:
        shebang = shlex.split(first_line.removeprefix("#!"))
        if not shebang or shebang[0] != "/usr/bin/env" or "node" not in shebang[1:]:
            raise RunnerError(
                "Codex JavaScript entrypoint must use the bound /usr/bin/env Node interpreter"
            )
        package_root = resolved.parent.parent
        package_json = package_root / "package.json"
        if not package_json.is_file():
            raise RunnerError("Codex JavaScript entrypoint has no package closure")
        node_name = shutil.which("node")
        if node_name is None:
            raise RunnerError("Codex JavaScript entrypoint has no Node executable")
        node_lexical_path = Path(node_name).absolute()
        node_path = node_lexical_path.resolve()
        lexical_node_record = lexical_executable_record(
            node_lexical_path, "Node executable"
        )
        env_tool = fixed_absolute_tool_record("env", Path("/usr/bin/env"))
        node_tool = fixed_absolute_tool_record("node", node_path)
        interpreter_paths = {"env": Path("/usr/bin/env"), "node": node_path}
        interpreter_records = {"env": env_tool, "node": node_tool}
        interpreter_dynamic_linking = dynamic_linking_record(
            interpreter_paths,
            interpreter_records,
            ("env", "node"),
            ldd_path=TRUSTED_LDD_PATH,
            readelf_path=Path("/usr/bin/readelf"),
        )
        record.update(
            {
                "node": {
                    "invocationPath": str(node_lexical_path),
                    "lexicalExecutable": lexical_node_record,
                    "executable": executable_record(node_path, "Node executable"),
                },
                "interpreterChain": {
                    "shebang": first_line,
                    "envExecutable": env_tool,
                    "nodeExecutable": node_tool,
                    "dynamicLinking": interpreter_dynamic_linking,
                },
                "packageRoot": workspace_display_path(package_root),
                "packageFiles": tree_file_records(
                    package_root, description="host Codex package"
                ),
            }
        )
    else:
        interpreter = first_line.removeprefix("#!").split()
        if interpreter:
            interpreter_name = interpreter[0]
            if Path(interpreter_name).name == "env" and len(interpreter) > 1:
                interpreter_name = shutil.which(interpreter[1]) or interpreter[1]
            interpreter_path = Path(interpreter_name).resolve()
            if interpreter_path.is_file() and os.access(interpreter_path, os.X_OK):
                record["interpreter"] = executable_record(
                    interpreter_path, "Codex launcher interpreter"
                )
    solver_path = codex_solver_path_record(lexical_record, lexical_node_record)
    record["solverPath"] = solver_path
    version_environment = codex_command_environment(solver_path["value"])
    record["version"] = command_version(
        [str(lexical_path), "--version"],
        "Codex CLI",
        environment=version_environment,
    )
    if "node" in record:
        record["node"]["version"] = command_version(
            [str(Path(record["node"]["invocationPath"])), "--version"],
            "Node",
            environment=version_environment,
        )
    return record


def build_codex_provider_manifest(
    config_path: Path, endpoint_identity: dict[str, Any]
) -> dict[str, Any]:
    if not config_path.is_file() or config_path.is_symlink():
        raise RunnerError(f"sanitized Codex config snapshot is missing: {config_path}")
    config_text = config_path.read_text(encoding="utf-8")
    forbidden = re.compile(
        r"(?i)(api[_-]?key|access[_-]?token|secret|password|credential)\s*="
    )
    if forbidden.search(config_text):
        raise RunnerError("sanitized Codex config contains credential-shaped material")
    return {
        "schemaVersion": 1,
        "algorithm": CODEX_PROVIDER_MANIFEST_ALGORITHM,
        "config": {
            "path": "codex-provider-config.toml",
            "sha256": sha256_file(config_path),
            "bytes": config_path.stat().st_size,
            "kind": "sanitized-minimal-nonsecret-codex-config",
        },
        "model": EXPECTED_MODEL,
        "reasoningEffort": EXPECTED_REASONING_EFFORT,
        "endpoint": endpoint_identity,
        "hostCodexCli": codex_cli_record(),
        "commandShell": {
            "shellExecutable": "/usr/bin/bash",
            "shellArguments": ["--noprofile", "--norc", "-c"],
        },
        "commandEnvironmentPolicy": command_provider_environment_policy_record(),
        "commands": {
            "counterexample": DEFAULT_COUNTEREXAMPLE_COMMAND,
            "counterexampleResume": DEFAULT_COUNTEREXAMPLE_RESUME_COMMAND,
            "proofAgent": DEFAULT_PROOF_AGENT_COMMAND,
            "proofAgentResume": DEFAULT_PROOF_AGENT_RESUME_COMMAND,
        },
    }


def codex_provider_record(run_dir: Path, *, resume: bool) -> tuple[dict[str, Any], Path]:
    encoded, endpoint, source_home = sanitized_codex_config()
    config_path = run_dir / "codex-provider-config.toml"
    config_digest = write_or_validate_secure_snapshot(config_path, encoded, resume=resume)
    document = build_codex_provider_manifest(config_path, endpoint)
    manifest_path = run_dir / "codex-provider-manifest.json"
    manifest_digest = write_or_validate_manifest(
        manifest_path,
        document,
        resume=resume,
        description="Codex provider manifest",
    )
    return (
        {
            "manifestPath": workspace_display_path(manifest_path),
            "manifestSha256": manifest_digest,
            "algorithm": CODEX_PROVIDER_MANIFEST_ALGORITHM,
            "configPath": workspace_display_path(config_path),
            "configSha256": config_digest,
            "configBytes": len(encoded),
            "model": EXPECTED_MODEL,
            "reasoningEffort": EXPECTED_REASONING_EFFORT,
            "endpoint": endpoint,
            "endpointSha256": sha256_text(
                json.dumps(endpoint, sort_keys=True, separators=(",", ":"))
            ),
            "hostCodexVersion": document["hostCodexCli"]["version"],
            "hostCodexInvocationPath": document["hostCodexCli"]["invocationPath"],
            "hostCodexLexicalWrapper": document["hostCodexCli"]["lexicalWrapper"],
            "hostCodexNodeInvocationPath": (
                document["hostCodexCli"].get("node", {}).get("invocationPath")
            ),
            "solverPath": document["hostCodexCli"]["solverPath"],
            "commandShell": document["commandShell"],
            "commandEnvironmentPolicy": document["commandEnvironmentPolicy"],
            "commands": document["commands"],
        },
        source_home,
    )


def prepare_codex_runtime_root() -> Path:
    if CODEX_RUNTIME_ROOT.is_symlink():
        raise RunnerError(
            f"Codex runtime root must not be symlinked: {CODEX_RUNTIME_ROOT}"
        )
    try:
        CODEX_RUNTIME_ROOT.mkdir(parents=True, mode=0o700, exist_ok=True)
    except OSError as error:
        raise RunnerError(
            f"cannot create Codex runtime root {CODEX_RUNTIME_ROOT}: {error}"
        ) from error
    if not CODEX_RUNTIME_ROOT.is_dir() or CODEX_RUNTIME_ROOT.is_symlink():
        raise RunnerError(
            f"Codex runtime root is not a real directory: {CODEX_RUNTIME_ROOT}"
        )
    if CODEX_RUNTIME_ROOT.stat().st_uid != os.getuid():
        raise RunnerError(
            f"Codex runtime root is not owned by the runner user: {CODEX_RUNTIME_ROOT}"
        )
    CODEX_RUNTIME_ROOT.chmod(0o700)
    return CODEX_RUNTIME_ROOT.resolve()


def stage_codex_runtime_home(
    source_home: Path, config_path: Path, runtime_parent: Path
) -> Path:
    if not source_home.is_dir() or source_home.is_symlink():
        raise RunnerError(
            f"Codex credential home is missing or symlinked: {source_home}"
        )
    if not runtime_parent.is_dir() or runtime_parent.is_symlink():
        raise RunnerError(
            "Codex runtime parent is missing, symlinked, or not a directory: "
            f"{runtime_parent}"
        )
    runtime_parent = runtime_parent.resolve()
    system_temporary_root = Path("/tmp").resolve()
    if (
        runtime_parent == system_temporary_root
        or system_temporary_root in runtime_parent.parents
    ):
        raise RunnerError(
            "Codex runtime parent must be outside the system temporary tree: "
            f"{runtime_parent}"
        )
    # Recent Codex CLIs deliberately refuse to create their execve/PATH helper
    # aliases when CODEX_HOME itself is below the system temporary directory.
    # Keep the credential copy private and ephemeral, but place it beside (not
    # inside) the supervisor-owned run tree so every solver invocation has a
    # usable campaign-local runtime home without making credentials part of the
    # durable run artifacts. The dedicated runtime root is outside every
    # published run tree, so an abnormal exit cannot make credentials look
    # like a run artifact awaiting publication.
    runtime_home = Path(
        tempfile.mkdtemp(prefix=".codex-runtime-", dir=str(runtime_parent))
    )
    runtime_home.chmod(0o700)
    try:
        shutil.copyfile(config_path, runtime_home / "config.toml")
        (runtime_home / "config.toml").chmod(0o600)
        auth_copied = False
        for name in ("auth.json", "credentials.json"):
            source = source_home / name
            if not source.exists():
                continue
            if not source.is_file() or source.is_symlink():
                raise RunnerError(
                    f"Codex credential source is not a regular file: {source}"
                )
            destination = runtime_home / name
            shutil.copyfile(source, destination)
            destination.chmod(0o600)
            auth_copied = auth_copied or name == "auth.json"
        if not auth_copied:
            raise RunnerError(
                "Codex auth.json is unavailable for the temporary runtime home"
            )
        return runtime_home
    except Exception:
        shutil.rmtree(runtime_home, ignore_errors=True)
        raise


def postgres_profile_document(postgres_url: str | None) -> dict[str, Any]:
    url_digest = (
        hashlib.sha256(postgres_url.encode("utf-8")).hexdigest()
        if postgres_url is not None
        else None
    )
    document: dict[str, Any] = {
        "schemaVersion": 1,
        "algorithm": POSTGRES_PROFILE_MANIFEST_ALGORITHM,
        "configured": postgres_url is not None,
        "urlSha256": url_digest,
    }
    if postgres_url is None:
        return document
    psql_name = shutil.which("psql")
    if psql_name is None:
        raise RunnerError(
            "psql is unavailable for PostgreSQL server-profile attestation"
        )
    psql = Path(psql_name).resolve()
    query = (
        "SELECT current_setting('server_version'),"
        "current_setting('server_version_num'),datcollate,datctype,"
        "CASE datlocprovider WHEN 'c' THEN 'libc' WHEN 'i' THEN 'icu' "
        "WHEN 'b' THEN 'builtin' ELSE datlocprovider::text END,"
        "pg_encoding_to_char(encoding),current_setting('TimeZone'),"
        "current_setting('max_connections') "
        "FROM pg_database WHERE datname=current_database();"
    )
    environment = {
        key: value for key, value in os.environ.items() if not key.startswith("PG")
    }
    environment.update({"PGCONNECT_TIMEOUT": "10", "PGAPPNAME": "logos-provenance"})
    try:
        completed = subprocess.run(
            [
                str(psql),
                "-X",
                "-A",
                "-t",
                "-F",
                "\t",
                "-v",
                "ON_ERROR_STOP=1",
                "--dbname",
                postgres_url,
                "--command",
                query,
            ],
            env=environment,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RunnerError(
            f"PostgreSQL server-profile probe failed: {type(error).__name__}"
        ) from error
    rows = completed.stdout.decode("utf-8", errors="strict").strip().splitlines()
    fields = rows[0].split("\t") if len(rows) == 1 else []
    if completed.returncode != 0 or len(fields) != 8:
        raise RunnerError(
            "PostgreSQL server-profile probe returned no unique eight-field row"
        )
    profile = {
        "serverVersion": fields[0],
        "serverVersionNum": fields[1],
        "databaseCollation": fields[2],
        "databaseCharacterClassification": fields[3],
        "localeProvider": fields[4],
        "serverEncoding": fields[5],
        "timeZone": fields[6],
        "maxConnections": fields[7],
    }
    expected = {
        "serverVersionNum": EXPECTED_POSTGRES_VERSION_NUM,
        "databaseCollation": "C",
        "databaseCharacterClassification": "C",
        "localeProvider": "libc",
        "serverEncoding": "UTF8",
        "timeZone": "UTC",
        "maxConnections": "96",
    }
    if (
        any(profile[key] != value for key, value in expected.items())
        or re.match(r"^17\.4(?:\s|$)", profile["serverVersion"]) is None
    ):
        raise RunnerError(
            "PostgreSQL server profile differs from frozen PG17.4 UTC/C contract"
        )
    document.update(
        {
            "psql": {
                "executable": executable_record(psql, "psql executable"),
                "version": command_version([str(psql), "--version"], "psql"),
            },
            "profile": profile,
        }
    )
    return document


def postgres_server_profile_record(
    run_dir: Path,
    postgres_url: str | None,
    *,
    require_frozen: bool,
    resume: bool,
) -> dict[str, Any]:
    if require_frozen and postgres_url is None:
        raise RunnerError("frozen full run requires an attested PostgreSQL server URL")
    document = postgres_profile_document(postgres_url)
    path = run_dir / "postgres-server-profile.json"
    digest = write_or_validate_manifest(
        path,
        document,
        resume=resume,
        description="PostgreSQL server-profile manifest",
    )
    return {
        "manifestPath": workspace_display_path(path),
        "manifestSha256": digest,
        "algorithm": POSTGRES_PROFILE_MANIFEST_ALGORITHM,
        "configured": document["configured"],
        "urlSha256": document["urlSha256"],
        "profile": document.get("profile"),
        "psql": document.get("psql"),
    }


def source_tree_digest_helper_record() -> dict[str, Any]:
    return {
        "path": SOURCE_TREE_DIGEST_HELPER_RELATIVE_PATH,
        "sha256": SOURCE_TREE_DIGEST_HELPER_SHA256,
        "bytes": SOURCE_TREE_DIGEST_HELPER_BYTES,
        "executionPolicy": "exact-bytes-loaded-before-module-execution-v1",
    }


def validate_framework_source_tree_helper_binding(
    manifest: dict[str, Any],
) -> dict[str, Any]:
    repository = manifest.get("repository")
    entries = repository.get("entries") if isinstance(repository, dict) else None
    if not isinstance(entries, list):
        raise RunnerError("framework source manifest has no repository entries")
    matches = [
        value
        for value in entries
        if isinstance(value, dict)
        and value.get("path") == SOURCE_TREE_DIGEST_HELPER_RELATIVE_PATH
    ]
    if len(matches) > 1:
        raise RunnerError("framework source manifest repeats the source digest helper")
    if matches and (
        matches[0].get("kind") != "file"
        or matches[0].get("sha256") != SOURCE_TREE_DIGEST_HELPER_SHA256
        or matches[0].get("bytes") != SOURCE_TREE_DIGEST_HELPER_BYTES
    ):
        raise RunnerError(
            "framework source manifest source digest helper binding drifted"
        )
    return source_tree_digest_helper_record()


def framework_source_tree_summary(
    manifest: dict[str, Any], path: Path, digest: str
) -> dict[str, Any]:
    repository = manifest["repository"]
    runner_entry = next(
        (
            value
            for value in repository["entries"]
            if value.get("path") == "benchmarks/scripts/run-logos"
            and value.get("kind") == "file"
        ),
        None,
    )
    if not isinstance(runner_entry, dict) or not isinstance(
        runner_entry.get("sha256"), str
    ):
        raise RunnerError("framework source manifest does not bind run-logos")
    helper_binding = validate_framework_source_tree_helper_binding(manifest)
    formal_sql = next(
        (
            value
            for value in repository["submodules"]
            if value.get("path") == "vendor/FormalSQL"
        ),
        None,
    )
    return {
        "manifestPath": workspace_display_path(path),
        "manifestSha256": digest,
        "logosHead": repository["head"],
        "formalSqlHead": formal_sql.get("head")
        if isinstance(formal_sql, dict)
        else None,
        "runnerScriptSha256": runner_entry["sha256"],
        "sourceTreeDigestHelper": helper_binding,
        "dirty": repository["dirty"],
    }


def read_preserved_source_tree_manifest(path: Path) -> tuple[dict[str, Any], str]:
    manifest = read_json_object(path, "framework source-tree manifest")
    try:
        encoded = source_tree_manifest_bytes(manifest)
        digest = source_tree_manifest_sha256(manifest)
    except (KeyError, TypeError, ValueError, SourceTreeError) as error:
        raise RunnerError(f"invalid framework source-tree manifest: {path}") from error
    if path.read_bytes() != encoded or sha256_file(path) != digest:
        raise RunnerError("preserved framework source-tree manifest changed")
    return manifest, digest


def framework_source_tree_record(
    run_dir: Path, *, resume: bool, allow_drift: bool = False
) -> dict[str, Any]:
    path = run_dir / "framework-source-tree-manifest.json"
    if resume:
        if not path.is_file() or path.is_symlink():
            raise RunnerError(f"resume source-tree manifest does not exist: {path}")
        preserved_manifest, preserved_digest = read_preserved_source_tree_manifest(path)
        preserved_summary = framework_source_tree_summary(
            preserved_manifest, path, preserved_digest
        )
        if sha256_file(Path(__file__).resolve()) != preserved_summary[
            "runnerScriptSha256"
        ]:
            raise RunnerError(
                "resume runner script differs from the preserved launch runner"
            )
        if not allow_drift:
            try:
                current_manifest = build_source_tree_manifest(LOGOS_ROOT)
            except (SourceTreeError, OSError) as error:
                raise RunnerError(str(error)) from error
            if source_tree_manifest_sha256(current_manifest) != preserved_digest:
                raise RunnerError(
                    "resume framework source tree differs from the preserved manifest; "
                    "do not mix framework revisions in one run"
                )
        return preserved_summary

    try:
        manifest = build_source_tree_manifest(LOGOS_ROOT)
    except (SourceTreeError, OSError) as error:
        raise RunnerError(str(error)) from error
    encoded = source_tree_manifest_bytes(manifest)
    digest = source_tree_manifest_sha256(manifest)
    atomic_write_bytes(path, encoded)
    if sha256_file(path) != digest:
        raise RunnerError("canonical source-tree manifest serialization drifted")
    return framework_source_tree_summary(manifest, path, digest)


def runtime_capture_source_file(
    source: Path,
    destination_relative: str,
    *,
    capture: str = "exact-copy",
    allow_empty: bool = False,
) -> dict[str, Any]:
    try:
        metadata = source.lstat()
    except OSError as error:
        raise RunnerError(f"cannot inspect trusted runtime source {source}: {error}") from error
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or (metadata.st_size == 0 and not allow_empty)
    ):
        raise RunnerError(
            f"trusted runtime source is not a nonempty regular non-symlink file: {source}"
        )
    relative = Path(destination_relative)
    if (
        relative.is_absolute()
        or relative.as_posix() != destination_relative
        or any(part in ("", ".", "..") for part in relative.parts)
    ):
        raise RunnerError(f"invalid trusted runtime destination: {destination_relative}")
    mode = 0o555 if metadata.st_mode & 0o111 else 0o444
    return {
        "path": destination_relative,
        "sourcePath": workspace_display_path(source.resolve(strict=True)),
        "sourceSha256": sha256_file(source),
        "sourceBytes": metadata.st_size,
        "mode": f"{mode:04o}",
        "capture": capture,
    }


def parse_runtime_findlib_configuration(path: Path) -> dict[str, str]:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as error:
        raise RunnerError(f"cannot read Rocq findlib configuration {path}: {error}") from error
    values: dict[str, str] = {}
    for line in lines:
        match = re.fullmatch(r'([a-z]+)="([^"\n]*)"', line)
        if match is None or match.group(1) in values:
            raise RunnerError("Rocq findlib configuration is not the fixed key/value form")
        values[match.group(1)] = match.group(2)
    expected_commands = {
        "ocamlc": "ocamlc.opt",
        "ocamlopt": "ocamlopt.opt",
        "ocamldep": "ocamldep.opt",
        "ocamldoc": "ocamldoc.opt",
    }
    if set(values) != {"destdir", "path", *expected_commands} or any(
        values[name] != value for name, value in expected_commands.items()
    ):
        raise RunnerError("Rocq findlib configuration has unexpected keys or commands")
    if not values["destdir"] or not values["path"]:
        raise RunnerError("Rocq findlib configuration has an empty search root")
    return values


def rewritten_runtime_findlib_bytes(snapshot_root: Path) -> bytes:
    install_library = snapshot_root / "_opam/lib"
    values = (
        ("destdir", str(install_library)),
        ("path", f"{install_library / 'ocaml'}:{install_library}"),
        ("ocamlc", "ocamlc.opt"),
        ("ocamlopt", "ocamlopt.opt"),
        ("ocamldep", "ocamldep.opt"),
        ("ocamldoc", "ocamldoc.opt"),
    )
    return "".join(f'{name}="{value}"\n' for name, value in values).encode("utf-8")


def selected_runtime_bwrap_and_libcap() -> tuple[Path, str, Path]:
    selected_name = shutil.which("bwrap", path=TRUSTED_CHECKER_INITIAL_PATH)
    if selected_name is None:
        raise RunnerError("trusted bubblewrap is unavailable in the fixed checker PATH")
    selected = Path(selected_name)
    if not selected.is_absolute() or selected.is_symlink():
        raise RunnerError("selected trusted bubblewrap must be an absolute non-symlink path")
    resolved = selected.resolve(strict=True)
    if (
        not resolved.is_file()
        or resolved.is_symlink()
        or resolved.stat().st_size == 0
        or not os.access(resolved, os.X_OK)
    ):
        raise RunnerError("selected trusted bubblewrap is not a nonempty executable file")
    output = trusted_command_output(
        [str(TRUSTED_LDD_PATH), str(resolved)], "trusted bubblewrap dependencies"
    )
    libcap_names = []
    for line in output.splitlines():
        match = re.match(r"^[ \t]*libcap\.so\.2[ \t]+=>[ \t]+([^ \t]+)", line)
        if match is not None:
            libcap_names.append(match.group(1))
    if len(libcap_names) != 1 or not libcap_names[0].startswith("/"):
        raise RunnerError("trusted bubblewrap did not resolve exactly one absolute libcap.so.2")
    selected_libcap = libcap_names[0]
    resolved_libcap = Path(selected_libcap).resolve(strict=True)
    metadata = resolved_libcap.lstat()
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_size == 0
    ):
        raise RunnerError("trusted bubblewrap libcap payload is not a regular file")
    return resolved, selected_libcap, resolved_libcap


def trusted_rocq_runtime_source_capture(source_switch: Path) -> dict[str, Any]:
    source_switch = source_switch.expanduser()
    if not source_switch.is_dir() or source_switch.is_symlink():
        raise RunnerError(
            f"configured Rocq source switch is missing or symlinked: {source_switch}"
        )
    source_switch = source_switch.resolve()
    install_prefix = source_switch / "_opam"
    if not install_prefix.is_dir() or install_prefix.is_symlink():
        raise RunnerError(f"configured Rocq install prefix is unsafe: {install_prefix}")

    files: list[dict[str, Any]] = []
    for source_relative, destination_relative in TRUSTED_ROCQ_RUNTIME_STANDALONE_FILES:
        files.append(
            runtime_capture_source_file(
                source_switch / source_relative,
                destination_relative,
            )
        )

    for root_relative in TRUSTED_ROCQ_RUNTIME_DIRECTORY_ROOTS:
        source_root = source_switch / root_relative
        if not source_root.is_dir() or source_root.is_symlink():
            raise RunnerError(f"trusted Rocq runtime directory is unsafe: {source_root}")
        for directory, directory_names, file_names in os.walk(
            source_root, topdown=True, followlinks=False
        ):
            directory_names.sort()
            file_names.sort()
            directory_path = Path(directory)
            directory_metadata = directory_path.lstat()
            if stat.S_ISLNK(directory_metadata.st_mode) or not stat.S_ISDIR(
                directory_metadata.st_mode
            ):
                raise RunnerError(
                    f"trusted Rocq runtime contains an unsafe directory: {directory_path}"
                )
            for name in directory_names:
                child = directory_path / name
                metadata = child.lstat()
                if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
                    raise RunnerError(
                        f"trusted Rocq runtime contains an unsafe directory: {child}"
                    )
            for name in file_names:
                source = directory_path / name
                relative = source.relative_to(source_switch).as_posix()
                files.append(
                    runtime_capture_source_file(source, relative, allow_empty=True)
                )

    findlib_source = source_switch / TRUSTED_ROCQ_RUNTIME_FINDLIB_PATH
    parse_runtime_findlib_configuration(findlib_source)
    files.append(
        runtime_capture_source_file(
            findlib_source,
            TRUSTED_ROCQ_RUNTIME_FINDLIB_PATH,
            capture="rewritten-findlib",
        )
    )

    bwrap, selected_libcap, libcap = selected_runtime_bwrap_and_libcap()
    files.append(
        runtime_capture_source_file(
            bwrap,
            TRUSTED_ROCQ_RUNTIME_BWRAP_PATH,
        )
    )
    libcap_record = runtime_capture_source_file(
        libcap,
        TRUSTED_ROCQ_RUNTIME_BWRAP_LIBCAP_PATH,
    )
    libcap_record["mode"] = "0444"
    files.append(libcap_record)

    files.sort(key=lambda record: record["path"])
    paths = [record["path"] for record in files]
    if len(paths) != len(set(paths)):
        raise RunnerError("trusted Rocq runtime capture repeats a destination path")
    return {
        "sourceSwitch": workspace_display_path(source_switch),
        "bwrapSelectedPath": workspace_display_path(bwrap),
        "bwrapLibcapSelectedPath": selected_libcap,
        "bwrapLibcapResolvedPath": workspace_display_path(libcap),
        "files": files,
    }


def copy_runtime_capture_file(
    source_record: dict[str, Any], destination: Path, snapshot_root: Path
) -> dict[str, Any]:
    source = resolve_artifact_path(source_record["sourcePath"])
    expected_sha256 = source_record["sourceSha256"]
    expected_bytes = source_record["sourceBytes"]
    mode = int(source_record["mode"], 8)
    destination.parent.mkdir(parents=True, exist_ok=True)
    if source_record["capture"] == "rewritten-findlib":
        parse_runtime_findlib_configuration(source)
        data = rewritten_runtime_findlib_bytes(snapshot_root)
        with destination.open("xb") as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
    else:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        descriptor = -1
        digest = hashlib.sha256()
        byte_count = 0
        try:
            descriptor = os.open(source, flags)
            metadata = os.fstat(descriptor)
            if not stat.S_ISREG(metadata.st_mode) or metadata.st_size != expected_bytes:
                raise RunnerError(f"trusted runtime source changed during capture: {source}")
            with os.fdopen(descriptor, "rb", closefd=True) as input_file, destination.open(
                "xb"
            ) as output:
                descriptor = -1
                while True:
                    chunk = input_file.read(1024 * 1024)
                    if not chunk:
                        break
                    digest.update(chunk)
                    byte_count += len(chunk)
                    output.write(chunk)
                output.flush()
                os.fsync(output.fileno())
        finally:
            if descriptor >= 0:
                os.close(descriptor)
        if byte_count != expected_bytes or digest.hexdigest() != expected_sha256:
            raise RunnerError(f"trusted runtime source changed during capture: {source}")
    destination.chmod(mode)
    os.utime(
        destination,
        ns=(TRUSTED_ROCQ_RUNTIME_CAPTURE_MTIME_NS,) * 2,
    )
    return {
        **source_record,
        "sha256": sha256_file(destination),
        "bytes": destination.stat().st_size,
    }


def trusted_rocq_runtime_snapshot_document(
    source_capture: dict[str, Any], files: list[dict[str, Any]]
) -> dict[str, Any]:
    directories = {""}
    for record in files:
        parent = Path(record["path"]).parent
        while parent != Path("."):
            directories.add(parent.as_posix())
            parent = parent.parent
    ordered_directories = sorted(directories)
    return {
        "schemaVersion": TRUSTED_ROCQ_RUNTIME_SNAPSHOT_SCHEMA_VERSION,
        "algorithm": TRUSTED_ROCQ_RUNTIME_SNAPSHOT_ALGORITHM,
        "policy": TRUSTED_ROCQ_RUNTIME_SNAPSHOT_POLICY,
        "rootLayout": "minimal-opam-rocq-runtime-bwrap-libcap-v1",
        "sourceSwitch": source_capture["sourceSwitch"],
        "findlibRewritePolicy": TRUSTED_ROCQ_RUNTIME_FINDLIB_REWRITE_POLICY,
        "bwrap": {
            "path": TRUSTED_ROCQ_RUNTIME_BWRAP_PATH,
            "selectedPath": source_capture["bwrapSelectedPath"],
            "libcapPath": TRUSTED_ROCQ_RUNTIME_BWRAP_LIBCAP_PATH,
            "libcapSelectedPath": source_capture["bwrapLibcapSelectedPath"],
            "libcapResolvedPath": source_capture["bwrapLibcapResolvedPath"],
            "resolutionPolicy": "origin-relative-snapshot-libcap-exact-v1",
        },
        "directoryCount": len(ordered_directories),
        "fileCount": len(files),
        "totalBytes": sum(record["bytes"] for record in files),
        "directories": ordered_directories,
        "files": files,
    }


def trusted_rocq_runtime_expected_files(
    document: dict[str, Any],
) -> dict[str, dict[str, Any]]:
    if (
        document.get("schemaVersion") != TRUSTED_ROCQ_RUNTIME_SNAPSHOT_SCHEMA_VERSION
        or document.get("algorithm") != TRUSTED_ROCQ_RUNTIME_SNAPSHOT_ALGORITHM
        or document.get("policy") != TRUSTED_ROCQ_RUNTIME_SNAPSHOT_POLICY
        or document.get("rootLayout")
        != "minimal-opam-rocq-runtime-bwrap-libcap-v1"
        or document.get("findlibRewritePolicy")
        != TRUSTED_ROCQ_RUNTIME_FINDLIB_REWRITE_POLICY
    ):
        raise RunnerError("trusted Rocq runtime snapshot manifest is incompatible")
    files = document.get("files")
    directories = document.get("directories")
    bwrap = document.get("bwrap")
    if (
        not isinstance(document.get("sourceSwitch"), str)
        or not document["sourceSwitch"]
        or not isinstance(files, list)
        or not files
        or not isinstance(directories, list)
        or not directories
        or directories != sorted(set(directories))
        or directories[0] != ""
        or not isinstance(bwrap, dict)
        or set(bwrap)
        != {
            "path",
            "selectedPath",
            "libcapPath",
            "libcapSelectedPath",
            "libcapResolvedPath",
            "resolutionPolicy",
        }
        or bwrap.get("path") != TRUSTED_ROCQ_RUNTIME_BWRAP_PATH
        or bwrap.get("libcapPath") != TRUSTED_ROCQ_RUNTIME_BWRAP_LIBCAP_PATH
        or bwrap.get("resolutionPolicy")
        != "origin-relative-snapshot-libcap-exact-v1"
    ):
        raise RunnerError("trusted Rocq runtime snapshot manifest is malformed")
    expected: dict[str, dict[str, Any]] = {}
    total_bytes = 0
    derived_directories = {""}
    for record in files:
        if not isinstance(record, dict) or set(record) != {
            "path",
            "sourcePath",
            "sourceSha256",
            "sourceBytes",
            "mode",
            "capture",
            "sha256",
            "bytes",
        }:
            raise RunnerError("trusted Rocq runtime snapshot file record is malformed")
        relative = record.get("path")
        if (
            not isinstance(relative, str)
            or not relative
            or Path(relative).is_absolute()
            or Path(relative).as_posix() != relative
            or any(part in ("", ".", "..") for part in Path(relative).parts)
            or relative in expected
            or not isinstance(record.get("sourcePath"), str)
            or not record["sourcePath"]
            or re.fullmatch(r"[0-9a-f]{64}", str(record.get("sourceSha256")))
            is None
            or isinstance(record.get("sourceBytes"), bool)
            or not isinstance(record.get("sourceBytes"), int)
            or record["sourceBytes"] < 0
            or record.get("mode") not in {"0444", "0555"}
            or record.get("capture") not in {"exact-copy", "rewritten-findlib"}
            or re.fullmatch(r"[0-9a-f]{64}", str(record.get("sha256"))) is None
            or isinstance(record.get("bytes"), bool)
            or not isinstance(record.get("bytes"), int)
            or record["bytes"] < 0
        ):
            raise RunnerError("trusted Rocq runtime snapshot file record is invalid")
        if record["capture"] == "exact-copy" and (
            record["sha256"] != record["sourceSha256"]
            or record["bytes"] != record["sourceBytes"]
        ):
            raise RunnerError("trusted Rocq runtime exact-copy provenance drifted")
        if record["capture"] == "rewritten-findlib" and relative != (
            TRUSTED_ROCQ_RUNTIME_FINDLIB_PATH
        ):
            raise RunnerError("unexpected rewritten trusted runtime file")
        expected[relative] = record
        total_bytes += record["bytes"]
        parent = Path(relative).parent
        while parent != Path("."):
            derived_directories.add(parent.as_posix())
            parent = parent.parent
    if (
        document.get("fileCount") != len(expected)
        or document.get("directoryCount") != len(directories)
        or document.get("totalBytes") != total_bytes
        or directories != sorted(derived_directories)
        or TRUSTED_ROCQ_RUNTIME_BWRAP_PATH not in expected
        or TRUSTED_ROCQ_RUNTIME_BWRAP_LIBCAP_PATH not in expected
        or TRUSTED_ROCQ_RUNTIME_FINDLIB_PATH not in expected
    ):
        raise RunnerError("trusted Rocq runtime snapshot counts or closure drifted")
    return expected


def verify_snapshot_bwrap_resolution(root: Path) -> None:
    expected = root / TRUSTED_ROCQ_RUNTIME_BWRAP_LIBCAP_PATH
    output = trusted_command_output(
        [str(TRUSTED_LDD_PATH), str(root / TRUSTED_ROCQ_RUNTIME_BWRAP_PATH)],
        "snapshotted trusted bubblewrap dependencies",
    )
    observed = []
    for line in output.splitlines():
        match = re.match(r"^[ \t]*libcap\.so\.2[ \t]+=>[ \t]+([^ \t]+)", line)
        if match is not None:
            observed.append(Path(match.group(1)))
    if len(observed) != 1 or observed[0].resolve(strict=True) != expected.resolve(
        strict=True
    ):
        raise RunnerError("snapshotted bubblewrap does not resolve its snapshotted libcap")


def verify_trusted_rocq_runtime_snapshot_tree(
    root: Path, document: dict[str, Any]
) -> None:
    if not root.is_dir() or root.is_symlink():
        raise RunnerError(f"trusted Rocq runtime snapshot root is unsafe: {root}")
    expected_files = trusted_rocq_runtime_expected_files(document)
    expected_directories = set(document["directories"])
    observed_files: set[str] = set()
    observed_directories = {""}
    for directory, directory_names, file_names in os.walk(
        root, topdown=True, followlinks=False
    ):
        directory_names.sort()
        file_names.sort()
        directory_path = Path(directory)
        relative_directory = directory_path.relative_to(root)
        directory_key = (
            "" if relative_directory == Path(".") else relative_directory.as_posix()
        )
        observed_directories.add(directory_key)
        metadata = directory_path.lstat()
        if (
            stat.S_ISLNK(metadata.st_mode)
            or not stat.S_ISDIR(metadata.st_mode)
            or stat.S_IMODE(metadata.st_mode) != 0o555
        ):
            raise RunnerError(
                f"trusted Rocq runtime snapshot directory is mutable or unsafe: {directory_path}"
            )
        for name in directory_names:
            child = directory_path / name
            child_metadata = child.lstat()
            if stat.S_ISLNK(child_metadata.st_mode) or not stat.S_ISDIR(
                child_metadata.st_mode
            ):
                raise RunnerError(
                    f"trusted Rocq runtime snapshot contains an unsafe directory: {child}"
                )
        for name in file_names:
            path = directory_path / name
            relative = path.relative_to(root).as_posix()
            record = expected_files.get(relative)
            file_metadata = path.lstat()
            if (
                record is None
                or stat.S_ISLNK(file_metadata.st_mode)
                or not stat.S_ISREG(file_metadata.st_mode)
                or file_metadata.st_nlink != 1
                or stat.S_IMODE(file_metadata.st_mode) != int(record["mode"], 8)
                or file_metadata.st_size != record["bytes"]
                or sha256_file(path) != record["sha256"]
            ):
                raise RunnerError(
                    f"trusted Rocq runtime snapshot file is invalid: {path}"
                )
            observed_files.add(relative)
    if observed_files != set(expected_files):
        raise RunnerError("trusted Rocq runtime snapshot file set changed")
    if observed_directories != expected_directories:
        raise RunnerError("trusted Rocq runtime snapshot directory set changed")
    expected_findlib = rewritten_runtime_findlib_bytes(root)
    if (root / TRUSTED_ROCQ_RUNTIME_FINDLIB_PATH).read_bytes() != expected_findlib:
        raise RunnerError("trusted Rocq runtime findlib configuration escaped its snapshot")
    verify_snapshot_bwrap_resolution(root)


def read_trusted_rocq_runtime_snapshot_manifest(
    path: Path,
) -> tuple[dict[str, Any], str]:
    if not path.is_file() or path.is_symlink():
        raise RunnerError(f"trusted Rocq runtime manifest is missing or symlinked: {path}")
    if stat.S_IMODE(path.stat().st_mode) != 0o444:
        raise RunnerError(f"trusted Rocq runtime manifest is not mode 0444: {path}")
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise RunnerError(f"cannot read trusted Rocq runtime manifest: {error}") from error
    if not isinstance(document, dict) or path.read_bytes() != canonical_json_bytes(
        document
    ):
        raise RunnerError("trusted Rocq runtime manifest is not canonical JSON")
    trusted_rocq_runtime_expected_files(document)
    return document, sha256_file(path)


def trusted_rocq_runtime_snapshot_summary(
    root: Path, manifest_path: Path, document: dict[str, Any], digest: str
) -> dict[str, Any]:
    return {
        "root": workspace_display_path(root),
        "manifestPath": workspace_display_path(manifest_path),
        "manifestSha256": digest,
        "schemaVersion": document["schemaVersion"],
        "algorithm": document["algorithm"],
        "policy": document["policy"],
        "fileCount": document["fileCount"],
        "directoryCount": document["directoryCount"],
        "totalBytes": document["totalBytes"],
    }


def load_trusted_rocq_runtime_snapshot_for_switch(
    switch: Path,
) -> tuple[dict[str, Any], dict[str, Any]]:
    switch = switch.expanduser().resolve()
    if switch.name != TRUSTED_ROCQ_RUNTIME_SNAPSHOT_NAME or switch.parent.name != "runtime":
        raise RunnerError("trusted Rocq switch is not the canonical run-private snapshot")
    manifest_path = switch.parent.parent / TRUSTED_ROCQ_RUNTIME_MANIFEST_NAME
    document, digest = read_trusted_rocq_runtime_snapshot_manifest(manifest_path)
    verify_trusted_rocq_runtime_snapshot_tree(switch, document)
    return document, trusted_rocq_runtime_snapshot_summary(
        switch, manifest_path, document, digest
    )


def pin_trusted_rocq_runtime(
    source_switch: Path, run_dir: Path, *, resume: bool
) -> dict[str, Any]:
    runtime_dir = run_dir / "runtime"
    destination = runtime_dir / TRUSTED_ROCQ_RUNTIME_SNAPSHOT_NAME
    manifest_path = run_dir / TRUSTED_ROCQ_RUNTIME_MANIFEST_NAME
    if resume:
        document, digest = read_trusted_rocq_runtime_snapshot_manifest(manifest_path)
        verify_trusted_rocq_runtime_snapshot_tree(destination, document)
        return trusted_rocq_runtime_snapshot_summary(
            destination, manifest_path, document, digest
        )
    if destination.exists() or destination.is_symlink() or manifest_path.exists():
        raise RunnerError("trusted Rocq runtime snapshot already exists")
    runtime_dir.mkdir(parents=True, exist_ok=True)
    initial_capture = trusted_rocq_runtime_source_capture(source_switch)
    stage = Path(tempfile.mkdtemp(prefix=".trusted-rocq-switch.", dir=runtime_dir))
    published = False
    try:
        files = []
        for source_record in initial_capture["files"]:
            files.append(
                copy_runtime_capture_file(
                    source_record,
                    stage / source_record["path"],
                    destination,
                )
            )
        if trusted_rocq_runtime_source_capture(source_switch) != initial_capture:
            raise RunnerError("trusted Rocq runtime changed during snapshot capture")
        document = trusted_rocq_runtime_snapshot_document(initial_capture, files)
        for directory, directory_names, _ in os.walk(stage, topdown=False):
            for name in directory_names:
                (Path(directory) / name).chmod(0o555)
            Path(directory).chmod(0o555)
        # The staged findlib file already names the final atomically published
        # prefix. Structural verification is meaningful only after that rename.
        trusted_rocq_runtime_expected_files(document)
        os.replace(stage, destination)
        published = True
        directory_fd = os.open(runtime_dir, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if not published and stage.exists():
            make_tree_writable_for_cleanup(stage)
            shutil.rmtree(stage)
    encoded = canonical_json_bytes(document)
    atomic_write_bytes(manifest_path, encoded)
    manifest_path.chmod(0o444)
    digest = hashlib.sha256(encoded).hexdigest()
    if sha256_file(manifest_path) != digest:
        raise RunnerError("trusted Rocq runtime manifest drifted after publication")
    verify_trusted_rocq_runtime_snapshot_tree(destination, document)
    return trusted_rocq_runtime_snapshot_summary(
        destination, manifest_path, document, digest
    )


def frozen_git_blob_bytes(repository: Path, commit: str, relative: str) -> bytes:
    if re.fullmatch(r"[0-9a-f]{40}", commit) is None:
        raise RunnerError("framework source manifest contains an invalid Git commit")
    if (
        not relative
        or Path(relative).is_absolute()
        or Path(relative).as_posix() != relative
        or any(part in ("", ".", "..") for part in Path(relative).parts)
    ):
        raise RunnerError(f"invalid frozen Git blob path: {relative}")
    command = ["/usr/bin/git", "-C", str(repository), "show", f"{commit}:{relative}"]
    environment = dict(TRUSTED_INSPECTION_ENVIRONMENT_ITEMS)
    environment["GIT_NO_REPLACE_OBJECTS"] = "1"
    try:
        completed = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            cwd="/",
            env=environment,
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RunnerError(f"cannot read frozen Git blob {commit}:{relative}: {error}") from error
    if completed.returncode != 0:
        diagnostic = completed.stderr.decode("utf-8", errors="replace").strip()
        raise RunnerError(
            f"cannot read frozen Git blob {commit}:{relative}: {diagnostic[:1000]}"
        )
    return completed.stdout


def framework_source_authority_record(
    framework_document: dict[str, Any], relative: str
) -> dict[str, Any]:
    repository = framework_document.get("repository")
    if not isinstance(repository, dict):
        raise RunnerError("framework source manifest has no repository authority")
    if relative.startswith("vendor/FormalSQL/"):
        submodules = repository.get("submodules")
        matches = (
            [
                value
                for value in submodules
                if isinstance(value, dict) and value.get("path") == "vendor/FormalSQL"
            ]
            if isinstance(submodules, list)
            else []
        )
        if len(matches) != 1:
            raise RunnerError("framework source manifest has no unique FormalSQL submodule")
        authority = matches[0]
        manifest_relative = relative.removeprefix("vendor/FormalSQL/")
        repository_root = LOGOS_ROOT / "vendor/FormalSQL"
        repository_name = "formal-sql-submodule"
    else:
        authority = repository
        manifest_relative = relative
        repository_root = LOGOS_ROOT
        repository_name = "logos"
    entries = authority.get("entries")
    if not isinstance(entries, list):
        raise RunnerError("framework source authority has no dirty-entry list")
    matching_entries = [
        entry
        for entry in entries
        if isinstance(entry, dict) and entry.get("path") == manifest_relative
    ]
    if len(matching_entries) > 1:
        raise RunnerError(f"framework source manifest repeats {relative}")
    commit = authority.get("head")
    if not isinstance(commit, str) or re.fullmatch(r"[0-9a-f]{40}", commit) is None:
        raise RunnerError(f"framework source authority has no frozen HEAD for {relative}")
    if matching_entries:
        entry = matching_entries[0]
        if (
            entry.get("kind") != "file"
            or not isinstance(entry.get("sha256"), str)
            or re.fullmatch(r"[0-9a-f]{64}", entry["sha256"]) is None
            or isinstance(entry.get("bytes"), bool)
            or not isinstance(entry.get("bytes"), int)
            or entry["bytes"] <= 0
        ):
            raise RunnerError(
                f"framework source manifest does not authorize a regular file for {relative}"
            )
        expected_sha256 = entry["sha256"]
        expected_bytes = entry["bytes"]
        origin = {
            "kind": "dirty-entry",
            "repository": repository_name,
            "commit": commit,
            "path": manifest_relative,
        }
    else:
        blob = frozen_git_blob_bytes(repository_root, commit, manifest_relative)
        expected_sha256 = hashlib.sha256(blob).hexdigest()
        expected_bytes = len(blob)
        if expected_bytes == 0:
            raise RunnerError(f"frozen Git blob is empty for {relative}")
        origin = {
            "kind": "git-blob",
            "repository": repository_name,
            "commit": commit,
            "path": manifest_relative,
        }
    path = LOGOS_ROOT / relative
    try:
        metadata = path.lstat()
    except OSError as error:
        raise RunnerError(f"cannot inspect framework-bound source {path}: {error}") from error
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_size != expected_bytes
        or sha256_file(path) != expected_sha256
    ):
        raise RunnerError(
            f"live trusted Rocq source differs from preserved framework authority: {relative}"
        )
    return {
        "path": relative,
        "sha256": expected_sha256,
        "bytes": expected_bytes,
        "origin": origin,
    }


def parse_vendor_rocq_build_order(project_bytes: bytes) -> list[str]:
    try:
        lines = project_bytes.decode("utf-8", errors="strict").splitlines()
    except UnicodeError as error:
        raise RunnerError("vendor _CoqProject is not strict UTF-8") from error
    declarations = [line.strip() for line in lines if line.strip()]
    if not declarations or declarations[0] != "-R . SQLFS":
        raise RunnerError("vendor _CoqProject has an unexpected logical-root declaration")
    sources = declarations[1:]
    if (
        not sources
        or len(sources) != len(set(sources))
        or any(
            not source.endswith(".v")
            or Path(source).is_absolute()
            or Path(source).as_posix() != source
            or any(part in ("", ".", "..") for part in Path(source).parts)
            for source in sources
        )
    ):
        raise RunnerError("vendor _CoqProject source order is malformed")
    return [f"vendor/FormalSQL/src/{source}" for source in sources]


def parse_logos_rocq_build_order(makefile_bytes: bytes) -> list[str]:
    try:
        lines = makefile_bytes.decode("utf-8", errors="strict").splitlines()
    except UnicodeError as error:
        raise RunnerError("Logos Makefile is not strict UTF-8") from error
    headers = [
        index
        for index, line in enumerate(lines)
        if line == "logos-formal-sql-lemmas: formal-sql"
    ]
    if len(headers) != 1:
        raise RunnerError("Logos Makefile has no unique trusted-theory target")
    sources: list[str] = []
    for line in lines[headers[0] + 1 :]:
        if not line.startswith("\t"):
            break
        match = re.fullmatch(
            r"\t\$\(LOGOS_ROCQ_COMPILE\) (theories/FormalSQL/[A-Z][A-Za-z0-9_]*\.v)",
            line,
        )
        if match is None:
            raise RunnerError("Logos trusted-theory recipe contains an unexpected command")
        sources.append(match.group(1))
    if not sources or len(sources) != len(set(sources)):
        raise RunnerError("Logos trusted-theory build order is empty or duplicated")
    return sources


def read_framework_bound_control_bytes(record: dict[str, Any]) -> bytes:
    path = LOGOS_ROOT / record["path"]
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    descriptor = -1
    try:
        descriptor = os.open(path, flags)
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size != record["bytes"]:
            raise RunnerError(f"framework control file changed during capture: {path}")
        with os.fdopen(descriptor, "rb", closefd=True) as stream:
            descriptor = -1
            data = stream.read()
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    if len(data) != record["bytes"] or hashlib.sha256(data).hexdigest() != record[
        "sha256"
    ]:
        raise RunnerError(f"framework control file changed during capture: {path}")
    return data


def trusted_rocq_source_build_inputs(
    framework_source_tree: dict[str, Any],
) -> dict[str, Any]:
    manifest_path = resolve_artifact_path(framework_source_tree["manifestPath"])
    framework_document, framework_digest = read_preserved_source_tree_manifest(
        manifest_path
    )
    if framework_digest != framework_source_tree.get("manifestSha256"):
        raise RunnerError("framework source summary digest drifted before Rocq capture")
    control_relatives = ("vendor/FormalSQL/src/_CoqProject", "Makefile")
    controls = [
        framework_source_authority_record(framework_document, relative)
        for relative in control_relatives
    ]
    control_by_path = {record["path"]: record for record in controls}
    vendor_order = parse_vendor_rocq_build_order(
        read_framework_bound_control_bytes(
            control_by_path["vendor/FormalSQL/src/_CoqProject"]
        )
    )
    logos_order = parse_logos_rocq_build_order(
        read_framework_bound_control_bytes(control_by_path["Makefile"])
    )

    vendor_root = LOGOS_ROOT / "vendor/FormalSQL/src"
    logos_root = LOGOS_ROOT / "theories/FormalSQL"
    observed_vendor = {
        path.relative_to(LOGOS_ROOT).as_posix()
        for path in vendor_root.rglob("*.v")
        if path.is_file() and not path.is_symlink()
    }
    observed_logos = {
        path.relative_to(LOGOS_ROOT).as_posix()
        for path in logos_root.glob("*.v")
        if path.is_file() and not path.is_symlink()
    }
    if observed_vendor != set(vendor_order):
        raise RunnerError("vendor _CoqProject does not exactly enumerate trusted .v sources")
    if observed_logos != set(logos_order):
        raise RunnerError("Logos Makefile does not exactly enumerate trusted .v sources")

    sources = []
    for declaration_index, relative in enumerate(
        [*vendor_order, *logos_order], start=1
    ):
        record = framework_source_authority_record(framework_document, relative)
        sources.append(
            {
                "declarationIndex": declaration_index,
                "logicalRoot": "SQLFS" if relative.startswith("vendor/") else "Logos",
                "sourcePath": record["path"],
                "sourceSha256": record["sha256"],
                "sourceBytes": record["bytes"],
                "origin": record["origin"],
            }
        )
    return {
        "frameworkSourceManifestPath": workspace_display_path(manifest_path),
        "frameworkSourceManifestSha256": framework_digest,
        "controlFiles": controls,
        "vendorSourceCount": len(vendor_order),
        "logosSourceCount": len(logos_order),
        "sources": sources,
    }


def trusted_source_object_pairs(authority_root: Path = LOGOS_ROOT) -> list[dict[str, Any]]:
    authority_root = authority_root.expanduser()
    if not authority_root.is_dir() or authority_root.is_symlink():
        raise RunnerError(
            f"trusted Rocq authority root is missing or symlinked: {authority_root}"
        )
    authority_root = authority_root.resolve()
    sources: list[Path] = []
    vendor_root = authority_root / "vendor/FormalSQL/src"
    logos_root = authority_root / "theories/FormalSQL"
    if (
        not vendor_root.is_dir()
        or vendor_root.is_symlink()
        or not logos_root.is_dir()
        or logos_root.is_symlink()
    ):
        raise RunnerError("trusted FormalSQL source roots are missing")
    sources.extend(vendor_root.rglob("*.v"))
    sources.extend(logos_root.glob("*.v"))

    records: list[dict[str, Any]] = []
    for source in sorted(sources):
        relative = source.relative_to(authority_root)
        if any(
            part in {"Examples", "examples", "catalog", "build", "_build", "var"}
            for part in relative.parts
        ):
            continue
        if source.name.endswith(("Example.v", "Examples.v")):
            continue
        object_path = source.with_suffix(".vo")
        if not source.is_file() or source.is_symlink():
            raise RunnerError(
                f"trusted source is not a regular non-symlink file: {source}"
            )
        if (
            not object_path.is_file()
            or object_path.is_symlink()
            or object_path.stat().st_size == 0
        ):
            raise RunnerError(
                f"trusted source lacks a nonempty regular .vo object: {source}"
            )
        if source.stat().st_mtime_ns > object_path.stat().st_mtime_ns:
            raise RunnerError(
                f"trusted object predates its source; rebuild before running: {object_path}"
            )
        records.append(
            {
                "sourcePath": relative.as_posix(),
                "sourceSha256": sha256_file(source),
                "sourceBytes": source.stat().st_size,
                "objectPath": object_path.relative_to(authority_root).as_posix(),
                "objectSha256": sha256_file(object_path),
                "objectBytes": object_path.stat().st_size,
            }
        )
    if not records:
        raise RunnerError("trusted FormalSQL source/object closure is empty")
    return records


def trusted_executable_record(path: Path, description: str) -> dict[str, Any]:
    """Bind one executable selected by the trusted checker, without hiding symlinks."""
    expanded = path.expanduser()
    if expanded.is_symlink():
        raise RunnerError(f"{description} must not be symlinked: {expanded}")
    if (
        not expanded.is_file()
        or expanded.stat().st_size == 0
        or not os.access(expanded, os.X_OK)
    ):
        raise RunnerError(
            f"{description} is missing, empty, or not executable: {expanded}"
        )
    resolved = expanded.resolve(strict=True)
    return {
        "path": workspace_display_path(resolved),
        "sha256": sha256_file(resolved),
        "bytes": resolved.stat().st_size,
    }


def trusted_command_output(command: list[str], description: str) -> str:
    if not command or not Path(command[0]).is_absolute():
        raise RunnerError(
            f"trusted inspection command is not absolute for {description}"
        )
    # This environment is intentionally constructed from an empty mapping.
    # In particular, Bash startup hooks/exported functions, loader variables,
    # OCaml lookup variables, CDPATH, and temporary-directory overrides are not
    # inherited by the ldd/readelf inspection subprocesses.
    environment = dict(TRUSTED_INSPECTION_ENVIRONMENT_ITEMS)
    try:
        completed = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=environment,
            cwd="/",
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RunnerError(f"cannot inspect {description}: {error}") from error
    if completed.returncode != 0:
        diagnostic = completed.stderr.decode("utf-8", errors="replace").strip()
        raise RunnerError(f"cannot inspect {description}: {diagnostic[:1000]}")
    return completed.stdout.decode("utf-8", errors="strict")


def trusted_inspection_environment_record() -> dict[str, Any]:
    return {
        "policy": TRUSTED_INSPECTION_ENVIRONMENT_POLICY,
        "parentEnvironmentInherited": False,
        "workingDirectory": "/",
        "allowedVariableCount": len(TRUSTED_INSPECTION_ENVIRONMENT_ITEMS),
        "allowedVariables": [
            {"name": name, "value": value}
            for name, value in TRUSTED_INSPECTION_ENVIRONMENT_ITEMS
        ],
    }


def trusted_checker_environment_policy_record() -> dict[str, Any]:
    return {
        "schemaVersion": 1,
        "inheritedEnvironmentCleared": True,
        "fixedVariables": [
            f"PATH={TRUSTED_CHECKER_INITIAL_PATH}",
            "HOME=/nonexistent",
            "LC_ALL=C",
            "LANG=C",
        ],
        "hostEnvironmentAllowlist": [],
        "explicitContractVariables": [
            "LOGOS_REPO_ROOT",
            "LOGOS_PROOF_WORKDIR",
            "LOGOS_TRUSTED_ROCQ_CACHE_DIR",
            "LOGOS_ROCQ_OPAM_SWITCH",
        ],
        "unlistedEnvironmentPolicy": "excluded_by_env_clear_before_process_start",
        "explicitlyExcludedVariables": list(TRUSTED_LAUNCH_EXCLUDED_VARIABLES),
        "explicitlyExcludedPrefixes": list(TRUSTED_LAUNCH_EXCLUDED_PREFIXES),
    }


def proof_agent_launcher_environment_policy_record() -> dict[str, Any]:
    return {
        "schemaVersion": 1,
        "inheritedEnvironmentCleared": True,
        "fixedVariables": [
            "PATH=/usr/bin:/bin",
            "LC_ALL=C",
            "LANG=C",
        ],
        "hostEnvironmentAllowlist": [
            "HOME",
            "CODEX_HOME",
            "LOGOS_SOLVER_CODEX_HOME",
            "LOGOS_SOLVER_CODEX_CONFIG",
            "OPENAI_API_KEY",
            "CODEX_API_KEY",
            "DOCKER_HOST",
            "DOCKER_CONTEXT",
            "DOCKER_CONFIG",
            "DOCKER_CERT_PATH",
            "DOCKER_TLS",
            "DOCKER_TLS_VERIFY",
            "DOCKER_API_VERSION",
        ],
        "explicitContractVariables": [
            "LOGOS_REPO_ROOT",
            "LOGOS_PROOF_WORKDIR",
            "LOGOS_PROOF_AGENT_CODEX_HOME",
            "LOGOS_PROOF_AGENT_STAGE",
            "LOGOS_PROOF_DIAGNOSTIC_SOCKET",
            "LOGOS_PROOF_DIAGNOSTIC_NONCE",
            "LOGOS_SOLVER_IMAGE",
            "LOGOS_PROOF_AGENT_COMMAND",
            "LOGOS_PROOF_AGENT_MEMORY_LIMIT",
            "LOGOS_PROOF_AGENT_STORAGE_LIMIT_BYTES",
            "LOGOS_PROOF_AGENT_TIMEOUT",
        ],
        "unlistedEnvironmentPolicy": "excluded_by_env_clear_before_process_start",
        "explicitlyExcludedVariables": list(TRUSTED_LAUNCH_EXCLUDED_VARIABLES),
        "explicitlyExcludedPrefixes": list(TRUSTED_LAUNCH_EXCLUDED_PREFIXES),
    }


def parse_literal_ldd_rtldlist(script: bytes) -> list[str]:
    """Parse the one literal RTLDLIST assignment used by the bound ldd script."""
    try:
        source = script.decode("utf-8", errors="strict")
    except UnicodeDecodeError as error:
        raise RunnerError("trusted ldd script is not strict UTF-8") from error
    assignments = [
        line
        for line in source.splitlines()
        if re.match(
            r"^[ \t]*(?:(?:export|readonly)[ \t]+)?RTLDLIST[ \t]*=",
            line,
        )
    ]
    if len(assignments) != 1:
        raise RunnerError(
            "trusted ldd script must contain exactly one RTLDLIST assignment"
        )
    match = re.fullmatch(r'RTLDLIST="([^"]+)"', assignments[0])
    if match is None:
        raise RunnerError(
            "trusted ldd RTLDLIST must be one unadorned double-quoted literal"
        )
    payload = match.group(1)
    candidates = payload.split(" ")
    if (
        not candidates
        or " ".join(candidates) != payload
        or any(not candidate for candidate in candidates)
    ):
        raise RunnerError("trusted ldd RTLDLIST has non-canonical whitespace")
    if len(set(candidates)) != len(candidates):
        raise RunnerError("trusted ldd RTLDLIST contains a duplicate candidate")
    for candidate in candidates:
        if (
            re.fullmatch(r"/[A-Za-z0-9._+/-]+", candidate) is None
            or os.path.normpath(candidate) != candidate
        ):
            raise RunnerError(
                "trusted ldd RTLDLIST contains a dynamic or non-canonical path"
            )
    return candidates


def selected_path_symlink_record(path: Path) -> dict[str, Any]:
    is_symlink = path.is_symlink()
    return {
        "selectedPathIsSymlink": is_symlink,
        "selectedPathSymlinkTarget": os.readlink(path) if is_symlink else None,
    }


def ldd_runtime_loader_closure(ldd_path: Path) -> dict[str, Any]:
    candidates = parse_literal_ldd_rtldlist(ldd_path.read_bytes())
    records: list[dict[str, Any]] = []
    present_count = 0
    for ordinal, candidate_name in enumerate(candidates, start=1):
        candidate = Path(candidate_name)
        base = {
            "ordinal": ordinal,
            "selectedPath": candidate_name,
        }
        if not os.path.lexists(candidate):
            records.append({**base, "state": "absent"})
            continue
        if not candidate.exists():
            raise RunnerError(
                f"trusted ldd RTLDLIST candidate is a dangling symlink: {candidate}"
            )
        resolved = candidate.resolve(strict=True)
        if (
            not resolved.is_file()
            or resolved.is_symlink()
            or resolved.stat().st_size == 0
            or not os.access(candidate, os.X_OK)
        ):
            raise RunnerError(
                "trusted ldd RTLDLIST candidate is not a nonempty executable "
                f"regular file: {candidate}"
            )
        with resolved.open("rb") as stream:
            magic = stream.read(4)
        if magic != b"\x7fELF":
            raise RunnerError(f"trusted ldd RTLDLIST candidate is not ELF: {candidate}")
        present_count += 1
        records.append(
            {
                **base,
                "state": "present",
                **selected_path_symlink_record(candidate),
                "resolvedPath": workspace_display_path(resolved),
                "resolvedMode": f"{resolved.stat().st_mode & 0o7777:04o}",
                "sha256": sha256_file(resolved),
                "bytes": resolved.stat().st_size,
                "executableCheckPassed": True,
                "elfCheck": {"passed": True, "magicHex": magic.hex()},
            }
        )
    if present_count == 0:
        raise RunnerError("trusted ldd RTLDLIST has no present executable loader")
    return {
        "algorithm": "logos-ldd-literal-rtldlist-closure-v1",
        "declaration": "RTLDLIST",
        "selectionPolicy": "ordered-first-present-compatible-loader-v1",
        "candidateCount": len(records),
        "presentCandidateCount": present_count,
        "absentCandidateCount": len(records) - present_count,
        "candidates": records,
    }


def optional_system_file_record(path: Path, description: str) -> dict[str, Any]:
    base = {"selectedPath": str(path)}
    if not os.path.lexists(path):
        return {**base, "state": "absent"}
    if not path.exists():
        raise RunnerError(f"{description} is a dangling symlink: {path}")
    resolved = path.resolve(strict=True)
    if not resolved.is_file() or resolved.is_symlink():
        raise RunnerError(f"{description} is not a regular file: {path}")
    return {
        **base,
        "state": "present",
        **selected_path_symlink_record(path),
        "resolvedPath": workspace_display_path(resolved),
        "resolvedMode": f"{resolved.stat().st_mode & 0o7777:04o}",
        "sha256": sha256_file(resolved),
        "bytes": resolved.stat().st_size,
    }


def system_resolver_configuration_record() -> dict[str, Any]:
    entries = [
        optional_system_file_record(path, "trusted dynamic-loader configuration")
        for path in TRUSTED_SYSTEM_RESOLVER_CONFIGURATION_PATHS
    ]
    present_count = sum(entry["state"] == "present" for entry in entries)
    return {
        "algorithm": "logos-system-dynamic-loader-config-closure-v1",
        "selectionPolicy": "fixed-system-dynamic-loader-paths-v1",
        "pathCount": len(entries),
        "presentPathCount": present_count,
        "absentPathCount": len(entries) - present_count,
        "paths": entries,
    }


def required_system_identity_file_record(
    path: Path, description: str
) -> dict[str, Any]:
    if not os.path.lexists(path):
        raise RunnerError(f"{description} is missing: {path}")
    if path.is_symlink() or not path.is_file():
        raise RunnerError(f"{description} is not a regular non-symlink file: {path}")
    resolved = path.resolve(strict=True)
    if resolved != path:
        raise RunnerError(f"{description} resolved away from its fixed path: {path}")
    return {
        "path": str(path),
        "present": True,
        "resolvedPath": workspace_display_path(resolved),
        "sha256": sha256_file(resolved),
        "bytes": resolved.stat().st_size,
    }


def system_identity_configuration_record() -> dict[str, Any]:
    entries = [
        required_system_identity_file_record(
            path, "trusted system identity configuration"
        )
        for path in TRUSTED_SYSTEM_IDENTITY_CONFIGURATION_PATHS
    ]
    present_count = sum(entry["present"] is True for entry in entries)
    return {
        "algorithm": TRUSTED_SYSTEM_IDENTITY_CONFIGURATION_ALGORITHM,
        "selectionPolicy": "fixed-system-identity-paths-v1",
        "pathCount": len(entries),
        "presentPathCount": present_count,
        "absentPathCount": len(entries) - present_count,
        "paths": entries,
    }


def elf_interpreter(path: Path, readelf_path: Path, description: str) -> str:
    output = trusted_command_output(
        [str(readelf_path), "-lW", str(path)], f"{description} ELF interpreter"
    )
    matches = re.findall(r"Requesting program interpreter:\s*([^\]]+)\]", output)
    if len(matches) != 1 or not matches[0].startswith("/"):
        raise RunnerError(f"{description} has no unique absolute ELF interpreter")
    return matches[0]


def elf_dependencies(
    path: Path,
    ldd_path: Path,
    description: str,
    *,
    allow_empty: bool = False,
) -> list[str]:
    output = trusted_command_output(
        [str(ldd_path), str(path)], f"{description} dependencies"
    )
    dependencies: set[str] = set()
    for line in output.splitlines():
        if "=> not found" in line:
            raise RunnerError(f"{description} has an unresolved ELF dependency: {line}")
        match = re.match(r"^\s*\S+\s+=>\s+(/\S+)\s+\(", line)
        if match is None:
            match = re.match(r"^\s*(/\S+)\s+\(", line)
        if match is not None:
            dependencies.add(match.group(1))
    if not dependencies and not allow_empty:
        raise RunnerError(f"{description} has no resolved ELF dependencies")
    return sorted(dependencies)


def dynamic_linking_record(
    executable_paths: dict[str, Path],
    executable_records: dict[str, dict[str, Any]],
    consumer_names: tuple[str, ...],
    *,
    ldd_path: Path,
    readelf_path: Path,
) -> dict[str, Any]:
    consumers: list[dict[str, Any]] = []
    files_by_mount_path: dict[str, dict[str, Any]] = {}
    for name in consumer_names:
        path = executable_paths[name]
        interpreter = elf_interpreter(path, readelf_path, f"trusted executable {name}")
        dependencies = elf_dependencies(path, ldd_path, f"trusted executable {name}")
        consumers.append(
            {
                "name": name,
                "executableSha256": executable_records[name]["sha256"],
                "interpreterMountPath": interpreter,
                "dependencyMountPaths": dependencies,
            }
        )
        for mount_path in sorted(set((interpreter, *dependencies))):
            source = Path(mount_path).resolve(strict=True)
            if (
                not source.is_file()
                or source.is_symlink()
                or source.stat().st_size == 0
            ):
                raise RunnerError(
                    "trusted executable runtime dependency is missing, empty, or "
                    f"invalid: {mount_path}"
                )
            record = {
                "mountPath": mount_path,
                "sourcePath": workspace_display_path(source),
                "sha256": sha256_file(source),
                "bytes": source.stat().st_size,
            }
            previous = files_by_mount_path.get(mount_path)
            if previous is not None and previous != record:
                raise RunnerError(
                    f"trusted ELF runtime target resolves inconsistently: {mount_path}"
                )
            files_by_mount_path[mount_path] = record
    files = [files_by_mount_path[path] for path in sorted(files_by_mount_path)]
    return {
        "algorithm": TRUSTED_DYNAMIC_LINKING_ALGORITHM,
        "consumerCount": len(consumers),
        "consumers": consumers,
        "fileCount": len(files),
        "files": files,
    }


def trusted_host_tools_record(
    install_prefix: Path,
) -> tuple[dict[str, Any], dict[str, Path]]:
    search_directories = (install_prefix / "bin", Path("/usr/bin"), Path("/bin"))
    search_path = os.pathsep.join(str(path) for path in search_directories)
    paths: dict[str, Path] = {}
    records: dict[str, dict[str, Any]] = {}
    for name in TRUSTED_HOST_TOOL_NAMES:
        selected_name = shutil.which(name, path=search_path)
        if selected_name is None:
            raise RunnerError(
                f"trusted host tool is unavailable in the sanitized PATH: {name}"
            )
        selected = Path(selected_name)
        if not selected.is_absolute():
            raise RunnerError(f"trusted host tool did not resolve absolutely: {name}")
        resolved = selected.resolve(strict=True)
        if (
            not resolved.is_file()
            or resolved.is_symlink()
            or resolved.stat().st_size == 0
            or not os.access(resolved, os.X_OK)
        ):
            raise RunnerError(
                f"trusted host tool is missing, empty, or non-executable: {selected}"
            )
        with resolved.open("rb") as stream:
            file_format = "elf" if stream.read(4) == b"\x7fELF" else "script"
        if file_format == "script" and name != "ldd":
            raise RunnerError(
                f"unexpected non-ELF trusted host tool in reviewed closure: {name}"
            )
        paths[name] = selected
        records[name] = {
            "name": name,
            "selectedPath": str(selected),
            "resolvedPath": workspace_display_path(resolved),
            "selectedPathIsSymlink": selected.is_symlink(),
            "format": file_format,
            "sha256": sha256_file(resolved),
            "bytes": resolved.stat().st_size,
        }

    bash_record = records["bash"]
    ldd_record = records["ldd"]
    for name, expected in (
        ("bash", Path("/usr/bin/bash")),
        ("timeout", Path("/usr/bin/timeout")),
        ("readlink", Path("/usr/bin/readlink")),
    ):
        if paths[name] != expected:
            raise RunnerError(
                f"trusted Rust host tool {name} did not resolve to {expected}"
            )
    ldd_path = paths["ldd"]
    if ldd_path != TRUSTED_LDD_PATH:
        raise RunnerError(
            f"trusted ldd did not resolve to the reviewed path {TRUSTED_LDD_PATH}"
        )
    if ldd_record["sha256"] not in TRUSTED_LDD_SHA256S:
        raise RunnerError(
            "trusted ldd differs from every reviewed literal-RTLDLIST script"
        )
    first_line = ldd_path.read_bytes().splitlines()[:1]
    if first_line != [b"#!/bin/bash"]:
        raise RunnerError("trusted ldd script has an unexpected interpreter")
    ldd_interpreter = Path("/bin/bash")
    ldd_interpreter_resolved = ldd_interpreter.resolve(strict=True)
    if sha256_file(ldd_interpreter_resolved) != bash_record["sha256"]:
        raise RunnerError("trusted ldd interpreter differs from the bound bash tool")
    ldd_record["scriptInterpreter"] = {
        "path": str(ldd_interpreter),
        "resolvedPath": workspace_display_path(ldd_interpreter_resolved),
        "hostTool": "bash",
        "sha256": bash_record["sha256"],
    }
    ldd_runtime_loaders = ldd_runtime_loader_closure(ldd_path)

    elf_names = tuple(
        name for name in TRUSTED_HOST_TOOL_NAMES if records[name]["format"] == "elf"
    )
    dynamic_linking = dynamic_linking_record(
        paths,
        records,
        elf_names,
        ldd_path=paths["ldd"],
        readelf_path=paths["readelf"],
    )
    return (
        {
            "selectionPolicy": "first-executable-in-sanitized-path-v1",
            "searchPath": search_path,
            "toolCount": len(records),
            "tools": [records[name] for name in TRUSTED_HOST_TOOL_NAMES],
            "inspectionEnvironment": trusted_inspection_environment_record(),
            "lddRuntimeLoaders": ldd_runtime_loaders,
            "systemResolverConfiguration": system_resolver_configuration_record(),
            "systemIdentityConfiguration": system_identity_configuration_record(),
            "dynamicLinking": dynamic_linking,
        },
        paths,
    )


def rocq_runtime_configuration_records(runtime_root: Path) -> list[dict[str, Any]]:
    paths = set(runtime_root.rglob("META"))
    paths.update(runtime_root.rglob("META.*"))
    paths.update(runtime_root.rglob("*.conf"))
    records: list[dict[str, Any]] = []
    for path in sorted(
        paths, key=lambda candidate: candidate.relative_to(runtime_root).as_posix()
    ):
        if not path.is_file() or path.is_symlink():
            raise RunnerError(f"invalid Rocq runtime configuration file: {path}")
        # Empty package markers carry no configuration bytes. If one gains
        # content it enters the deterministic closure on terminal recomputation.
        if path.stat().st_size == 0:
            continue
        records.append(
            {
                "path": path.relative_to(runtime_root).as_posix(),
                "sha256": sha256_file(path),
                "bytes": path.stat().st_size,
            }
        )
    required = {"findlib.conf", "rocq-runtime/META"}
    present = {record["path"] for record in records}
    missing = sorted(required - present)
    if missing:
        raise RunnerError(
            "required nonempty Rocq runtime configuration is missing: "
            + ", ".join(missing)
        )
    return records


def build_trusted_stack_manifest(
    proof_rocq_opam_switch: Path,
    authority_root: Path = LOGOS_ROOT,
) -> dict[str, Any]:
    switch = proof_rocq_opam_switch.resolve()
    _runtime_document, runtime_snapshot = (
        load_trusted_rocq_runtime_snapshot_for_switch(switch)
    )
    authority_root = authority_root.resolve()
    authority_manifest_path = authority_root.parent.parent / (
        "trusted-rocq-authority-manifest.json"
    )
    authority_document, authority_digest = read_rocq_authority_snapshot_manifest(
        authority_manifest_path
    )
    verify_rocq_authority_snapshot_tree(authority_root, authority_document)
    if (
        authority_document.get("runtimeSnapshotManifestPath")
        != runtime_snapshot["manifestPath"]
        or authority_document.get("runtimeSnapshotManifestSha256")
        != runtime_snapshot["manifestSha256"]
    ):
        raise RunnerError("trusted stack authority/runtime cross-binding drifted")
    authority_snapshot = rocq_authority_snapshot_summary(
        authority_root,
        authority_manifest_path,
        authority_document,
        authority_digest,
    )
    install_prefix = switch / "_opam"
    trusted_host_tools, trusted_host_tool_paths = trusted_host_tools_record(
        install_prefix
    )
    rocq_path = install_prefix / "bin/rocq"
    rocqchk_path = install_prefix / "bin/rocqchk"
    rocq_runtime_dir = install_prefix / "lib/rocq-runtime"
    rocqworker_path = rocq_runtime_dir / "rocqworker"
    rocqnative_path = rocq_runtime_dir / "rocqnative"
    bwrap_path = install_prefix / "bin/bwrap"
    executable_paths = {
        "rocq": rocq_path,
        "rocqchk": rocqchk_path,
        "rocqworker": rocqworker_path,
        "rocqnative": rocqnative_path,
        "bwrap": bwrap_path,
    }
    executables = {
        name: trusted_executable_record(path, f"trusted {name} executable")
        for name, path in executable_paths.items()
    }
    executables["bwrap"].update(
        {
            "selectionPolicy": "exact-run-private-switch-path-v1",
            "runtimeSnapshotManifestSha256": runtime_snapshot["manifestSha256"],
            "selectedPath": str(bwrap_path),
            "selectedPathIsSymlink": False,
        }
    )
    dynamic_linking = dynamic_linking_record(
        executable_paths,
        executables,
        TRUSTED_EXECUTABLE_NAMES,
        ldd_path=trusted_host_tool_paths["ldd"],
        readelf_path=trusted_host_tool_paths["readelf"],
    )

    scripts: list[dict[str, Any]] = []
    for relative in sorted(TRUSTED_STACK_SCRIPTS):
        path = LOGOS_ROOT / relative
        if not path.is_file() or path.is_symlink():
            raise RunnerError(f"trusted proof script is missing or symlinked: {path}")
        scripts.append(
            {
                "path": relative,
                "sha256": sha256_file(path),
                "bytes": path.stat().st_size,
            }
        )

    stdlib_root = install_prefix / "lib/coq"
    if not stdlib_root.is_dir() or stdlib_root.is_symlink():
        raise RunnerError(
            f"configured Rocq standard library is missing or symlinked: {stdlib_root}"
        )
    stdlib_objects = []
    for path in sorted(stdlib_root.rglob("*.vo")):
        if not path.is_file() or path.is_symlink() or path.stat().st_size == 0:
            raise RunnerError(f"invalid Rocq standard-library object: {path}")
        stdlib_objects.append(
            {
                "path": path.relative_to(stdlib_root).as_posix(),
                "sha256": sha256_file(path),
                "bytes": path.stat().st_size,
            }
        )
    if not stdlib_objects:
        raise RunnerError(
            f"no Rocq standard-library .vo files found under {stdlib_root}"
        )

    runtime_root = install_prefix / "lib"
    if not runtime_root.is_dir() or runtime_root.is_symlink():
        raise RunnerError(
            f"configured Rocq runtime is missing or symlinked: {runtime_root}"
        )
    runtime_paths = sorted(
        set(runtime_root.rglob("*.cmxs")) | set(runtime_root.rglob("*.so"))
    )
    runtime_components = []
    for path in runtime_paths:
        if not path.is_file() or path.is_symlink() or path.stat().st_size == 0:
            raise RunnerError(f"invalid Rocq runtime component: {path}")
        runtime_components.append(
            {
                "path": path.relative_to(runtime_root).as_posix(),
                "sha256": sha256_file(path),
                "bytes": path.stat().st_size,
            }
        )
    if not runtime_components:
        raise RunnerError(
            f"no Rocq runtime *.cmxs/*.so components found under {runtime_root}"
        )
    runtime_configuration = rocq_runtime_configuration_records(runtime_root)

    source_objects = trusted_source_object_pairs(authority_root)
    return {
        "schemaVersion": TRUSTED_STACK_MANIFEST_SCHEMA_VERSION,
        "algorithm": TRUSTED_STACK_MANIFEST_ALGORITHM,
        "rocqOpamSwitch": workspace_display_path(switch),
        "rocqRuntimeSnapshot": runtime_snapshot,
        "rocqAuthoritySnapshot": authority_snapshot,
        "executables": executables,
        "dynamicLinking": dynamic_linking,
        "trustedHostTools": trusted_host_tools,
        "trustedScripts": scripts,
        "sourceObjects": source_objects,
        "rocqStdlib": {
            "root": workspace_display_path(stdlib_root),
            "objectCount": len(stdlib_objects),
            "objects": stdlib_objects,
        },
        "rocqRuntime": {
            "root": workspace_display_path(runtime_root),
            "componentCount": len(runtime_components),
            "components": runtime_components,
            "configurationSelection": "nonempty-findlib-meta-conf-v1",
            "configurationCount": len(runtime_configuration),
            "configuration": runtime_configuration,
        },
    }


def trusted_stack_record(
    run_dir: Path,
    proof_rocq_opam_switch: Path,
    authority_root: Path,
    runtime_snapshot: dict[str, Any],
    authority_snapshot: dict[str, Any],
    *,
    resume: bool,
) -> dict[str, Any]:
    document = build_trusted_stack_manifest(
        proof_rocq_opam_switch,
        authority_root,
    )
    if document.get("rocqRuntimeSnapshot") != runtime_snapshot:
        raise RunnerError("trusted stack runtime snapshot binding drifted")
    if document.get("rocqAuthoritySnapshot") != authority_snapshot:
        raise RunnerError("trusted stack authority snapshot binding drifted")
    host_tools = document["trustedHostTools"]
    ldd_runtime_loaders = host_tools["lddRuntimeLoaders"]
    resolver_configuration = host_tools["systemResolverConfiguration"]
    identity_configuration = host_tools["systemIdentityConfiguration"]
    path = run_dir / "trusted-proof-stack-manifest.json"
    digest = write_or_validate_manifest(
        path,
        document,
        resume=resume,
        description="trusted proof-stack manifest",
    )
    return {
        "manifestPath": workspace_display_path(path),
        "manifestSha256": digest,
        "manifestSchemaVersion": TRUSTED_STACK_MANIFEST_SCHEMA_VERSION,
        "algorithm": TRUSTED_STACK_MANIFEST_ALGORITHM,
        "dynamicLinkingAlgorithm": TRUSTED_DYNAMIC_LINKING_ALGORITHM,
        "rocqRuntimeSnapshot": runtime_snapshot,
        "rocqAuthoritySnapshot": authority_snapshot,
        "sourceObjectPairCount": len(document["sourceObjects"]),
        "rocqStdlibObjectCount": document["rocqStdlib"]["objectCount"],
        "rocqRuntimeComponentCount": document["rocqRuntime"]["componentCount"],
        "rocqRuntimeConfigurationCount": document["rocqRuntime"]["configurationCount"],
        "trustedExecutableCount": len(document["executables"]),
        "dynamicRuntimeFileCount": document["dynamicLinking"]["fileCount"],
        "trustedHostToolCount": host_tools["toolCount"],
        "trustedHostDynamicRuntimeFileCount": host_tools["dynamicLinking"]["fileCount"],
        "trustedInspectionEnvironmentPolicy": host_tools["inspectionEnvironment"][
            "policy"
        ],
        "trustedInspectionEnvironmentVariableCount": host_tools[
            "inspectionEnvironment"
        ]["allowedVariableCount"],
        "lddRuntimeLoaderCandidateCount": ldd_runtime_loaders["candidateCount"],
        "lddRuntimeLoaderClosureAlgorithm": ldd_runtime_loaders["algorithm"],
        "lddRuntimeLoaderPresentCandidateCount": ldd_runtime_loaders[
            "presentCandidateCount"
        ],
        "lddRuntimeLoaderAbsentCandidateCount": ldd_runtime_loaders[
            "absentCandidateCount"
        ],
        "systemResolverConfigurationPathCount": resolver_configuration["pathCount"],
        "systemResolverConfigurationAlgorithm": resolver_configuration["algorithm"],
        "systemResolverConfigurationPresentPathCount": resolver_configuration[
            "presentPathCount"
        ],
        "systemResolverConfigurationAbsentPathCount": resolver_configuration[
            "absentPathCount"
        ],
        "systemIdentityConfigurationAlgorithm": identity_configuration["algorithm"],
        "systemIdentityConfigurationPathCount": identity_configuration["pathCount"],
        "systemIdentityConfigurationPresentPathCount": identity_configuration[
            "presentPathCount"
        ],
        "systemIdentityConfigurationAbsentPathCount": identity_configuration[
            "absentPathCount"
        ],
        "rocqExecutable": document["executables"]["rocq"],
        "rocqCheckExecutable": document["executables"]["rocqchk"],
        "rocqWorkerExecutable": document["executables"]["rocqworker"],
        "rocqNativeExecutable": document["executables"]["rocqnative"],
        "bwrapExecutable": document["executables"]["bwrap"],
        "trustedCheckerEnvironmentPolicy": (
            trusted_checker_environment_policy_record()
        ),
        "proofAgentLauncherEnvironmentPolicy": (
            proof_agent_launcher_environment_policy_record()
        ),
    }


def frozen_benchmark_record(
    input_root: Path,
    available_cases: list[BenchmarkCase],
    selected_cases: list[BenchmarkCase],
) -> dict[str, Any] | None:
    if input_root.resolve() != LEGACY_FROZEN_INPUT_ROOT.resolve():
        return None
    if (
        not FROZEN_SUMMARY.is_file()
        or sha256_file(FROZEN_SUMMARY) != FROZEN_SUMMARY_SHA256
    ):
        raise RunnerError(
            "frozen FinalExperiment/Logos/summary.raw.json digest changed"
        )
    try:
        document = json.loads(FROZEN_SUMMARY.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RunnerError(f"cannot read frozen benchmark summary: {error}") from error
    if document.get("benchmarkFingerprint") != FROZEN_BENCHMARK_FINGERPRINT:
        raise RunnerError("frozen benchmark fingerprint changed")
    rows = document.get("results")
    if not isinstance(rows, list):
        raise RunnerError("frozen benchmark summary has no results array")
    frozen_cases = {
        row.get("case")
        for row in rows
        if isinstance(row, dict) and isinstance(row.get("case"), str)
    }
    if len(rows) != 389 or len(frozen_cases) != 389:
        raise RunnerError("frozen benchmark summary is not 389 unique cases")
    generated = {case.case_id for case in available_cases}
    if generated != frozen_cases:
        missing = sorted(frozen_cases - generated)
        unexpected = sorted(generated - frozen_cases)
        details = []
        if missing:
            details.append("missing=" + ", ".join(missing[:8]))
        if unexpected:
            details.append("unexpected=" + ", ".join(unexpected[:8]))
        raise RunnerError(
            "generated benchmark root differs from the frozen 389-case cohort: "
            + "; ".join(details)
        )
    selected = {case.case_id for case in selected_cases}
    if not selected <= frozen_cases:
        unexpected = sorted(selected - frozen_cases)
        raise RunnerError(
            "selected generated cases escape the frozen benchmark: "
            + ", ".join(unexpected[:8])
        )
    return {
        "benchmarkFingerprint": FROZEN_BENCHMARK_FINGERPRINT,
        "frozenSummaryPath": workspace_display_path(FROZEN_SUMMARY),
        "frozenSummarySha256": FROZEN_SUMMARY_SHA256,
        "frozenCaseCount": len(frozen_cases),
        "generatedCaseCount": len(generated),
        "selectedCaseSetSha256": sha256_text("\n".join(sorted(selected)) + "\n"),
    }


def is_frozen_full_selection(
    input_root: Path,
    available_cases: list[BenchmarkCase],
    selected_cases: list[BenchmarkCase],
) -> bool:
    return (
        input_root.resolve() == LEGACY_FROZEN_INPUT_ROOT.resolve()
        and len(available_cases) == 389
        and len(selected_cases) == 389
        and {case.case_id for case in available_cases}
        == {case.case_id for case in selected_cases}
    )


def validate_frozen_full_launch_request(
    input_root: Path,
    available_cases: list[BenchmarkCase],
    selected_cases: list[BenchmarkCase],
    args: argparse.Namespace,
) -> None:
    full = is_frozen_full_selection(input_root, available_cases, selected_cases)
    if not full:
        if args.allow_ungated_full_run:
            raise RunnerError(
                "--allow-ungated-full-run is valid only for the exact frozen "
                "389-case selection"
            )
        return
    errors = []
    if args.jobs != 32:
        errors.append(f"--jobs must be 32, got {args.jobs}")
    expected_timeout = 14400 if args.allow_ungated_full_run else 3600
    if args.case_timeout != expected_timeout:
        errors.append(
            "--case-timeout must be exactly "
            f"{expected_timeout} seconds, got {args.case_timeout}"
        )
    if args.verification_mode != "outcome-unconditional":
        errors.append("--verification-mode must be outcome-unconditional")
    if args.allow_framework_source_drift:
        errors.append(
            "--allow-framework-source-drift is not permitted for the exact frozen "
            "389-case campaign"
        )
    if not args.postgres_url:
        errors.append("--postgres-url is required for the frozen full run")
    if not args.allow_ungated_full_run and not args.cohort16_gate_summary:
        errors.append("--cohort16-gate-summary is required")
    if errors:
        raise RunnerError(
            "frozen full 389-case launch configuration is invalid: " + "; ".join(errors)
        )


def resolve_artifact_path(value: str) -> Path:
    path = Path(value).expanduser()
    if path.is_absolute():
        return path.resolve()
    if path.parts and path.parts[0] == LOGOS_ROOT.name:
        return (WORKFLOW_ROOT / path).resolve()
    return (LOGOS_ROOT / path).resolve()


def frozen_scope_record() -> tuple[dict[str, Any], str, list[str]]:
    if not FROZEN_SCOPE.is_file() or FROZEN_SCOPE.is_symlink():
        raise RunnerError(f"frozen campaign scope is missing: {FROZEN_SCOPE}")
    scope_sha256 = sha256_file(FROZEN_SCOPE)
    if scope_sha256 != FROZEN_SCOPE_SHA256:
        raise RunnerError(
            "verifier-owned frozen campaign scope changed: expected "
            f"{FROZEN_SCOPE_SHA256}, got {scope_sha256}"
        )
    try:
        scope = json.loads(FROZEN_SCOPE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RunnerError(f"cannot read frozen campaign scope: {error}") from error
    if not isinstance(scope, dict) or scope.get("schemaVersion") != 1:
        raise RunnerError("frozen campaign scope is not schemaVersion 1")
    ablation = scope.get("ablationCases")
    extension = scope.get("extensionCases")
    if not isinstance(ablation, list) or not isinstance(extension, list):
        raise RunnerError("frozen campaign scope has no 8+8 case lists")
    cases = [*ablation, *extension]
    if (
        len(ablation) != 8
        or len(extension) != 8
        or len(cases) != len(set(cases))
        or not all(isinstance(case_id, str) and case_id for case_id in cases)
    ):
        raise RunnerError("frozen campaign scope does not contain 16 unique case IDs")
    return scope, scope_sha256, sorted(cases)


def completed_return_code_is_coherent(row: dict[str, Any]) -> bool:
    """Accept unknown exit telemetry only for strict crash-window recovery."""
    return_code = row.get("returnCode")
    if (
        isinstance(return_code, int)
        and not isinstance(return_code, bool)
        and return_code == 0
    ):
        return True
    invocation = row.get("terminalizedByInvocation")
    evidence = row.get("reportEvidence")
    return (
        return_code is None
        and row.get("status") == "completed"
        and row.get("recoveredFromTerminalReport") is True
        and row.get("elapsedIncomplete") is True
        and isinstance(invocation, int)
        and not isinstance(invocation, bool)
        and invocation >= 1
        and isinstance(evidence, dict)
        and evidence.get("present") is True
        and row.get("runnerError") is None
    )


def validate_gate_report(
    report_path: Path,
    case: BenchmarkCase,
    config: RunConfig,
    expected_metrics: dict[str, Any],
) -> None:
    """Validate one gate report through the ordinary trusted publication path.

    In particular, do not infer acceptance from an individual proof-agent
    round.  A deterministic-tail publication deliberately has no successful
    original round; its accepted final Rocq check lives in the separately
    digest-bound recovery record validated by the shared report validators.
    """
    report = read_json_object(report_path, "cohort16 solver report")
    validate_counterexample_provider_commands(report)
    if report.get("outcome") != "outcome_unconditional":
        raise RunnerError(
            f"cohort16 report is not outcome_unconditional: {report_path}"
        )
    proof = report.get("proof")
    if (
        not isinstance(proof, dict)
        or proof.get("verificationMode") != "outcome_unconditional"
        or proof.get("backendStatus") != "proof_complete"
        or proof.get("certification") != "OUTCOME-UNCONDITIONAL"
    ):
        raise RunnerError(
            f"cohort16 report has no trusted outcome certificate: {report_path}"
        )
    metrics = proof_metrics_from_report(report, case, config, report_path.parent)
    if metrics != expected_metrics:
        raise RunnerError(f"cohort16 report proof metrics drifted: {report_path}")
    validate_completed_report(
        report,
        {"proofMetrics": metrics},
        report_path.parent,
        case,
        config,
    )


def cohort16_gate_record(
    value: str | None,
    input_root: Path,
    available_cases: list[BenchmarkCase],
    selected_cases: list[BenchmarkCase],
    input_files: dict[str, dict[str, Any]],
    input_manifest: dict[str, Any],
    framework_source_tree: dict[str, Any],
    solver_binary: dict[str, Any],
    case_process_bootstrap: Path,
    case_process_supervisor: Path,
    case_process_isolation: dict[str, Any],
    rocq_authority_snapshot: dict[str, Any],
    trusted_stack: dict[str, Any],
    frontend_stack: dict[str, Any],
    codex_provider: dict[str, Any],
    postgres_server_profile: dict[str, Any],
    args: argparse.Namespace,
    proof_docker_image_identity: dict[str, Any],
    effective_postgres_url: str | None,
) -> dict[str, Any] | None:
    full = is_frozen_full_selection(input_root, available_cases, selected_cases)
    if value is None:
        if full and not args.allow_ungated_full_run:
            raise RunnerError("frozen full run requires a cohort16 gate summary")
        return None
    gate_path = resolve_path(value)
    if not gate_path.is_file() or gate_path.is_symlink():
        raise RunnerError(f"cohort16 gate summary is missing or symlinked: {gate_path}")
    gate_sha256 = sha256_file(gate_path)
    gate = read_json_object(gate_path, "cohort16 gate summary")
    scope, scope_sha256, expected_cases = frozen_scope_record()
    gate_cases = gate.get("cases")
    if (
        gate.get("schemaVersion") != 1
        or gate.get("status") != "complete"
        or not isinstance(gate_cases, list)
        or sorted(gate_cases) != expected_cases
        or len(gate_cases) != 16
    ):
        raise RunnerError("cohort16 gate is not one complete exact frozen 16-case run")
    counts = gate.get("counts")
    if (
        not isinstance(counts, dict)
        or counts.get("selected") != 16
        or counts.get("pending") != 0
        or counts.get("completed") != 16
        or counts.get("timedOut") != 0
        or counts.get("failed") != 0
        or counts.get("cancelled") != 0
    ):
        raise RunnerError("cohort16 gate terminal accounting is incomplete")
    if (
        gate.get("verificationMode") != "outcome-unconditional"
        or gate.get("model") != EXPECTED_MODEL
        or gate.get("reasoningEffort") != EXPECTED_REASONING_EFFORT
        or gate.get("usageComplete") is not True
    ):
        raise RunnerError("cohort16 gate treatment or usage configuration is invalid")
    integrity = gate.get("integrityVerification")
    if (
        not isinstance(integrity, dict)
        or integrity.get("verified") is not True
        or gate.get("integrityError") is not None
    ):
        raise RunnerError("cohort16 gate did not pass terminal integrity verification")

    configuration = gate.get("configuration")
    if not isinstance(configuration, dict):
        raise RunnerError("cohort16 gate has no configuration record")
    gate_framework = configuration.get("frameworkSourceTree")
    if (
        not isinstance(gate_framework, dict)
        or gate_framework.get("manifestSha256")
        != framework_source_tree["manifestSha256"]
    ):
        raise RunnerError("cohort16 gate framework digest differs from this run")
    gate_solver = configuration.get("solverBinary")
    if (
        not isinstance(gate_solver, dict)
        or gate_solver.get("sha256") != solver_binary["sha256"]
    ):
        raise RunnerError(
            "cohort16 gate solver executable digest differs from this run"
        )
    gate_stack = configuration.get("trustedStack")
    if (
        not isinstance(gate_stack, dict)
        or gate_stack.get("manifestSha256") != trusted_stack["manifestSha256"]
    ):
        raise RunnerError(
            "cohort16 gate trusted proof-stack digest differs from this run"
        )
    gate_runtime = configuration.get("rocqRuntimeSnapshot")
    expected_runtime = trusted_stack.get("rocqRuntimeSnapshot")
    if gate_runtime != expected_runtime:
        raise RunnerError("cohort16 gate trusted Rocq runtime differs from this run")
    gate_authority = configuration.get("rocqAuthoritySnapshot")
    if (
        not isinstance(gate_authority, dict)
        or gate_authority.get("policy") != TRUSTED_ROCQ_AUTHORITY_SNAPSHOT_POLICY
        or gate_authority.get("manifestSha256")
        != rocq_authority_snapshot["manifestSha256"]
    ):
        raise RunnerError(
            "cohort16 gate trusted Rocq authority differs from this run"
        )
    gate_frontend = configuration.get("frontendStack")
    gate_provider = configuration.get("codexProvider")
    gate_postgres = configuration.get("postgresServerProfile")
    if (
        not isinstance(gate_frontend, dict)
        or gate_frontend.get("manifestSha256") != frontend_stack["manifestSha256"]
        or not isinstance(gate_provider, dict)
        or gate_provider.get("manifestSha256") != codex_provider["manifestSha256"]
        or gate_provider.get("configSha256") != codex_provider["configSha256"]
        or gate_provider.get("endpointSha256") != codex_provider["endpointSha256"]
        or not isinstance(gate_postgres, dict)
        or gate_postgres.get("manifestSha256")
        != postgres_server_profile["manifestSha256"]
    ):
        raise RunnerError(
            "cohort16 gate frontend/provider/PostgreSQL provenance differs from this run"
        )
    expected_sql_environment = {
        "timeZone": args.sql_time_zone,
        "defaultCollation": args.sql_default_collation,
        "characterClassification": args.sql_character_classification,
        "localeProvider": args.sql_locale_provider,
        "serverEncoding": args.sql_server_encoding,
    }
    requested_solver_args = tuple(args.solver_arg or ())
    effective_args = (
        requested_solver_args
        if FORCED_COUNTEREXAMPLE_ARGUMENT in requested_solver_args
        else (FORCED_COUNTEREXAMPLE_ARGUMENT, *requested_solver_args)
    )
    proof_agent = configuration.get("proofAgent")
    if (
        configuration.get("caseTimeoutSeconds") != args.case_timeout
        or configuration.get("terminationGraceSeconds") != args.termination_grace
        or configuration.get("verificationMode") != args.verification_mode
        or configuration.get("model") != EXPECTED_MODEL
        or configuration.get("reasoningEffort") != EXPECTED_REASONING_EFFORT
        or configuration.get("effectiveSolverArgs") != list(effective_args)
        or configuration.get("solverBinarySnapshotPolicy")
        != SOLVER_BINARY_SNAPSHOT_POLICY
        or configuration.get("caseProcessIsolation")
        != case_process_isolation
        or configuration.get("rocqRuntimeSnapshot") != expected_runtime
        or configuration.get("rocqAuthoritySnapshotPolicy")
        != TRUSTED_ROCQ_AUTHORITY_SNAPSHOT_POLICY
        or configuration.get("frameworkSourceTreeDigestPolicy")
        != FRAMEWORK_SOURCE_DIGEST_POLICY_REQUIRED
        or configuration.get("postgresUrl")
        != postgres_url_value_record(effective_postgres_url)
        or configuration.get("sqlEnvironment") != expected_sql_environment
        or not isinstance(proof_agent, dict)
        or not isinstance(proof_agent.get("rocqOpamSwitch"), str)
        or resolve_artifact_path(proof_agent["rocqOpamSwitch"])
        != resolve_artifact_path(expected_runtime["root"])
        or proof_agent.get("model") != EXPECTED_MODEL
        or proof_agent.get("reasoningEffort") != EXPECTED_REASONING_EFFORT
        or proof_agent.get("totalTimeoutSeconds")
        != max(1, int(args.case_timeout) - 300)
        or proof_agent.get("trustedCheckTimeoutSeconds")
        != args.proof_check_timeout_seconds
        or proof_agent.get("trustedCheckerEnvironmentPolicy")
        != trusted_checker_environment_policy_record()
        or proof_agent.get("proofAgentLauncherEnvironmentPolicy")
        != proof_agent_launcher_environment_policy_record()
        or proof_agent.get("resourcePolicy")
        != {
            "memoryLimitMiB": args.proof_agent_memory_limit_mib,
            "storageLimitMiB": args.proof_agent_storage_limit_mib,
            "cpuLimit": None,
        }
        or proof_agent.get("dockerImage") != proof_docker_image_identity
    ):
        raise RunnerError(
            "cohort16 gate differs from the full run's immutable treatment/configuration"
        )

    available_by_id = {case.case_id: case for case in available_cases}
    if not set(expected_cases) <= set(available_by_id):
        raise RunnerError("current frozen inputs do not contain every cohort16 case")
    expected_selected_manifest = build_input_manifest(
        (available_by_id[case_id] for case_id in expected_cases), legacy=True
    )
    expected_selected_digest = input_manifest_sha256(expected_selected_manifest)
    expected_selected_semantic_manifest = build_semantic_input_authority_manifest(
        available_by_id[case_id] for case_id in expected_cases
    )
    expected_selected_semantic_digest = input_manifest_sha256(
        expected_selected_semantic_manifest
    )
    if (
        input_manifest.get("semanticAuthoritySha256")
        != FROZEN_SEMANTIC_INPUT_AUTHORITY_SHA256
        or input_manifest.get("selectedSemanticAuthoritySha256")
        != FROZEN_SEMANTIC_INPUT_AUTHORITY_SHA256
    ):
        raise RunnerError("current frozen semantic-input authority is not exact")
    gate_input = configuration.get("inputManifest")
    if (
        not isinstance(gate_input, dict)
        or gate_input.get("selectedSha256") != expected_selected_digest
        or gate_input.get("semanticAuthoritySha256")
        != FROZEN_SEMANTIC_INPUT_AUTHORITY_SHA256
        or gate_input.get("selectedSemanticAuthoritySha256")
        != expected_selected_semantic_digest
    ):
        raise RunnerError(
            "cohort16 gate selected semantic/input digest differs from frozen inputs"
        )
    if gate_input.get("sha256") != FROZEN_INPUT_MANIFEST_SHA256:
        raise RunnerError("cohort16 gate full-input manifest digest is not frozen")
    expected_integrity_bindings = {
        "frameworkSourceTreeManifestSha256": framework_source_tree["manifestSha256"],
        "solverBinarySha256": solver_binary["sha256"],
        "caseProcessIsolationSha256": hashlib.sha256(
            canonical_json_bytes(case_process_isolation)
        ).hexdigest(),
        "rocqRuntimeSnapshotManifestSha256": trusted_stack[
            "rocqRuntimeSnapshot"
        ]["manifestSha256"],
        "rocqAuthoritySnapshotManifestSha256": rocq_authority_snapshot[
            "manifestSha256"
        ],
        "trustedStackManifestSha256": trusted_stack["manifestSha256"],
        "frontendStackManifestSha256": frontend_stack["manifestSha256"],
        "codexProviderManifestSha256": codex_provider["manifestSha256"],
        "codexConfigSha256": codex_provider["configSha256"],
        "providerEndpointSha256": codex_provider["endpointSha256"],
        "postgresServerProfileSha256": postgres_server_profile["manifestSha256"],
        "inputManifestSha256": FROZEN_INPUT_MANIFEST_SHA256,
        "selectedInputManifestSha256": expected_selected_digest,
        "semanticAuthoritySha256": FROZEN_SEMANTIC_INPUT_AUTHORITY_SHA256,
        "selectedSemanticAuthoritySha256": expected_selected_semantic_digest,
    }
    for key, expected in expected_integrity_bindings.items():
        if integrity.get(key) != expected:
            raise RunnerError(f"cohort16 gate integrity binding drifted: {key}")

    expected_effective_configuration = {
        "verificationMode": args.verification_mode,
        "model": EXPECTED_MODEL,
        "reasoningEffort": EXPECTED_REASONING_EFFORT,
        "trustedCheckTimeoutSeconds": args.proof_check_timeout_seconds,
        "dockerImage": proof_docker_image_identity["effectiveReference"],
        "caseTimeoutSeconds": args.case_timeout,
        "statementTimeoutSeconds": args.statement_timeout_seconds,
        "maxCounterexampleRounds": args.max_counterexample_rounds,
        "terminationGraceSeconds": args.termination_grace,
        "proofAgentTotalTimeoutSeconds": max(1, int(args.case_timeout) - 300),
        "proofAgentSessionRestartAfterFailedRounds": (
            PROOF_AGENT_SESSION_RESTART_AFTER_FAILED_ROUNDS
        ),
        "proofAgentSessionHomePolicy": PROOF_AGENT_SESSION_HOME_POLICY,
        "proofAgentDiagnosticTransport": PROOF_AGENT_DIAGNOSTIC_TRANSPORT,
        "proofAgentDiagnosticCachePolicy": PROOF_AGENT_DIAGNOSTIC_CACHE_POLICY,
        "proofAgentDiagnosticTimeoutPolicy": PROOF_AGENT_DIAGNOSTIC_TIMEOUT_POLICY,
        "proofAgentDiagnosticBudgetPolicy": PROOF_AGENT_DIAGNOSTIC_BUDGET_POLICY,
        "proofAgentDiagnosticCheckerParallelismMax": (
            PROOF_AGENT_DIAGNOSTIC_CHECKER_PARALLELISM_MAX
        ),
        "proofAgentDiagnosticCheckerSchedulingPolicy": (
            PROOF_AGENT_DIAGNOSTIC_CHECKER_SCHEDULING_POLICY
        ),
        "proofAgentCompileCheckpointPolicy": PROOF_AGENT_COMPILE_CHECKPOINT_POLICY,
        "proofAgentScratchPersistencePolicy": PROOF_AGENT_SCRATCH_PERSISTENCE_POLICY,
        "proofAgentWritableStorageLimitBytes": (
            args.proof_agent_storage_limit_mib * 1024 * 1024
        ),
        "proofAgentWritableStoragePolicy": PROOF_AGENT_WRITABLE_STORAGE_POLICY,
        "proofAgentScratchAllowedExtensions": list(
            PROOF_AGENT_SCRATCH_ALLOWED_EXTENSIONS
        ),
        "trustedCheckerEnvironmentPolicy": (
            trusted_checker_environment_policy_record()
        ),
        "proofAgentLauncherEnvironmentPolicy": (
            proof_agent_launcher_environment_policy_record()
        ),
        "resourcePolicy": {
            "memoryLimitMiB": args.proof_agent_memory_limit_mib,
            "storageLimitMiB": args.proof_agent_storage_limit_mib,
            "cpuLimit": None,
        },
        "solverArgs": list(requested_solver_args),
        "effectiveSolverArgs": list(effective_args),
        "postgresUrl": postgres_url_value_record(effective_postgres_url),
        "sqlEnvironment": expected_sql_environment,
        "solverLaunchEnvironmentPolicy": configuration.get(
            "solverLaunchEnvironmentPolicy"
        ),
        "solverEnvironment": configuration.get("solverEnvironment"),
        "frontendLaunchEnvironmentPolicy": configuration.get(
            "frontendLaunchEnvironmentPolicy"
        ),
        "commandProviderEnvironmentPolicy": configuration.get(
            "commandProviderEnvironmentPolicy"
        ),
        "solverBinarySnapshotPolicy": SOLVER_BINARY_SNAPSHOT_POLICY,
        "caseProcessIsolation": case_process_isolation,
        "rocqRuntimeSnapshotPolicy": TRUSTED_ROCQ_RUNTIME_SNAPSHOT_POLICY,
        "rocqRuntimeSnapshotManifestSha256": trusted_stack[
            "rocqRuntimeSnapshot"
        ]["manifestSha256"],
        "rocqAuthoritySnapshotPolicy": TRUSTED_ROCQ_AUTHORITY_SNAPSHOT_POLICY,
        "rocqAuthoritySnapshotManifestSha256": rocq_authority_snapshot[
            "manifestSha256"
        ],
        "frameworkSourceTreeDigestPolicy": (
            FRAMEWORK_SOURCE_DIGEST_POLICY_REQUIRED
        ),
        "frameworkSourceTreeManifestSha256": framework_source_tree["manifestSha256"],
        "inputManifestSha256": FROZEN_INPUT_MANIFEST_SHA256,
        "selectedInputManifestSha256": expected_selected_digest,
        "semanticAuthoritySha256": FROZEN_SEMANTIC_INPUT_AUTHORITY_SHA256,
        "selectedSemanticAuthoritySha256": expected_selected_semantic_digest,
        "solverBinarySha256": solver_binary["sha256"],
        "trustedStackManifestSha256": trusted_stack["manifestSha256"],
        "frontendStackManifestSha256": frontend_stack["manifestSha256"],
        "codexProviderManifestSha256": codex_provider["manifestSha256"],
        "codexConfigSha256": codex_provider["configSha256"],
        "providerEndpointSha256": codex_provider["endpointSha256"],
        "postgresServerProfileSha256": postgres_server_profile["manifestSha256"],
        "cohort16GateSha256": None,
    }

    gate_validation_config = RunConfig(
        solver_bin=resolve_artifact_path(solver_binary["path"]),
        case_process_bootstrap=case_process_bootstrap,
        case_process_supervisor=case_process_supervisor,
        case_process_isolation=case_process_isolation,
        proof_authority_root=resolve_artifact_path(
            rocq_authority_snapshot["root"]
        ),
        run_dir=gate_path.parent.resolve(),
        case_timeout_seconds=args.case_timeout,
        termination_grace_seconds=args.termination_grace,
        verification_mode=args.verification_mode,
        postgres_url=effective_postgres_url,
        sql_time_zone=args.sql_time_zone,
        sql_default_collation=args.sql_default_collation,
        sql_character_classification=args.sql_character_classification,
        sql_locale_provider=args.sql_locale_provider,
        sql_server_encoding=args.sql_server_encoding,
        solver_args=requested_solver_args,
        proof_agent_memory_limit_mib=args.proof_agent_memory_limit_mib,
        proof_agent_storage_limit_mib=args.proof_agent_storage_limit_mib,
        statement_timeout_seconds=args.statement_timeout_seconds,
        max_counterexample_rounds=args.max_counterexample_rounds,
        proof_check_timeout_seconds=args.proof_check_timeout_seconds,
        proof_docker_image=args.proof_docker_image,
        proof_docker_image_effective=proof_docker_image_identity[
            "effectiveReference"
        ],
        proof_docker_image_identity=proof_docker_image_identity,
        proof_rocq_opam_switch=resolve_artifact_path(
            trusted_stack["rocqRuntimeSnapshot"]["root"]
        ),
        allow_framework_source_drift=args.allow_framework_source_drift,
        framework_source_tree=framework_source_tree,
        input_manifest=input_manifest,
        input_files=input_files,
        solver_binary=solver_binary,
        rocq_authority_snapshot=rocq_authority_snapshot,
        trusted_stack=trusted_stack,
        frontend_stack=frontend_stack,
        codex_provider=codex_provider,
        postgres_server_profile=postgres_server_profile,
        codex_runtime_home=gate_path.parent / ".unused-codex-runtime-home",
        cohort16_gate=None,
        frozen_benchmark=None,
        rbot_authority=None,
    )

    results = gate.get("results")
    if not isinstance(results, list) or len(results) != 16:
        raise RunnerError("cohort16 gate has no complete 16-row result array")
    by_case = {
        row.get("caseId"): row
        for row in results
        if isinstance(row, dict) and isinstance(row.get("caseId"), str)
    }
    if sorted(by_case) != expected_cases or len(by_case) != 16:
        raise RunnerError("cohort16 gate results do not match the frozen case set")
    for case_id in expected_cases:
        row = by_case[case_id]
        if (
            row.get("status") != "completed"
            or not completed_return_code_is_coherent(row)
            or row.get("outcome") != "outcome_unconditional"
            or row.get("backendStatus") != "proof_complete"
            or row.get("certification") != "OUTCOME-UNCONDITIONAL"
            or row.get("usageComplete") is not True
        ):
            raise RunnerError(
                f"cohort16 gate case lacks a trusted certificate: {case_id}"
            )
        effective = row.get("effectiveConfiguration")
        if effective != expected_effective_configuration:
            raise RunnerError(
                f"cohort16 gate case treatment binding is invalid: {case_id}"
            )
        metrics = row.get("proofMetrics")
        if (
            not isinstance(metrics, dict)
            or not isinstance(metrics.get("proofRoundCount"), int)
            or metrics.get("proofRoundCount", 0) < 1
            or not isinstance(metrics.get("diagnosticInvocationCount"), int)
            or metrics.get("diagnosticInvocationCount", -1) < 1
            or not isinstance(metrics.get("finalProofCheckElapsedMs"), int)
            or metrics.get("finalProofCheckElapsedMs", -1) < 0
        ):
            raise RunnerError(
                f"cohort16 gate case has no trusted proof metrics: {case_id}"
            )
        evidence = row.get("reportEvidence")
        if not isinstance(evidence, dict) or evidence.get("present") is not True:
            raise RunnerError(f"cohort16 gate case has no report evidence: {case_id}")
        report_path_value = evidence.get("path")
        if not isinstance(report_path_value, str) or not report_path_value:
            raise RunnerError(f"cohort16 gate report path is invalid: {case_id}")
        report_path = resolve_artifact_path(report_path_value)
        if not report_path.is_file() or report_path.is_symlink():
            raise RunnerError(f"cohort16 gate report is missing: {report_path}")
        if evidence.get("sha256") != sha256_file(report_path):
            raise RunnerError(f"cohort16 gate report digest drifted: {report_path}")
        expected_files = input_files.get(case_id)
        if not isinstance(expected_files, dict):
            raise RunnerError(f"current cohort16 input binding is missing: {case_id}")
        if row.get("inputFiles") != expected_files:
            raise RunnerError(f"cohort16 gate case input binding drifted: {case_id}")
        validate_gate_report(
            report_path,
            available_by_id[case_id],
            gate_validation_config,
            metrics,
        )

    return {
        "path": workspace_display_path(gate_path),
        "sha256": gate_sha256,
        "scopePath": workspace_display_path(FROZEN_SCOPE),
        "scopeSha256": scope_sha256,
        "caseSetSha256": sha256_text("\n".join(expected_cases) + "\n"),
        "frameworkSourceTreeManifestSha256": framework_source_tree["manifestSha256"],
        "selectedInputManifestSha256": expected_selected_digest,
        "semanticAuthoritySha256": FROZEN_SEMANTIC_INPUT_AUTHORITY_SHA256,
        "selectedSemanticAuthoritySha256": expected_selected_semantic_digest,
        "solverBinarySha256": solver_binary["sha256"],
        "caseProcessIsolationSha256": hashlib.sha256(
            canonical_json_bytes(case_process_isolation)
        ).hexdigest(),
        "rocqRuntimeSnapshotManifestSha256": trusted_stack[
            "rocqRuntimeSnapshot"
        ]["manifestSha256"],
        "rocqAuthoritySnapshotManifestSha256": rocq_authority_snapshot[
            "manifestSha256"
        ],
        "trustedStackManifestSha256": trusted_stack["manifestSha256"],
        "frontendStackManifestSha256": frontend_stack["manifestSha256"],
        "codexProviderManifestSha256": codex_provider["manifestSha256"],
        "codexConfigSha256": codex_provider["configSha256"],
        "providerEndpointSha256": codex_provider["endpointSha256"],
        "postgresServerProfileSha256": postgres_server_profile["manifestSha256"],
        "verificationMode": scope.get("verificationMode"),
    }


def docker_image_identity(reference: str) -> dict[str, Any]:
    try:
        completed = subprocess.run(
            ["docker", "image", "inspect", reference],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return {"reference": reference, "resolved": False, "error": str(error)}
    if completed.returncode != 0:
        diagnostic = completed.stderr.decode("utf-8", errors="replace").strip()
        return {
            "reference": reference,
            "resolved": False,
            "error": diagnostic[:1000],
        }
    try:
        values = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        return {"reference": reference, "resolved": False, "error": str(error)}
    if (
        not isinstance(values, list)
        or len(values) != 1
        or not isinstance(values[0], dict)
    ):
        return {
            "reference": reference,
            "resolved": False,
            "error": "docker image inspect returned an unexpected document",
        }
    value = values[0]
    return {
        "reference": reference,
        "resolved": True,
        "imageId": value.get("Id"),
        "repoDigests": sorted(value.get("RepoDigests") or []),
        "created": value.get("Created"),
        "os": value.get("Os"),
        "architecture": value.get("Architecture"),
    }


def resolve_docker_image_identity(reference: str) -> dict[str, Any]:
    identity = docker_image_identity(reference)
    image_id = identity.get("imageId")
    if (
        identity.get("resolved") is not True
        or not isinstance(image_id, str)
        or re.fullmatch(r"sha256:[0-9a-f]{64}", image_id) is None
    ):
        diagnostic = identity.get("error", "missing immutable sha256 image ID")
        raise RunnerError(
            f"cannot resolve proof Docker image {reference!r} immutably: {diagnostic}"
        )
    identity["effectiveReference"] = image_id
    return identity


def discover_cases(input_root: Path) -> list[BenchmarkCase]:
    if not input_root.is_dir():
        raise RunnerError(
            f"generated benchmark root does not exist: {input_root}; run "
            "benchmarks/scripts/materialize --tool logos --target all first"
        )
    cases: list[BenchmarkCase] = []
    ids: dict[str, Path] = {}
    for metadata_path in sorted(input_root.rglob("metadata.json")):
        case_dir = metadata_path.parent
        required = {
            "schema": case_dir / "schema.sql",
            "source": case_dir / "sql1.sql",
            "target": case_dir / "sql2.sql",
        }
        missing = [path.name for path in required.values() if not path.is_file()]
        if missing:
            raise RunnerError(
                f"incomplete generated case {case_dir}: missing {', '.join(sorted(missing))}"
            )
        try:
            metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            raise RunnerError(f"cannot read {metadata_path}: {error}") from error
        relative = case_dir.relative_to(input_root)
        cohort = relative.parts[0] if len(relative.parts) > 1 else "generated"
        flat_case_id = optional_string(metadata.get("flatCaseId"))
        base_id = flat_case_id or "__".join(relative.parts)
        case_id = (
            base_id if base_id.startswith(f"{cohort}__") else f"{cohort}__{base_id}"
        )
        case_id = safe_case_id(case_id)
        if case_id in ids:
            raise RunnerError(
                f"duplicate canonical case id {case_id}: {ids[case_id]} and {case_dir}"
            )
        ids[case_id] = case_dir
        cases.append(
            BenchmarkCase(
                case_id=case_id,
                cohort=cohort,
                input_dir=case_dir,
                relative_dir=relative.as_posix(),
                schema=required["schema"],
                source=required["source"],
                target=required["target"],
                source_benchmark=optional_string(metadata.get("sourceBenchmark")),
                source_case=optional_string(metadata.get("sourceCase")),
                flat_case_id=flat_case_id,
            )
        )
    if not cases:
        raise RunnerError(f"no generated benchmark cases found under {input_root}")
    return sorted(cases, key=lambda case: case.case_id)


def optional_string(value: Any) -> str | None:
    return value if isinstance(value, str) and value else None


def safe_case_id(value: str) -> str:
    result = re.sub(r"[^A-Za-z0-9_.-]+", "_", value).strip("_")
    if not result:
        raise RunnerError(f"case id has no usable characters: {value!r}")
    return result


def select_cases(
    cases: list[BenchmarkCase], args: argparse.Namespace
) -> list[BenchmarkCase]:
    benchmark_filters = set(args.benchmark or ())
    pool = [
        case
        for case in cases
        if not benchmark_filters
        or case.cohort in benchmark_filters
        or case.source_benchmark in benchmark_filters
    ]
    if benchmark_filters:
        found = {case.cohort for case in pool} | {
            case.source_benchmark for case in pool if case.source_benchmark
        }
        missing = sorted(benchmark_filters - found)
        if missing:
            raise RunnerError(f"unknown benchmark selector(s): {', '.join(missing)}")

    exact_selectors = list(args.case or ())
    for case_file in args.case_file or ():
        path = resolve_path(case_file)
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except OSError as error:
            raise RunnerError(f"cannot read case file {path}: {error}") from error
        exact_selectors.extend(
            line.strip()
            for line in lines
            if line.strip() and not line.lstrip().startswith("#")
        )

    selected_ids: set[str] = set()
    exact_cases: list[BenchmarkCase] = []
    for selector in exact_selectors:
        matches = [case for case in pool if selector in case.aliases()]
        if not matches:
            raise RunnerError(f"unknown case selector: {selector}")
        if len(matches) > 1:
            choices = ", ".join(case.case_id for case in matches[:8])
            raise RunnerError(f"ambiguous case selector {selector!r}: {choices}")
        match = matches[0]
        if match.case_id not in selected_ids:
            selected_ids.add(match.case_id)
            exact_cases.append(match)

    patterns: list[re.Pattern[str]] = []
    for value in args.match or ():
        try:
            patterns.append(re.compile(value))
        except re.error as error:
            raise RunnerError(
                f"invalid --match expression {value!r}: {error}"
            ) from error

    if exact_selectors:
        selected = exact_cases + [
            case
            for case in pool
            if case.case_id not in selected_ids
            and any(pattern.search(case.searchable_text()) for pattern in patterns)
        ]
    elif patterns:
        selected = [
            case
            for case in pool
            if any(pattern.search(case.searchable_text()) for pattern in patterns)
        ]
    else:
        selected = pool
    if not selected:
        raise RunnerError("selection matched no benchmark cases")
    if args.limit is not None:
        selected = selected[: args.limit]
    return selected


def print_case_list(cases: Iterable[BenchmarkCase]) -> None:
    for case in cases:
        benchmark = case.source_benchmark or case.cohort
        print(f"{case.case_id}\t{benchmark}\t{case.relative_dir}")


def build_solver() -> None:
    print("building logos-solver (incremental)", file=sys.stderr, flush=True)
    completed = subprocess.run(
        ["cargo", "build", "-p", "logos-solver"],
        cwd=LOGOS_ROOT,
        check=False,
    )
    if completed.returncode != 0:
        raise RunnerError(f"cargo build failed with exit code {completed.returncode}")


def build_trusted_rocq_library() -> None:
    print("building trusted Rocq lemma closure", file=sys.stderr, flush=True)
    completed = subprocess.run(
        ["make", "logos-formal-sql-lemmas"],
        cwd=LOGOS_ROOT,
        check=False,
    )
    if completed.returncode != 0:
        raise RunnerError(
            "trusted Rocq lemma build failed with exit code " f"{completed.returncode}"
        )


def validate_solver_args(values: tuple[str, ...]) -> None:
    for value in values:
        if not value or not value.startswith("--"):
            raise RunnerError(
                "--solver-arg values must be explicit long options beginning with --"
            )
        option = value.split("=", 1)[0]
        if option in PIPELINE_SHORT_CIRCUIT_SOLVER_OPTIONS:
            raise RunnerError(
                f"--solver-arg cannot disable or short-circuit the complete pipeline: {option}"
            )
        if option in RUNNER_OWNED_SOLVER_OPTIONS:
            raise RunnerError(
                f"--solver-arg cannot override runner-owned option {option}"
            )


def effective_solver_args(config: RunConfig) -> tuple[str, ...]:
    if FORCED_COUNTEREXAMPLE_ARGUMENT in config.solver_args:
        return config.solver_args
    return (FORCED_COUNTEREXAMPLE_ARGUMENT, *config.solver_args)


def prepare_run_dir(value: str | None, *, resume: bool) -> Path:
    if value:
        run_dir = resolve_path(value)
    else:
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        run_dir = DEFAULT_RUN_ROOT / f"run-{stamp}-{os.getpid()}"
    if resume:
        if not run_dir.is_dir():
            raise RunnerError(f"resume run directory does not exist: {run_dir}")
        if not any(run_dir.iterdir()):
            raise RunnerError(f"resume run directory is empty: {run_dir}")
    elif run_dir.exists() and any(run_dir.iterdir()):
        raise RunnerError(f"run directory is not empty: {run_dir}")
    run_dir.mkdir(parents=True, exist_ok=True)
    return run_dir.resolve()


def pin_run_executable(
    source: Path,
    run_dir: Path,
    *,
    destination_name: str,
    description: str,
    resume: bool,
) -> Path:
    """Bind every worker in one run to one private executable snapshot."""

    runtime_dir = run_dir / "runtime"
    destination = runtime_dir / destination_name
    if resume:
        if (
            not destination.is_file()
            or destination.is_symlink()
            or not os.access(destination, os.X_OK)
            or stat.S_IMODE(destination.stat().st_mode) != 0o555
        ):
            raise RunnerError(
                f"resume {description} snapshot is missing or invalid: {destination}"
            )
        return destination.resolve()

    if not source.is_file() or source.is_symlink() or not os.access(source, os.X_OK):
        raise RunnerError(f"{description} is missing or invalid: {source}")
    runtime_dir.mkdir(parents=True, exist_ok=True)
    if destination.exists() or destination.is_symlink():
        raise RunnerError(f"{description} snapshot already exists: {destination}")
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{destination_name}.", dir=runtime_dir
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as output, source.open("rb") as input_file:
            shutil.copyfileobj(input_file, output)
            output.flush()
            os.fsync(output.fileno())
        temporary.chmod(0o555)
        os.replace(temporary, destination)
        directory_fd = os.open(runtime_dir, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if temporary.exists():
            temporary.unlink()
    if sha256_file(destination) != sha256_file(source):
        raise RunnerError(f"run-private {description} snapshot differs from its source")
    if stat.S_IMODE(destination.stat().st_mode) != 0o555:
        raise RunnerError(f"run-private {description} snapshot is not mode 0555")
    return destination.resolve()


def pin_solver_binary(source: Path, run_dir: Path, *, resume: bool) -> Path:
    return pin_run_executable(
        source,
        run_dir,
        destination_name="logos-solver",
        description="solver binary",
        resume=resume,
    )


def pin_case_process_bootstrap(run_dir: Path, *, resume: bool) -> Path:
    return pin_run_executable(
        CASE_PROCESS_BOOTSTRAP,
        run_dir,
        destination_name="case-process-bootstrap",
        description="case process bootstrap",
        resume=resume,
    )


def pin_case_process_supervisor(run_dir: Path, *, resume: bool) -> Path:
    return pin_run_executable(
        CASE_PROCESS_SUPERVISOR_SOURCE,
        run_dir,
        destination_name="case-process-supervisor",
        description="case process supervisor",
        resume=resume,
    )


def case_process_supervisor_command(
    payload: Iterable[str],
    bootstrap: Path,
    supervisor: Path,
) -> list[str]:
    """Wrap one case in a PID namespace whose host supervisor keeps its PID.

    Bash expands ``$$`` before exec, so the exported value is the host PID of
    the run-pinned unshare process.  The child solver is PID 1 in the new
    namespace; killing the exact host supervisor therefore gives the kernel a
    complete, race-free process-reclamation boundary.
    """

    return [
        str(bootstrap),
        *CASE_PROCESS_BOOTSTRAP_ARGUMENTS,
        CASE_PROCESS_BOOTSTRAP_BODY,
        "logos-case-process-bootstrap",
        str(supervisor),
        *CASE_PROCESS_SUPERVISOR_ARGUMENTS,
        *payload,
    ]


def case_process_snapshot_binding(
    path: Path,
    run_dir: Path,
    expected_name: str,
    description: str,
) -> dict[str, Any]:
    expected = (run_dir / "runtime" / expected_name).resolve()
    if (
        path.resolve() != expected
        or not path.is_file()
        or path.is_symlink()
        or not os.access(path, os.X_OK)
        or stat.S_IMODE(path.stat().st_mode) != 0o555
    ):
        raise RunnerError(f"invalid run-private {description} snapshot: {path}")
    return {
        "relativePath": f"runtime/{expected_name}",
        "sha256": sha256_file(path),
        "bytes": path.stat().st_size,
        "mode": "0555",
        "snapshotPolicy": CASE_PROCESS_SUPERVISOR_SNAPSHOT_POLICY,
    }


def validate_case_process_isolation(bootstrap: Path, supervisor: Path) -> None:
    """Execute the exact wrapper contract before any benchmark is launched."""

    environment = dict(SOLVER_FIXED_ENVIRONMENT_ITEMS)
    environment["PATH"] = "/usr/bin:/bin"
    probe = case_process_supervisor_command(
        (
            "/bin/sh",
            "-c",
            'printf "%s:%s\\n" "$LOGOS_CASE_SUPERVISOR_PID" "$$"',
        ),
        bootstrap,
        supervisor,
    )
    try:
        process = subprocess.Popen(
            probe,
            env=environment,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
    except OSError as error:
        raise RunnerError(f"cannot start case process-isolation preflight: {error}") from error
    try:
        stdout, stderr = process.communicate(timeout=15)
    except subprocess.TimeoutExpired as error:
        process.kill()
        process.communicate()
        raise RunnerError("case process-isolation preflight timed out") from error
    expected = f"{process.pid}:1\n".encode("ascii")
    if process.returncode != 0 or stdout != expected:
        diagnostic = stderr.decode("utf-8", errors="replace").strip()
        raise RunnerError(
            "case process-isolation preflight failed: "
            f"returnCode={process.returncode} stdout={stdout!r} stderr={diagnostic!r}"
        )
    descriptor = pidfd_open(os.getpid())
    if descriptor is None:
        raise RunnerError("pidfd preflight could not bind the current process")
    os.close(descriptor)


def case_process_isolation_record(
    bootstrap: Path,
    supervisor: Path,
    run_dir: Path,
) -> dict[str, Any]:
    return {
        "schemaVersion": 1,
        "policy": CASE_PROCESS_ISOLATION_POLICY,
        "bootstrap": case_process_snapshot_binding(
            bootstrap,
            run_dir,
            "case-process-bootstrap",
            "case process bootstrap",
        ),
        "supervisor": case_process_snapshot_binding(
            supervisor,
            run_dir,
            "case-process-supervisor",
            "case process supervisor",
        ),
        "bootstrapArguments": list(CASE_PROCESS_BOOTSTRAP_ARGUMENTS),
        "bootstrapBodySha256": sha256_text(CASE_PROCESS_BOOTSTRAP_BODY),
        "supervisorArguments": list(CASE_PROCESS_SUPERVISOR_ARGUMENTS),
        "hostSupervisorPidChannel": {
            "environmentVariable": CASE_PROCESS_SUPERVISOR_PID_ENVIRONMENT,
            "injectedBy": "run-private-bootstrap-$$-before-same-pid-exec",
            "initialLaunchEnvironmentContainsVariable": False,
            "acceptedSyntax": "canonical-positive-decimal-u32",
        },
        "liveTerminationAuthority": (
            "unreaped-popen-bound-process-group-term-then-exact-supervisor-kill"
        ),
        "crashRecoveryAuthority": (
            "identity-revalidated-pidfd-for-exact-host-supervisor"
        ),
        "namespaceContract": {
            "solverPid": 1,
            "mountProc": True,
            "kernelReclaimsNamespaceWhenPid1Dies": True,
        },
        "preflightValidated": True,
    }


def rocq_authority_snapshot_document(
    source_objects: list[dict[str, Any]],
    build_outputs: list[dict[str, Any]],
    build_inputs: dict[str, Any],
    runtime_snapshot: dict[str, Any],
    compiler: dict[str, Any],
    build_log: dict[str, Any],
    namespace: dict[str, Any],
) -> dict[str, Any]:
    total_bytes = sum(
        int(record[field])
        for record in source_objects
        for field in ("sourceBytes", "objectBytes")
    )
    objects_by_source = {record["sourcePath"]: record for record in source_objects}
    inputs_by_source = {
        record["sourcePath"]: record for record in build_inputs["sources"]
    }
    build_order = []
    for build_index, output in enumerate(build_outputs, start=1):
        record = inputs_by_source.get(output["sourcePath"])
        pair = objects_by_source.get(output["sourcePath"])
        if record is None or pair is None:
            raise RunnerError(
                f"private Rocq build emitted an unknown authority source: {output['sourcePath']}"
            )
        build_order.append(
            {
                **record,
                "buildIndex": build_index,
                "objectPath": pair["objectPath"],
                "objectSha256": pair["objectSha256"],
                "objectBytes": pair["objectBytes"],
            }
        )
    return {
        "schemaVersion": TRUSTED_ROCQ_AUTHORITY_SNAPSHOT_SCHEMA_VERSION,
        "algorithm": TRUSTED_ROCQ_AUTHORITY_SNAPSHOT_ALGORITHM,
        "policy": TRUSTED_ROCQ_AUTHORITY_SNAPSHOT_POLICY,
        "rootLayout": "logos-formalsql-private-source-build-closure-v2",
        "buildPolicy": TRUSTED_ROCQ_AUTHORITY_BUILD_POLICY,
        "frameworkSourceManifestPath": build_inputs["frameworkSourceManifestPath"],
        "frameworkSourceManifestSha256": build_inputs[
            "frameworkSourceManifestSha256"
        ],
        "runtimeSnapshotManifestPath": runtime_snapshot["manifestPath"],
        "runtimeSnapshotManifestSha256": runtime_snapshot["manifestSha256"],
        "runtimeSnapshotPolicy": runtime_snapshot["policy"],
        "compiler": compiler,
        "privateBuildNamespace": namespace,
        "compileCommand": {
            "executable": "<runtime-snapshot>/_opam/bin/rocq",
            "arguments": private_rocq_compile_argument_template(),
            "environmentPolicy": TRUSTED_ROCQ_AUTHORITY_ENVIRONMENT_POLICY,
            "environmentVariables": [
                "CAMLLIB",
                "CAML_LD_LIBRARY_PATH",
                "COQLIB",
                "HOME",
                "LANG",
                "LC_ALL",
                "LD_LIBRARY_PATH",
                "OCAMLFIND_CONF",
                "OCAMLLIB",
                "PATH",
                "ROCQLIB",
                "TMPDIR",
                "XDG_CACHE_HOME",
                "XDG_CONFIG_HOME",
                "XDG_DATA_DIRS",
                "XDG_DATA_HOME",
            ],
            "orderingPolicy": "snapshot-rocq-dep-sort-exact-source-set-v1",
            "orderingArguments": private_rocq_dependency_argument_template(),
            "timeoutSecondsPerSource": TRUSTED_ROCQ_AUTHORITY_BUILD_TIMEOUT_SECONDS,
            "sequential": True,
        },
        "controlFiles": build_inputs["controlFiles"],
        "vendorSourceCount": build_inputs["vendorSourceCount"],
        "logosSourceCount": build_inputs["logosSourceCount"],
        "buildOrderCount": len(build_order),
        "buildOrder": build_order,
        "buildLog": build_log,
        "sourceObjectPairCount": len(source_objects),
        "fileCount": len(source_objects) * 2,
        "totalBytes": total_bytes,
        "sourceObjects": source_objects,
    }


def rocq_authority_expected_files(
    document: dict[str, Any],
) -> dict[str, dict[str, Any]]:
    if (
        document.get("schemaVersion")
        != TRUSTED_ROCQ_AUTHORITY_SNAPSHOT_SCHEMA_VERSION
        or document.get("algorithm")
        != TRUSTED_ROCQ_AUTHORITY_SNAPSHOT_ALGORITHM
        or document.get("policy") != TRUSTED_ROCQ_AUTHORITY_SNAPSHOT_POLICY
        or document.get("rootLayout")
        != "logos-formalsql-private-source-build-closure-v2"
        or document.get("buildPolicy") != TRUSTED_ROCQ_AUTHORITY_BUILD_POLICY
    ):
        raise RunnerError("trusted Rocq authority snapshot manifest is incompatible")
    pairs = document.get("sourceObjects")
    if not isinstance(pairs, list) or not pairs:
        raise RunnerError("trusted Rocq authority snapshot closure is empty")

    files: dict[str, dict[str, Any]] = {}
    total_bytes = 0
    for record in pairs:
        if not isinstance(record, dict):
            raise RunnerError("trusted Rocq authority snapshot pair is not an object")
        for kind, path_field, digest_field, bytes_field, suffix in (
            ("source", "sourcePath", "sourceSha256", "sourceBytes", ".v"),
            ("object", "objectPath", "objectSha256", "objectBytes", ".vo"),
        ):
            relative = record.get(path_field)
            digest = record.get(digest_field)
            byte_count = record.get(bytes_field)
            if (
                not isinstance(relative, str)
                or not relative
                or not relative.endswith(suffix)
                or "\\" in relative
                or Path(relative).is_absolute()
                or any(part in ("", ".", "..") for part in Path(relative).parts)
                or Path(relative).as_posix() != relative
                or not isinstance(digest, str)
                or re.fullmatch(r"[0-9a-f]{64}", digest) is None
                or isinstance(byte_count, bool)
                or not isinstance(byte_count, int)
                or byte_count <= 0
            ):
                raise RunnerError(
                    f"trusted Rocq authority snapshot has an invalid {kind} record"
                )
            if relative in files:
                raise RunnerError(
                    f"trusted Rocq authority snapshot repeats a path: {relative}"
                )
            files[relative] = {
                "sha256": digest,
                "bytes": byte_count,
                "kind": kind,
            }
            total_bytes += byte_count
        if Path(record["sourcePath"]).with_suffix(".vo").as_posix() != record[
            "objectPath"
        ]:
            raise RunnerError(
                "trusted Rocq authority snapshot source/object paths do not pair"
            )

    if (
        document.get("sourceObjectPairCount") != len(pairs)
        or document.get("fileCount") != len(files)
        or document.get("totalBytes") != total_bytes
        or [record["sourcePath"] for record in pairs]
        != sorted(record["sourcePath"] for record in pairs)
    ):
        raise RunnerError("trusted Rocq authority snapshot manifest counts drifted")
    build_order = document.get("buildOrder")
    controls = document.get("controlFiles")
    compiler = document.get("compiler")
    command = document.get("compileCommand")
    namespace = document.get("privateBuildNamespace")
    build_log = document.get("buildLog")
    vendor_source_count = document.get("vendorSourceCount")
    logos_source_count = document.get("logosSourceCount")
    if (
        not isinstance(document.get("frameworkSourceManifestPath"), str)
        or re.fullmatch(
            r"[0-9a-f]{64}",
            str(document.get("frameworkSourceManifestSha256")),
        )
        is None
        or not isinstance(document.get("runtimeSnapshotManifestPath"), str)
        or re.fullmatch(
            r"[0-9a-f]{64}",
            str(document.get("runtimeSnapshotManifestSha256")),
        )
        is None
        or document.get("runtimeSnapshotPolicy")
        != TRUSTED_ROCQ_RUNTIME_SNAPSHOT_POLICY
        or not isinstance(compiler, dict)
        or set(compiler) != {"path", "sha256", "bytes"}
        or re.fullmatch(r"[0-9a-f]{64}", str(compiler.get("sha256"))) is None
        or isinstance(compiler.get("bytes"), bool)
        or not isinstance(compiler.get("bytes"), int)
        or compiler["bytes"] <= 0
        or not isinstance(command, dict)
        or command.get("executable") != "<runtime-snapshot>/_opam/bin/rocq"
        or command.get("arguments") != private_rocq_compile_argument_template()
        or command.get("sequential") is not True
        or command.get("environmentPolicy")
        != TRUSTED_ROCQ_AUTHORITY_ENVIRONMENT_POLICY
        or command.get("environmentVariables")
        != sorted(private_rocq_build_environment_variable_names())
        or command.get("orderingPolicy")
        != "snapshot-rocq-dep-sort-exact-source-set-v1"
        or command.get("orderingArguments")
        != private_rocq_dependency_argument_template()
        or command.get("timeoutSecondsPerSource")
        != TRUSTED_ROCQ_AUTHORITY_BUILD_TIMEOUT_SECONDS
        or not isinstance(command.get("arguments"), list)
        or not isinstance(controls, list)
        or len(controls) != 2
        or not isinstance(build_log, dict)
        or set(build_log) != {"path", "sha256", "bytes"}
        or re.fullmatch(r"[0-9a-f]{64}", str(build_log.get("sha256"))) is None
        or isinstance(build_log.get("bytes"), bool)
        or not isinstance(build_log.get("bytes"), int)
        or build_log["bytes"] <= 0
        or not isinstance(build_order, list)
        or not build_order
        or document.get("buildOrderCount") != len(build_order)
        or isinstance(vendor_source_count, bool)
        or not isinstance(vendor_source_count, int)
        or vendor_source_count <= 0
        or isinstance(logos_source_count, bool)
        or not isinstance(logos_source_count, int)
        or logos_source_count <= 0
        or vendor_source_count + logos_source_count != len(build_order)
    ):
        raise RunnerError("trusted Rocq authority build provenance is malformed")
    validate_private_rocq_namespace_record(namespace)
    pairs_by_source = {record["sourcePath"]: record for record in pairs}
    if len(pairs_by_source) != len(pairs):
        raise RunnerError("trusted Rocq authority contains duplicate sources")
    for index, record in enumerate(build_order, start=1):
        pair = pairs_by_source.get(record.get("sourcePath")) if isinstance(record, dict) else None
        if (
            not isinstance(record, dict)
            or set(record)
            != {
                "buildIndex",
                "declarationIndex",
                "logicalRoot",
                "sourcePath",
                "sourceSha256",
                "sourceBytes",
                "origin",
                "objectPath",
                "objectSha256",
                "objectBytes",
            }
            or record.get("buildIndex") != index
            or isinstance(record.get("declarationIndex"), bool)
            or not isinstance(record.get("declarationIndex"), int)
            or not 1 <= record["declarationIndex"] <= len(build_order)
            or record.get("logicalRoot") not in {"SQLFS", "Logos"}
            or not isinstance(record.get("origin"), dict)
            or pair is None
            or any(
                record.get(field) != pair.get(field)
                for field in (
                    "sourcePath",
                    "sourceSha256",
                    "sourceBytes",
                    "objectPath",
                    "objectSha256",
                    "objectBytes",
                )
            )
        ):
            raise RunnerError("trusted Rocq authority build order drifted from its pairs")
    if sorted(record["declarationIndex"] for record in build_order) != list(
        range(1, len(build_order) + 1)
    ):
        raise RunnerError("trusted Rocq authority declaration order is not a permutation")
    return files


def verify_rocq_authority_snapshot_tree(
    root: Path,
    document: dict[str, Any],
) -> None:
    if not root.is_dir() or root.is_symlink():
        raise RunnerError(
            f"trusted Rocq authority snapshot root is missing or symlinked: {root}"
        )
    expected_files = rocq_authority_expected_files(document)
    expected_directories = {""}
    for relative in expected_files:
        parent = Path(relative).parent
        while parent != Path("."):
            expected_directories.add(parent.as_posix())
            parent = parent.parent

    observed_files: set[str] = set()
    observed_directories = {""}
    for directory, directory_names, file_names in os.walk(
        root, topdown=True, followlinks=False
    ):
        directory_path = Path(directory)
        directory_relative = directory_path.relative_to(root)
        directory_key = (
            "" if directory_relative == Path(".") else directory_relative.as_posix()
        )
        observed_directories.add(directory_key)
        directory_metadata = directory_path.lstat()
        if (
            not stat.S_ISDIR(directory_metadata.st_mode)
            or stat.S_ISLNK(directory_metadata.st_mode)
            or stat.S_IMODE(directory_metadata.st_mode) != 0o555
        ):
            raise RunnerError(
                f"trusted Rocq authority snapshot directory is not immutable: "
                f"{directory_path}"
            )
        for name in directory_names:
            child = directory_path / name
            metadata = child.lstat()
            if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
                raise RunnerError(
                    f"trusted Rocq authority snapshot contains an invalid directory: {child}"
                )
            observed_directories.add(child.relative_to(root).as_posix())
        for name in file_names:
            path = directory_path / name
            relative = path.relative_to(root).as_posix()
            metadata = path.lstat()
            expected = expected_files.get(relative)
            if (
                expected is None
                or stat.S_ISLNK(metadata.st_mode)
                or not stat.S_ISREG(metadata.st_mode)
                or metadata.st_nlink != 1
                or stat.S_IMODE(metadata.st_mode) != 0o444
                or metadata.st_size != expected["bytes"]
                or sha256_file(path) != expected["sha256"]
            ):
                raise RunnerError(
                    f"trusted Rocq authority snapshot file is invalid: {path}"
                )
            observed_files.add(relative)

    if observed_files != set(expected_files):
        raise RunnerError("trusted Rocq authority snapshot file set changed")
    if observed_directories != expected_directories:
        raise RunnerError("trusted Rocq authority snapshot directory set changed")

    # Preserve the checker's source/object freshness invariant in the immutable copy.
    for pair in document["sourceObjects"]:
        source = root / pair["sourcePath"]
        object_path = root / pair["objectPath"]
        if source.stat().st_mtime_ns > object_path.stat().st_mtime_ns:
            raise RunnerError(
                f"trusted Rocq snapshot object predates its source: {object_path}"
            )


def read_rocq_authority_snapshot_manifest(
    path: Path,
) -> tuple[dict[str, Any], str]:
    if not path.is_file() or path.is_symlink():
        raise RunnerError(
            f"trusted Rocq authority snapshot manifest is missing or symlinked: {path}"
        )
    if stat.S_IMODE(path.stat().st_mode) != 0o444:
        raise RunnerError(
            f"trusted Rocq authority snapshot manifest is not mode 0444: {path}"
        )
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RunnerError(
            f"cannot read trusted Rocq authority snapshot manifest: {error}"
        ) from error
    if not isinstance(document, dict) or path.read_bytes() != canonical_json_bytes(
        document
    ):
        raise RunnerError(
            "trusted Rocq authority snapshot manifest is not canonical JSON"
        )
    rocq_authority_expected_files(document)
    return document, sha256_file(path)


def rocq_authority_snapshot_summary(
    root: Path,
    manifest_path: Path,
    document: dict[str, Any],
    digest: str,
) -> dict[str, Any]:
    return {
        "root": workspace_display_path(root),
        "manifestPath": workspace_display_path(manifest_path),
        "manifestSha256": digest,
        "schemaVersion": document["schemaVersion"],
        "algorithm": document["algorithm"],
        "policy": document["policy"],
        "sourceObjectPairCount": document["sourceObjectPairCount"],
        "fileCount": document["fileCount"],
        "totalBytes": document["totalBytes"],
    }


def make_tree_writable_for_cleanup(root: Path) -> None:
    if not root.exists() or root.is_symlink():
        return
    for directory, directory_names, file_names in os.walk(
        root, topdown=False, followlinks=False
    ):
        directory_path = Path(directory)
        for name in file_names:
            path = directory_path / name
            if not path.is_symlink():
                path.chmod(0o600)
        for name in directory_names:
            path = directory_path / name
            if not path.is_symlink():
                path.chmod(0o700)
        directory_path.chmod(0o700)


def copy_trusted_authority_file(
    source: Path,
    destination: Path,
    expected_sha256: str,
    expected_bytes: int,
) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        source_descriptor = os.open(source, flags)
    except OSError as error:
        raise RunnerError(f"cannot open trusted Rocq source {source}: {error}") from error
    digest = hashlib.sha256()
    byte_count = 0
    try:
        metadata = os.fstat(source_descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size != expected_bytes:
            raise RunnerError(f"trusted Rocq source changed during capture: {source}")
        with os.fdopen(source_descriptor, "rb", closefd=True) as input_file, destination.open(
            "xb"
        ) as output:
            source_descriptor = -1
            while True:
                chunk = input_file.read(1024 * 1024)
                if not chunk:
                    break
                digest.update(chunk)
                byte_count += len(chunk)
                output.write(chunk)
            output.flush()
            os.fsync(output.fileno())
    finally:
        if source_descriptor >= 0:
            os.close(source_descriptor)
    if byte_count != expected_bytes or digest.hexdigest() != expected_sha256:
        raise RunnerError(f"trusted Rocq source changed during capture: {source}")
    destination.chmod(0o444)
    # Equal deterministic mtimes satisfy the checker's source -nt object guard.
    os.utime(destination, ns=(1_000_000_000, 1_000_000_000))


def private_rocq_build_environment_variable_names() -> tuple[str, ...]:
    return (
        "CAMLLIB",
        "CAML_LD_LIBRARY_PATH",
        "COQLIB",
        "HOME",
        "LANG",
        "LC_ALL",
        "LD_LIBRARY_PATH",
        "OCAMLFIND_CONF",
        "OCAMLLIB",
        "PATH",
        "ROCQLIB",
        "TMPDIR",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_DIRS",
        "XDG_DATA_HOME",
    )


def validate_private_rocq_namespace_record(namespace: Any) -> None:
    if (
        not isinstance(namespace, dict)
        or set(namespace)
        != {
            "policy",
            "root",
            "network",
            "runtimeCanonicalPath",
            "runtimeCompiledInstallPrefix",
            "runtimePrefixBinding",
            "privateBuildBinding",
            "systemRuntimeBinding",
            "bwrapOuterLaunch",
            "systemRuntime",
        }
        or namespace.get("policy") != TRUSTED_ROCQ_AUTHORITY_NAMESPACE_POLICY
        or namespace.get("root") != "empty-tmpfs"
        or namespace.get("network") != "unshared"
        or not isinstance(namespace.get("runtimeCanonicalPath"), str)
        or not namespace["runtimeCanonicalPath"]
        or not isinstance(namespace.get("runtimeCompiledInstallPrefix"), str)
        or not Path(namespace["runtimeCompiledInstallPrefix"]).is_absolute()
        or not namespace["runtimeCompiledInstallPrefix"].endswith("/_opam")
        or namespace.get("runtimePrefixBinding")
        != "same-immutable-snapshot-at-both-prefixes"
        or namespace.get("privateBuildBinding")
        != "read-write-at-exact-absolute-path"
        or namespace.get("systemRuntimeBinding") != "captured-files-read-only"
        or not isinstance(namespace.get("bwrapOuterLaunch"), dict)
        or set(namespace["bwrapOuterLaunch"])
        != {
            "policy",
            "interpreterMountPath",
            "interpreterSha256",
            "libraryPath",
            "bwrapSha256",
            "libcapSha256",
        }
        or namespace["bwrapOuterLaunch"].get("policy")
        != "staged-interpreter-snapshot-libcap-system-closure-v1"
        or not Path(
            namespace["bwrapOuterLaunch"].get("interpreterMountPath", "")
        ).is_absolute()
        or any(
            re.fullmatch(r"[0-9a-f]{64}", str(namespace["bwrapOuterLaunch"].get(key)))
            is None
            for key in ("interpreterSha256", "bwrapSha256", "libcapSha256")
        )
        or not isinstance(namespace["bwrapOuterLaunch"].get("libraryPath"), str)
        or not namespace["bwrapOuterLaunch"]["libraryPath"]
    ):
        raise RunnerError("trusted Rocq authority namespace record is malformed")
    system_runtime = namespace.get("systemRuntime")
    if (
        not isinstance(system_runtime, dict)
        or set(system_runtime)
        != {
            "algorithm",
            "inspectionTools",
            "bwrapInterpreterMountPath",
            "consumerCount",
            "consumers",
            "fileCount",
            "files",
        }
        or system_runtime.get("algorithm")
        != "logos-private-rocq-system-runtime-closure-v1"
        or not isinstance(system_runtime.get("bwrapInterpreterMountPath"), str)
        or not Path(system_runtime["bwrapInterpreterMountPath"]).is_absolute()
        or not isinstance(system_runtime.get("consumers"), list)
        or not system_runtime["consumers"]
        or system_runtime.get("consumerCount") != len(system_runtime["consumers"])
        or not isinstance(system_runtime.get("files"), list)
        or not system_runtime["files"]
        or system_runtime.get("fileCount") != len(system_runtime["files"])
    ):
        raise RunnerError("trusted Rocq authority system runtime record is malformed")
    inspection_tools = system_runtime.get("inspectionTools")
    if (
        not isinstance(inspection_tools, dict)
        or set(inspection_tools) != {"ldd", "readelf"}
        or any(
            not isinstance(record, dict)
            or set(record) != {"selectedPath", "resolvedPath", "sha256", "bytes"}
            or not Path(record.get("selectedPath", "")).is_absolute()
            or not isinstance(record.get("resolvedPath"), str)
            or not record["resolvedPath"]
            or re.fullmatch(r"[0-9a-f]{64}", str(record.get("sha256"))) is None
            or isinstance(record.get("bytes"), bool)
            or not isinstance(record.get("bytes"), int)
            or record["bytes"] <= 0
            for record in inspection_tools.values()
        )
        or inspection_tools["ldd"]["selectedPath"] != str(TRUSTED_LDD_PATH)
        or inspection_tools["ldd"]["sha256"] not in TRUSTED_LDD_SHA256S
        or inspection_tools["readelf"]["selectedPath"] != "/usr/bin/readelf"
    ):
        raise RunnerError("trusted Rocq authority inspection tools are malformed")
    expected_mounts: set[str] = set()
    for consumer in system_runtime["consumers"]:
        if (
            not isinstance(consumer, dict)
            or set(consumer)
            != {
                "path",
                "sha256",
                "interpreterMountPath",
                "dependencyMountPaths",
            }
            or not isinstance(consumer.get("path"), str)
            or not consumer["path"].startswith("_opam/")
            or re.fullmatch(r"[0-9a-f]{64}", str(consumer.get("sha256"))) is None
            or not isinstance(consumer.get("dependencyMountPaths"), list)
            or consumer["dependencyMountPaths"]
            != sorted(set(consumer["dependencyMountPaths"]))
            or any(
                not isinstance(path, str) or not Path(path).is_absolute()
                for path in consumer["dependencyMountPaths"]
            )
            or (
                consumer.get("interpreterMountPath") is not None
                and (
                    not isinstance(consumer["interpreterMountPath"], str)
                    or not Path(consumer["interpreterMountPath"]).is_absolute()
                )
            )
        ):
            raise RunnerError("trusted Rocq authority system runtime consumer is malformed")
        expected_mounts.update(consumer["dependencyMountPaths"])
        if consumer["interpreterMountPath"] is not None:
            expected_mounts.add(consumer["interpreterMountPath"])
    observed_mounts: set[str] = set()
    staged_names: dict[str, tuple[str, int]] = {}
    for file_record in system_runtime["files"]:
        if (
            not isinstance(file_record, dict)
            or set(file_record)
            != {"mountPath", "sourcePath", "stagedName", "sha256", "bytes"}
            or not isinstance(file_record.get("mountPath"), str)
            or not Path(file_record["mountPath"]).is_absolute()
            or file_record["mountPath"] in observed_mounts
            or not isinstance(file_record.get("sourcePath"), str)
            or not file_record["sourcePath"]
            or not isinstance(file_record.get("stagedName"), str)
            or Path(file_record["stagedName"]).name != file_record["stagedName"]
            or file_record["stagedName"] in ("", ".", "..")
            or re.fullmatch(r"[0-9a-f]{64}", str(file_record.get("sha256"))) is None
            or isinstance(file_record.get("bytes"), bool)
            or not isinstance(file_record.get("bytes"), int)
            or file_record["bytes"] <= 0
        ):
            raise RunnerError("trusted Rocq authority system runtime file is malformed")
        observed_mounts.add(file_record["mountPath"])
        value = (file_record["sha256"], file_record["bytes"])
        previous = staged_names.get(file_record["stagedName"])
        if previous is not None and previous != value:
            raise RunnerError("trusted Rocq authority staged system file conflicts")
        staged_names[file_record["stagedName"]] = value
    if observed_mounts != expected_mounts:
        raise RunnerError("trusted Rocq authority system runtime closure is incomplete")
    if system_runtime["bwrapInterpreterMountPath"] not in observed_mounts:
        raise RunnerError("trusted Rocq bwrap interpreter is outside staged closure")


def private_rocq_build_environment(
    runtime_switch: Path,
    build_root: Path,
    system_runtime_root: Path,
) -> dict[str, str]:
    install_prefix = runtime_switch / "_opam"
    ocaml_library = install_prefix / "lib/ocaml"
    dynamic_library_path = os.pathsep.join(
        (
            str(system_runtime_root),
            str(install_prefix / "lib/stublibs"),
            str(ocaml_library / "stublibs"),
        )
    )
    home = build_root / ".trusted-build-home"
    temporary = build_root / ".trusted-build-tmp"
    xdg_data_home = build_root / ".trusted-build-xdg-data-home"
    xdg_data_dirs = build_root / ".trusted-build-xdg-data-dirs"
    xdg_config_home = build_root / ".trusted-build-xdg-config"
    xdg_cache_home = build_root / ".trusted-build-xdg-cache"
    home.mkdir(mode=0o700)
    temporary.mkdir(mode=0o700)
    xdg_data_home.mkdir(mode=0o700)
    xdg_data_dirs.mkdir(mode=0o700)
    xdg_config_home.mkdir(mode=0o700)
    xdg_cache_home.mkdir(mode=0o700)
    return {
        "PATH": str(install_prefix / "bin"),
        "HOME": str(home),
        "TMPDIR": str(temporary),
        "LC_ALL": "C",
        "LANG": "C",
        # Rocq otherwise falls back to absolute data/config paths compiled into
        # the source switch.  Keep every optional lookup inside this private
        # build root even when the compiled-in location happens not to exist.
        "XDG_DATA_HOME": str(xdg_data_home),
        "XDG_DATA_DIRS": str(xdg_data_dirs),
        "XDG_CONFIG_HOME": str(xdg_config_home),
        "XDG_CACHE_HOME": str(xdg_cache_home),
        "ROCQLIB": str(install_prefix / "lib/coq"),
        "COQLIB": str(install_prefix / "lib/coq"),
        "OCAMLLIB": str(ocaml_library),
        "CAMLLIB": str(ocaml_library),
        "OCAMLFIND_CONF": str(install_prefix / "lib/findlib.conf"),
        "CAML_LD_LIBRARY_PATH": dynamic_library_path,
        "LD_LIBRARY_PATH": dynamic_library_path,
    }


def private_rocq_compile_arguments(
    source: Path,
    object_path: Path,
    runtime_switch: Path,
    build_root: Path,
) -> list[str]:
    return [
        "compile",
        "-q",
        "-noglob",
        "-coqlib",
        str(runtime_switch / "_opam/lib/coq"),
        "-R",
        str(build_root / "vendor/FormalSQL/src"),
        "SQLFS",
        "-Q",
        str(build_root / "theories"),
        "Logos",
        "-o",
        str(object_path),
        str(source),
    ]


def private_rocq_compile_argument_template() -> list[str]:
    return [
        "compile",
        "-q",
        "-noglob",
        "-coqlib",
        "<runtime-snapshot>/_opam/lib/coq",
        "-R",
        "<private-build>/vendor/FormalSQL/src",
        "SQLFS",
        "-Q",
        "<private-build>/theories",
        "Logos",
        "-o",
        "<source>.vo",
        "<source>.v",
    ]


def private_rocq_dependency_arguments(
    runtime_switch: Path,
    build_root: Path,
    source_paths: Iterable[str],
) -> list[str]:
    return [
        "dep",
        "-sort",
        "-coqlib",
        str(runtime_switch / "_opam/lib/coq"),
        "-R",
        str(build_root / "vendor/FormalSQL/src"),
        "SQLFS",
        "-Q",
        str(build_root / "theories"),
        "Logos",
        *source_paths,
    ]


def private_rocq_dependency_argument_template() -> list[str]:
    return [
        "dep",
        "-sort",
        "-coqlib",
        "<runtime-snapshot>/_opam/lib/coq",
        "-R",
        "<private-build>/vendor/FormalSQL/src",
        "SQLFS",
        "-Q",
        "<private-build>/theories",
        "Logos",
        "<all-bound-sources-exactly-once>",
    ]


def bwrap_parent_directory_arguments(destinations: Iterable[Path]) -> list[str]:
    directories: set[Path] = set()
    for destination in destinations:
        if not destination.is_absolute() or destination == Path("/"):
            raise RunnerError(f"unsafe private Rocq namespace destination: {destination}")
        parent = destination.parent
        while parent != Path("/"):
            directories.add(parent)
            parent = parent.parent
    arguments: list[str] = []
    for directory in sorted(
        directories, key=lambda path: (len(path.parts), path.as_posix())
    ):
        arguments.extend(("--dir", str(directory)))
    return arguments


def private_rocq_inspection_tool_record(
    selected: Path,
    description: str,
    *,
    expected_sha256s: tuple[str, ...] | None = None,
) -> dict[str, Any]:
    if not selected.is_absolute():
        raise RunnerError(f"{description} selection is not absolute")
    resolved = selected.resolve(strict=True)
    metadata = resolved.stat()
    digest = sha256_file(resolved)
    if (
        not resolved.is_file()
        or resolved.is_symlink()
        or metadata.st_size == 0
        or metadata.st_uid != 0
        or metadata.st_mode & 0o022
        or not os.access(resolved, os.X_OK)
        or (expected_sha256s is not None and digest not in expected_sha256s)
    ):
        raise RunnerError(f"{description} authority is unsafe or drifted")
    return {
        "selectedPath": str(selected),
        "resolvedPath": workspace_display_path(resolved),
        "sha256": digest,
        "bytes": metadata.st_size,
    }


def verify_private_rocq_inspection_tools(records: dict[str, Any]) -> None:
    for name, record in records.items():
        expected_sha256s = TRUSTED_LDD_SHA256S if name == "ldd" else None
        observed = private_rocq_inspection_tool_record(
            Path(record["selectedPath"]),
            f"private Rocq {name}",
            expected_sha256s=expected_sha256s,
        )
        if observed != record:
            raise RunnerError(f"private Rocq {name} inspection authority drifted")


def private_rocq_system_runtime(
    runtime_switch: Path,
    build_root: Path,
) -> tuple[dict[str, Any], Path, dict[str, Path]]:
    """Capture the exact host ELF payload needed inside the empty-root build."""

    readelf_selected = Path("/usr/bin/readelf")
    readelf = readelf_selected.resolve(strict=True)
    inspection_tools = {
        "ldd": private_rocq_inspection_tool_record(
            TRUSTED_LDD_PATH,
            "private Rocq ldd",
            expected_sha256s=TRUSTED_LDD_SHA256S,
        ),
        "readelf": private_rocq_inspection_tool_record(
            readelf_selected,
            "private Rocq readelf",
        ),
    }

    install_prefix = runtime_switch / "_opam"
    executable_consumers = [
        install_prefix / "bin/rocq",
        install_prefix / "lib/rocq-runtime/rocqworker",
        install_prefix / "lib/rocq-runtime/rocqnative",
    ]
    dynamic_roots = (
        install_prefix / "lib/rocq-runtime",
        install_prefix / "lib/stublibs",
        install_prefix / "lib/ocaml",
        install_prefix / "lib/findlib",
        install_prefix / "lib/zarith",
    )
    dynamic_consumers: list[Path] = []
    for root in dynamic_roots:
        for candidate in sorted(root.rglob("*")):
            if (
                candidate.is_file()
                and not candidate.is_symlink()
                and (
                    candidate.name.endswith(".so")
                    or ".so." in candidate.name
                    or candidate.name.endswith(".cmxs")
                )
            ):
                with candidate.open("rb") as stream:
                    if stream.read(4) == b"\x7fELF":
                        dynamic_consumers.append(candidate)

    verify_private_rocq_inspection_tools(inspection_tools)
    bwrap_interpreter_mount_path = elf_interpreter(
        install_prefix / "bin/bwrap",
        readelf,
        "private Rocq snapshot bwrap",
    )
    verify_private_rocq_inspection_tools(inspection_tools)

    mount_sources: dict[str, Path] = {}
    consumers: list[dict[str, Any]] = []
    runtime_mounts: dict[str, Path] = {}
    for consumer in (*executable_consumers, *dynamic_consumers):
        verify_private_rocq_inspection_tools(inspection_tools)
        relative = consumer.relative_to(runtime_switch).as_posix()
        dependencies = elf_dependencies(
            consumer,
            TRUSTED_LDD_PATH,
            f"private Rocq runtime {relative}",
            allow_empty=consumer not in executable_consumers,
        )
        interpreter = None
        if consumer in executable_consumers:
            interpreter = elf_interpreter(
                consumer,
                readelf,
                f"private Rocq runtime {relative}",
            )
        verify_private_rocq_inspection_tools(inspection_tools)
        consumers.append(
            {
                "path": relative,
                "sha256": sha256_file(consumer),
                "interpreterMountPath": interpreter,
                "dependencyMountPaths": dependencies,
            }
        )
        for mount_path in (*(() if interpreter is None else (interpreter,)), *dependencies):
            source = Path(mount_path).resolve(strict=True)
            metadata = source.stat()
            if (
                not source.is_file()
                or source.is_symlink()
                or metadata.st_size == 0
                or metadata.st_uid != 0
                or metadata.st_mode & 0o022
            ):
                raise RunnerError(
                    f"private Rocq system runtime dependency is unsafe: {mount_path}"
                )
            previous = mount_sources.get(mount_path)
            if previous is not None and previous != source:
                raise RunnerError(
                    f"private Rocq system runtime target drifted: {mount_path}"
                )
            mount_sources[mount_path] = source

    stage = build_root / ".trusted-build-system-runtime"
    stage.mkdir(mode=0o700)
    basename_sources: dict[str, Path] = {}
    files: list[dict[str, Any]] = []
    for mount_path, source in sorted(mount_sources.items()):
        # Preserve the loader-visible SONAME alias (for example
        # libgmp.so.10), not the resolved payload basename.
        basename = Path(mount_path).name
        previous_source = basename_sources.get(basename)
        if previous_source is not None and previous_source != source:
            raise RunnerError(
                f"private Rocq system runtime basename collision: {basename}"
        )
        basename_sources[basename] = source
        destination = stage / basename
        if not destination.exists():
            source_sha256 = sha256_file(source)
            source_bytes = source.stat().st_size
            copy_trusted_authority_file(
                source,
                destination,
                source_sha256,
                source_bytes,
            )
            destination.chmod(0o555)
        files.append(
            {
                "mountPath": mount_path,
                "sourcePath": workspace_display_path(source),
                "stagedName": destination.name,
                "sha256": sha256_file(destination),
                "bytes": destination.stat().st_size,
            }
        )
        # Rocq's worker launcher does not preserve LD_LIBRARY_PATH.  Bind every
        # captured SONAME target, not only the ELF interpreter, at the exact
        # absolute path reported by the trusted ldd/readelf inspection.
        runtime_mounts[mount_path] = destination
    stage.chmod(0o555)
    return (
        {
            "algorithm": "logos-private-rocq-system-runtime-closure-v1",
            "inspectionTools": inspection_tools,
            "bwrapInterpreterMountPath": bwrap_interpreter_mount_path,
            "consumerCount": len(consumers),
            "consumers": consumers,
            "fileCount": len(files),
            "files": files,
        },
        stage,
        runtime_mounts,
    )


def verify_private_rocq_system_runtime(
    root: Path,
    record: dict[str, Any],
) -> None:
    expected_by_name: dict[str, tuple[str, int]] = {}
    for file_record in record["files"]:
        name = file_record["stagedName"]
        value = (file_record["sha256"], file_record["bytes"])
        previous = expected_by_name.get(name)
        if previous is not None and previous != value:
            raise RunnerError("private Rocq staged system runtime record conflicts")
        expected_by_name[name] = value
    if (
        not root.is_dir()
        or root.is_symlink()
        or stat.S_IMODE(root.stat().st_mode) != 0o555
        or {path.name for path in root.iterdir()} != set(expected_by_name)
    ):
        raise RunnerError("private Rocq staged system runtime closure drifted")
    for name, (digest, byte_count) in expected_by_name.items():
        path = root / name
        metadata = path.lstat()
        if (
            not stat.S_ISREG(metadata.st_mode)
            or stat.S_ISLNK(metadata.st_mode)
            or stat.S_IMODE(metadata.st_mode) != 0o555
            or metadata.st_size != byte_count
            or sha256_file(path) != digest
        ):
            raise RunnerError(f"private Rocq staged system runtime file drifted: {path}")


def verify_private_bwrap_outer_runtime(
    runtime_switch: Path,
    runtime_document: dict[str, Any],
) -> dict[str, str]:
    expected = trusted_rocq_runtime_expected_files(runtime_document)
    result: dict[str, str] = {}
    for name, relative in (
        ("bwrapSha256", TRUSTED_ROCQ_RUNTIME_BWRAP_PATH),
        ("libcapSha256", TRUSTED_ROCQ_RUNTIME_BWRAP_LIBCAP_PATH),
    ):
        record = expected[relative]
        path = runtime_switch / relative
        metadata = path.lstat()
        if (
            not stat.S_ISREG(metadata.st_mode)
            or stat.S_ISLNK(metadata.st_mode)
            or metadata.st_nlink != 1
            or stat.S_IMODE(metadata.st_mode) != int(record["mode"], 8)
            or metadata.st_size != record["bytes"]
            or sha256_file(path) != record["sha256"]
        ):
            raise RunnerError(f"private bwrap outer runtime drifted: {path}")
        result[name] = record["sha256"]
    return result


def private_rocq_namespace_command(
    runtime_switch: Path,
    build_root: Path,
    system_runtime_root: Path,
    system_runtime: dict[str, Any],
    runtime_mounts: dict[str, Path],
    environment: dict[str, str],
    inner_arguments: list[str],
    runtime_document: dict[str, Any],
) -> tuple[list[str], dict[str, Any]]:
    runtime_switch = runtime_switch.resolve(strict=True)
    build_root = build_root.resolve(strict=True)
    system_runtime_root = system_runtime_root.resolve(strict=True)
    source_switch_value = runtime_document["sourceSwitch"]
    source_switch_path = Path(source_switch_value)
    if not source_switch_path.is_absolute():
        if source_switch_path.parts and source_switch_path.parts[0] == LOGOS_ROOT.name:
            source_switch_path = WORKFLOW_ROOT / source_switch_path
        else:
            source_switch_path = LOGOS_ROOT / source_switch_path
    source_switch_path = Path(os.path.abspath(source_switch_path))
    compiled_install_prefix = source_switch_path / "_opam"
    canonical_install_prefix = runtime_switch / "_opam"
    if compiled_install_prefix == canonical_install_prefix:
        raise RunnerError("private Rocq dual-prefix namespace collapsed to one path")

    destinations = [
        runtime_switch,
        build_root,
        system_runtime_root,
        compiled_install_prefix,
        *(Path(path) for path in runtime_mounts),
    ]
    verify_private_rocq_inspection_tools(system_runtime["inspectionTools"])
    interpreter_mount_path = system_runtime["bwrapInterpreterMountPath"]
    staged_interpreter = runtime_mounts.get(interpreter_mount_path)
    if staged_interpreter is None:
        raise RunnerError("private Rocq namespace has no staged ELF interpreter")
    outer_runtime = verify_private_bwrap_outer_runtime(
        runtime_switch, runtime_document
    )
    outer_library_path = os.pathsep.join(
        (str(canonical_install_prefix / "lib"), str(system_runtime_root))
    )
    command = [
        str(staged_interpreter),
        "--library-path",
        outer_library_path,
        str(runtime_switch / TRUSTED_ROCQ_RUNTIME_BWRAP_PATH),
        "--die-with-parent",
        "--new-session",
        "--unshare-all",
        "--unshare-user",
        "--disable-userns",
        "--assert-userns-disabled",
        "--tmpfs",
        "/",
        *bwrap_parent_directory_arguments(destinations),
        "--dev",
        "/dev",
        "--proc",
        "/proc",
        "--ro-bind",
        str(runtime_switch),
        str(runtime_switch),
        "--ro-bind",
        str(canonical_install_prefix),
        str(compiled_install_prefix),
        "--bind",
        str(build_root),
        str(build_root),
        "--ro-bind",
        str(system_runtime_root),
        str(system_runtime_root),
    ]
    for mount_path, source in sorted(runtime_mounts.items()):
        command.extend(("--ro-bind", str(source), mount_path))
    command.extend(("--chdir", str(build_root), "--clearenv"))
    for name, value in sorted(environment.items()):
        command.extend(("--setenv", name, value))
    command.extend((str(canonical_install_prefix / "bin/rocq"), *inner_arguments))
    return command, {
        "policy": TRUSTED_ROCQ_AUTHORITY_NAMESPACE_POLICY,
        "root": "empty-tmpfs",
        "network": "unshared",
        "runtimeCanonicalPath": workspace_display_path(runtime_switch),
        "runtimeCompiledInstallPrefix": str(compiled_install_prefix),
        "runtimePrefixBinding": "same-immutable-snapshot-at-both-prefixes",
        "privateBuildBinding": "read-write-at-exact-absolute-path",
        "systemRuntimeBinding": "captured-files-read-only",
        "bwrapOuterLaunch": {
            "policy": "staged-interpreter-snapshot-libcap-system-closure-v1",
            "interpreterMountPath": interpreter_mount_path,
            "interpreterSha256": sha256_file(staged_interpreter),
            "libraryPath": "<runtime-snapshot>/_opam/lib:<private-build-system-runtime>",
            **outer_runtime,
        },
    }


def build_private_trusted_rocq_objects(
    source_root: Path,
    build_root: Path,
    runtime_switch: Path,
    build_inputs: dict[str, Any],
) -> tuple[list[dict[str, Any]], bytes, dict[str, Any]]:
    for record in build_inputs["sources"]:
        copy_trusted_authority_file(
            source_root / record["sourcePath"],
            build_root / record["sourcePath"],
            record["sourceSha256"],
            record["sourceBytes"],
        )
    runtime_document, runtime_summary = load_trusted_rocq_runtime_snapshot_for_switch(
        runtime_switch
    )
    system_runtime, system_runtime_root, runtime_mounts = (
        private_rocq_system_runtime(runtime_switch, build_root)
    )
    environment = private_rocq_build_environment(
        runtime_switch, build_root, system_runtime_root
    )
    outputs = []
    log = [
        "LOGOS_TRUSTED_ROCQ_AUTHORITY_BUILD schema=1\n",
        f"runtime_manifest_sha256={runtime_summary['manifestSha256']}\n",
        f"namespace_policy={TRUSTED_ROCQ_AUTHORITY_NAMESPACE_POLICY}\n",
        f"environment_policy={TRUSTED_ROCQ_AUTHORITY_ENVIRONMENT_POLICY}\n",
        f"source_count={len(build_inputs['sources'])}\n",
    ]
    source_by_path = {
        record["sourcePath"]: record for record in build_inputs["sources"]
    }
    if len(source_by_path) != len(build_inputs["sources"]):
        raise RunnerError("private Rocq authority sources are duplicated")
    dependency_arguments = private_rocq_dependency_arguments(
        runtime_switch,
        build_root,
        source_by_path,
    )
    dependency_command, namespace_record = private_rocq_namespace_command(
        runtime_switch,
        build_root,
        system_runtime_root,
        system_runtime,
        runtime_mounts,
        environment,
        dependency_arguments,
        runtime_document,
    )
    verify_private_rocq_system_runtime(system_runtime_root, system_runtime)
    expected_outer_runtime = {
        key: namespace_record["bwrapOuterLaunch"][key]
        for key in ("bwrapSha256", "libcapSha256")
    }
    try:
        dependency_result = subprocess.run(
            dependency_command,
            cwd=build_root,
            env={
                "PATH": "/usr/bin:/bin",
                "LANG": "C",
                "LC_ALL": "C",
            },
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=TRUSTED_ROCQ_AUTHORITY_BUILD_TIMEOUT_SECONDS,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RunnerError(
            f"private Rocq dependency ordering failed to execute: {error}"
        ) from error
    log.extend(
        (
            f"BEGIN dependency-order returnCode={dependency_result.returncode}\n",
            "[stdout]\n",
            dependency_result.stdout.decode("utf-8", errors="replace"),
            "\n[stderr]\n",
            dependency_result.stderr.decode("utf-8", errors="replace"),
            "\nEND\n",
        )
    )
    if dependency_result.returncode != 0:
        raise RunnerError(
            "private Rocq dependency ordering failed: "
            + dependency_result.stderr.decode("utf-8", errors="replace")[-4000:]
        )
    try:
        ordered_paths = dependency_result.stdout.decode("utf-8", errors="strict").split()
    except UnicodeError as error:
        raise RunnerError("private Rocq dependency order is not UTF-8") from error
    if (
        len(ordered_paths) != len(source_by_path)
        or len(set(ordered_paths)) != len(ordered_paths)
        or set(ordered_paths) != set(source_by_path)
    ):
        raise RunnerError(
            "private Rocq dependency order is not an exact bound-source permutation"
        )
    verify_private_rocq_system_runtime(system_runtime_root, system_runtime)
    if (
        verify_private_bwrap_outer_runtime(runtime_switch, runtime_document)
        != expected_outer_runtime
    ):
        raise RunnerError("private bwrap outer runtime changed during dependency ordering")
    for build_index, record in enumerate(
        (source_by_path[path] for path in ordered_paths), start=1
    ):
        source = build_root / record["sourcePath"]
        object_path = source.with_suffix(".vo")
        if object_path.exists() or object_path.is_symlink():
            raise RunnerError(
                f"private Rocq build unexpectedly inherited an object: {object_path}"
            )
        inner_arguments = private_rocq_compile_arguments(
            source, object_path, runtime_switch, build_root
        )
        command, observed_namespace = private_rocq_namespace_command(
            runtime_switch,
            build_root,
            system_runtime_root,
            system_runtime,
            runtime_mounts,
            environment,
            inner_arguments,
            runtime_document,
        )
        if namespace_record != observed_namespace:
            raise RunnerError("private Rocq namespace policy drifted between sources")
        verify_private_rocq_system_runtime(system_runtime_root, system_runtime)
        started = time.monotonic()
        try:
            completed = subprocess.run(
                command,
                cwd=build_root,
                env={
                    "PATH": "/usr/bin:/bin",
                    "LANG": "C",
                    "LC_ALL": "C",
                },
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=TRUSTED_ROCQ_AUTHORITY_BUILD_TIMEOUT_SECONDS,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            raise RunnerError(
                f"private Rocq authority build failed to execute for {record['sourcePath']}: {error}"
            ) from error
        elapsed_ms = int((time.monotonic() - started) * 1000)
        log.extend(
            (
                f"BEGIN buildIndex={build_index} declarationIndex={record['declarationIndex']} source={record['sourcePath']} elapsedMs={elapsed_ms} returnCode={completed.returncode}\n",
                "[stdout]\n",
                completed.stdout.decode("utf-8", errors="replace"),
                "\n[stderr]\n",
                completed.stderr.decode("utf-8", errors="replace"),
                "\nEND\n",
            )
        )
        if completed.returncode != 0:
            diagnostic = completed.stderr.decode("utf-8", errors="replace")[-4000:]
            raise RunnerError(
                f"private Rocq authority build failed for {record['sourcePath']}: {diagnostic}"
            )
        verify_private_rocq_system_runtime(system_runtime_root, system_runtime)
        if (
            verify_private_bwrap_outer_runtime(runtime_switch, runtime_document)
            != expected_outer_runtime
        ):
            raise RunnerError("private bwrap outer runtime changed during source build")
        metadata = object_path.lstat()
        if (
            stat.S_ISLNK(metadata.st_mode)
            or not stat.S_ISREG(metadata.st_mode)
            or metadata.st_size == 0
        ):
            raise RunnerError(
                f"private Rocq authority build produced no safe object: {object_path}"
            )
        outputs.append(
            {
                "sourcePath": record["sourcePath"],
                "objectPath": object_path.relative_to(build_root).as_posix(),
                "objectSha256": sha256_file(object_path),
                "objectBytes": metadata.st_size,
            }
        )
    return (
        outputs,
        "".join(log).encode("utf-8"),
        {**namespace_record, "systemRuntime": system_runtime},
    )


def validate_rocq_authority_external_bindings(
    document: dict[str, Any],
    runtime_snapshot: dict[str, Any],
    framework_source_tree: dict[str, Any],
) -> None:
    if (
        document.get("runtimeSnapshotManifestPath")
        != runtime_snapshot.get("manifestPath")
        or document.get("runtimeSnapshotManifestSha256")
        != runtime_snapshot.get("manifestSha256")
        or document.get("runtimeSnapshotPolicy") != runtime_snapshot.get("policy")
        or document.get("frameworkSourceManifestPath")
        != framework_source_tree.get("manifestPath")
        or document.get("frameworkSourceManifestSha256")
        != framework_source_tree.get("manifestSha256")
    ):
        raise RunnerError("trusted Rocq authority external provenance binding drifted")
    build_log = document["buildLog"]
    build_log_path = resolve_artifact_path(build_log["path"])
    if (
        not build_log_path.is_file()
        or build_log_path.is_symlink()
        or stat.S_IMODE(build_log_path.stat().st_mode) != 0o444
        or build_log_path.stat().st_size != build_log["bytes"]
        or sha256_file(build_log_path) != build_log["sha256"]
    ):
        raise RunnerError("trusted Rocq authority build log binding drifted")


def pin_trusted_rocq_authority(
    source_root: Path,
    run_dir: Path,
    runtime_switch: Path,
    runtime_snapshot: dict[str, Any],
    framework_source_tree: dict[str, Any],
    *,
    resume: bool,
) -> dict[str, Any]:
    runtime_dir = run_dir / "runtime"
    destination = runtime_dir / "trusted-rocq-authority"
    manifest_path = run_dir / "trusted-rocq-authority-manifest.json"
    build_log_path = run_dir / "trusted-rocq-authority-build.log"

    if source_root.resolve() != LOGOS_ROOT.resolve():
        raise RunnerError("trusted Rocq authority build requires the framework repository root")
    runtime_document, observed_runtime_snapshot = (
        load_trusted_rocq_runtime_snapshot_for_switch(runtime_switch)
    )
    if observed_runtime_snapshot != runtime_snapshot:
        raise RunnerError("trusted Rocq authority received a drifting runtime snapshot")

    if resume:
        document, digest = read_rocq_authority_snapshot_manifest(manifest_path)
        verify_rocq_authority_snapshot_tree(destination, document)
        validate_rocq_authority_external_bindings(
            document, runtime_snapshot, framework_source_tree
        )
        return rocq_authority_snapshot_summary(
            destination, manifest_path, document, digest
        )

    if (
        destination.exists()
        or destination.is_symlink()
        or manifest_path.exists()
        or build_log_path.exists()
    ):
        raise RunnerError("trusted Rocq authority snapshot already exists")
    runtime_dir.mkdir(parents=True, exist_ok=True)
    build_inputs = trusted_rocq_source_build_inputs(framework_source_tree)
    build_stage = Path(
        tempfile.mkdtemp(prefix=".trusted-rocq-build.", dir=runtime_dir)
    )
    stage = Path(tempfile.mkdtemp(prefix=".trusted-rocq-authority.", dir=runtime_dir))
    published = False
    try:
        outputs, build_log_bytes, private_build_namespace = (
            build_private_trusted_rocq_objects(
                source_root,
                build_stage,
                runtime_switch,
                build_inputs,
            )
        )
        if trusted_rocq_source_build_inputs(framework_source_tree) != build_inputs:
            raise RunnerError("framework-bound Rocq sources changed during private build")
        output_by_source = {record["sourcePath"]: record for record in outputs}
        for source_record in build_inputs["sources"]:
            output = output_by_source[source_record["sourcePath"]]
            copy_trusted_authority_file(
                build_stage / source_record["sourcePath"],
                stage / source_record["sourcePath"],
                source_record["sourceSha256"],
                source_record["sourceBytes"],
            )
            copy_trusted_authority_file(
                build_stage / output["objectPath"],
                stage / output["objectPath"],
                output["objectSha256"],
                output["objectBytes"],
            )
        captured_pairs = trusted_source_object_pairs(stage)
        pairs_by_source = {
            record["sourcePath"]: record for record in captured_pairs
        }
        if set(pairs_by_source) != {
            record["sourcePath"] for record in outputs
        }:
            raise RunnerError("private Rocq authority output set drifted")
        initial_pairs = captured_pairs
        atomic_write_bytes(build_log_path, build_log_bytes)
        build_log_path.chmod(0o444)
        build_log = {
            "path": workspace_display_path(build_log_path),
            "sha256": sha256_file(build_log_path),
            "bytes": build_log_path.stat().st_size,
        }
        compiler = trusted_executable_record(
            runtime_switch / "_opam/bin/rocq", "private authority Rocq compiler"
        )
        document = rocq_authority_snapshot_document(
            initial_pairs,
            outputs,
            build_inputs,
            runtime_snapshot,
            compiler,
            build_log,
            private_build_namespace,
        )
        runtime_document_before_publish, runtime_snapshot_before_publish = (
            load_trusted_rocq_runtime_snapshot_for_switch(runtime_switch)
        )
        if (
            runtime_document_before_publish != runtime_document
            or runtime_snapshot_before_publish != runtime_snapshot
        ):
            raise RunnerError("trusted Rocq runtime changed before authority publication")
        for directory, directory_names, _ in os.walk(stage, topdown=False):
            for name in directory_names:
                (Path(directory) / name).chmod(0o555)
            Path(directory).chmod(0o555)
        verify_rocq_authority_snapshot_tree(stage, document)
        os.replace(stage, destination)
        published = True
        directory_fd = os.open(runtime_dir, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if not published and stage.exists():
            make_tree_writable_for_cleanup(stage)
            shutil.rmtree(stage)
        if build_stage.exists():
            make_tree_writable_for_cleanup(build_stage)
            shutil.rmtree(build_stage)

    encoded = canonical_json_bytes(document)
    atomic_write_bytes(manifest_path, encoded)
    manifest_path.chmod(0o444)
    digest = hashlib.sha256(encoded).hexdigest()
    if sha256_file(manifest_path) != digest:
        raise RunnerError("trusted Rocq authority snapshot manifest drifted")
    verify_rocq_authority_snapshot_tree(destination, document)
    runtime_document_after, runtime_snapshot_after = (
        load_trusted_rocq_runtime_snapshot_for_switch(runtime_switch)
    )
    if runtime_document_after != runtime_document or runtime_snapshot_after != runtime_snapshot:
        raise RunnerError("trusted Rocq runtime changed during private authority build")
    validate_rocq_authority_external_bindings(
        document, runtime_snapshot, framework_source_tree
    )
    return rocq_authority_snapshot_summary(
        destination, manifest_path, document, digest
    )


def sql_environment_record(config: RunConfig) -> dict[str, str]:
    return {
        "timeZone": config.sql_time_zone,
        "defaultCollation": config.sql_default_collation,
        "characterClassification": config.sql_character_classification,
        "localeProvider": config.sql_locale_provider,
        "serverEncoding": config.sql_server_encoding,
    }


def postgres_url_value_record(value: str | None) -> dict[str, Any]:
    if value is None:
        return {"configured": False, "sha256": None}
    return {
        "configured": True,
        "sha256": hashlib.sha256(value.encode("utf-8")).hexdigest(),
    }


def postgres_url_record(config: RunConfig) -> dict[str, Any]:
    return postgres_url_value_record(config.postgres_url)


def configuration_record(
    input_root: Path, config: RunConfig, jobs: int
) -> dict[str, Any]:
    proof_timeout_seconds = max(1, int(config.case_timeout_seconds) - 300)
    return {
        "inputRoot": display_path(input_root),
        "solverBin": display_path(config.solver_bin),
        "solverBinary": config.solver_binary,
        "solverBinarySnapshotPolicy": SOLVER_BINARY_SNAPSHOT_POLICY,
        "caseProcessIsolation": config.case_process_isolation,
        "rocqRuntimeSnapshot": config.trusted_stack["rocqRuntimeSnapshot"],
        "rocqAuthoritySnapshot": config.rocq_authority_snapshot,
        "rocqAuthoritySnapshotPolicy": TRUSTED_ROCQ_AUTHORITY_SNAPSHOT_POLICY,
        "jobs": jobs,
        "caseTimeoutSeconds": config.case_timeout_seconds,
        "statementTimeoutSeconds": config.statement_timeout_seconds,
        "maxCounterexampleRounds": config.max_counterexample_rounds,
        "terminationGraceSeconds": config.termination_grace_seconds,
        "verificationMode": config.verification_mode,
        "model": config.model,
        "reasoningEffort": config.reasoning_effort,
        "solverArgs": list(config.solver_args),
        "effectiveSolverArgs": list(effective_solver_args(config)),
        "counterexampleAssessmentPolicy": "force-fresh",
        "postgresUrl": postgres_url_record(config),
        "sqlEnvironment": sql_environment_record(config),
        "solverLaunchEnvironmentPolicy": solver_launch_environment_policy_record(
            config
        ),
        "solverEnvironment": solver_environment_record(config),
        "frontendLaunchEnvironmentPolicy": frontend_launch_environment_policy_record(),
        "commandProviderEnvironmentPolicy": config.codex_provider[
            "commandEnvironmentPolicy"
        ],
        "frameworkSourceTree": config.framework_source_tree,
        "frameworkSourceTreeDigestPolicy": (
            FRAMEWORK_SOURCE_DIGEST_POLICY_RECORD_ONLY
            if config.allow_framework_source_drift
            else FRAMEWORK_SOURCE_DIGEST_POLICY_REQUIRED
        ),
        "inputManifest": config.input_manifest,
        "trustedStack": config.trusted_stack,
        "frontendStack": config.frontend_stack,
        "codexProvider": config.codex_provider,
        "postgresServerProfile": config.postgres_server_profile,
        "cohort16Gate": config.cohort16_gate,
        "frozenBenchmark": config.frozen_benchmark,
        "rbotAuthority": config.rbot_authority,
        "proofAgent": {
            "model": config.model,
            "reasoningEffort": config.reasoning_effort,
            "sessionRestartAfterFailedRounds": (
                PROOF_AGENT_SESSION_RESTART_AFTER_FAILED_ROUNDS
            ),
            "sessionHomePolicy": PROOF_AGENT_SESSION_HOME_POLICY,
            "diagnosticTransport": PROOF_AGENT_DIAGNOSTIC_TRANSPORT,
            "diagnosticCachePolicy": PROOF_AGENT_DIAGNOSTIC_CACHE_POLICY,
            "diagnosticTimeoutPolicy": PROOF_AGENT_DIAGNOSTIC_TIMEOUT_POLICY,
            "diagnosticBudgetPolicy": PROOF_AGENT_DIAGNOSTIC_BUDGET_POLICY,
            "diagnosticCheckerParallelismMax": (
                PROOF_AGENT_DIAGNOSTIC_CHECKER_PARALLELISM_MAX
            ),
            "diagnosticCheckerSchedulingPolicy": (
                PROOF_AGENT_DIAGNOSTIC_CHECKER_SCHEDULING_POLICY
            ),
            "compileCheckpointPolicy": PROOF_AGENT_COMPILE_CHECKPOINT_POLICY,
            "scratchPersistencePolicy": PROOF_AGENT_SCRATCH_PERSISTENCE_POLICY,
            "writableStorageLimitBytes": (
                config.proof_agent_storage_limit_mib * 1024 * 1024
            ),
            "writableStoragePolicy": PROOF_AGENT_WRITABLE_STORAGE_POLICY,
            "scratchAllowedExtensions": list(
                PROOF_AGENT_SCRATCH_ALLOWED_EXTENSIONS
            ),
            "trustedCheckerEnvironmentPolicy": (
                trusted_checker_environment_policy_record()
            ),
            "proofAgentLauncherEnvironmentPolicy": (
                proof_agent_launcher_environment_policy_record()
            ),
            "totalTimeoutSeconds": proof_timeout_seconds,
            "trustedCheckTimeoutSeconds": config.proof_check_timeout_seconds,
            "resourcePolicy": {
                "memoryLimitMiB": config.proof_agent_memory_limit_mib,
                "storageLimitMiB": config.proof_agent_storage_limit_mib,
                "cpuLimit": None,
            },
            "dockerImage": config.proof_docker_image_identity,
            "rocqOpamSwitch": workspace_display_path(config.proof_rocq_opam_switch),
        },
    }


def load_and_validate_resume_summary(
    input_root: Path,
    cases: list[BenchmarkCase],
    config: RunConfig,
    jobs: int,
) -> dict[str, Any]:
    summary_path = config.run_dir / "runner-summary.json"
    try:
        summary_text = summary_path.read_text(encoding="utf-8")
        summary = json.loads(summary_text)
    except FileNotFoundError as error:
        raise RunnerError(f"resume summary does not exist: {summary_path}") from error
    except (OSError, json.JSONDecodeError) as error:
        raise RunnerError(
            f"cannot read resume summary {summary_path}: {error}"
        ) from error
    if not isinstance(summary, dict) or summary.get("schemaVersion") != 1:
        raise RunnerError("resume summary must be a schemaVersion 1 JSON object")
    if summary.get("status") == "complete":
        raise RunnerError("cannot resume a complete run")
    if summary.get("status") not in ("running", "interrupted"):
        raise RunnerError(f"cannot resume run with status {summary.get('status')!r}")

    expected_cases = [case.case_id for case in cases]
    preserved_cases = summary.get("cases")
    if preserved_cases != expected_cases:
        expected_set = set(expected_cases)
        preserved_set = (
            set(preserved_cases) if isinstance(preserved_cases, list) else set()
        )
        missing = sorted(preserved_set - expected_set)
        added = sorted(expected_set - preserved_set)
        details = []
        if missing:
            details.append(f"missing current IDs: {', '.join(missing[:8])}")
        if added:
            details.append(f"unexpected current IDs: {', '.join(added[:8])}")
        suffix = f" ({'; '.join(details)})" if details else ""
        raise RunnerError(
            f"resume cohort does not exactly match preserved case IDs{suffix}"
        )
    if len(expected_cases) != len(set(expected_cases)):
        raise RunnerError("resume cohort contains duplicate case IDs")

    expected_configuration = configuration_record(input_root, config, jobs)
    preserved_configuration = summary.get("configuration")
    if preserved_configuration != expected_configuration:
        mismatches = configuration_mismatches(
            preserved_configuration, expected_configuration
        )
        raise RunnerError("resume configuration mismatch: " + "; ".join(mismatches[:8]))
    if not isinstance(summary.get("startedAt"), str) or not summary["startedAt"]:
        raise RunnerError("resume summary has no original startedAt")
    elapsed_ms = summary.get("elapsedMs")
    if (
        isinstance(elapsed_ms, bool)
        or not isinstance(elapsed_ms, int)
        or elapsed_ms < 0
    ):
        raise RunnerError("resume summary elapsedMs must be a nonnegative integer")
    return summary

def configuration_mismatches(preserved: Any, expected: dict[str, Any]) -> list[str]:
    if not isinstance(preserved, dict):
        return ["preserved summary has no exact configuration record"]
    mismatches: list[str] = []
    for key in sorted(set(preserved) | set(expected)):
        if preserved.get(key) != expected.get(key):
            mismatches.append(
                f"{key}: preserved={preserved.get(key)!r}, requested={expected.get(key)!r}"
            )
    return mismatches or ["configuration records differ"]


def selection_record(args: argparse.Namespace) -> dict[str, Any]:
    return {
        "benchmarks": list(args.benchmark or ()),
        "cases": list(args.case or ()),
        "caseFiles": list(args.case_file or ()),
        "patterns": list(args.match or ()),
        "limit": args.limit,
        "allowUngatedFullRun": args.allow_ungated_full_run,
        "allowFrameworkSourceDrift": args.allow_framework_source_drift,
    }


def recover_completed_report_after_runner_crash(
    case: BenchmarkCase,
    config: RunConfig,
    invocation_index: int,
    prior_result: dict[str, Any] | None,
) -> dict[str, Any] | None:
    """Recover only a fully valid terminal report from the runner crash window."""
    case_dir = config.run_dir / "cases" / case.case_id
    report_path = case_dir / "report.json"
    if not report_path.is_file() or report_path.is_symlink():
        return None
    elapsed_ms = prior_result.get("elapsedMs") if prior_result is not None else 0
    if (
        isinstance(elapsed_ms, bool)
        or not isinstance(elapsed_ms, int)
        or elapsed_ms < 0
    ):
        elapsed_ms = 0
    result = base_result(case, config, invocation_index)
    result.update(
        {
            "status": "completed",
            "returnCode": (
                prior_result.get("returnCode")
                if prior_result is not None
                else None
            ),
            "elapsedMs": elapsed_ms,
            "elapsedIncomplete": True,
            "recoveredFromTerminalReport": True,
            "terminalizedByInvocation": invocation_index,
        }
    )
    append_solver_report(result, report_path, case, config)
    fatal_keys = (
        "reportError",
        "reportCoherenceError",
        "reportUsageError",
        "usageError",
    )
    if any(key in result for key in fatal_keys) or "llmUsage" not in result:
        return None
    if not completed_return_code_is_coherent(result):
        return None
    write_case_result(config, case, result)
    return result


def load_resume_case_state(
    cases: list[BenchmarkCase], config: RunConfig, invocation_index: int
) -> tuple[list[dict[str, Any]], list[BenchmarkCase], list[str]]:
    cases_root = config.run_dir / "cases"
    expected = {case.case_id: case for case in cases}
    if cases_root.exists() and not cases_root.is_dir():
        raise RunnerError(f"resume cases path is not a directory: {cases_root}")
    if cases_root.is_dir():
        unexpected = sorted(
            path.name
            for path in cases_root.iterdir()
            if path.is_dir() and path.name not in expected
        )
        if unexpected:
            raise RunnerError(
                "resume directory contains case directories outside the preserved cohort: "
                + ", ".join(unexpected[:8])
            )

    results: list[dict[str, Any]] = []
    pending: list[BenchmarkCase] = []
    finalized_partials: list[str] = []
    for case in cases:
        case_dir = cases_root / case.case_id
        if not case_dir.exists():
            pending.append(case)
            continue
        if not case_dir.is_dir():
            raise RunnerError(f"resume case path is not a directory: {case_dir}")
        cleanup_case_proof_containers(
            case_dir,
            termination_grace_seconds=config.termination_grace_seconds,
        )
        result_path = case_dir / "runner-result.json"
        if not result_path.is_file():
            recovered = recover_completed_report_after_runner_crash(
                case, config, invocation_index, None
            )
            if recovered is not None:
                results.append(recovered)
                finalized_partials.append(case.case_id)
                continue
            results.append(
                finalize_interrupted_case(
                    case,
                    config,
                    invocation_index,
                    prior_result=None,
                    reason="case directory exists without runner-result.json",
                )
            )
            finalized_partials.append(case.case_id)
            continue
        result = read_existing_case_result(result_path, case, config)
        if result.get("status") not in TERMINAL_CASE_STATUSES:
            recovered = recover_completed_report_after_runner_crash(
                case, config, invocation_index, result
            )
            if recovered is not None:
                results.append(recovered)
                finalized_partials.append(case.case_id)
                continue
            results.append(
                finalize_interrupted_case(
                    case,
                    config,
                    invocation_index,
                    prior_result=result,
                    reason=(
                        "case has non-terminal preserved status "
                        f"{result.get('status')!r}"
                    ),
                )
            )
            finalized_partials.append(case.case_id)
            continue
        results.append(result)
    return results, pending, finalized_partials


def read_existing_case_result(
    path: Path, case: BenchmarkCase, config: RunConfig
) -> dict[str, Any]:
    try:
        result = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RunnerError(
            f"cannot read existing case result {path}: {error}"
        ) from error
    if not isinstance(result, dict):
        raise RunnerError(f"existing case result is not a JSON object: {path}")
    if result.get("caseId") != case.case_id:
        raise RunnerError(
            f"existing case result {path} identifies {result.get('caseId')!r}, "
            f"expected {case.case_id!r}"
        )
    status = result.get("status")
    if not isinstance(status, str):
        raise RunnerError(f"existing case result has no string status: {path}")
    if status == "completed" and not completed_return_code_is_coherent(result):
        raise RunnerError(
            f"completed existing case has incoherent solver return telemetry: {path}"
        )
    if result.get("inputFiles") != config.input_files[case.case_id]:
        raise RunnerError(f"existing case result input binding drifted: {path}")
    if result.get("effectiveConfiguration") != effective_configuration_record(config):
        raise RunnerError(
            f"existing case result effective configuration drifted: {path}"
        )
    evidence = result.get("reportEvidence")
    if not isinstance(evidence, dict):
        raise RunnerError(f"existing case result has no reportEvidence: {path}")
    if evidence.get("present") is True:
        report_value = evidence.get("path")
        if not isinstance(report_value, str):
            raise RunnerError(f"existing case report path is invalid: {path}")
        report_path = resolve_artifact_path(report_value)
        if not report_path.is_file() or report_path.is_symlink():
            raise RunnerError(f"existing case report is missing: {report_path}")
        if evidence.get("sha256") != sha256_file(report_path):
            raise RunnerError(f"existing case report digest drifted: {report_path}")
        report = read_json_object(report_path, "existing solver report")
        metrics = proof_metrics_from_report(report, case, config, report_path.parent)
        if result.get("proofMetrics") != metrics:
            raise RunnerError(f"existing case proof metrics drifted: {path}")
        if status == "completed":
            validate_completed_report(
                report, result, report_path.parent, case, config
            )
    elif status == "completed":
        raise RunnerError(f"completed existing case has no report evidence: {path}")
    changed = False
    if "llmUsage" in result:
        result["llmUsage"] = validate_llm_usage(result["llmUsage"])
    elif status in TERMINAL_CASE_STATUSES:
        try:
            result["llmUsage"] = recover_llm_usage(
                path.parent, require_usage=status == "completed"
            )
            result.pop("usageError", None)
            changed = True
        except RunnerError as error:
            if status == "completed":
                raise RunnerError(
                    f"completed existing result has no authoritative usage, {path}: {error}"
                ) from error
            if result.get("usageError") != str(error):
                result["usageError"] = str(error)
                changed = True
    if changed:
        atomic_write_json(path, result)
    write_case_result_sidecars(path.parent, case, result)
    return result


def finalize_interrupted_case(
    case: BenchmarkCase,
    config: RunConfig,
    invocation_index: int,
    *,
    prior_result: dict[str, Any] | None,
    reason: str,
) -> dict[str, Any]:
    result = base_result(case, config)
    if prior_result is not None:
        result.update(prior_result)
    elapsed_ms = result.get("elapsedMs")
    if (
        isinstance(elapsed_ms, bool)
        or not isinstance(elapsed_ms, int)
        or elapsed_ms < 0
    ):
        elapsed_ms = 0
    interruption_reason = (
        f"interrupted prior invocation: {reason}; partial artifacts retained and case "
        "was not rerun by the continuation"
    )
    result.update(
        {
            "status": "failed",
            "returnCode": result.get("returnCode"),
            "elapsedMs": elapsed_ms,
            "elapsedIncomplete": True,
            "runnerError": interruption_reason,
            "interruptionReason": interruption_reason,
            "terminalizedByInvocation": invocation_index,
        }
    )
    result.pop("llmUsage", None)
    result.pop("usageError", None)
    append_solver_report(
        result,
        config.run_dir / "cases" / case.case_id / "report.json",
        case,
        config,
    )
    write_case_result(config, case, result)
    return result


def verify_framework_source_tree_integrity(config: RunConfig) -> dict[str, Any]:
    starting_digest = config.framework_source_tree["manifestSha256"]
    source_path = resolve_artifact_path(config.framework_source_tree["manifestPath"])
    if (
        not source_path.is_file()
        or source_path.is_symlink()
        or sha256_file(source_path) != starting_digest
    ):
        raise RunnerError("preserved framework source-tree manifest changed")

    observed_digest = None
    observation_error = None
    try:
        source_manifest = build_source_tree_manifest(LOGOS_ROOT)
    except (SourceTreeError, OSError) as error:
        if not config.allow_framework_source_drift:
            raise RunnerError(str(error)) from error
        observation_error = str(error)
    else:
        observed_digest = source_tree_manifest_sha256(source_manifest)

    drift_detected = observed_digest != starting_digest
    if observation_error is not None:
        drift_detected = True
    if drift_detected and not config.allow_framework_source_drift:
        raise RunnerError("framework source tree changed while the run was active")
    return {
        "frameworkSourceTreeManifestSha256": starting_digest,
        "frameworkSourceTreeDigestPolicy": (
            FRAMEWORK_SOURCE_DIGEST_POLICY_RECORD_ONLY
            if config.allow_framework_source_drift
            else FRAMEWORK_SOURCE_DIGEST_POLICY_REQUIRED
        ),
        "frameworkSourceTreeObservedManifestSha256": observed_digest,
        "frameworkSourceTreeDriftDetected": drift_detected,
        "frameworkSourceTreeObservationError": observation_error,
    }


def verify_run_integrity(
    input_root: Path,
    cases: list[BenchmarkCase],
    config: RunConfig,
    results: list[dict[str, Any]],
) -> dict[str, Any]:
    source_integrity = verify_framework_source_tree_integrity(config)

    validate_case_process_isolation(
        config.case_process_bootstrap,
        config.case_process_supervisor,
    )
    current_case_process_isolation = case_process_isolation_record(
        config.case_process_bootstrap,
        config.case_process_supervisor,
        config.run_dir,
    )
    if current_case_process_isolation != config.case_process_isolation:
        raise RunnerError("case process-isolation snapshots or policy changed")

    current_solver = solver_binary_record(config.solver_bin)
    if current_solver != config.solver_binary:
        raise RunnerError("solver executable changed while the run was active")
    if stat.S_IMODE(config.solver_bin.stat().st_mode) != 0o555:
        raise RunnerError("solver binary snapshot permissions changed")

    runtime_document, runtime_snapshot = load_trusted_rocq_runtime_snapshot_for_switch(
        config.proof_rocq_opam_switch
    )
    if runtime_snapshot != config.trusted_stack.get("rocqRuntimeSnapshot"):
        raise RunnerError("trusted Rocq runtime snapshot binding changed")

    authority_manifest_path = config.run_dir / "trusted-rocq-authority-manifest.json"
    if config.rocq_authority_snapshot["manifestPath"] != workspace_display_path(
        authority_manifest_path
    ):
        raise RunnerError("trusted Rocq authority manifest path binding changed")
    authority_document, authority_digest = read_rocq_authority_snapshot_manifest(
        authority_manifest_path
    )
    if authority_digest != config.rocq_authority_snapshot["manifestSha256"]:
        raise RunnerError("preserved trusted Rocq authority manifest changed")
    if config.proof_authority_root != resolve_artifact_path(
        config.rocq_authority_snapshot["root"]
    ):
        raise RunnerError("trusted Rocq authority root binding changed")
    verify_rocq_authority_snapshot_tree(
        config.proof_authority_root,
        authority_document,
    )
    validate_rocq_authority_external_bindings(
        authority_document,
        runtime_snapshot,
        config.framework_source_tree,
    )

    stack_document = build_trusted_stack_manifest(
        config.proof_rocq_opam_switch,
        config.proof_authority_root,
    )
    identity_configuration = stack_document["trustedHostTools"][
        "systemIdentityConfiguration"
    ]
    expected_identity_summary = {
        "systemIdentityConfigurationAlgorithm": identity_configuration["algorithm"],
        "systemIdentityConfigurationPathCount": identity_configuration["pathCount"],
        "systemIdentityConfigurationPresentPathCount": identity_configuration[
            "presentPathCount"
        ],
        "systemIdentityConfigurationAbsentPathCount": identity_configuration[
            "absentPathCount"
        ],
    }
    if any(
        config.trusted_stack.get(name) != value
        for name, value in expected_identity_summary.items()
    ):
        raise RunnerError("trusted proof-stack identity summary changed")
    stack_digest = hashlib.sha256(canonical_json_bytes(stack_document)).hexdigest()
    if stack_digest != config.trusted_stack["manifestSha256"]:
        raise RunnerError("trusted proof stack changed while the run was active")
    stack_path = resolve_artifact_path(config.trusted_stack["manifestPath"])
    if sha256_file(stack_path) != stack_digest:
        raise RunnerError("preserved trusted proof-stack manifest changed")

    frontend_document = build_frontend_stack_manifest()
    if (
        frontend_document["launchEnvironment"]
        != frontend_launch_environment_policy_record()
        or config.frontend_stack.get("manifestSchemaVersion")
        != FRONTEND_STACK_MANIFEST_SCHEMA_VERSION
        or config.frontend_stack.get("launchToolCount")
        != frontend_document["launchTools"]["toolCount"]
    ):
        raise RunnerError("SQL frontend launch policy changed while the run was active")
    frontend_digest = hashlib.sha256(
        canonical_json_bytes(frontend_document)
    ).hexdigest()
    if frontend_digest != config.frontend_stack["manifestSha256"]:
        raise RunnerError("SQL frontend stack changed while the run was active")
    frontend_path = resolve_artifact_path(config.frontend_stack["manifestPath"])
    if sha256_file(frontend_path) != frontend_digest:
        raise RunnerError("preserved SQL frontend-stack manifest changed")

    codex_config_path = resolve_artifact_path(config.codex_provider["configPath"])
    if sha256_file(codex_config_path) != config.codex_provider["configSha256"]:
        raise RunnerError("sanitized Codex config changed while the run was active")
    provider_document = build_codex_provider_manifest(
        codex_config_path, config.codex_provider["endpoint"]
    )
    if provider_document["commandEnvironmentPolicy"] != config.codex_provider.get(
        "commandEnvironmentPolicy"
    ) or provider_document["hostCodexCli"]["solverPath"] != config.codex_provider.get(
        "solverPath"
    ):
        raise RunnerError(
            "Codex command launch policy changed while the run was active"
        )
    provider_digest = hashlib.sha256(
        canonical_json_bytes(provider_document)
    ).hexdigest()
    if provider_digest != config.codex_provider["manifestSha256"]:
        raise RunnerError("Codex CLI/provider stack changed while the run was active")
    provider_path = resolve_artifact_path(config.codex_provider["manifestPath"])
    if sha256_file(provider_path) != provider_digest:
        raise RunnerError("preserved Codex provider manifest changed")

    postgres_document = postgres_profile_document(config.postgres_url)
    postgres_digest = hashlib.sha256(
        canonical_json_bytes(postgres_document)
    ).hexdigest()
    if postgres_digest != config.postgres_server_profile["manifestSha256"]:
        raise RunnerError("PostgreSQL server profile changed while the run was active")
    postgres_path = resolve_artifact_path(
        config.postgres_server_profile["manifestPath"]
    )
    if sha256_file(postgres_path) != postgres_digest:
        raise RunnerError("preserved PostgreSQL server-profile manifest changed")

    selected_document = build_input_manifest(
        cases,
        legacy=(
            config.input_manifest.get("algorithm")
            == LEGACY_INPUT_MANIFEST_ALGORITHM
        ),
    )
    selected_digest = input_manifest_sha256(selected_document)
    if selected_digest != config.input_manifest["selectedSha256"]:
        raise RunnerError(
            "selected metadata/schema/sql1/sql2 inputs changed while the run was active"
        )
    selected_path = resolve_artifact_path(config.input_manifest["selectedPath"])
    if sha256_file(selected_path) != selected_digest:
        raise RunnerError("preserved selected-input manifest changed")
    input_path = resolve_artifact_path(config.input_manifest["path"])
    if sha256_file(input_path) != config.input_manifest["sha256"]:
        raise RunnerError("preserved full input manifest changed")
    current_semantic_document = build_semantic_input_authority_manifest(cases)
    current_semantic_digest = input_manifest_sha256(current_semantic_document)
    if (
        current_semantic_digest
        != config.input_manifest["selectedSemanticAuthoritySha256"]
    ):
        raise RunnerError(
            "selected metadata/semantic-sidecar authority changed while the run was active"
        )
    selected_semantic_path = resolve_artifact_path(
        config.input_manifest["selectedSemanticAuthorityPath"]
    )
    if sha256_file(selected_semantic_path) != current_semantic_digest:
        raise RunnerError("preserved selected semantic-input authority changed")
    semantic_path = resolve_artifact_path(
        config.input_manifest["semanticAuthorityPath"]
    )
    if sha256_file(semantic_path) != config.input_manifest["semanticAuthoritySha256"]:
        raise RunnerError("preserved full semantic-input authority changed")
    if config.input_manifest["frozenVerified"] and (
        config.input_manifest["sha256"] != FROZEN_INPUT_MANIFEST_SHA256
    ):
        raise RunnerError("frozen full input manifest binding changed")
    if config.input_manifest["frozenSemanticAuthorityVerified"] and (
        config.input_manifest["semanticAuthoritySha256"]
        != FROZEN_SEMANTIC_INPUT_AUTHORITY_SHA256
    ):
        raise RunnerError("frozen semantic-input authority binding changed")

    current_rbot_authority = validate_rbot_input_authority(
        input_root,
        discover_cases(input_root),
        cases,
        require_exact_selection=bool(
            config.rbot_authority
            and config.rbot_authority.get("canonicalSelectionRequired") is True
        ),
    )
    if current_rbot_authority != config.rbot_authority:
        raise RunnerError("frozen R-Bot input authority changed while the run was active")

    if config.cohort16_gate is not None:
        gate_path = resolve_artifact_path(config.cohort16_gate["path"])
        if sha256_file(gate_path) != config.cohort16_gate["sha256"]:
            raise RunnerError("cohort16 gate summary changed while the run was active")

    expected_effective = effective_configuration_record(config)
    expected_by_case = {case.case_id: case for case in cases}
    if len(results) != len(cases):
        raise RunnerError(
            "terminal integrity verification saw incomplete result accounting"
        )
    result_case_ids = [result.get("caseId") for result in results]
    if not all(isinstance(case_id, str) for case_id in result_case_ids) or set(
        result_case_ids
    ) != set(expected_by_case):
        raise RunnerError(
            "terminal integrity verification saw duplicate or missing case results"
        )
    for result in results:
        case_id = result.get("caseId")
        if case_id not in expected_by_case:
            raise RunnerError(f"terminal result escapes selected cohort: {case_id!r}")
        if result.get("status") not in TERMINAL_CASE_STATUSES:
            raise RunnerError(f"case has no terminal result status: {case_id}")
        if (
            result.get("status") == "completed"
            and not completed_return_code_is_coherent(result)
        ):
            raise RunnerError(
                f"completed case has incoherent solver return telemetry: {case_id}"
            )
        expected_files = config.input_files[case_id]
        if result.get("inputFiles") != expected_files:
            raise RunnerError(f"case input binding changed: {case_id}")
        for record in expected_files.values():
            path = resolve_artifact_path(record["path"])
            if sha256_file(path) != record["sha256"]:
                raise RunnerError(f"case input file changed: {case_id}: {path}")
        if result.get("effectiveConfiguration") != expected_effective:
            raise RunnerError(f"case effective configuration changed: {case_id}")
        result_path = config.run_dir / "cases" / case_id / "runner-result.json"
        preserved = read_json_object(result_path, "terminal runner result")
        if preserved != result:
            raise RunnerError(f"in-memory and durable runner result differ: {case_id}")
        evidence = result.get("reportEvidence")
        if not isinstance(evidence, dict):
            raise RunnerError(f"case has no report evidence record: {case_id}")
        evidence_path_value = evidence.get("path")
        if not isinstance(evidence_path_value, str) or not evidence_path_value:
            raise RunnerError(f"case report evidence path is invalid: {case_id}")
        evidence_path = resolve_artifact_path(evidence_path_value)
        expected_report_path = (
            config.run_dir / "cases" / case_id / "report.json"
        ).resolve()
        if evidence_path != expected_report_path:
            raise RunnerError(f"case report evidence escapes its case: {case_id}")
        if evidence.get("present") is True:
            if not evidence_path.is_file() or evidence_path.is_symlink():
                raise RunnerError(f"case report evidence is missing: {case_id}")
            if sha256_file(evidence_path) != evidence.get("sha256"):
                raise RunnerError(f"case report changed: {case_id}")
        elif evidence_path.exists():
            raise RunnerError(f"unrecorded case report appeared: {case_id}")
        elif result.get("status") == "completed":
            raise RunnerError(f"completed case has no report evidence: {case_id}")

        metrics = result.get("proofMetrics")
        proof_source = metrics.get("proofSource") if isinstance(metrics, dict) else None
        if not isinstance(proof_source, dict):
            raise RunnerError(f"case has no proof-source evidence record: {case_id}")
        proof_path_value = proof_source.get("path")
        if not isinstance(proof_path_value, str) or not proof_path_value:
            raise RunnerError(f"case proof-source path is invalid: {case_id}")
        proof_path = resolve_artifact_path(proof_path_value)
        expected_proof_path = (
            config.run_dir / "cases" / case_id / "proof-stage/formal-sql/Problem.v"
        ).resolve()
        if proof_path != expected_proof_path:
            raise RunnerError(f"case proof source escapes its case: {case_id}")
        if proof_source.get("present") is True:
            if not proof_path.is_file() or proof_path.is_symlink():
                raise RunnerError(f"case proof source is missing: {case_id}")
            if sha256_file(proof_path) != proof_source.get(
                "sha256"
            ) or proof_path.stat().st_size != proof_source.get("bytes"):
                raise RunnerError(f"case proof source changed: {case_id}")
        elif proof_path.exists():
            raise RunnerError(f"unrecorded case proof source appeared: {case_id}")

    image = resolve_docker_image_identity(config.proof_docker_image)
    if image != config.proof_docker_image_identity:
        raise RunnerError(
            "proof-agent Docker image identity changed while the run was active"
        )
    current_solver_environment = solver_environment_record(config)
    return {
        "verified": True,
        "verifiedAt": iso_now(),
        **source_integrity,
        "solverBinarySha256": current_solver["sha256"],
        "caseProcessIsolationSha256": hashlib.sha256(
            canonical_json_bytes(current_case_process_isolation)
        ).hexdigest(),
        "rocqRuntimeSnapshotManifestSha256": runtime_snapshot["manifestSha256"],
        "rocqAuthoritySnapshotManifestSha256": authority_digest,
        "trustedStackManifestSha256": stack_digest,
        "frontendStackManifestSha256": frontend_digest,
        "codexProviderManifestSha256": provider_digest,
        "codexConfigSha256": config.codex_provider["configSha256"],
        "providerEndpointSha256": config.codex_provider["endpointSha256"],
        "solverEnvironmentSha256": current_solver_environment["sha256"],
        "postgresServerProfileSha256": postgres_digest,
        "inputManifestSha256": config.input_manifest["sha256"],
        "selectedInputManifestSha256": selected_digest,
        "semanticAuthoritySha256": config.input_manifest[
            "semanticAuthoritySha256"
        ],
        "selectedSemanticAuthoritySha256": current_semantic_digest,
        "rbotManifestSha256": (
            config.rbot_authority.get("manifestSha256")
            if config.rbot_authority is not None
            else None
        ),
        "cohort16GateSha256": (
            config.cohort16_gate.get("sha256")
            if config.cohort16_gate is not None
            else None
        ),
        "proofDockerImage": config.proof_docker_image_effective,
    }


def run_selected_cases(
    input_root: Path,
    cases: list[BenchmarkCase],
    config: RunConfig,
    jobs: int,
    selection: dict[str, Any],
    *,
    preserved_summary: dict[str, Any] | None = None,
) -> int:
    started_monotonic = time.monotonic()
    case_order = {case.case_id: index for index, case in enumerate(cases)}
    if preserved_summary is None:
        started_at = iso_now()
        elapsed_base_ms = 0
        summary_template: dict[str, Any] = {}
        continuations: list[dict[str, Any]] = []
        invocation_index = 0
        results: list[dict[str, Any]] = []
        scheduled_cases = list(cases)
    else:
        started_at = preserved_summary["startedAt"]
        elapsed_base_ms = preserved_summary["elapsedMs"]
        summary_template = dict(preserved_summary)
        preserved_continuations = preserved_summary.get("continuations", [])
        if not isinstance(preserved_continuations, list) or not all(
            isinstance(value, dict) for value in preserved_continuations
        ):
            raise RunnerError(
                "resume summary continuations must be an array of objects"
            )
        continuations = [dict(value) for value in preserved_continuations]
        invocation_index = len(continuations) + 1
        results, scheduled_cases, finalized_partials = load_resume_case_state(
            cases, config, invocation_index
        )
        continuations.append(
            {
                "invocation": invocation_index,
                "resumedAt": iso_now(),
                "priorStatus": preserved_summary.get("status"),
                "priorUpdatedAt": preserved_summary.get("updatedAt"),
                "priorElapsedMs": elapsed_base_ms,
                "reusedTerminalCases": len(results) - len(finalized_partials),
                "finalizedInterruptedCases": len(finalized_partials),
                "finalizedInterruptedCaseIds": finalized_partials,
                "scheduledNeverStartedCases": len(scheduled_cases),
                "configuration": configuration_record(input_root, config, jobs),
            }
        )
    stop_event = threading.Event()
    registry = ProcessRegistry()
    interrupted_signal: list[int | None] = [None]
    termination_wake = threading.Event()
    termination_shutdown = threading.Event()
    termination_errors: list[BaseException] = []

    def terminate_registered_cases() -> None:
        while True:
            termination_wake.wait()
            termination_wake.clear()
            if termination_shutdown.is_set():
                return
            try:
                registry.terminate_all(config.termination_grace_seconds)
            except BaseException as error:
                termination_errors.append(error)

    termination_worker = threading.Thread(
        target=terminate_registered_cases,
        name="logos-case-terminator",
        daemon=True,
    )
    termination_worker.start()

    def request_stop(signum: int, _frame: Any) -> None:
        if interrupted_signal[0] is None:
            interrupted_signal[0] = signum
        stop_event.set()
        # Python signal handlers run on the main thread and may reenter code
        # interrupted while it owns registry or managed-process locks.  Wake a
        # prestarted ordinary thread; never acquire lifecycle locks here.
        termination_wake.set()

    previous_handlers: dict[signal.Signals, Any] = {}
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        previous_handlers[sig] = signal.getsignal(sig)
        signal.signal(sig, request_stop)

    def write_summary(status: str) -> None:
        ordered_results = sorted(
            results,
            key=lambda result: (
                case_order.get(result.get("caseId"), len(case_order)),
                str(result.get("caseId", "")),
            ),
        )
        counts = result_counts(ordered_results, len(cases))
        usage = aggregate_usage(ordered_results)
        configuration = configuration_record(input_root, config, jobs)
        document = dict(summary_template)
        document.update(
            {
                "schemaVersion": 1,
                "status": status,
                "startedAt": started_at,
                "updatedAt": iso_now(),
                "elapsedMs": elapsed_base_ms
                + round((time.monotonic() - started_monotonic) * 1000),
                "inputRoot": display_path(input_root),
                "runDir": display_path(config.run_dir),
                "solverBin": display_path(config.solver_bin),
                "jobs": jobs,
                "caseTimeoutSeconds": config.case_timeout_seconds,
                "terminationGraceSeconds": config.termination_grace_seconds,
                "verificationMode": config.verification_mode,
                "model": config.model,
                "reasoningEffort": config.reasoning_effort,
                "proofAgentMemoryLimitMiB": config.proof_agent_memory_limit_mib,
                "proofAgentStorageLimitMiB": config.proof_agent_storage_limit_mib,
                "statementTimeoutSeconds": config.statement_timeout_seconds,
                "maxCounterexampleRounds": config.max_counterexample_rounds,
                "proofCheckTimeoutSeconds": config.proof_check_timeout_seconds,
                "proofDockerImage": config.proof_docker_image_effective,
                "proofDockerImageRequested": config.proof_docker_image,
                "proofDockerImageEffective": config.proof_docker_image_effective,
                "solverArgs": list(config.solver_args),
                "effectiveSolverArgs": list(effective_solver_args(config)),
                "counterexampleAssessmentPolicy": "force-fresh",
                "sqlEnvironment": sql_environment_record(config),
                "configuration": configuration,
                "selection": summary_template.get("selection", selection),
                "cases": [case.case_id for case in cases],
                "counts": counts,
                "llmUsage": usage,
                "usageComplete": all(
                    result.get("usageComplete", "llmUsage" in result)
                    for result in ordered_results
                )
                and len(ordered_results) == len(cases),
                "provenance": {
                    "runner": "benchmarks/scripts/run-logos",
                    "initialStartedAt": started_at,
                    "continuationCount": len(continuations),
                    "currentInvocation": invocation_index,
                    "benchmarkFingerprint": (
                        config.frozen_benchmark.get("benchmarkFingerprint")
                        if config.frozen_benchmark is not None
                        else None
                    ),
                    "frozenSummarySha256": (
                        config.frozen_benchmark.get("frozenSummarySha256")
                        if config.frozen_benchmark is not None
                        else None
                    ),
                    "frameworkSourceTreeManifestSha256": config.framework_source_tree[
                        "manifestSha256"
                    ],
                    "rocqRuntimeSnapshotManifestSha256": config.trusted_stack[
                        "rocqRuntimeSnapshot"
                    ]["manifestSha256"],
                    "rocqRuntimeSnapshotRoot": config.trusted_stack[
                        "rocqRuntimeSnapshot"
                    ]["root"],
                    "rocqAuthoritySnapshotManifestSha256": config.rocq_authority_snapshot[
                        "manifestSha256"
                    ],
                    "rocqAuthoritySnapshotRoot": config.rocq_authority_snapshot[
                        "root"
                    ],
                    "trustedStackManifestSha256": config.trusted_stack[
                        "manifestSha256"
                    ],
                    "frontendStackManifestSha256": config.frontend_stack[
                        "manifestSha256"
                    ],
                    "codexProviderManifestSha256": config.codex_provider[
                        "manifestSha256"
                    ],
                    "codexConfigSha256": config.codex_provider["configSha256"],
                    "providerEndpointSha256": config.codex_provider["endpointSha256"],
                    "postgresServerProfileSha256": config.postgres_server_profile[
                        "manifestSha256"
                    ],
                },
                "continuations": continuations,
                "results": ordered_results,
            }
        )
        atomic_write_json(config.run_dir / "runner-summary.json", document)

    write_summary("running")
    print(
        f"running {len(scheduled_cases)} pending of {len(cases)} case(s) with "
        f"{jobs} worker(s); results: {config.run_dir}",
        file=sys.stderr,
        flush=True,
    )
    try:
        executor = concurrent.futures.ThreadPoolExecutor(max_workers=jobs)
        futures = {
            executor.submit(
                run_case_guarded,
                case,
                config,
                registry,
                stop_event,
                invocation_index,
            ): case
            for case in scheduled_cases
        }
        try:
            for index, future in enumerate(
                concurrent.futures.as_completed(futures), start=1
            ):
                result = future.result()
                results.append(result)
                write_summary("interrupted" if stop_event.is_set() else "running")
                print(
                    f"[{index}/{len(scheduled_cases)}] {result['status']}: "
                    f"{result['caseId']} "
                    f"({result['elapsedMs'] / 1000:.1f}s)",
                    file=sys.stderr,
                    flush=True,
                )
        finally:
            if stop_event.is_set():
                for future in futures:
                    future.cancel()
                registry.terminate_all(config.termination_grace_seconds)
            executor.shutdown(wait=True, cancel_futures=True)
    finally:
        try:
            registry.terminate_all(config.termination_grace_seconds)
        finally:
            termination_shutdown.set()
            termination_wake.set()
            termination_worker.join()
            for sig, handler in previous_handlers.items():
                signal.signal(sig, handler)

    if termination_errors:
        raise RunnerError(
            "case termination worker failed: "
            + "; ".join(
                f"{type(error).__name__}: {error}" for error in termination_errors
            )
        )

    interrupted = interrupted_signal[0] is not None
    if continuations:
        continuations[-1]["completedAt"] = iso_now()
        continuations[-1]["status"] = "interrupted" if interrupted else "complete"
    if interrupted:
        write_summary("interrupted")
        return 128 + int(interrupted_signal[0] or signal.SIGINT)
    try:
        summary_template["integrityVerification"] = verify_run_integrity(
            input_root, cases, config, results
        )
        summary_template.pop("integrityError", None)
    except RunnerError as error:
        summary_template["integrityVerification"] = {"verified": False}
        summary_template["integrityError"] = str(error)
        if continuations:
            continuations[-1]["status"] = "interrupted"
        write_summary("interrupted")
        raise
    write_summary("complete")
    print(
        f"complete: {config.run_dir / 'runner-summary.json'}",
        file=sys.stderr,
        flush=True,
    )
    return 0


def run_case_guarded(
    case: BenchmarkCase,
    config: RunConfig,
    registry: ProcessRegistry,
    stop_event: threading.Event,
    invocation_index: int,
) -> dict[str, Any]:
    case_dir = config.run_dir / "cases" / case.case_id
    run_error: Exception | None = None
    try:
        result = run_case(case, config, registry, stop_event, invocation_index)
    except (
        Exception
    ) as error:  # Keep one runner bug from aborting the remaining cohort.
        run_error = error
        result = base_result(case, config, invocation_index)
        result.update(
            {
                "status": "failed",
                "returnCode": None,
                "elapsedMs": 0,
                "runnerError": f"{type(error).__name__}: {error}",
            }
        )

    cleanup_error: Exception | None = None
    try:
        cleanup_case_proof_containers(
            case_dir,
            termination_grace_seconds=config.termination_grace_seconds,
        )
    except Exception as error:
        cleanup_error = error
        prior_error = result.get("runnerError")
        cleanup_diagnostic = (
            f"proof-agent host cleanup failed: {type(error).__name__}: {error}"
        )
        result.update(
            {
                "status": "failed",
                "runnerError": (
                    f"{prior_error}; {cleanup_diagnostic}"
                    if isinstance(prior_error, str) and prior_error
                    else cleanup_diagnostic
                ),
            }
        )

    if run_error is not None or cleanup_error is not None:
        write_case_result(config, case, result)
    return result


def run_case(
    case: BenchmarkCase,
    config: RunConfig,
    registry: ProcessRegistry,
    stop_event: threading.Event,
    invocation_index: int,
) -> dict[str, Any]:
    started = time.monotonic()
    result = base_result(case, config, invocation_index)
    if stop_event.is_set():
        result.update({"status": "cancelled", "returnCode": None, "elapsedMs": 0})
        return result

    case_dir = config.run_dir / "cases" / case.case_id
    case_dir.mkdir(parents=True, exist_ok=False)
    stdout_path = case_dir / "stdout.log"
    stderr_path = case_dir / "stderr.log"
    command = solver_command(case, case_dir, config)
    timed_out = False
    with stdout_path.open("wb") as stdout, stderr_path.open("wb") as stderr:
        process = subprocess.Popen(
            command,
            cwd=LOGOS_ROOT,
            env=solver_environment(config),
            stdout=stdout,
            stderr=stderr,
            start_new_session=True,
        )
        managed = registry.register(process)
        try:
            write_solver_pid_marker(
                case_dir,
                process,
                config.case_process_supervisor,
            )
            if stop_event.is_set():
                terminate_process_group(managed, config.termination_grace_seconds)
            try:
                return_code = managed.wait(config.case_timeout_seconds)
            except subprocess.TimeoutExpired:
                timed_out = True
                terminate_process_group(managed, config.termination_grace_seconds)
                return_code = managed.wait(0.0)
        finally:
            if not managed.has_exited():
                terminate_process_group(managed, config.termination_grace_seconds)
            else:
                managed.wait(0.0)
            registry.unregister(managed)

    elapsed_ms = round((time.monotonic() - started) * 1000)
    if timed_out:
        status = "timed_out"
    elif stop_event.is_set() and return_code != 0:
        status = "cancelled"
    elif return_code == 0:
        status = "completed"
    else:
        status = "failed"
    result.update(
        {
            "status": status,
            "returnCode": return_code,
            "elapsedMs": elapsed_ms,
        }
    )
    append_solver_report(result, case_dir / "report.json", case, config)
    if status == "failed" and not (case_dir / "report.json").is_file():
        stderr_tail = read_utf8_log(stderr_path)
        if stderr_tail:
            diagnostic = (
                f"solver exited with return code {return_code}; stderr tail:\n"
                f"{stderr_tail}"
            )
            result["runnerError"] = diagnostic
            result.setdefault("reason", diagnostic)
    if (
        status == "completed"
        and "llmUsage" not in result
        and "usageError" not in result
    ):
        result["usageError"] = "solver completed without a report carrying llmUsage"
    if status == "completed" and (
        "usageError" in result
        or "reportError" in result
        or "reportCoherenceError" in result
    ):
        result["status"] = "failed"
        result["runnerError"] = (
            "authoritative solver report, proof evidence, or LLM usage validation failed"
        )
    write_case_result(config, case, result)
    return result


def read_utf8_log(path: Path) -> str:
    try:
        value = path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""
    return value


def solver_command(case: BenchmarkCase, case_dir: Path, config: RunConfig) -> list[str]:
    payload = [
        str(config.solver_bin),
        "check",
        "--schema",
        str(case.schema),
        "--source",
        str(case.source),
        "--target",
        str(case.target),
        "--log-dir",
        str(case_dir),
        "--logos-repo-root",
        str(config.proof_authority_root),
        "--calcite-ir-command",
        CANONICAL_FRONTEND_COMMAND,
        "--verification-mode",
        config.verification_mode,
        "--proof-agent-timeout-seconds",
        str(max(1, int(config.case_timeout_seconds) - 300)),
        "--proof-agent-memory-limit-mib",
        str(config.proof_agent_memory_limit_mib),
        "--proof-agent-storage-limit-mib",
        str(config.proof_agent_storage_limit_mib),
        "--proof-check-timeout-seconds",
        str(config.proof_check_timeout_seconds),
        "--statement-timeout-ms",
        str(config.statement_timeout_seconds * 1000),
        "--max-counterexample-rounds",
        str(config.max_counterexample_rounds),
        "--proof-docker-image",
        config.proof_docker_image_effective,
        "--proof-rocq-opam-switch",
        str(config.proof_rocq_opam_switch),
        "--sql-time-zone",
        config.sql_time_zone,
        "--sql-default-collation",
        config.sql_default_collation,
        "--sql-character-classification",
        config.sql_character_classification,
        "--sql-locale-provider",
        config.sql_locale_provider,
        "--sql-server-encoding",
        config.sql_server_encoding,
        "--quiet",
    ]
    if config.postgres_url:
        payload.extend(("--postgres-url", config.postgres_url))
    payload.extend(effective_solver_args(config))
    return case_process_supervisor_command(
        payload,
        config.case_process_bootstrap,
        config.case_process_supervisor,
    )


def solver_environment(config: RunConfig) -> dict[str, str]:
    environment = dict(SOLVER_FIXED_ENVIRONMENT_ITEMS)
    environment["PATH"] = config.codex_provider["solverPath"]["value"]
    runtime_home = str(config.codex_runtime_home)
    environment["CODEX_HOME"] = runtime_home
    environment["LOGOS_SOLVER_CODEX_HOME"] = runtime_home
    environment["LOGOS_SOLVER_CODEX_CONFIG"] = str(
        config.codex_runtime_home / "config.toml"
    )
    frontend_environment = canonical_frontend_environment(
        include_runtime_classpath=True
    )
    for name in FRONTEND_EXPLICIT_ENVIRONMENT_NAMES:
        environment[name] = frontend_environment[name]
    expected_names = {
        "PATH",
        *(name for name, _value in SOLVER_FIXED_ENVIRONMENT_ITEMS),
        *SOLVER_EXPLICIT_ENVIRONMENT_NAMES,
    }
    if set(environment) != expected_names:
        raise RunnerError("solver launch environment differs from its strict allowlist")
    return environment


def solver_launch_environment_policy_record(config: RunConfig) -> dict[str, Any]:
    return {
        "schemaVersion": 2,
        "inheritedEnvironmentCleared": True,
        "fixedVariables": [
            f"PATH={config.codex_provider['solverPath']['value']}",
            *(f"{name}={value}" for name, value in SOLVER_FIXED_ENVIRONMENT_ITEMS),
        ],
        "hostEnvironmentAllowlist": [],
        "explicitContractVariables": list(SOLVER_EXPLICIT_ENVIRONMENT_NAMES),
        "bootstrapInjectedContractVariables": [
            CASE_PROCESS_SUPERVISOR_PID_ENVIRONMENT
        ],
        "bootstrapInjectedFixedVariables": ["SHLVL=0"],
        "bootstrapInjectionPolicy": config.case_process_isolation[
            "hostSupervisorPidChannel"
        ],
        "unlistedEnvironmentPolicy": "excluded_by_env_clear_before_process_start",
        "explicitlyExcludedVariables": list(SOLVER_LAUNCH_EXCLUDED_VARIABLES),
        "explicitlyExcludedPrefixes": list(TRUSTED_LAUNCH_EXCLUDED_PREFIXES),
        "codexInvocationPath": config.codex_provider["hostCodexInvocationPath"],
        "nodeInvocationPath": config.codex_provider["hostCodexNodeInvocationPath"],
        "codexSolverPathAlgorithm": config.codex_provider["solverPath"]["algorithm"],
    }


def solver_environment_record(config: RunConfig) -> dict[str, Any]:
    environment = solver_environment(config)
    normalized_environment = dict(environment)
    normalized_environment["SHLVL"] = "0"
    normalized_environment[CASE_PROCESS_SUPERVISOR_PID_ENVIRONMENT] = (
        "<case-host-supervisor-pid>"
    )
    normalized_runtime_home = "<isolated-codex-runtime-home>"
    normalized_environment["CODEX_HOME"] = normalized_runtime_home
    normalized_environment["LOGOS_SOLVER_CODEX_HOME"] = normalized_runtime_home
    normalized_environment["LOGOS_SOLVER_CODEX_CONFIG"] = (
        f"{normalized_runtime_home}/config.toml"
    )
    return {
        "algorithm": SOLVER_ENVIRONMENT_POLICY_ALGORITHM,
        "variableCount": len(normalized_environment),
        "variableNames": sorted(normalized_environment),
        "normalization": "isolated-codex-runtime-home-symbolic-v1",
        "sha256": hashlib.sha256(
            canonical_json_bytes(normalized_environment)
        ).hexdigest(),
    }


