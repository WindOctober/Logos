# Copy this file to .env and replace external paths with paths on this host.
# Paths may be absolute or relative to the Logos repository root.

# JDK 17 used by the Calcite frontend and SQLSolver compatibility checks.
LOGOS_JAVA_HOME=/path/to/jdk-17

# Optional external publication destination. Without this setting, publication
# defaults to var/final-experiment/Logos inside this repository.
LOGOS_FINAL_EXPERIMENT_DIR=/path/to/FinalExperiment/Logos

# Optional external baseline-tool integrations.
LOGOS_QED_PARSER=/path/to/PaperTools/scripts/qed-parser
LOGOS_SQLSOLVER_JAR=/path/to/PaperTools/SQLSolver/build/libs/sqlsolver.jar

# Optional runtime configuration. The repository-local Rocq switch is used when
# LOGOS_ROCQ_OPAM_SWITCH is unset.
LOGOS_ROCQ_OPAM_SWITCH=.opam-rocq
# Full benchmark runs require this home's config.toml to select
# model = "gpt-5.6-sol" and model_reasoning_effort = "medium".
CODEX_HOME=/path/to/.codex
LOGOS_POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
