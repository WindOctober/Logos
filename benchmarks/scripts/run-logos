}


def expected_artifact_sql_environment(config: RunConfig) -> dict[str, str]:
    return {
        "defaultCollation": config.sql_default_collation,
        "characterClassification": config.sql_character_classification,
        "localeProvider": config.sql_locale_provider,
        "serverEncoding": config.sql_server_encoding,
    }


_ASCII_IDENTIFIER_FOLD = str.maketrans(
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz"
)


def _ascii_fold_identifier(value: str) -> str:
    return value.translate(_ASCII_IDENTIFIER_FOLD)


def schema_ir_integrity_tables(schema_ir: dict[str, Any]) -> list[dict[str, Any]]:
    """Return the complete effective contract transported by accepted schema IR."""
    schema_tables = schema_ir.get("tables")
    if not isinstance(schema_tables, list):
        raise RunnerError("schema IR table catalog is malformed")
    rows: list[dict[str, Any]] = []
    table_names: set[str] = set()
    for table in schema_tables:
        if (
            not isinstance(table, dict)
            or not isinstance(table.get("name"), str)
            or not table["name"]
            or not isinstance(table.get("columns"), list)
        ):
            raise RunnerError("schema IR table identity is malformed")
        table_name = table["name"]
        if table_name in table_names:
            raise RunnerError("schema IR has duplicate exact table identities")
        table_names.add(table_name)
        column_names: set[str] = set()
        for column in table["columns"]:
            if (
                not isinstance(column, dict)
                or not isinstance(column.get("name"), str)
                or not column["name"]
                or column["name"] in column_names
            ):
                raise RunnerError("schema IR column identity is malformed")
            column_names.add(column["name"])
        constraints = table.get("constraints")
        if constraints is None:
            continue
        if not isinstance(constraints, dict):
            raise RunnerError("schema IR table constraints are malformed")
        if constraints:
            rows.append({"name": table_name, "constraints": constraints})
    return rows


def pair_metadata_integrity_tables(
    metadata: dict[str, Any], schema_ir: dict[str, Any]
) -> list[dict[str, Any]]:
    """Canonicalize the metadata-only subset using the Rust resolver policy."""
    constraints = metadata.get("constraints")
    scope = metadata.get("constraintScope")
    if constraints is None and scope is None:
        return []
    if not isinstance(constraints, list) or scope not in {"none", "pair"}:
        raise RunnerError("selected pair metadata constraint authority is malformed")
    if scope == "none" and constraints:
        raise RunnerError("constraintScope=none carries pair constraints")

    schema_tables = schema_ir.get("tables")
    if not isinstance(schema_tables, list):
        raise RunnerError("schema IR table catalog is malformed")
    table_order: list[str] = []
    column_order: dict[str, list[str]] = {}
    for table in schema_tables:
        if (
            not isinstance(table, dict)
            or not isinstance(table.get("name"), str)
            or not table["name"]
            or not isinstance(table.get("columns"), list)
        ):
            raise RunnerError("schema IR table identity is malformed")
        table_name = table["name"]
        if table_name in column_order:
            raise RunnerError("schema IR has duplicate exact table identities")
        table_order.append(table_name)
        columns: list[str] = []
        column_names: set[str] = set()
        for column in table["columns"]:
            if (
                not isinstance(column, dict)
                or not isinstance(column.get("name"), str)
                or not column["name"]
            ):
                raise RunnerError("schema IR column identity is malformed")
            column_name = column["name"]
            if column_name in column_names:
                raise RunnerError("schema IR has duplicate exact column identities")
            column_names.add(column_name)
            columns.append(column_name)
        column_order[table_name] = columns
    tables: dict[str, dict[str, Any]] = {}

    def resolve_identifier(
        requested: str, candidates: list[str], kind: str
    ) -> str:
        if requested in candidates:
            return requested
        folded = _ascii_fold_identifier(requested)
        matches = [
            candidate
            for candidate in candidates
            if _ascii_fold_identifier(candidate) == folded
        ]
        if len(matches) == 1:
            return matches[0]
        if not matches:
            raise RunnerError(f"pair constraint names unknown {kind}")
        raise RunnerError(
            f"pair constraint identifier ambiguously case-folds to multiple {kind} names"
        )

    def endpoint(value: Any) -> tuple[str, str]:
        if not isinstance(value, str) or not value:
            raise RunnerError("pair constraint endpoint is malformed")
        parts = value.rsplit("__", 1)
        if len(parts) != 2 or not parts[0] or not parts[1]:
            raise RunnerError("pair constraint endpoint is not TABLE__COLUMN")
        table = resolve_identifier(parts[0], table_order, "table")
        column = resolve_identifier(
            parts[1], column_order[table], f"column of table {table!r}"
        )
        return table, column

    def table_constraints(table: str) -> dict[str, Any]:
        return tables.setdefault(table, {})

    for constraint in constraints:
        if not isinstance(constraint, dict) or len(constraint) != 1:
            raise RunnerError("pair constraint entry is malformed")
        kind, payload = next(iter(constraint.items()))
        if kind == "not_null":
            if not isinstance(payload, dict) or set(payload) != {"value"}:
                raise RunnerError("pair not-null constraint is malformed")
            table, column = endpoint(payload["value"])
            not_null = table_constraints(table).setdefault("notNull", [])
            if column not in not_null:
                not_null.append(column)
        elif kind == "primary":
            if not isinstance(payload, list) or not payload:
                raise RunnerError("pair primary-key constraint is malformed")
            endpoints = [
                endpoint(value.get("value"))
                if isinstance(value, dict) and set(value) == {"value"}
                else (_ for _ in ()).throw(
                    RunnerError("pair primary-key endpoint is malformed")
                )
                for value in payload
            ]
            table = endpoints[0][0]
            if any(endpoint_table != table for endpoint_table, _ in endpoints):
                raise RunnerError("pair primary-key constraint crosses tables")
            columns = [column for _, column in endpoints]
            target = table_constraints(table)
            if target.get("primaryKey", columns) != columns:
                raise RunnerError("pair metadata declares conflicting primary keys")
            target["primaryKey"] = columns
        elif kind == "foreign":
            if not isinstance(payload, list) or len(payload) != 2:
                raise RunnerError("pair foreign-key constraint is malformed")
            endpoints = [
                endpoint(value.get("value"))
                if isinstance(value, dict) and set(value) == {"value"}
                else (_ for _ in ()).throw(
                    RunnerError("pair foreign-key endpoint is malformed")
                )
                for value in payload
            ]
            (table, column), (referenced_table, referenced_column) = endpoints
            foreign = {
                "columns": [column],
                "referencedTable": referenced_table,
                "referencedColumns": [referenced_column],
                "matchType": "simple",
            }
            foreign_keys = table_constraints(table).setdefault("foreignKeys", [])
            if foreign not in foreign_keys:
                foreign_keys.append(foreign)
        else:
            raise RunnerError("pair metadata uses an unsupported constraint kind")
    rows = []
    for table in table_order:
        if table not in tables:
            continue
        value = tables[table]
        if "primaryKey" in value:
            not_null = value.setdefault("notNull", [])
            for column in value["primaryKey"]:
                if column not in not_null:
                    not_null.append(column)
        if "notNull" in value:
            selected = set(value["notNull"])
            value["notNull"] = [
                column for column in column_order[table] if column in selected
            ]
        ordered = {
            key: value[key]
            for key in ("notNull", "primaryKey", "foreignKeys")
            if key in value and value[key]
        }
        rows.append({"name": table, "constraints": ordered})
    return rows


def validate_pair_metadata_integrity_subset(
    expected_rows: list[dict[str, Any]], actual_rows: list[dict[str, Any]]
) -> None:
    """Require every pair-metadata declaration in the DDL+metadata contract."""
    actual_by_table = {
        row.get("name"): row.get("constraints")
        for row in actual_rows
        if isinstance(row, dict)
    }
    for row in expected_rows:
        table = row["name"]
        expected = row["constraints"]
        actual = actual_by_table.get(table)
        if not isinstance(actual, dict):
            raise RunnerError(
                "effective integrity contract omits a selected pair constraint table"
            )
        actual_not_null = actual.get("notNull", [])
        if not isinstance(actual_not_null, list) or any(
            column not in actual_not_null for column in expected.get("notNull", [])
        ):
            raise RunnerError(
                "effective integrity contract omits selected pair NOT NULL constraints"
            )
        if "primaryKey" in expected and actual.get("primaryKey") != expected["primaryKey"]:
            raise RunnerError(
                "effective integrity contract differs from a selected pair primary key"
            )
        actual_foreign = actual.get("foreignKeys", [])
        if not isinstance(actual_foreign, list):
            raise RunnerError("effective integrity foreign keys are malformed")
        for foreign in expected.get("foreignKeys", []):
            if not any(
                isinstance(candidate, dict)
                and all(candidate.get(key) == value for key, value in foreign.items())
                for candidate in actual_foreign
            ):
                raise RunnerError(
                    "effective integrity contract omits a selected pair foreign key"
                )


WETUNE_RAW_TYPE_SEMANTICS = (
    "sourceType/sourceDeclaration are authoritative for benchmark semantics; "
    "normalizedFrontendType is a tool-facing lowering."
)
WETUNE_UNIQUE_SEMANTICS = "sql_unique_allows_multiple_nulls"
_INTEGRITY_KEYWORDS = {
    "and",
    "or",
    "not",
    "is",
    "null",
    "true",
    "false",
    "any",
    "array",
    "lower",
    "coalesce",
    "text",
    "integer",
    "int",
    "int4",
    "asc",
    "desc",
    "nulls",
    "first",
    "last",
    "varchar_pattern_ops",
}


def _integrity_tokens(source: str) -> list[tuple[str, str]]:
    tokens: list[tuple[str, str]] = []
    index = 0
    while index < len(source):
        value = source[index]
        if value.isspace():
            index += 1
        elif source.startswith("::", index):
            tokens.append(("cast", "::"))
            index += 2
        elif source.startswith("<>", index) or source.startswith("!=", index):
            tokens.append(("ne", "<>"))
            index += 2
        elif value in "()[],=-":
            tokens.append(
                (
                    {
                        "(": "lp",
                        ")": "rp",
                        "[": "lb",
                        "]": "rb",
                        ",": "comma",
                        "=": "eq",
                        "-": "minus",
                    }[value],
                    value,
                )
            )
            index += 1
        elif value == "'":
            index += 1
            result = []
            while index < len(source):
                if source[index] == "'":
                    if index + 1 < len(source) and source[index + 1] == "'":
                        result.append("'")
                        index += 2
                        continue
                    index += 1
                    break
                result.append(source[index])
                index += 1
            else:
                raise RunnerError("WeTune integrity expression has an unterminated string")
            tokens.append(("string", "".join(result)))
        elif value == '"':
            index += 1
            result = []
            while index < len(source):
                if source[index] == '"':
                    if index + 1 < len(source) and source[index + 1] == '"':
                        result.append('"')
                        index += 2
                        continue
                    index += 1
                    break
                result.append(source[index])
                index += 1
            else:
                raise RunnerError(
                    "WeTune integrity expression has an unterminated identifier"
                )
            tokens.append(("quoted", "".join(result)))
        elif value.isdigit():
            start = index
            while index < len(source) and source[index].isdigit():
                index += 1
            tokens.append(("integer", source[start:index]))
        elif value.isalpha() or value == "_":
            start = index
            index += 1
            while index < len(source) and (
                source[index].isalnum() or source[index] in "_$"
            ):
                index += 1
            tokens.append(("ident", source[start:index].lower()))
        else:
            raise RunnerError(
                f"WeTune integrity expression has unsupported character {value!r}"
            )
    return tokens


def _quote_integrity_identifier(value: str) -> str:
    return '"' + value.replace('"', '""') + '"'


def _renamed_integrity_source(
    source: str, rename: Callable[[str], str]
) -> str:
    rendered = []
    for kind, value in _integrity_tokens(source):
        if kind == "ident":
            rendered.append(
                value.upper()
                if value in _INTEGRITY_KEYWORDS
                else _quote_integrity_identifier(rename(value))
            )
        elif kind == "quoted":
            rendered.append(_quote_integrity_identifier(rename(value)))
        elif kind == "string":
            rendered.append("'" + value.replace("'", "''") + "'")
        else:
            rendered.append(value)
    return " ".join(rendered)


class _IntegrityParser:
    def __init__(
        self, source: str, rename: Callable[[str], str]
    ) -> None:
        self.tokens = _integrity_tokens(source)
        self.position = 0
        self.rename = rename

    def _take(self, kind: str, value: str | None = None) -> bool:
        if self.position >= len(self.tokens):
            return False
        actual_kind, actual_value = self.tokens[self.position]
        if actual_kind != kind or (value is not None and actual_value != value):
            return False
        self.position += 1
        return True

    def _keyword(self, value: str) -> bool:
        return self._take("ident", value.lower())

    def _expect(self, kind: str, value: str | None = None) -> None:
        if not self._take(kind, value):
            raise RunnerError("WeTune integrity expression is outside the closed grammar")

    def value(self) -> dict[str, Any]:
        if self._keyword("lower"):
            self._expect("lp")
            expression = self.value()
            self._expect("rp")
            result: dict[str, Any] = {
                "kind": "lower",
                "expression": expression,
            }
        elif self._keyword("coalesce"):
            self._expect("lp")
            arguments = [self.value()]
            while self._take("comma"):
                arguments.append(self.value())
            self._expect("rp")
            if len(arguments) < 2:
                raise RunnerError("WeTune COALESCE integrity term has too few arguments")
            result = {"kind": "coalesce", "arguments": arguments}
        elif self._take("lp"):
            result = self.value()
            self._expect("rp")
        elif self._take("minus"):
            if self.position >= len(self.tokens) or self.tokens[self.position][0] != "integer":
                raise RunnerError("WeTune integrity unary minus is malformed")
            raw = "-" + self.tokens[self.position][1]
            self.position += 1
            if not -(2**31) <= int(raw) < 2**31:
                raise RunnerError("WeTune integrity integer is outside int4")
            result = {"kind": "literal", "raw": raw, "ty": "integer"}
        elif self.position < len(self.tokens):
            kind, raw = self.tokens[self.position]
            self.position += 1
            if kind == "ident" and raw in {"true", "false"}:
                result = {"kind": "literal", "raw": raw, "ty": "boolean"}
            elif kind in {"ident", "quoted"}:
                result = {"kind": "column", "name": self.rename(raw)}
            elif kind == "string":
                result = {"kind": "literal", "raw": raw, "ty": "text"}
            elif kind == "integer":
                if not -(2**31) <= int(raw) < 2**31:
                    raise RunnerError("WeTune integrity integer is outside int4")
                result = {"kind": "literal", "raw": raw, "ty": "integer"}
            else:
                raise RunnerError("WeTune integrity value is outside the closed grammar")
        else:
            raise RunnerError("WeTune integrity expression ended before a value")

        while self._take("cast"):
            if self.position >= len(self.tokens) or self.tokens[self.position][0] != "ident":
                raise RunnerError("WeTune integrity cast type is malformed")
            target = self.tokens[self.position][1]
            self.position += 1
            if target == "text":
                ty = "text"
            elif target in {"integer", "int", "int4"}:
                ty = "integer"
            else:
                raise RunnerError("WeTune integrity cast type is unsupported")
            if (
                ty == "integer"
                and result.get("kind") == "literal"
                and result.get("ty") == "text"
            ):
                try:
                    parsed = int(result["raw"])
                except ValueError as error:
                    raise RunnerError(
                        "WeTune integrity integer literal cast is malformed"
                    ) from error
                if not -(2**31) <= parsed < 2**31:
                    raise RunnerError("WeTune integrity integer is outside int4")
                result = {"kind": "literal", "raw": str(parsed), "ty": "integer"}
            else:
                result = {"kind": "cast", "expression": result, "ty": ty}
        return result

    def predicate(self) -> dict[str, Any]:
        result = self._parse_or()
        if self.position != len(self.tokens):
            raise RunnerError("WeTune integrity predicate has trailing tokens")
        return result

    def _parse_or(self) -> dict[str, Any]:
        result = self._parse_and()
        while self._keyword("or"):
            result = {"kind": "or", "left": result, "right": self._parse_and()}
        return result

    def _parse_and(self) -> dict[str, Any]:
        result = self._parse_not()
        while self._keyword("and"):
            result = {"kind": "and", "left": result, "right": self._parse_not()}
        return result

    def _parse_not(self) -> dict[str, Any]:
        if self._keyword("not"):
            return {"kind": "not", "predicate": self._parse_not()}
        return self._predicate_atom()

    def _predicate_atom(self) -> dict[str, Any]:
        saved = self.position
        try:
            left = self.value()
        except RunnerError:
            self.position = saved
        else:
            if self._keyword("is"):
                negate = self._keyword("not")
                if self._keyword("null"):
                    return {
                        "kind": "is_not_null" if negate else "is_null",
                        "expression": left,
                    }
                if not negate and self._keyword("true"):
                    return {"kind": "is_true", "expression": left}
                raise RunnerError("WeTune IS predicate is outside the closed grammar")
            comparison = None
            if self._take("eq"):
                comparison = "equal"
            elif self._take("ne"):
                comparison = "not_equal"
            if comparison is not None:
                if self._keyword("any"):
                    self._expect("lp")
                    if not self._keyword("array"):
                        raise RunnerError("WeTune ANY predicate lacks ARRAY")
                    self._expect("lb")
                    values = []
                    if not self._take("rb"):
                        while True:
                            values.append(self.value())
                            if self._take("comma"):
                                continue
                            self._expect("rb")
                            break
                    self._expect("rp")
                    if not values:
                        raise RunnerError("WeTune ANY predicate has an empty array")
                    return {
                        "kind": "any",
                        "comparison": comparison,
                        "left": left,
                        "values": values,
                    }
                return {
                    "kind": "comparison",
                    "comparison": comparison,
                    "left": left,
                    "right": self.value(),
                }
            return {"kind": "truth", "expression": left}
        self._expect("lp")
        result = self._parse_or()
        self._expect("rp")
        return result

    def unique_term(self, source: str) -> dict[str, Any]:
        expression = self.value()
        operator_class = (
            "varchar_pattern_ops"
            if self._keyword("varchar_pattern_ops")
            else None
        )
        direction = "asc"
        if self._keyword("asc"):
            direction = "asc"
        elif self._keyword("desc"):
            direction = "desc"
        nulls = None
        if self._keyword("nulls"):
            if self._keyword("first"):
                nulls = "first"
            elif self._keyword("last"):
                nulls = "last"
            else:
                raise RunnerError("WeTune unique-index NULLS order is malformed")
        if self.position != len(self.tokens):
            raise RunnerError("WeTune unique-index term has trailing tokens")
        result = {
            "expression": expression,
            "sourceSql": _renamed_integrity_source(source, self.rename),
            "direction": direction,
        }
        if nulls is not None:
            result["nulls"] = nulls
        if operator_class is not None:
            result["operatorClass"] = operator_class
        return result


def _strict_sidecar_object(value: Any, keys: set[str], label: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != keys:
        raise RunnerError(f"WeTune sidecar {label} schema is not strict")
    return value


def _sidecar_string(value: Any, label: str, *, allow_empty: bool = False) -> str:
    if not isinstance(value, str) or (not allow_empty and not value):
        raise RunnerError(f"WeTune sidecar {label} must be a string")
    return value


def _sidecar_string_array(
    value: Any, label: str, *, allow_empty: bool = False
) -> list[str]:
    if (
        not isinstance(value, list)
        or (not allow_empty and not value)
        or any(not isinstance(item, str) or not item for item in value)
        or len(value) != len(set(value))
    ):
        raise RunnerError(f"WeTune sidecar {label} must contain unique strings")
    return value


def _expression_uses_string(
    value: dict[str, Any], column_types: dict[str, str]
) -> bool:
    kind = value.get("kind")
    if kind == "column":
        ty = column_types.get(value["name"], "")
        return any(marker in ty.upper() for marker in ("CHAR", "TEXT", "STRING"))
    if kind == "literal":
        return value.get("ty") == "text"
    if kind == "cast":
        return value.get("ty") == "text" or _expression_uses_string(
            value["expression"], column_types
        )
    if kind == "lower":
        return True
    if kind == "coalesce":
        return any(
            _expression_uses_string(argument, column_types)
            for argument in value["arguments"]
        )
    return False


def _predicate_uses_string(
    value: dict[str, Any], column_types: dict[str, str]
) -> bool:
    kind = value.get("kind")
    if kind in {"truth", "is_true", "is_null", "is_not_null"}:
        return _expression_uses_string(value["expression"], column_types)
    if kind == "comparison":
        return _expression_uses_string(
            value["left"], column_types
        ) or _expression_uses_string(value["right"], column_types)
    if kind == "any":
        return _expression_uses_string(
            value["left"], column_types
        ) or any(
            _expression_uses_string(item, column_types) for item in value["values"]
        )
    if kind in {"and", "or"}:
        return _predicate_uses_string(
            value["left"], column_types
        ) or _predicate_uses_string(value["right"], column_types)
    if kind == "not":
        return _predicate_uses_string(value["predicate"], column_types)
    return False


def _ir_sql_type_is_string(value: Any) -> bool:
    if isinstance(value, str):
        return value in {"text", "varchar", "char", "bpchar"}
    if isinstance(value, dict) and isinstance(value.get("kind"), str):
        return value["kind"] in {"text", "varchar", "char", "bpchar"}
    raise RunnerError("schema IR SQL type is malformed")


def _ir_integrity_expression_is_string(
    value: Any, column_types: dict[str, Any]
) -> bool:
    if not isinstance(value, dict) or not isinstance(value.get("kind"), str):
        raise RunnerError("schema IR integrity expression is malformed")
    kind = value["kind"]
    if kind == "column":
        name = value.get("name")
        if not isinstance(name, str) or name not in column_types:
            raise RunnerError("schema IR integrity expression names an unknown column")
        return _ir_sql_type_is_string(column_types[name])
    if kind == "literal":
        return _ir_sql_type_is_string(value.get("ty"))
    if kind == "cast":
        return _ir_sql_type_is_string(value.get("ty"))
    if kind == "lower":
        if not _ir_integrity_expression_is_string(
            value.get("expression"), column_types
        ):
            raise RunnerError("schema IR lower expression is not string-valued")
        return True
    if kind == "coalesce":
        arguments = value.get("arguments")
        if not isinstance(arguments, list) or not arguments:
            raise RunnerError("schema IR coalesce expression is malformed")
        return any(
            _ir_integrity_expression_is_string(argument, column_types)
            for argument in arguments
        )
    raise RunnerError("schema IR integrity expression kind is unsupported")


def _ir_integrity_predicate_uses_string(
    value: Any, column_types: dict[str, Any]
) -> bool:
    if not isinstance(value, dict) or not isinstance(value.get("kind"), str):
        raise RunnerError("schema IR integrity predicate is malformed")
    kind = value["kind"]
    if kind in {"truth", "is_true", "is_null", "is_not_null"}:
        return _ir_integrity_expression_is_string(
            value.get("expression"), column_types
        )
    if kind == "comparison":
        return _ir_integrity_expression_is_string(
            value.get("left"), column_types
        ) or _ir_integrity_expression_is_string(value.get("right"), column_types)
    if kind == "any":
        values = value.get("values")
        if not isinstance(values, list) or not values:
            raise RunnerError("schema IR ANY predicate is malformed")
        return _ir_integrity_expression_is_string(
            value.get("left"), column_types
        ) or any(
            _ir_integrity_expression_is_string(item, column_types) for item in values
        )
    if kind in {"and", "or"}:
        return _ir_integrity_predicate_uses_string(
            value.get("left"), column_types
        ) or _ir_integrity_predicate_uses_string(value.get("right"), column_types)
    if kind == "not":
        return _ir_integrity_predicate_uses_string(
            value.get("predicate"), column_types
        )
    raise RunnerError("schema IR integrity predicate kind is unsupported")


def schema_ir_requires_postgres_utf8_c_text_semantics(
    schema_ir: dict[str, Any]
) -> bool:
    """Mirror the Rust full-schema text-integrity environment calculation."""
    schema_tables = schema_ir.get("tables")
    if not isinstance(schema_tables, list):
        raise RunnerError("schema IR table catalog is malformed")
    table_columns: dict[str, dict[str, Any]] = {}
    for table in schema_tables:
        if not isinstance(table, dict) or not isinstance(table.get("name"), str):
            raise RunnerError("schema IR table identity is malformed")
        columns = table.get("columns")
        if not isinstance(columns, list):
            raise RunnerError("schema IR table columns are malformed")
        types: dict[str, Any] = {}
        for column in columns:
            if (
                not isinstance(column, dict)
                or not isinstance(column.get("name"), str)
                or "ty" not in column
            ):
                raise RunnerError("schema IR column type is malformed")
            _ir_sql_type_is_string(column["ty"])
            types[column["name"]] = column["ty"]
        table_columns[table["name"]] = types

    def string_column(types: dict[str, Any], name: Any) -> bool:
        if not isinstance(name, str) or name not in types:
            raise RunnerError("schema IR integrity constraint names an unknown column")
        return _ir_sql_type_is_string(types[name])

    for table in schema_tables:
        table_name = table["name"]
        types = table_columns[table_name]
        constraints = table.get("constraints", {})
        if not isinstance(constraints, dict):
            raise RunnerError("schema IR table constraints are malformed")
        primary_key = constraints.get("primaryKey", [])
        if not isinstance(primary_key, list):
            raise RunnerError("schema IR primary key is malformed")
        if any(string_column(types, column) for column in primary_key):
            return True
        unique_constraints = constraints.get("unique", [])
        if not isinstance(unique_constraints, list):
            raise RunnerError("schema IR unique constraints are malformed")
        for unique in unique_constraints:
            columns = unique.get("columns") if isinstance(unique, dict) else None
            if not isinstance(columns, list):
                raise RunnerError("schema IR unique constraint is malformed")
            if any(string_column(types, column) for column in columns):
                return True
        foreign_keys = constraints.get("foreignKeys", [])
        if not isinstance(foreign_keys, list):
            raise RunnerError("schema IR foreign keys are malformed")
        for foreign in foreign_keys:
            if not isinstance(foreign, dict):
                raise RunnerError("schema IR foreign key is malformed")
            columns = foreign.get("columns")
            referenced_table = foreign.get("referencedTable")
            referenced_columns = foreign.get("referencedColumns")
            if (
                not isinstance(columns, list)
                or not isinstance(referenced_table, str)
                or referenced_table not in table_columns
                or not isinstance(referenced_columns, list)
            ):
                raise RunnerError("schema IR foreign key endpoint is malformed")
            if any(string_column(types, column) for column in columns) or any(
                string_column(table_columns[referenced_table], column)
                for column in referenced_columns
            ):
                return True
        checks = constraints.get("checks", [])
        if not isinstance(checks, list):
            raise RunnerError("schema IR checks are malformed")
        for check in checks:
            if not isinstance(check, dict) or _ir_integrity_predicate_uses_string(
                check.get("expression"), types
            ):
                if not isinstance(check, dict):
                    raise RunnerError("schema IR check is malformed")
                return True
        indexes = constraints.get("uniqueIndexes", [])
        if not isinstance(indexes, list):
            raise RunnerError("schema IR unique indexes are malformed")
        for index in indexes:
            if not isinstance(index, dict) or not isinstance(index.get("terms"), list):
                raise RunnerError("schema IR unique index is malformed")
            if any(
                not isinstance(term, dict)
                or _ir_integrity_expression_is_string(term.get("expression"), types)
                for term in index["terms"]
            ):
                if any(not isinstance(term, dict) for term in index["terms"]):
                    raise RunnerError("schema IR unique index term is malformed")
                return True
            predicate = index.get("predicate")
            if predicate is not None and _ir_integrity_predicate_uses_string(
                predicate, types
            ):
                return True
    return False


def _wetune_expected_integrity_tables(
    metadata: dict[str, Any], sidecar: dict[str, Any]
) -> tuple[list[dict[str, Any]], bool]:
    renamed = metadata.get("renamedIdentifiers")
    if (
        not isinstance(renamed, dict)
        or any(
            not isinstance(key, str)
            or not key
            or not isinstance(value, str)
            or not value
            for key, value in renamed.items()
        )
    ):
        raise RunnerError("WeTune identifier-renaming authority is malformed")
    def rename(value: str) -> str:
        folded = value.lower()
        return renamed.get(value, renamed.get(folded, folded))
    schema = _strict_sidecar_object(
        sidecar["semanticSchema"], {"tables", "typeSemantics"}, "semanticSchema"
    )
    if schema["typeSemantics"] != WETUNE_RAW_TYPE_SEMANTICS:
        raise RunnerError("WeTune sidecar raw-type authority drifted")
    semantic_tables = schema.get("tables")
    if not isinstance(semantic_tables, list):
        raise RunnerError("WeTune sidecar semantic tables are malformed")

    catalog: dict[str, dict[str, dict[str, Any]]] = {}
    expected: dict[str, dict[str, Any]] = {}
    column_types: dict[str, dict[str, str]] = {}
    for table_index, raw_table in enumerate(semantic_tables):
        table = _strict_sidecar_object(
            raw_table, {"name", "columns"}, f"semanticSchema.tables[{table_index}]"
        )
        source_name = _sidecar_string(table["name"], "semantic table name")
        if source_name in catalog:
            raise RunnerError("WeTune sidecar repeats a semantic table")
        target_name = rename(source_name)
        if target_name in expected:
            raise RunnerError("WeTune table renames collide")
        columns = table["columns"]
        if not isinstance(columns, list):
            raise RunnerError("WeTune semantic table columns are malformed")
        source_columns: dict[str, dict[str, Any]] = {}
        target_types: dict[str, str] = {}
        not_null: list[str] = []
        for column_index, raw_column in enumerate(columns):
            column = _strict_sidecar_object(
                raw_column,
                {
                    "autoIncrement",
                    "default",
                    "generated",
                    "inlinePrimary",
                    "inlineUnique",
                    "name",
                    "normalizedFrontendType",
                    "notNull",
                    "nullable",
                    "sourceDeclaration",
                    "sourceType",
                },
                f"semantic column {table_index}:{column_index}",
            )
            source_column = _sidecar_string(column["name"], "semantic column name")
            if source_column in source_columns:
                raise RunnerError("WeTune sidecar repeats a semantic column")
            for field in (
                "normalizedFrontendType",
                "sourceDeclaration",
                "sourceType",
            ):
                _sidecar_string(column[field], f"semantic column {field}")
            for field in (
                "autoIncrement",
                "generated",
                "inlinePrimary",
                "inlineUnique",
                "notNull",
                "nullable",
            ):
                if not isinstance(column[field], bool):
                    raise RunnerError("WeTune semantic column Boolean is malformed")
            if (
                column["generated"]
                or column["inlinePrimary"]
                or column["inlineUnique"]
                or column["nullable"] == column["notNull"]
                or not (
                    column["default"] is None
                    or isinstance(column["default"], str)
                )
            ):
                raise RunnerError("WeTune semantic column authority is unsupported")
            target_column = rename(source_column)
            if target_column in target_types:
                raise RunnerError("WeTune column renames collide")
            source_columns[source_column] = column
            target_types[target_column] = column["normalizedFrontendType"]
            if column["notNull"]:
                not_null.append(target_column)
        catalog[source_name] = source_columns
        column_types[target_name] = target_types
        expected[target_name] = {"notNull": not_null}

    def references(table: str, columns: list[str], label: str) -> None:
        if table not in catalog or any(
            column not in catalog[table] for column in columns
        ):
            raise RunnerError(f"WeTune {label} references an unknown table/column")

    def target(table: str) -> dict[str, Any]:
        if table not in catalog:
            raise RunnerError("WeTune constraint references an unknown table")
        return expected[rename(table)]

    for index, raw in enumerate(sidecar["primaryKeys"]):
        key = _strict_sidecar_object(
            raw, {"table", "columns"}, f"primaryKeys[{index}]"
        )
        table = _sidecar_string(key["table"], "primary-key table")
        columns = _sidecar_string_array(key["columns"], "primary-key columns")
        references(table, columns, "primary key")
        renamed_columns = [rename(column) for column in columns]
        constraints = target(table)
        if (
            "primaryKey" in constraints
            and constraints["primaryKey"] != renamed_columns
        ):
            raise RunnerError("WeTune sidecar has conflicting primary keys")
        constraints["primaryKey"] = renamed_columns

    for index, raw in enumerate(sidecar["uniqueKeys"]):
        key = _strict_sidecar_object(
            raw,
            {"table", "columns", "nullableColumns", "semantics"},
            f"uniqueKeys[{index}]",
        )
        table = _sidecar_string(key["table"], "unique-key table")
        columns = _sidecar_string_array(key["columns"], "unique-key columns")
        nullable = _sidecar_string_array(
            key["nullableColumns"], "unique nullable columns", allow_empty=True
        )
        references(table, columns, "unique key")
        expected_nullable = [
            column for column in columns if catalog[table][column]["nullable"]
        ]
        if (
            key["semantics"] != WETUNE_UNIQUE_SEMANTICS
            or nullable != expected_nullable
        ):
            raise RunnerError("WeTune UNIQUE null semantics drifted")
        entry = {"columns": [rename(column) for column in columns]}
        values = target(table).setdefault("unique", [])
        if not values or values[-1] != entry:
            values.append(entry)

    for index, raw in enumerate(sidecar["foreignKeys"]):
        foreign = _strict_sidecar_object(
            raw,
            {"table", "columns", "refTable", "refColumns", "source", "actions"},
            f"foreignKeys[{index}]",
        )
        table = _sidecar_string(foreign["table"], "foreign-key table")
        columns = _sidecar_string_array(
            foreign["columns"], "foreign-key columns"
        )
        ref_table = _sidecar_string(
            foreign["refTable"], "foreign-key referenced table"
        )
        ref_columns = _sidecar_string_array(
            foreign["refColumns"], "foreign-key referenced columns"
        )
        references(table, columns, "foreign key")
        references(ref_table, ref_columns, "foreign key target")
        actions = _sidecar_string(
            foreign["actions"], "foreign-key actions", allow_empty=True
        )
        if (
            len(columns) != len(ref_columns)
            or foreign["source"] not in {"alter_table", "create_table"}
            or actions
            not in {
                "",
                "ON DELETE CASCADE",
                "ON DELETE CASCADE ON UPDATE CASCADE",
                "ON DELETE RESTRICT",
                "ON DELETE SET NULL",
            }
        ):
            raise RunnerError("WeTune foreign-key authority is malformed")
        entry = {
            "columns": [rename(column) for column in columns],
            "referencedTable": rename(ref_table),
            "referencedColumns": [rename(column) for column in ref_columns],
            "matchType": "simple",
        }
        if actions:
            entry["referentialActions"] = actions
        values = target(table).setdefault("foreignKeys", [])
        signature = {
            key: entry[key]
            for key in (
                "columns",
                "referencedTable",
                "referencedColumns",
                "matchType",
            )
        }
        prior_signature = (
            {
                key: values[-1][key]
                for key in (
                    "columns",
                    "referencedTable",
                    "referencedColumns",
                    "matchType",
                )
            }
            if values
            else None
        )
        if prior_signature != signature:
            values.append(entry)

    for index, raw in enumerate(sidecar["checks"]):
        check = _strict_sidecar_object(
            raw, {"table", "expression", "source"}, f"checks[{index}]"
        )
        table = _sidecar_string(check["table"], "check table")
        source = _sidecar_string(check["expression"], "check expression")
        if check["source"] != "create_table":
            raise RunnerError("WeTune CHECK source is unsupported")
        references(table, [], "check")
        expression = _IntegrityParser(source, rename).predicate()
        entry = {
            "expression": expression,
            "sourceSql": _renamed_integrity_source(source, rename),
        }
        values = target(table).setdefault("checks", [])
        if not values or values[-1]["expression"] != expression:
            values.append(entry)

    for index, raw in enumerate(sidecar["uniqueIndexes"]):
        unique_index = _strict_sidecar_object(
            raw,
            {"table", "terms", "where", "source"},
            f"uniqueIndexes[{index}]",
        )
        table = _sidecar_string(unique_index["table"], "unique-index table")
        terms = _sidecar_string_array(
            unique_index["terms"], "unique-index terms"
        )
        predicate_source = _sidecar_string(
            unique_index["where"],
            "unique-index predicate",
            allow_empty=True,
        )
        if unique_index["source"] != "create_unique_index":
            raise RunnerError("WeTune unique-index source is unsupported")
        references(table, [], "unique index")
        parsed_terms = [
            _IntegrityParser(term, rename).unique_term(term) for term in terms
        ]
        entry: dict[str, Any] = {"terms": parsed_terms}
        predicate = None
        if predicate_source:
            predicate = _IntegrityParser(predicate_source, rename).predicate()
            entry["predicate"] = predicate
            entry["predicateSql"] = _renamed_integrity_source(
                predicate_source, rename
            )
        values = target(table).setdefault("uniqueIndexes", [])
        if (
            not values
            or values[-1]["terms"] != parsed_terms
            or values[-1].get("predicate") != predicate
        ):
            values.append(entry)

    for constraints in expected.values():
        if "primaryKey" in constraints:
            constraints["notNull"].extend(
                column
                for column in constraints["primaryKey"]
                if column not in constraints["notNull"]
            )
        constraints["notNull"] = list(dict.fromkeys(constraints["notNull"]))
        if not constraints["notNull"]:
            constraints.pop("notNull")

    uses_string = False
    for table_name, constraints in expected.items():
        types = column_types[table_name]
        constrained_columns = list(constraints.get("primaryKey", []))
        constrained_columns.extend(
            column
            for unique in constraints.get("unique", [])
            for column in unique["columns"]
        )
        if any(
            any(marker in types.get(column, "").upper() for marker in ("CHAR", "TEXT", "STRING"))
            for column in constrained_columns
        ):
            uses_string = True
        for foreign in constraints.get("foreignKeys", []):
            referenced_types = column_types[foreign["referencedTable"]]
            if any(
                any(marker in types.get(column, "").upper() for marker in ("CHAR", "TEXT", "STRING"))
                for column in foreign["columns"]
            ) or any(
                any(
                    marker in referenced_types.get(column, "").upper()
                    for marker in ("CHAR", "TEXT", "STRING")
                )
                for column in foreign["referencedColumns"]
            ):
                uses_string = True
        if any(
            _predicate_uses_string(check["expression"], types)
            for check in constraints.get("checks", [])
        ):
            uses_string = True
        for unique_index in constraints.get("uniqueIndexes", []):
            if any(
                _expression_uses_string(term["expression"], types)
                for term in unique_index["terms"]
            ) or (
                unique_index.get("predicate") is not None
                and _predicate_uses_string(unique_index["predicate"], types)
            ):
                uses_string = True

    order = (
        "notNull",
        "primaryKey",
        "unique",
        "foreignKeys",
        "checks",
        "uniqueIndexes",
    )
    return (
        [
            {
                "name": name,
                "constraints": {
                    key: expected[name][key] for key in order if key in expected[name]
                },
            }
            for name in sorted(expected)
        ],
        uses_string,
    )


def validate_effective_integrity_contract(
    metadata: dict[str, Any],
    integrity: dict[str, Any],
    semantic_sidecar: dict[str, Any] | None,
    schema_ir: dict[str, Any],
) -> None:
    actual_tables = integrity.get("tables", [])
    if not isinstance(actual_tables, list):
        raise RunnerError("effective integrity contract tables are malformed")
    if actual_tables != schema_ir_integrity_tables(schema_ir):
        raise RunnerError(
            "effective integrity contract differs from accepted schema IR constraints"
        )
    expected_string_semantics = schema_ir_requires_postgres_utf8_c_text_semantics(
        schema_ir
    )
    if (
        integrity.get("requiresPostgresUtf8CTextSemantics", False)
        is not expected_string_semantics
    ):
        raise RunnerError(
            "effective integrity text-semantics authority differs from accepted schema IR"
        )
    if semantic_sidecar is None:
        validate_pair_metadata_integrity_subset(
            pair_metadata_integrity_tables(metadata, schema_ir), actual_tables
        )
        return

    semantic = metadata.get("semanticConstraints")
    renamed = metadata.get("renamedIdentifiers")
    if not isinstance(semantic, dict) or not isinstance(renamed, dict):
        raise RunnerError("WeTune semantic metadata authority is malformed")
    sidecar_keys = {
        "checks",
        "foreignKeys",
        "primaryKeys",
        "semanticSchema",
        "uniqueIndexes",
        "uniqueKeys",
        "unsupportedSemanticConstraints",
    }
    if set(semantic_sidecar) != sidecar_keys:
        raise RunnerError("WeTune semantic sidecar schema is not strict")
    for key in (
        "checks",
        "foreignKeys",
        "primaryKeys",
        "uniqueIndexes",
        "uniqueKeys",
        "unsupportedSemanticConstraints",
    ):
        values = semantic_sidecar.get(key)
        if not isinstance(values, list):
            raise RunnerError("WeTune semantic sidecar constraint array is malformed")
        if key != "unsupportedSemanticConstraints" and semantic.get(key) != len(values):
            raise RunnerError("WeTune semantic constraint count differs from sidecar")
    if semantic_sidecar["unsupportedSemanticConstraints"]:
        raise RunnerError("WeTune sidecar contains unsupported semantic constraints")
    schema = semantic_sidecar.get("semanticSchema")
    semantic_tables = schema.get("tables") if isinstance(schema, dict) else None
    if not isinstance(semantic_tables, list):
        raise RunnerError("WeTune sidecar semantic schema is malformed")
    if semantic.get("columns") != sum(
        len(table.get("columns", []))
        for table in semantic_tables
        if isinstance(table, dict) and isinstance(table.get("columns"), list)
    ):
        raise RunnerError("WeTune semantic column count differs from sidecar")
    expected_tables, expected_string_semantics = (
        _wetune_expected_integrity_tables(metadata, semantic_sidecar)
    )
    if (
        any(
            not isinstance(row, dict)
            or set(row) != {"name", "constraints"}
            or not isinstance(row.get("name"), str)
            or not row["name"]
            or not isinstance(row.get("constraints"), dict)
            for row in actual_tables
        )
        or len({row["name"] for row in actual_tables}) != len(actual_tables)
    ):
        raise RunnerError("effective WeTune integrity table rows are malformed")
    canonical_actual = sorted(actual_tables, key=lambda row: row["name"])
    if canonical_actual != expected_tables:
        raise RunnerError(
            "effective WeTune integrity contract differs from the exact renamed sidecar"
        )
    if (
        integrity.get("requiresPostgresUtf8CTextSemantics", False)
        is not expected_string_semantics
    ):
        raise RunnerError(
            "effective WeTune PostgreSQL text-semantics authority differs from sidecar"
        )


def validate_case_input_and_lowering_authority(
    case_dir: Path,
    case: BenchmarkCase,
    config: RunConfig,
    *,
    require_lowering: bool,
    context_root: Path | None = None,
    reported_problem_module_bytes: Any = None,
) -> dict[str, Any]:
    """Bind generated semantic artifacts to this selected runner case."""
    input_root = case_dir / "input"
    require_real_directory_chain(case_dir, input_root, "solver input artifacts")
    verification_path = input_root / "verification-input.json"
    integrity_path = input_root / "integrity-contract.json"
    verification = read_json_object(
        verification_path, "verification-input artifact"
    )
    if set(verification) != {
        "sqlEnvironment",
        "integrityContract",
        "schema",
        "sourceQuery",
        "targetQuery",
    }:
        raise RunnerError("verification-input artifact schema is not strict")
    integrity = read_json_object(integrity_path, "integrity-contract artifact")
    if verification.get("integrityContract") != integrity:
        raise RunnerError("verification input differs from integrity-contract artifact")
    schema_ir_path = input_root / "schema-ir.json"
    schema_ir: dict[str, Any] | None = None
    if schema_ir_path.exists():
        require_regular_nonsymlink_file(schema_ir_path, "schema IR artifact")
        schema_ir = read_json_object(schema_ir_path, "schema IR artifact")
    elif require_lowering:
        require_regular_nonsymlink_file(schema_ir_path, "schema IR artifact")
    frozen = config.input_files[case.case_id]
    metadata_path = case.input_dir / "metadata.json"
    require_regular_nonsymlink_file(metadata_path, "selected case metadata")
    metadata_record = frozen.get("metadata")
    if not isinstance(metadata_record, dict) or set(metadata_record) != {
        "path",
        "sha256",
    } or (
        metadata_record.get("path") != workspace_display_path(metadata_path)
        or metadata_record.get("sha256") != sha256_file(metadata_path)
    ):
        raise RunnerError("selected case metadata binding drifted")
    metadata = read_json_object(metadata_path, "selected case metadata")
    semantic_case_id = optional_string(metadata.get("flatCaseId"))
    if semantic_case_id is None or semantic_case_id != case.flat_case_id:
        raise RunnerError("selected case has no bound semantic flatCaseId")
    integrity_case_id = integrity.get("caseId")
    if integrity_case_id != semantic_case_id:
        raise RunnerError("verification input integrity caseId identifies another case")
    integrity_source = integrity.get("source")
    if not isinstance(integrity_source, str) or not integrity_source:
        raise RunnerError("verification input integrity source is missing")
    declared_contract = metadata.get("integrityContract")
    semantic_sidecar = (
        declared_contract.get("semanticSidecar")
        if isinstance(declared_contract, dict)
        else None
    )
    semantic_sidecar_document: dict[str, Any] | None = None
    if semantic_sidecar is not None:
        semantic_constraints = metadata.get("semanticConstraints")
        if (
            declared_contract.get("sourceKind")
            != "wetune_base_schema_sidecar"
            or declared_contract.get("authoritativeForLogos") is not True
            or declared_contract.get("sidecarAuthority")
            != "integrity_declarations_only"
            or not isinstance(semantic_sidecar, str)
            or not semantic_sidecar
            or not isinstance(semantic_constraints, dict)
            or semantic_constraints.get("source") != semantic_sidecar
        ):
            raise RunnerError("declared semantic sidecar authority is malformed")
        sidecar_path = resolve_path(semantic_sidecar)
        require_regular_nonsymlink_file(sidecar_path, "semantic integrity sidecar")
        sidecar_record = frozen.get("semanticSidecar")
        if not isinstance(sidecar_record, dict) or set(sidecar_record) != {
            "path",
            "sha256",
        } or (
            sidecar_record.get("path") != workspace_display_path(sidecar_path)
            or sidecar_record.get("sha256") != sha256_file(sidecar_path)
        ):
            raise RunnerError("selected semantic sidecar binding drifted")
        semantic_sidecar_document = read_json_object(
            sidecar_path, "semantic integrity sidecar"
        )
        if resolve_path(integrity_source) != sidecar_path:
            raise RunnerError("verification integrity source differs from semantic sidecar")
    elif Path(integrity_source).resolve() != metadata_path.resolve():
        raise RunnerError("verification integrity source differs from selected metadata")
    if not {"caseId", "source"} <= set(integrity) or not set(integrity) <= {
        "caseId",
        "source",
        "tables",
        "requiresPostgresUtf8CTextSemantics",
    }:
        raise RunnerError("effective integrity contract schema is not strict")
    if schema_ir is not None:
        validate_effective_integrity_contract(
            metadata, integrity, semantic_sidecar_document, schema_ir
        )

    expected_environment = expected_artifact_sql_environment(config)
    if verification.get("sqlEnvironment") != expected_environment:
        raise RunnerError("verification input SQL environment differs from runner policy")
    input_components = (
        ("schema", "schema", case.schema),
        ("sourceQuery", "source", case.source),
        ("targetQuery", "target", case.target),
    )
    sql_digests: dict[str, str] = {}
    for artifact_key, frozen_key, selected_path in input_components:
        component = verification.get(artifact_key)
        require_regular_nonsymlink_file(
            selected_path, f"selected {frozen_key} SQL input"
        )
        if (
            not isinstance(component, dict)
            or set(component) != {"path", "sql"}
            or not isinstance(component.get("path"), str)
            or Path(component["path"]).resolve() != selected_path.resolve()
            or not isinstance(component.get("sql"), str)
        ):
            raise RunnerError(
                f"verification input {artifact_key} binding is malformed"
            )
        sql_bytes = component["sql"].encode("utf-8")
        digest = hashlib.sha256(sql_bytes).hexdigest()
        if (
            sql_bytes != selected_path.read_bytes()
            or digest != frozen[frozen_key]["sha256"]
            or sha256_file(selected_path) != frozen[frozen_key]["sha256"]
        ):
            raise RunnerError(
                f"verification input {artifact_key} SQL identifies another case"
            )
        sql_digests[frozen_key] = digest

    lowering_path = case_dir / "proof-stage/formal-sql-lowering.json"
    if not lowering_path.exists() and not require_lowering:
        return verification
    require_regular_nonsymlink_file(lowering_path, "FormalSQL lowering artifact")
    lowering = read_json_object(lowering_path, "FormalSQL lowering artifact")
    bindings = lowering.get("inputBindings")
    binding_keys = {
        "schemaVersion",
        "schemaSqlSha256",
        "sourceSqlSha256",
        "targetSqlSha256",
        "verificationInputSha256",
        "integrityContractSha256",
        "schemaIrSha256",
        "sourceIrSha256",
        "targetIrSha256",
    }
    if integrity_case_id is not None:
        binding_keys.add("caseId")
    if (
        not isinstance(bindings, dict)
        or set(bindings) != binding_keys
        or bindings.get("schemaVersion") != 1
        or bindings.get("caseId") != integrity_case_id
        or lowering.get("sqlEnvironment") != expected_environment
    ):
        raise RunnerError("FormalSQL lowering input bindings are malformed")
    artifact_digest_paths = {
        "verificationInputSha256": verification_path,
        "integrityContractSha256": integrity_path,
        "schemaIrSha256": schema_ir_path,
        "sourceIrSha256": input_root / "source-ir.json",
        "targetIrSha256": input_root / "target-ir.json",
    }
    expected_binding_values = {
        "schemaSqlSha256": sql_digests["schema"],
        "sourceSqlSha256": sql_digests["source"],
        "targetSqlSha256": sql_digests["target"],
    }
    for binding_key, path in artifact_digest_paths.items():
        require_regular_nonsymlink_file(path, f"lowering-bound {path.name}")
        expected_binding_values[binding_key] = sha256_file(path)
    if any(
        bindings.get(key) != expected
        for key, expected in expected_binding_values.items()
    ):
        raise RunnerError("FormalSQL lowering input binding digest drifted")

    if context_root is not None:
        schema_lowering = lowering.get("schema")
        schema_module = (
            schema_lowering.get("schema")
            if isinstance(schema_lowering, dict)
            else None
        )
        module_bindings = (
            ("Schema.v", schema_module, "schema"),
            ("Queries.v", lowering.get("queryModule"), "query"),
            ("Goal.v", lowering.get("goalModule"), "goal"),
        )
        for filename, module, label in module_bindings:
            rocq_module = module.get("rocqModule") if isinstance(module, dict) else None
            if not isinstance(rocq_module, str):
                raise RunnerError(f"FormalSQL lowering {label} module is missing")
            module_path = context_root / filename
            require_regular_nonsymlink_file(
                module_path, f"lowering-bound {filename}"
            )
            if module_path.read_bytes() != rocq_module.encode("utf-8"):
                raise RunnerError(
                    f"context {filename} differs from FormalSQL lowering"
                )
        proof_module = lowering.get("proofModule")
        proof_rocq = (
            proof_module.get("rocqModule")
            if isinstance(proof_module, dict)
            else None
        )
        if (
            not isinstance(proof_rocq, str)
            or reported_problem_module_bytes != len(proof_rocq.encode("utf-8"))
        ):
            raise RunnerError(
                "context generated Problem.v byte count differs from FormalSQL lowering"
            )
    return verification


PROOF_CONTEXT_REPORT_KEYS = {
    "manifestPath",
    "manifestSha256",
    "manifestBytes",
    "sourceSqlSha256",
    "sourceSqlBytes",
    "targetSqlSha256",
    "targetSqlBytes",
    "queryShapeSha256",
    "queryShapeBytes",
    "orderedSignaturesSha256",
    "orderedSignaturesBytes",
    "observationCertificatesSha256",
    "observationCertificatesBytes",
    "schemaModuleSha256",
    "schemaModuleBytes",
    "queriesModuleSha256",
    "queriesModuleBytes",
    "witnessModuleSha256",
    "witnessModuleBytes",
    "problemModuleBytes",
    "goalModuleBytes",
    "semanticPrimerBytes",
    "declarationSearchSha256",
    "declarationSearchBytes",
    "generatedContextBytes",
}


def validate_context_manifest_at_root(
    root: Path,
    manifest: Any,
    case: BenchmarkCase,
    config: RunConfig,
    static_prompt_and_primer_bytes: Any,
    description: str,
    *,
    report: dict[str, Any] | None = None,
) -> dict[str, Any]:
    static_bytes = nonnegative_integer(
        static_prompt_and_primer_bytes, "staticPromptAndPrimerBytes"
    )
    expected_manifest_keys = {
        "schemaVersion",
        "authority",
        "verificationMode",
        "staticPromptAndPrimerBytes",
        *PROOF_CONTEXT_BINDINGS,
    }
    if (
        set(manifest) != expected_manifest_keys
        or manifest.get("schemaVersion") != 8
        or manifest.get("authority") != PROOF_CONTEXT_AUTHORITY
        or manifest.get("verificationMode")
        != config.verification_mode.replace("-", "_")
        or manifest.get("staticPromptAndPrimerBytes") != static_bytes
    ):
        raise RunnerError(f"{description} manifest authority/schema drifted")

    binding_total_bytes = 0
    for manifest_key, (expected_name, report_sha_key, report_bytes_key) in (
        PROOF_CONTEXT_BINDINGS.items()
    ):
        binding = manifest.get(manifest_key)
        if (
            not isinstance(binding, dict)
            or set(binding) != {"path", "bytes", "sha256"}
            or binding.get("path") != expected_name
            or isinstance(binding.get("bytes"), bool)
            or not isinstance(binding.get("bytes"), int)
            or binding["bytes"] < 0
            or not isinstance(binding.get("sha256"), str)
            or re.fullmatch(r"[0-9a-f]{64}", binding["sha256"]) is None
        ):
            raise RunnerError(
                f"{description} binding {manifest_key} is malformed"
            )
        path = root / expected_name
        require_regular_nonsymlink_file(
            path,
            f"{description} file {expected_name}",
            allow_empty=binding["bytes"] == 0,
        )
        if (
            path.stat().st_size != binding["bytes"]
            or sha256_file(path) != binding["sha256"]
            or (
                report is not None
                and report.get(report_bytes_key) != binding["bytes"]
            )
            or (
                report is not None
                and
                report_sha_key is not None
                and report.get(report_sha_key) != binding["sha256"]
            )
        ):
            raise RunnerError(f"{description} binding {manifest_key} drifted")
        binding_total_bytes += binding["bytes"]

    problem_path = root / "Problem.v"
    require_regular_nonsymlink_file(problem_path, f"{description} Problem.v")
    if report is not None:
        generated_problem_bytes = nonnegative_integer(
            report.get("problemModuleBytes"), "problemModuleBytes"
        )
        semantic_primer_bytes = manifest["semanticPrimer"]["bytes"]
        if static_bytes < semantic_primer_bytes:
            raise RunnerError(f"{description} static context byte count is impossible")
        manifest_path = root / "context-manifest.json"
        expected_generated_bytes = (
            binding_total_bytes
            + generated_problem_bytes
            + manifest_path.stat().st_size
            + static_bytes
            - semantic_primer_bytes
        )
        if report.get("generatedContextBytes") != expected_generated_bytes:
            raise RunnerError(f"{description} generated byte total drifted")

    frozen = config.input_files[case.case_id]
    for name, input_path in (("source", case.source), ("target", case.target)):
        require_regular_nonsymlink_file(input_path, f"frozen {name} SQL input")
        if sha256_file(input_path) != frozen[name]["sha256"]:
            raise RunnerError(f"{description} frozen {name} SQL input drifted")
    if (
        manifest["sourceSql"]["sha256"] != frozen["source"]["sha256"]
        or manifest["targetSql"]["sha256"] != frozen["target"]["sha256"]
        or manifest["sourceSql"]["bytes"] != case.source.stat().st_size
        or manifest["targetSql"]["bytes"] != case.target.stat().st_size
    ):
        raise RunnerError(f"{description} SQL differs from frozen input")
    return manifest


def validate_proof_context_manifest(
    case_dir: Path,
    case: BenchmarkCase,
    context: Any,
    config: RunConfig,
    static_prompt_and_primer_bytes: Any,
) -> dict[str, Any]:
    if not isinstance(context, dict) or set(context) != PROOF_CONTEXT_REPORT_KEYS:
        raise RunnerError("proof-agent context report is not strict")
    expected_manifest_path = "proof-stage/formal-sql/context-manifest.json"
    if context.get("manifestPath") != expected_manifest_path:
        raise RunnerError("proof-agent context manifest path is not canonical")
    formal_root = case_dir / "proof-stage/formal-sql"
    require_real_directory_chain(
        case_dir, formal_root, "formal proof workspace"
    )
    manifest_path = formal_root / "context-manifest.json"
    require_regular_nonsymlink_file(manifest_path, "proof-agent context manifest")
    if (
        context.get("manifestSha256") != sha256_file(manifest_path)
        or context.get("manifestBytes") != manifest_path.stat().st_size
    ):
        raise RunnerError("proof-agent context manifest report binding drifted")
    manifest = read_json_object(manifest_path, "proof-agent context manifest")
    validated = validate_context_manifest_at_root(
        formal_root,
        manifest,
        case,
        config,
        static_prompt_and_primer_bytes,
        "proof-agent context",
        report=context,
    )
    validate_case_input_and_lowering_authority(
        case_dir,
        case,
        config,
        require_lowering=True,
        context_root=formal_root,
        reported_problem_module_bytes=context.get("problemModuleBytes"),
    )
    return validated


def validate_materialized_trusted_scripts(
    case_dir: Path,
    proof: dict[str, Any],
    config: RunConfig,
) -> None:
    """Bind scripts emitted by the solver binary to the frozen trusted stack.

    The solver embeds these scripts with Rust ``include_str!``.  Binding only
    the repository copies would let a stale pinned binary execute an older
    launcher/checker while the run attested the current source tree.
    """
    workspace = proof.get("proofWorkspace")
    if not isinstance(workspace, dict):
        raise RunnerError("proof-agent run has no proofWorkspace script bindings")

    stack = config.trusted_stack
    manifest_value = stack.get("manifestPath") if isinstance(stack, dict) else None
    manifest_digest = (
        stack.get("manifestSha256") if isinstance(stack, dict) else None
    )
    if not isinstance(manifest_value, str) or not isinstance(manifest_digest, str):
        raise RunnerError("trusted proof-stack manifest binding is malformed")
    manifest_path = resolve_artifact_path(manifest_value)
    require_regular_nonsymlink_file(
        manifest_path, "preserved trusted proof-stack manifest"
    )
    if sha256_file(manifest_path) != manifest_digest:
        raise RunnerError("preserved trusted proof-stack manifest changed")
    manifest = read_json_object(manifest_path, "trusted proof-stack manifest")
    scripts = manifest.get("trustedScripts")
    if (
        not isinstance(scripts, list)
        or len(scripts) != len(TRUSTED_STACK_SCRIPTS)
        or any(
            not isinstance(record, dict)
            or set(record) != {"path", "sha256", "bytes"}
            or not isinstance(record.get("path"), str)
            for record in scripts
        )
    ):
        raise RunnerError("trusted proof-stack script authority is malformed")
    scripts_by_path = {record["path"]: record for record in scripts}
    if set(scripts_by_path) != set(TRUSTED_STACK_SCRIPTS):
        raise RunnerError("trusted proof-stack script authority is incomplete")

    for source_name, projection_name, workspace_field in (
        TRUSTED_STACK_SCRIPT_PROJECTIONS
    ):
        if (
            workspace_field is not None
            and workspace.get(workspace_field) != projection_name
        ):
            raise RunnerError(
                f"proofWorkspace.{workspace_field} is not the canonical trusted script path"
            )
        projection = resolve_case_artifact(
            case_dir,
            projection_name,
            f"materialized trusted script {projection_name}",
        )
        require_regular_nonsymlink_file(
            projection, f"materialized trusted script {projection_name}"
        )
        source = scripts_by_path[source_name]
        if (
            isinstance(source.get("bytes"), bool)
            or not isinstance(source.get("bytes"), int)
            or source["bytes"] <= 0
            or not isinstance(source.get("sha256"), str)
            or re.fullmatch(r"[0-9a-f]{64}", source["sha256"]) is None
            or projection.stat().st_size != source["bytes"]
            or sha256_file(projection) != source["sha256"]
        ):
            raise RunnerError(
                f"materialized trusted script differs from frozen stack: {projection_name}"
            )


def proof_metrics_from_report(
    report: dict[str, Any], case: BenchmarkCase, config: RunConfig, case_dir: Path
) -> dict[str, Any]:
    metrics = empty_proof_metrics(case_dir)
    metrics["proofSource"] = proof_source_evidence(case_dir)
    proof = report.get("proof")
    if proof is None:
        return metrics
    if not isinstance(proof, dict):
        raise RunnerError("solver report proof must be a JSON object or null")
    if proof.get("verificationMode") != config.verification_mode.replace("-", "_"):
        raise RunnerError(
            "solver report verification mode differs from runner configuration"
        )
    expected_sql = sql_environment_record(config)
    expected_proof_sql = {
        "defaultCollation": expected_sql["defaultCollation"],
        "characterClassification": expected_sql["characterClassification"],
        "localeProvider": expected_sql["localeProvider"],
        "serverEncoding": expected_sql["serverEncoding"],
    }
    if proof.get("sqlEnvironment") != expected_proof_sql:
        raise RunnerError(
            "solver report SQL environment differs from runner configuration"
        )

    agent = proof.get("proofAgentConfiguration")
    context: dict[str, Any] | None = None
    trusted_elapsed_warnings: list[dict[str, Any]] = []
    if agent is not None:
        if not isinstance(agent, dict):
            raise RunnerError("proofAgentConfiguration must be a JSON object")
        if agent.get("enabled") is not True:
            raise RunnerError("proof agent was not effectively enabled")
        expected_agent_values = {
            "command": DEFAULT_PROOF_AGENT_COMMAND,
            "resumeCommand": DEFAULT_PROOF_AGENT_RESUME_COMMAND,
            "timeoutSeconds": max(1, int(config.case_timeout_seconds) - 300),
            "trustedCheckTimeoutSeconds": config.proof_check_timeout_seconds,
            "memoryLimitMib": config.proof_agent_memory_limit_mib,
            "dockerImage": config.proof_docker_image_effective,
            "sessionRestartAfterFailedRounds": (
                PROOF_AGENT_SESSION_RESTART_AFTER_FAILED_ROUNDS
            ),
            "sessionHomePolicy": PROOF_AGENT_SESSION_HOME_POLICY,
            "diagnosticTransport": PROOF_AGENT_DIAGNOSTIC_TRANSPORT,
            "diagnosticCachePolicy": PROOF_AGENT_DIAGNOSTIC_CACHE_POLICY,
            "diagnosticTimeoutPolicy": PROOF_AGENT_DIAGNOSTIC_TIMEOUT_POLICY,
            "diagnosticBudgetPolicy": PROOF_AGENT_DIAGNOSTIC_BUDGET_POLICY,
            "diagnosticCheckerParallelismMax": (
                PROOF_AGENT_DIAGNOSTIC_CHECKER_PARALLELISM_MAX
            ),
            "diagnosticCheckerSchedulingPolicy": (
                PROOF_AGENT_DIAGNOSTIC_CHECKER_SCHEDULING_POLICY
            ),
            "compileCheckpointPolicy": PROOF_AGENT_COMPILE_CHECKPOINT_POLICY,
            "scratchPersistencePolicy": PROOF_AGENT_SCRATCH_PERSISTENCE_POLICY,
            "writableStorageLimitBytes": (
                config.proof_agent_storage_limit_mib * 1024 * 1024
            ),
            "writableStoragePolicy": PROOF_AGENT_WRITABLE_STORAGE_POLICY,
            "scratchAllowedExtensions": list(
                PROOF_AGENT_SCRATCH_ALLOWED_EXTENSIONS
            ),
            "trustedCheckerEnvironmentPolicy": (
                trusted_checker_environment_policy_record()
            ),
            "proofAgentLauncherEnvironmentPolicy": (
                proof_agent_launcher_environment_policy_record()
            ),
        }
        for key, expected in expected_agent_values.items():
            if agent.get(key) != expected:
                raise RunnerError(
                    f"proofAgentConfiguration.{key} differs from effective runner config"
                )
        metrics["staticPromptAndPrimerBytes"] = nonnegative_integer(
            agent.get("staticPromptAndPrimerBytes"), "staticPromptAndPrimerBytes"
        )
        if proof.get("backendStatus") == "lowering_blocked":
            forbidden_lowering_evidence = (
                "diagnosticCacheManifestPath",
                "diagnosticCacheManifestSha256",
                "trustedEnvironmentPreflight",
                "context",
            )
            if any(agent.get(key) is not None for key in forbidden_lowering_evidence):
                raise RunnerError(
                    "lowering-blocked proof unexpectedly carries post-lowering authority evidence"
                )
            if (
                proof.get("proofAgentRounds", []) != []
                or proof.get("proofWorkspaceTransitions", []) != []
                or proof.get("deterministicTailRecovery") is not None
                or proof.get("proofAgent") is not None
                or proof.get("proofWorkspace") is not None
            ):
                raise RunnerError(
                    "lowering-blocked proof unexpectedly carries proof execution evidence"
                )
            return metrics

        validate_materialized_trusted_scripts(case_dir, proof, config)
        validate_trusted_diagnostic_cache(case_dir, agent)
        preflight = agent.get("trustedEnvironmentPreflight")
        if (
            not isinstance(preflight, dict)
            or preflight.get("timeoutSeconds") != config.proof_check_timeout_seconds
            or preflight.get("exitCode") != 0
            or preflight.get("timedOut") is not False
            or preflight.get("error") is not None
        ):
            raise RunnerError("trusted Rocq environment preflight was not accepted")
        context_value = agent.get("context")
        if not isinstance(context_value, dict):
            raise RunnerError("proof-agent context record is missing")
        context = context_value
        validate_proof_context_manifest(
            case_dir,
            case,
            context,
            config,
            agent.get("staticPromptAndPrimerBytes"),
        )
        if (
            context.get("sourceSqlSha256")
            != config.input_files[case.case_id]["source"]["sha256"]
        ):
            raise RunnerError("proof-agent source SQL digest differs from frozen input")
        if (
            context.get("targetSqlSha256")
            != config.input_files[case.case_id]["target"]["sha256"]
        ):
            raise RunnerError("proof-agent target SQL digest differs from frozen input")
        metric_fields = {
            "queryShapeBytes": context.get("queryShapeBytes"),
            "generatedContextBytes": context.get("generatedContextBytes"),
            "contextManifestBytes": context.get("manifestBytes"),
        }
        for key, value in metric_fields.items():
            metrics[key] = nonnegative_integer(value, key)

    rounds = proof.get("proofAgentRounds", [])
    if not isinstance(rounds, list) or not all(isinstance(row, dict) for row in rounds):
        raise RunnerError("proofAgentRounds must be an array of objects")
    final_agent = proof.get("proofAgent")
    if (rounds and final_agent != rounds[-1]) or (not rounds and final_agent is not None):
        raise RunnerError("proofAgent does not equal the terminal proof-agent round")
    if context is None or not isinstance(agent, dict):
        if rounds or proof.get("proofWorkspaceTransitions", []):
            raise RunnerError("proof execution evidence has no proof-agent context")
        workspace_state = {
            "transitionsByRound": {},
            "initialCheckpoints": {},
            "preflights": [],
            "checkpoints": [],
            "warnings": [],
            "moduleSourcesByGeneration": {},
        }
    else:
        workspace_state = validate_proof_workspace_transitions(
            proof, case, rounds, context, agent, case_dir, config
        )
        preflights = workspace_state["preflights"]
        checkpoints = workspace_state["checkpoints"]
        metrics["preflightInvocationCount"] = len(preflights)
        metrics["preflightElapsedMs"] = sum(
            record["elapsedMs"] for record in preflights
        )
        metrics["preflightGenerations"] = preflights
        metrics["initialProblemCompileInvocationCount"] = len(checkpoints)
        metrics["initialProblemCompileElapsedMs"] = sum(
            record["elapsedMs"] for record in checkpoints
        )
        metrics["initialProblemCompileTimeoutSeconds"] = (
            config.proof_check_timeout_seconds
        )
        metrics["initialProblemCompileGenerations"] = [
            {
                "workspaceGeneration": record["workspaceGeneration"],
                "path": record["path"],
                "sha256": record["sha256"],
                "elapsedMs": record["elapsedMs"],
            }
            for record in checkpoints
        ]
        trusted_elapsed_warnings.extend(workspace_state["warnings"])
    validate_proof_agent_session_sequence(
        rounds,
        f"{case.case_id}.proofAgentRounds",
        allow_terminal_unavailable_session=(
            proof.get("deterministicTailRecovery") is not None
            or (
                proof.get("backendStatus") == "proof_agent_failed"
                and bool(rounds)
                and round_has_unresumable_session_suffix(rounds[-1])
            )
            or (
                bool(rounds)
                and report_has_strict_terminal_counterexample_handoff(
                    report, rounds[-1]
                )
                    and round_has_unresumable_session_suffix(rounds[-1])
                )
            or (
                proof.get("backendStatus") == "proof_complete"
                and bool(rounds)
                and rounds[-1].get("success") is True
                and round_has_session_telemetry_failure(rounds[-1])
            )
        ),
        workspace_transitions_by_round=workspace_state["transitionsByRound"],
    )
    metrics["proofRoundCount"] = len(rounds)
    requested_timeouts: list[int] = []
    effective_timeouts: list[int] = []
    diagnostic_elapsed = 0
    diagnostic_elapsed_warnings: list[dict[str, Any]] = []
    diagnostic_clock_warnings: list[dict[str, Any]] = []
    diagnostic_broker_totals = {
        "requests": 0,
        "reservedTimeout": 0,
        "accepted": 0,
        "rejectedSourceAudit": 0,
        "otherRejected": 0,
        "acceptedAuditArtifacts": 0,
        "rejectedSourceAuditArtifacts": 0,
        "preservedArtifacts": 0,
    }
    previous_diagnostic_end: int | None = None
    final_proof_check_elapsed: int | None = None
    final_proof_check_invocation_count = 0
    final_proof_check_elapsed_total = 0
    active_checkpoints = {
        generation: record["sha256"]
        for generation, record in workspace_state["initialCheckpoints"].items()
    }
    for index, round_record in enumerate(rounds, start=1):
        if round_record.get("round") != index:
            raise RunnerError("proof-agent rounds are not consecutively numbered")
        workspace_generation = round_record.get("workspaceGeneration")
        active_checkpoint_sha256 = active_checkpoints.get(workspace_generation)
        if active_checkpoint_sha256 is None:
            raise RunnerError(
                f"proof-agent round {index} has no generation-bound initial checkpoint"
            )
        validate_proof_round_audit(
            round_record, f"proof-agent round {index}"
        )

        closure_path_value = round_record.get("authorityClosurePath")
        closure_sha256 = round_record.get("authorityClosureSha256")
        closure_bytes = round_record.get("authorityClosureBytes")
        expected_closure_path_value = (
            f"proof-stage/proof-agent/rounds/{index:02d}/"
            "checked-workspace/authority-closure.txt"
        )
        if closure_path_value != expected_closure_path_value:
            raise RunnerError("proof-agent round has no authority-closure path")
        closure_path = case_dir / expected_closure_path_value
        require_real_directory_chain(
            case_dir,
            closure_path.parent,
            "authority closure directory",
        )
        require_regular_nonsymlink_file(
            closure_path, "authority closure artifact"
        )
        if closure_sha256 != sha256_file(closure_path):
            raise RunnerError("authority closure artifact digest drifted")
        if (
            nonnegative_integer(closure_bytes, "authorityClosureBytes")
            != closure_path.stat().st_size
        ):
            raise RunnerError("authority closure artifact byte count drifted")

        nonnegative_integer(
            round_record.get("scratchFileCount"), "scratchFileCount"
        )
        nonnegative_integer(
            round_record.get("scratchBytes"), "scratchBytes"
        )

        invocations = round_record.get("diagnosticCheckerInvocations", [])
        if (
            not isinstance(invocations, list)
            or any(not isinstance(invocation, dict) for invocation in invocations)
        ):
            raise RunnerError(
                "proof-agent turn has malformed host diagnostic evidence"
            )
        if (
            round_record.get("diagnosticCheckerRequestPath") is not None
            or round_record.get("diagnosticCheckerRequestError") is not None
            or round_record.get("diagnosticCheckerTelemetryError") is not None
        ):
            raise RunnerError("legacy diagnostic request-file state is not permitted")
        telemetry_value = round_record.get("diagnosticCheckerTelemetryPath")
        if invocations:
            expected_telemetry_value = f"proof-stage/proof-agent/rounds/{index:02d}/interactive-diagnostics.json"
            if telemetry_value != expected_telemetry_value:
                raise RunnerError("host diagnostic telemetry path is missing")
            telemetry_path = resolve_case_artifact(
                case_dir, telemetry_value, "diagnostic telemetry"
            )
            if not telemetry_path.is_file() or telemetry_path.is_symlink():
                raise RunnerError("host diagnostic telemetry artifact is missing")
            telemetry = read_json_array(telemetry_path, "host diagnostic telemetry")
            if invocations != telemetry:
                raise RunnerError(
                    "report diagnostic telemetry differs from host artifact"
                )
        elif telemetry_value is not None:
            raise RunnerError("empty diagnostic round unexpectedly has telemetry")

        round_broker = validate_round_diagnostic_broker_evidence(
            case_dir, index, round_record, invocations
        )
        for key, value in round_broker.items():
            diagnostic_broker_totals[key] += value

        latest_passed_checkpoint_sha256: str | None = None
        for sequence, invocation in enumerate(invocations, start=1):
            required_invocation_keys = {
                "sequence",
                "mode",
                "candidateSha256",
                "candidatePath",
                "purpose",
                "compilePassed",
                "problemCompilePassed",
                "compileCheckpointAdvanced",
                "stdoutSha256",
                "stderrSha256",
                "requestedTimeoutSeconds",
                "effectiveTimeoutSeconds",
                "startedAtUnixMs",
                "elapsedMs",
                "exitCode",
                "timedOut",
            }
            if set(invocation) not in (
                required_invocation_keys,
                required_invocation_keys | {"error"},
            ):
                raise RunnerError("diagnostic invocation schema is not strict")
            candidate_sha256 = invocation.get("candidateSha256")
            mode = invocation.get("mode")
            candidate_path = invocation.get("candidatePath")
            purpose = invocation.get("purpose")
            validate_diagnostic_identity(
                mode,
                candidate_path,
                purpose,
                candidate_sha256,
                "diagnostic invocation",
            )
            current_checkpoint_sha256 = (
                latest_passed_checkpoint_sha256 or active_checkpoint_sha256
            )
            validate_diagnostic_checkpoint_dedup(
                mode, candidate_sha256, current_checkpoint_sha256
            )
            if invocation.get("sequence") != sequence:
                raise RunnerError(
                    "diagnostic invocation sequence is invalid"
                )
            requested = nonnegative_integer(
                invocation.get("requestedTimeoutSeconds"),
                "diagnostic requested timeout",
            )
            effective = nonnegative_integer(
                invocation.get("effectiveTimeoutSeconds"),
                "diagnostic effective timeout",
            )
            if not (1 <= effective <= requested):
                raise RunnerError(
                    "diagnostic timeout is outside the trusted broker contract"
                )
            diagnostic_dir = (
                telemetry_path.parent / "interactive-diagnostics" / f"{sequence:02d}"
            )
            request_path = diagnostic_dir / "request.json"
            invocation_path = diagnostic_dir / "invocation.json"
            diagnostic_stdout_path = diagnostic_dir / "stdout.txt"
            diagnostic_stderr_path = diagnostic_dir / "stderr.txt"
            diagnostic_problem_path = diagnostic_dir / "checked-workspace/Problem.v"
            diagnostic_candidate_path = (
                diagnostic_dir / "checked-workspace" / candidate_path
                if mode == "module"
                else diagnostic_problem_path
            )
            for path in (
                request_path,
                invocation_path,
                diagnostic_stdout_path,
                diagnostic_stderr_path,
                diagnostic_problem_path,
                diagnostic_candidate_path,
            ):
                if not path.is_file() or path.is_symlink():
                    raise RunnerError(
                        f"interactive diagnostic evidence is missing: {path}"
                    )
            validate_diagnostic_request_v2(
                read_json_object(request_path, "diagnostic broker request"),
                mode=mode,
                candidate_path=candidate_path,
                purpose=purpose,
                candidate_sha256=candidate_sha256,
                candidate_bytes=diagnostic_candidate_path.stat().st_size,
                requested_timeout_seconds=requested,
                description="diagnostic broker request",
            )
            if (
                read_json_object(invocation_path, "diagnostic broker invocation")
                != invocation
            ):
                raise RunnerError(
                    "diagnostic invocation artifact disagrees with report"
                )
            if sha256_file(diagnostic_candidate_path) != candidate_sha256:
                raise RunnerError("diagnostic candidate snapshot digest drifted")
            if invocation.get("stdoutSha256") != sha256_file(
                diagnostic_stdout_path
            ) or invocation.get("stderrSha256") != sha256_file(diagnostic_stderr_path):
                raise RunnerError("diagnostic output digest drifted")

            started = nonnegative_integer(
                invocation.get("startedAtUnixMs"), "diagnostic start time"
            )
            elapsed = nonnegative_integer(
                invocation.get("elapsedMs"), "diagnostic elapsed time"
            )
            elapsed_warning = diagnostic_elapsed_warning(
                round_number=index,
                sequence=sequence,
                requested_timeout_seconds=requested,
                effective_timeout_seconds=effective,
                elapsed_ms=elapsed,
            )
            if elapsed_warning is not None:
                diagnostic_elapsed_warnings.append(elapsed_warning)
            clock_warning = diagnostic_clock_warning(
                round_number=index,
                sequence=sequence,
                prior_estimated_end_unix_ms=previous_diagnostic_end,
                started_at_unix_ms=started,
            )
            if clock_warning is not None:
                diagnostic_clock_warnings.append(clock_warning)
            previous_diagnostic_end = started + elapsed
            timed_out = invocation.get("timedOut")
            exit_code = invocation.get("exitCode")
            error = invocation.get("error")
            compile_passed = invocation.get("compilePassed")
            problem_compile_passed = invocation.get("problemCompilePassed")
            checkpoint_advanced = invocation.get("compileCheckpointAdvanced")
            if (
                not isinstance(timed_out, bool)
                or not isinstance(compile_passed, bool)
                or not isinstance(problem_compile_passed, bool)
                or not isinstance(checkpoint_advanced, bool)
            ):
                raise RunnerError("diagnostic status fields must be boolean")
            if error is not None and (not isinstance(error, str) or not error):
                raise RunnerError("diagnostic error must be nonempty text or null")
            if timed_out and exit_code not in (124, 137) and not error:
                raise RunnerError(
                    "diagnostic timeout has no coherent exit/error evidence"
                )
            if exit_code is not None and (
                isinstance(exit_code, bool) or not isinstance(exit_code, int)
            ):
                raise RunnerError("diagnostic exitCode must be integer or null")
            ordinary_compile_passed = (
                exit_code == 0 and timed_out is False and error is None
            )
            if mode == "module":
                exact_durable_publication = (
                    workspace_state["moduleSourcesByGeneration"]
                    .get(workspace_generation, {})
                    .get(candidate_path)
                    == candidate_sha256
                )
                expected_compile_passed = (
                    exact_durable_publication
                    and error is None
                )
            else:
                expected_compile_passed = ordinary_compile_passed
            expected_problem_compile_passed = (
                expected_compile_passed and mode == "problem"
            )
            if (
                compile_passed is not expected_compile_passed
                or problem_compile_passed is not expected_problem_compile_passed
                or checkpoint_advanced is not expected_problem_compile_passed
            ):
                raise RunnerError("diagnostic compile/checkpoint status is incoherent")
            if problem_compile_passed:
                latest_passed_checkpoint_sha256 = candidate_sha256
            requested_timeouts.append(requested)
            effective_timeouts.append(effective)
            diagnostic_elapsed += elapsed

        checked_problem_path = closure_path.parent / "Problem.v"
        if not checked_problem_path.is_file() or checked_problem_path.is_symlink():
            raise RunnerError("round checked Problem.v snapshot is missing")
        candidate_problem_sha256 = sha256_file(checked_problem_path)
        candidate_problem_compile_passed = candidate_problem_has_compile_authority(
            candidate_problem_sha256,
            active_checkpoint_sha256,
            invocations,
        )
        candidate_has_final_theorem = problem_declares_final_theorem(
            checked_problem_path.read_text(encoding="utf-8"),
            config.verification_mode,
        )
        if (
            round_record.get("candidateProblemSha256") != candidate_problem_sha256
            or round_record.get("candidateProblemCompilePassed")
            is not candidate_problem_compile_passed
            or round_record.get("candidateHasFinalTheorem")
            is not candidate_has_final_theorem
            or round_record.get("activeProblemCompileCheckpointSha256")
            != active_checkpoint_sha256
            or round_record.get("updatedProblemCompileCheckpointSha256")
            != latest_passed_checkpoint_sha256
        ):
            raise RunnerError("round compile-checkpoint evidence is incoherent")
        if latest_passed_checkpoint_sha256 is not None:
            active_checkpoints[workspace_generation] = latest_passed_checkpoint_sha256

        proof_check_elapsed = round_record.get("proofCheckElapsedMs")
        if proof_check_elapsed is not None:
            elapsed = nonnegative_integer(
                proof_check_elapsed, "final proof-check elapsedMs"
            )
            proof_check_timeout = nonnegative_integer(
                round_record.get("proofCheckTimeoutSeconds"),
                "final proof-check timeoutSeconds",
            )
            if proof_check_timeout > config.proof_check_timeout_seconds:
                raise RunnerError("final proof-check timeout exceeds runner policy")
            final_proof_check_invocation_count += 1
            final_proof_check_elapsed_total += elapsed
            final_warning = trusted_elapsed_warning(
                phase="final_trusted_check",
                timeout_seconds=proof_check_timeout,
                elapsed_ms=elapsed,
                round_number=index,
            )
            if final_warning is not None:
                trusted_elapsed_warnings.append(final_warning)
            if (
                round_record.get("proofCheckExitCode") == 0
                and round_record.get("proofCheckTimedOut") is False
            ):
                final_proof_check_elapsed = elapsed
        elif round_record.get("proofCheckTimeoutSeconds") is not None:
            raise RunnerError(
                "final proof-check timeout is present without elapsed evidence"
            )

    recovery_check_elapsed = validate_deterministic_tail_recovery(
        proof, rounds, case_dir, config
    )
    if recovery_check_elapsed is not None:
        final_proof_check_invocation_count += 1
        final_proof_check_elapsed_total += recovery_check_elapsed
        final_proof_check_elapsed = recovery_check_elapsed
        recovery_warning = trusted_elapsed_warning(
            phase="deterministic_tail_trusted_check",
            timeout_seconds=config.proof_check_timeout_seconds,
            elapsed_ms=recovery_check_elapsed,
            round_number=len(rounds),
        )
        if recovery_warning is not None:
            trusted_elapsed_warnings.append(recovery_warning)

    metrics["diagnosticInvocationCount"] = len(requested_timeouts)
    metrics["diagnosticElapsedMs"] = diagnostic_elapsed
    if diagnostic_elapsed_warnings:
        metrics["diagnosticElapsedWarnings"] = diagnostic_elapsed_warnings
    if diagnostic_clock_warnings:
        metrics["diagnosticClockWarnings"] = diagnostic_clock_warnings
    if trusted_elapsed_warnings:
        metrics["trustedElapsedWarnings"] = trusted_elapsed_warnings
    metrics["diagnosticRequestCount"] = diagnostic_broker_totals["requests"]
    metrics["diagnosticRequestedTimeoutSecondsReserved"] = diagnostic_broker_totals[
        "reservedTimeout"
    ]
    metrics["diagnosticAcceptedRequestCount"] = diagnostic_broker_totals["accepted"]
    metrics["diagnosticRejectedSourceAuditCount"] = diagnostic_broker_totals[
        "rejectedSourceAudit"
    ]
    metrics["diagnosticOtherRejectedRequestCount"] = diagnostic_broker_totals[
        "otherRejected"
    ]
    metrics["diagnosticAcceptedAuditArtifactCount"] = diagnostic_broker_totals[
        "acceptedAuditArtifacts"
    ]
    metrics["diagnosticRejectedSourceAuditArtifactCount"] = diagnostic_broker_totals[
        "rejectedSourceAuditArtifacts"
    ]
    metrics["diagnosticPreservedArtifactCount"] = diagnostic_broker_totals[
        "preservedArtifacts"
    ]
    metrics["requestedTimeoutSeconds"] = requested_timeouts
    metrics["effectiveTimeoutSeconds"] = effective_timeouts
    metrics["finalProofCheckInvocationCount"] = final_proof_check_invocation_count
    metrics["finalProofCheckElapsedTotalMs"] = final_proof_check_elapsed_total
    metrics["checkerInvocationCount"] = (
        metrics["preflightInvocationCount"]
        + metrics["initialProblemCompileInvocationCount"]
        + len(requested_timeouts)
        + final_proof_check_invocation_count
    )
    metrics["checkerElapsedMs"] = (
        (metrics["preflightElapsedMs"] or 0)
        + (metrics["initialProblemCompileElapsedMs"] or 0)
        + diagnostic_elapsed
        + final_proof_check_elapsed_total
    )
    metrics["finalProofCheckElapsedMs"] = final_proof_check_elapsed
    return metrics


def serde_compact_json_sha256(path: Path, description: str) -> tuple[Any, str]:
    require_regular_nonsymlink_file(path, description)
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        compact = json.dumps(
            value,
            ensure_ascii=False,
            separators=(",", ":"),
            allow_nan=False,
        ).encode("utf-8")
    except (OSError, UnicodeError, json.JSONDecodeError, TypeError, ValueError) as error:
        raise RunnerError(f"{description} is not strict JSON") from error
    return value, hashlib.sha256(compact).hexdigest()


def verification_input_stable_key(value: Any) -> str:
    if not isinstance(value, dict) or set(value) != {
        "sqlEnvironment",
        "integrityContract",
        "schema",
        "sourceQuery",
        "targetQuery",
    }:
        raise RunnerError("verification-input artifact is malformed")
    environment = value.get("sqlEnvironment")
    schema = value.get("schema")
    source = value.get("sourceQuery")
    target = value.get("targetQuery")
    if (
        not isinstance(environment, dict)
        or not isinstance(schema, dict)
        or not isinstance(source, dict)
        or not isinstance(target, dict)
        or any(
            not isinstance(component, str)
            for component in (
                environment.get("defaultCollation"),
                environment.get("characterClassification"),
                environment.get("localeProvider"),
                environment.get("serverEncoding"),
                schema.get("sql"),
                source.get("sql"),
                target.get("sql"),
            )
        )
    ):
        raise RunnerError("verification-input artifact has malformed stable-key fields")
    values = (
        "logos-solver-verification-input-v4-query-program-environment",
        environment["defaultCollation"],
        environment["characterClassification"],
        environment["localeProvider"],
        environment["serverEncoding"],
        schema["sql"],
        json.dumps(
            value["integrityContract"],
            ensure_ascii=False,
            separators=(",", ":"),
            allow_nan=False,
        ),
        source["sql"],
        target["sql"],
    )
    state = 0xCBF29CE484222325
    for text_value in values:
        for byte in text_value.encode("utf-8"):
            state = ((state ^ byte) * 0x100000001B3) & ((1 << 64) - 1)
        state = ((state ^ 0xFF) * 0x100000001B3) & ((1 << 64) - 1)
    return f"{state:016x}"


def validate_observation_certificate(
    case_dir: Path, certificate: Any, statement: int, comparison: str
) -> None:
    certificate_keys = {
        "schemaVersion",
        "verificationInputKey",
        "verificationInputSha256",
        "loweringSha256",
        "statement",
        "comparison",
        "sourceDerivation",
        "targetDerivation",
    }
    if (
        not isinstance(certificate, dict)
        or set(certificate) != certificate_keys
        or certificate.get("schemaVersion") != 1
        or certificate.get("statement") != statement
        or certificate.get("comparison") != comparison
        or not isinstance(certificate.get("verificationInputKey"), str)
        or re.fullmatch(r"[0-9a-f]{16}", certificate["verificationInputKey"])
        is None
        or any(
            not isinstance(certificate.get(key), str)
            or re.fullmatch(r"[0-9a-f]{64}", certificate[key]) is None
            for key in ("verificationInputSha256", "loweringSha256")
        )
        or any(
            not isinstance(certificate.get(key), str) or not certificate[key]
            for key in ("sourceDerivation", "targetDerivation")
        )
    ):
        raise RunnerError("database counterexample observation certificate is malformed")

    authority_path = case_dir / "counterexample-stage/observation-certificates.json"
    authority = read_json_object(
        authority_path, "observation-certificate authority"
    ) if (
        authority_path.is_file() and not authority_path.is_symlink()
    ) else None
    if not isinstance(authority, dict) or set(authority) != {
        "schemaVersion",
        "verificationInputKey",
        "verificationInputSha256",
        "loweringSha256",
        "source",
        "target",
    }:
        raise RunnerError("observation-certificate authority artifact is malformed")
    for key in (
        "schemaVersion",
        "verificationInputKey",
        "verificationInputSha256",
        "loweringSha256",
    ):
        if authority.get(key) != certificate.get(key):
            raise RunnerError("observation certificate differs from host authority")

    input_value, input_sha256 = serde_compact_json_sha256(
        case_dir / "input/verification-input.json", "verification-input artifact"
    )
    _, lowering_sha256 = serde_compact_json_sha256(
        case_dir / "proof-stage/formal-sql-lowering.json",
        "FormalSQL lowering artifact",
    )
    if (
        certificate["verificationInputSha256"] != input_sha256
        or certificate["loweringSha256"] != lowering_sha256
        or certificate["verificationInputKey"]
        != verification_input_stable_key(input_value)
    ):
        raise RunnerError("observation certificate input/lowering authority drifted")

    fact_field = (
        "successBagFunctional"
        if comparison == "bag"
        else "successObservationFunctional"
    )
    derivations: list[tuple[str, bool]] = []
    for side in ("source", "target"):
        facts = authority.get(side)
        matches = (
            [fact for fact in facts if isinstance(fact, dict) and fact.get("statement") == statement]
            if isinstance(facts, list)
            else []
        )
        if len(matches) != 1:
            raise RunnerError(
                f"observation authority has no unique {side} statement {statement}"
            )
        fact = matches[0]
        allowed_fact_keys = {
            "statement",
            "permutationClosed",
            "successBagFunctional",
            "successObservationFunctional",
            "maxSuccessRows",
            "candidateKeys",
        }
        if (
            not {"statement", "permutationClosed", "successBagFunctional", "successObservationFunctional"}
            <= set(fact)
            or not set(fact) <= allowed_fact_keys
            or not isinstance(fact.get("permutationClosed"), bool)
        ):
            raise RunnerError("observation authority statement facts are malformed")
        status = fact.get(fact_field)
        if not isinstance(status, dict) or status.get("status") not in {
            "proven",
            "unknown",
        }:
            raise RunnerError("observation authority certificate status is malformed")
        proven = status["status"] == "proven"
        expected_status_keys = {"status", "rule"} if proven else {"status", "residual"}
        text_key = "rule" if proven else "residual"
        if (
            set(status) != expected_status_keys
            or not isinstance(status.get(text_key), str)
            or not status[text_key]
        ):
            raise RunnerError("observation authority derivation is malformed")
        derivations.append((status[text_key], proven))
    if (
        certificate["sourceDerivation"] != derivations[0][0]
        or certificate["targetDerivation"] != derivations[1][0]
        or not (derivations[0][1] or derivations[1][1])
    ):
        raise RunnerError("observation certificate derivation authority drifted")


def validate_output_column(value: Any, description: str, ordinal: int) -> None:
    if (
        not isinstance(value, dict)
        or set(value)
        != {"ordinal", "name", "typeOid", "typeModifier", "typeName"}
        or value.get("ordinal") != ordinal
        or not isinstance(value.get("name"), str)
        or isinstance(value.get("typeOid"), bool)
        or not isinstance(value.get("typeOid"), int)
        or not 0 <= value["typeOid"] <= 0xFFFFFFFF
        or isinstance(value.get("typeModifier"), bool)
        or not isinstance(value.get("typeModifier"), int)
        or not isinstance(value.get("typeName"), str)
        or not value["typeName"]
    ):
        raise RunnerError(f"{description} output column {ordinal} is malformed")


def validate_output_schema(value: Any, description: str) -> None:
    if not isinstance(value, dict) or set(value) != {"columns"} or not isinstance(
        value.get("columns"), list
    ):
        raise RunnerError(f"{description} output schema is malformed")
    for ordinal, column in enumerate(value["columns"], start=1):
        validate_output_column(column, description, ordinal)


def validate_statement_output(value: Any, description: str) -> None:
    if not isinstance(value, dict):
        raise RunnerError(f"{description} statement output is malformed")
    if value.get("kind") == "success":
        if set(value) != {"kind", "schema"}:
            raise RunnerError(f"{description} success output is malformed")
        validate_output_schema(value.get("schema"), description)
    elif value.get("kind") == "analysisError":
        if (
            set(value) != {"kind", "error", "sql_state", "message"}
            or value.get("error")
            not in {
                "ambiguous_column",
                "undefined_column",
                "undefined_function",
                "invalid_text_representation",
            }
            or not isinstance(value.get("sql_state"), str)
            or not value["sql_state"]
            or not isinstance(value.get("message"), str)
        ):
            raise RunnerError(f"{description} analysis error is malformed")
    else:
        raise RunnerError(f"{description} statement output kind is invalid")


def validate_schema_mismatch(value: Any) -> None:
    if not isinstance(value, dict) or not isinstance(value.get("reason"), str) or not value[
        "reason"
    ]:
        raise RunnerError("output-schema mismatch is malformed")
    kind = value.get("kind")
    if kind == "programLength":
        if set(value) != {
            "kind",
            "reason",
            "source_statement_count",
            "target_statement_count",
        }:
            raise RunnerError("program-length mismatch is malformed")
        for key in ("source_statement_count", "target_statement_count"):
            nonnegative_integer(value.get(key), f"program-length mismatch {key}")
    elif kind == "statementOutput":
        if set(value) != {"kind", "reason", "statement", "source", "target"}:
            raise RunnerError("statement-output mismatch is malformed")
        nonnegative_integer(value.get("statement"), "statement-output mismatch statement")
        validate_output_schema(value.get("source"), "source")
        validate_output_schema(value.get("target"), "target")
    elif kind == "statementOutcome":
        if set(value) != {"kind", "reason", "statement", "source", "target"}:
            raise RunnerError("statement-outcome mismatch is malformed")
        nonnegative_integer(value.get("statement"), "statement-outcome mismatch statement")
        validate_statement_output(value.get("source"), "source")
        validate_statement_output(value.get("target"), "target")
    else:
        raise RunnerError("output-schema mismatch kind is invalid")


def validate_database_counterexample(
    counterexample: Any,
    case_dir: Path,
    case: BenchmarkCase,
    config: RunConfig,
    result: dict[str, Any],
    solver_rounds: Any,
) -> None:
    if not isinstance(counterexample, dict):
        raise RunnerError("not_equivalent report lacks typed counterexample evidence")
    effective = result.get("effectiveConfiguration")
    if (
        not isinstance(effective, dict)
        or effective.get("verificationMode") != config.verification_mode
        or config.verification_mode
        not in {"safe-unconditional", "outcome-unconditional", "conditional"}
    ):
        raise RunnerError("database counterexample verification mode is incoherent")
    kind = counterexample.get("kind")
    if kind == "dataDifference":
        expected_keys = {
            "kind",
            "statement",
            "witness_sql",
            "source_result",
            "target_result",
            "diff_sample",
            "certificate",
        }
        comparison = "bag"
    elif kind == "rowSequenceDifference":
        expected_keys = {
            "kind",
            "statement",
            "witness_sql",
            "first_differing_row",
            "source_result",
            "target_result",
            "certificate",
        }
        comparison = "sequence"
    elif kind == "outputSchemaMismatch":
        if set(counterexample) != {"kind", "mismatch"}:
            raise RunnerError("output-schema counterexample evidence is malformed")
        mismatch = counterexample.get("mismatch")
        validate_schema_mismatch(mismatch)
        preflight_path = case_dir / "validation/output-schema-preflight.json"
        require_regular_nonsymlink_file(preflight_path, "output-schema preflight")
        preflight = read_json_object(preflight_path, "output-schema preflight")
        if (
            set(preflight) != {"schemaName", "result"}
            or not isinstance(preflight.get("schemaName"), str)
            or not preflight["schemaName"]
            or not isinstance(preflight.get("result"), dict)
            or preflight["result"] != {"kind": "mismatch", "mismatch": mismatch}
        ):
            raise RunnerError("output-schema counterexample differs from preflight authority")
        comparison = None
    else:
        raise RunnerError("not_equivalent report has an unknown database witness")

    if comparison is not None:
        if config.verification_mode == "conditional":
            raise RunnerError(
                "database value counterexample is not terminal in conditional mode"
            )
        validate_case_input_and_lowering_authority(
            case_dir, case, config, require_lowering=True
        )
        if set(counterexample) != expected_keys:
            raise RunnerError(f"{kind} counterexample evidence is malformed")
        statement = nonnegative_integer(
            counterexample.get("statement"), f"{kind} statement"
        )
        if (
            not isinstance(counterexample.get("witness_sql"), str)
            or not counterexample["witness_sql"].strip()
            or any(
                not isinstance(counterexample.get(key), str)
                for key in ("source_result", "target_result")
            )
            or (
                kind == "dataDifference"
                and not isinstance(counterexample.get("diff_sample"), str)
            )
        ):
            raise RunnerError(f"{kind} counterexample fields are malformed")
        if kind == "rowSequenceDifference":
            nonnegative_integer(
                counterexample.get("first_differing_row"),
                "row-sequence first differing row",
            )
        validate_observation_certificate(
            case_dir, counterexample.get("certificate"), statement, comparison
        )
    else:
        validate_case_input_and_lowering_authority(
            case_dir, case, config, require_lowering=False
        )

    stage_report_path = case_dir / "counterexample-stage/report.json"
    require_regular_nonsymlink_file(stage_report_path, "counterexample-stage report")
    stage_report = read_json_object(stage_report_path, "counterexample-stage report")
    if (
        set(stage_report)
        != {"outcome", "reason", "rounds", "counterexample", "elapsedMs", "llmUsage"}
        or
        stage_report.get("outcome") != "not_equivalent"
        or stage_report.get("counterexample") != counterexample
        or stage_report.get("rounds") != solver_rounds
    ):
        raise RunnerError("reported counterexample differs from counterexample-stage authority")
    if comparison is not None:
        validate_database_counterexample_round_authority(
            case_dir, stage_report, counterexample, comparison
        )


def validate_database_counterexample_round_authority(
    case_dir: Path,
    stage_report: dict[str, Any],
    counterexample: dict[str, Any],
    comparison: str,
) -> None:
    rounds = stage_report.get("rounds")
    if not isinstance(rounds, list) or not rounds or any(
        not isinstance(record, dict) for record in rounds
    ):
        raise RunnerError("database counterexample has no preserved validation round")
    expected_result = dict(counterexample)
    expected_result.pop("witness_sql")
    terminal_rounds = [
        record
        for record in rounds
        if isinstance(record.get("validation"), dict)
        and record["validation"].get("result") == expected_result
    ]
    if len(terminal_rounds) != 1 or terminal_rounds[0] is not rounds[-1]:
        raise RunnerError(
            "database counterexample has no unique terminal validation round"
        )
    terminal = terminal_rounds[0]
    round_number = nonnegative_integer(
        terminal.get("round"), "counterexample validation round"
    )
    if round_number < 1 or [record.get("round") for record in rounds] != list(
        range(1, len(rounds) + 1)
    ):
        raise RunnerError("counterexample validation rounds are not consecutive")
    proposal = terminal.get("proposal")
    validation = terminal.get("validation")
    assessment = terminal.get("assessment")
    if (
        not isinstance(proposal, dict)
        or proposal.get("decision") != "counterexample_candidate"
        or proposal.get("witnessSql") != counterexample["witness_sql"]
        or not isinstance(assessment, dict)
        or assessment.get("round") != round_number
        or assessment.get("proposalPath")
        != f"rounds/{round_number:02d}/proposal.json"
        or assessment.get("candidatePath")
        != f"rounds/{round_number:02d}/candidate.json"
        or not isinstance(validation.get("schemaName"), str)
        or not validation["schemaName"]
        or set(validation) not in (
            {"schemaName", "result"},
            {"schemaName", "warnings", "result"},
        )
        or (
            "warnings" in validation
            and not isinstance(validation.get("warnings"), list)
        )
    ):
        raise RunnerError("terminal database validation round is malformed")

    round_root = case_dir / f"rounds/{round_number:02d}"
    require_real_directory_chain(
        case_dir, round_root, "counterexample validation round artifacts"
    )
    witness_path = round_root / "witness.sql"
    validation_path = round_root / "validation.json"
    round_report_path = round_root / "round-report.json"
    require_regular_nonsymlink_file(witness_path, "counterexample witness artifact")
    require_regular_nonsymlink_file(
        validation_path, "counterexample validation artifact"
    )
    require_regular_nonsymlink_file(
        round_report_path, "counterexample round report"
    )
    try:
        witness_text = witness_path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise RunnerError("counterexample witness artifact is not UTF-8") from error
    if (
        witness_text != counterexample["witness_sql"]
        or read_json_object(validation_path, "counterexample validation artifact")
        != validation
    ):
        raise RunnerError("counterexample validation artifacts drifted")
    round_report = read_json_object(round_report_path, "counterexample round report")
    validation_log = round_report.get("validation")
    expected_outcome = (
        "data_difference" if comparison == "bag" else "row_sequence_difference"
    )
    if (
        set(round_report)
        != {"round", "assessment", "validation", "outcome", "error"}
        or round_report.get("round") != round_number
        or round_report.get("assessment") != assessment
        or round_report.get("outcome") != "counterexample_validated"
        or round_report.get("error") is not None
        or not isinstance(validation_log, dict)
        or set(validation_log) not in (
            {"startedMsSinceEpoch", "elapsedMs", "result"},
            {"startedMsSinceEpoch", "elapsedMs", "result", "warnings"},
        )
        or validation_log.get("result") != expected_outcome
        or (
            "warnings" in validation_log
            and validation_log.get("warnings") != validation.get("warnings")
        )
    ):
        raise RunnerError("counterexample round report/outcome binding drifted")
    nonnegative_integer(
        validation_log.get("startedMsSinceEpoch"),
        "counterexample validation start",
    )
    nonnegative_integer(
        validation_log.get("elapsedMs"), "counterexample validation elapsedMs"
    )


def validate_database_counterexample_proof_handoff(
    proof: Any, result: dict[str, Any], config: RunConfig
) -> None:
    if not isinstance(proof, dict):
        raise RunnerError("proof-bearing database counterexample is malformed")
    rounds = proof.get("proofAgentRounds")
    final_agent = proof.get("proofAgent")
    configuration = proof.get("proofAgentConfiguration")
    metrics = result.get("proofMetrics")
    handoff = (
        final_agent.get("counterexampleHandoff")
        if isinstance(final_agent, dict)
        else None
    )
    if (
        proof.get("backendStatus") != "proof_agent_run_completed"
        or proof.get("verificationMode")
        != config.verification_mode.replace("-", "_")
        or proof.get("certification") is not None
        or proof.get("proofSearchTimedOut") is not False
        or proof.get("deterministicTailRecovery") is not None
        or not isinstance(configuration, dict)
        or configuration.get("enabled") is not True
        or not isinstance(rounds, list)
        or not rounds
        or any(not isinstance(round_record, dict) for round_record in rounds)
        or final_agent != rounds[-1]
        or final_agent.get("success") is not False
        or final_agent.get("candidateClaim") is not None
        or final_agent.get("proofCheckExitCode") == 0
        or not isinstance(handoff, dict)
        or set(handoff) != {"decision", "reason", "guidance"}
        or handoff.get("decision") != "counterexample_candidate"
        or any(
            not isinstance(handoff.get(key), str) or not handoff[key].strip()
            for key in ("reason", "guidance")
        )
        or not isinstance(metrics, dict)
        or metrics.get("proofRoundCount") != len(rounds)
        or metrics.get("preflightInvocationCount", 0) < 1
        or metrics.get("initialProblemCompileInvocationCount", 0) < 1
        or not isinstance(metrics.get("proofSource"), dict)
        or metrics["proofSource"].get("present") is not True
    ):
        raise RunnerError(
            "proof-bearing database counterexample lacks strict terminal handoff provenance"
        )


def validate_proof_backend_coherence(
    report: dict[str, Any], proof: dict[str, Any]
) -> str:
    """Recompute the solver's Rust backend-state mapping from report evidence."""
    workspace = proof.get("proofWorkspace")
    if workspace is not None and not isinstance(workspace, dict):
        raise RunnerError("proofWorkspace is malformed")
    workspace_generated = isinstance(workspace, dict)

    rounds = proof.get("proofAgentRounds", [])
    final_agent = proof.get("proofAgent")
    if (
        not isinstance(rounds, list)
        or any(not isinstance(record, dict) for record in rounds)
        or (rounds and final_agent != rounds[-1])
        or (not rounds and final_agent is not None)
        or (final_agent is not None and not workspace_generated)
    ):
        raise RunnerError("proof backend round/workspace evidence is incoherent")
    for record in rounds:
        if not isinstance(record.get("success"), bool):
            raise RunnerError("proof backend round success state is malformed")
    if final_agent is not None:
        exit_code = final_agent.get("exitCode")
        if exit_code is not None and (
            isinstance(exit_code, bool) or not isinstance(exit_code, int)
        ):
            raise RunnerError("proof backend final exitCode is malformed")

    timed_out = proof.get("proofSearchTimedOut")
    if not isinstance(timed_out, bool):
        raise RunnerError("proofSearchTimedOut must be boolean")
    recovery = proof.get("deterministicTailRecovery")
    terminal_handoff = report_has_strict_terminal_counterexample_handoff(
        report, final_agent
    )

    if recovery is not None:
        if not workspace_generated or final_agent is None or timed_out is not False:
            raise RunnerError("deterministic-tail backend promotion is incoherent")
        expected = "proof_complete"
    elif terminal_handoff:
        expected = (
            "proof_agent_run_completed"
            if workspace_generated and final_agent is not None
            else "proof_agent_failed"
        )
    elif (
        isinstance(final_agent, dict)
        and round_has_unresumable_session_suffix(final_agent)
    ):
        expected = "proof_agent_failed"
    elif not workspace_generated:
        expected = "lowering_blocked"
    elif isinstance(final_agent, dict) and final_agent.get("success") is True:
        expected = "proof_complete"
    elif timed_out:
        expected = "proof_search_timed_out"
    elif (
        isinstance(final_agent, dict)
        and final_agent.get("success") is False
        and final_agent.get("exitCode") == 0
    ):
        expected = "proof_agent_run_completed"
    elif isinstance(final_agent, dict) and final_agent.get("success") is False:
        expected = "proof_agent_failed"
    else:
        expected = "workspace_generated"

    if (
        recovery is None
        and not terminal_handoff
        and timed_out is not (expected == "proof_search_timed_out")
    ):
        raise RunnerError("proof timeout flag is incoherent with backend state")
    certification = proof.get("certification")
    if certification is None and any(
        record.get("success") is True for record in rounds
    ):
        raise RunnerError("uncertified outcome contains a successful proof-agent round")
    if expected == "proof_complete" and certification is None:
        raise RunnerError("proof_complete backend has no certification")
    if certification is not None and expected != "proof_complete":
        raise RunnerError("proof certification is incoherent with backend state")
    if proof.get("backendStatus") != expected:
        raise RunnerError(
            "proof backend status differs from Rust evidence mapping: "
            f"reported {proof.get('backendStatus')!r}, expected {expected!r}"
        )
    return expected


def validate_ordinary_terminal_problem_binding(
    proof: dict[str, Any],
    final_agent: dict[str, Any],
    metrics: dict[str, Any],
    case_dir: Path,
    verification_mode: str,
    outcome: str,
) -> None:
    workspace = proof.get("proofWorkspace")
    expected_problem_value = "proof-stage/formal-sql/Problem.v"
    terminal_round = final_agent.get("round")
    if isinstance(terminal_round, bool) or not isinstance(terminal_round, int) or terminal_round < 1:
        raise RunnerError("ordinary terminal proof has an invalid round number")
    expected_closure_value = (
        f"proof-stage/proof-agent/rounds/{terminal_round:02d}/"
        "checked-workspace/authority-closure.txt"
    )
    proof_source = metrics.get("proofSource")
    live_problem = case_dir / expected_problem_value
    checked_problem = (
        case_dir / Path(expected_closure_value).parent / "Problem.v"
    )
    if (
        not isinstance(workspace, dict)
        or workspace.get("problemPath") != expected_problem_value
        or final_agent.get("authorityClosurePath") != expected_closure_value
        or not isinstance(proof_source, dict)
        or proof_source.get("path") != workspace_display_path(live_problem)
        or proof_source.get("present") is not True
    ):
        raise RunnerError("ordinary terminal proof source paths are not canonical")
    require_real_directory_chain(
        case_dir, live_problem.parent, "ordinary live proof workspace"
    )
    require_regular_nonsymlink_file(live_problem, "ordinary live Problem.v")
    require_real_directory_chain(
        case_dir, checked_problem.parent, "ordinary checked proof workspace"
    )
    require_regular_nonsymlink_file(
        checked_problem, "ordinary checked Problem.v"
    )
    candidate_sha256 = final_agent.get("candidateProblemSha256")
    live_bytes = live_problem.read_bytes()
    checked_bytes = checked_problem.read_bytes()
    live_sha256 = hashlib.sha256(live_bytes).hexdigest()
    if (
        re.fullmatch(r"[0-9a-f]{64}", str(candidate_sha256)) is None
        or live_bytes != checked_bytes
        or live_sha256 != candidate_sha256
        or proof_source.get("sha256") != live_sha256
        or proof_source.get("bytes") != len(live_bytes)
    ):
        raise RunnerError(
            "ordinary terminal live/checked/candidate Problem.v binding drifted"
        )
    try:
        problem_text = live_bytes.decode("utf-8", errors="strict")
    except UnicodeError as error:
        raise RunnerError("ordinary terminal Problem.v is not UTF-8") from error
    normalized_mode = verification_mode.replace("-", "_")
    if not problem_declares_final_theorem(problem_text, normalized_mode):
        raise RunnerError("ordinary terminal Problem.v lacks the mode-specific theorem")
    if final_agent.get("candidateClaim") != "equivalence":
        raise RunnerError("ordinary terminal report claim is not equivalence")
    if normalized_mode in {"safe_unconditional", "outcome_unconditional"}:
        if (
            not problem_declares_equivalence_claim(problem_text)
            or final_agent.get("preconditionSource") is not None
            or final_agent.get("preconditionDefinition") is not None
        ):
            raise RunnerError(
                "ordinary terminal Problem.v lacks exact unconditional equivalence provenance"
            )
    elif normalized_mode == "conditional":
        provenance = problem_conditional_provenance(problem_text)
        expected_source = {
            "conditional_derived": "derived",
            "conditional_external": "external",
        }.get(outcome)
        if (
            provenance is None
            or provenance[0] != expected_source
            or final_agent.get("preconditionSource") != provenance[0]
            or final_agent.get("preconditionDefinition") != provenance[1]
        ):
            raise RunnerError(
                "ordinary conditional Problem.v provenance binding drifted"
            )
    else:
        raise RunnerError("ordinary terminal proof has an unknown verification mode")


def validate_completed_report(
    report: dict[str, Any],
    result: dict[str, Any],
    case_dir: Path,
    case: BenchmarkCase | None = None,
    config: RunConfig | None = None,
) -> None:
    log_dir = report.get("logDir")
    if not isinstance(log_dir, str) or Path(log_dir).resolve() != case_dir.resolve():
        raise RunnerError("solver report logDir does not identify this case directory")
    outcome = report.get("outcome")
    proof = report.get("proof")
    if proof is not None and not isinstance(proof, dict):
        raise RunnerError("completed full-pipeline report proof is malformed")
    if isinstance(proof, dict):
        validate_proof_backend_coherence(report, proof)
    certification = proof.get("certification") if isinstance(proof, dict) else None
    backend_status = proof.get("backendStatus") if isinstance(proof, dict) else None
    certified_outcomes = {
        "safe_unconditional": (
            "SAFE-UNCONDITIONAL",
            "safe_unconditional",
            None,
        ),
        "outcome_unconditional": (
            "OUTCOME-UNCONDITIONAL",
            "outcome_unconditional",
            None,
        ),
        "conditional_derived": (
            "CONDITIONAL-DERIVED",
            "conditional",
            "derived",
        ),
        "conditional_external": (
            "CONDITIONAL-EXTERNAL",
            "conditional",
            "external",
        ),
    }
    if outcome in certified_outcomes:
        expected_certification, expected_mode, expected_precondition_source = (
            certified_outcomes[outcome]
        )
        agent = (
            proof.get("proofAgentConfiguration") if isinstance(proof, dict) else None
        )
        final_agent = proof.get("proofAgent") if isinstance(proof, dict) else None
        metrics = result["proofMetrics"]
        audit = final_agent.get("audit") if isinstance(final_agent, dict) else None
        ordinary_terminal_certificate = (
            isinstance(final_agent, dict)
            and final_agent.get("success") is True
            and final_agent.get("candidateClaim") == "equivalence"
            and final_agent.get("candidateProblemCompilePassed") is True
            and final_agent.get("candidateHasFinalTheorem") is True
            and final_agent.get("proofCheckExitCode") == 0
            and final_agent.get("proofCheckTimedOut") is False
            and isinstance(audit, dict)
            and audit.get("passed") is True
            and audit.get("findings") == []
        )
        recovery = proof.get("deterministicTailRecovery") if isinstance(proof, dict) else None
        recovered_outcome_certificate = (
            outcome == "outcome_unconditional"
            and isinstance(recovery, dict)
            and recovery.get("status") == "published"
            and recovery.get("claim") == "equivalence"
        )
        if ordinary_terminal_certificate:
            validate_ordinary_terminal_problem_binding(
                proof,
                final_agent,
                metrics,
                case_dir,
                expected_mode,
                outcome,
            )
        if recovered_outcome_certificate:
            if case is None or config is None:
                raise RunnerError(
                    "recovered outcome certificate has no runner authority context"
                )
            validate_deterministic_tail_recovery(
                proof,
                proof.get("proofAgentRounds", []),
                case_dir,
                config,
            )
        if (
            not isinstance(proof, dict)
            or backend_status != "proof_complete"
            or certification != expected_certification
            or proof.get("verificationMode") != expected_mode
            or not isinstance(agent, dict)
            or agent.get("enabled") is not True
            or metrics["proofRoundCount"] < 1
            or metrics["diagnosticInvocationCount"] < 1
            or metrics["finalProofCheckElapsedMs"] is None
            or metrics["proofSource"].get("present") is not True
            or not (
                ordinary_terminal_certificate or recovered_outcome_certificate
            )
        ):
            raise RunnerError(
                f"{outcome} report lacks complete proof-agent and trusted "
                "certificate evidence"
            )
        if expected_precondition_source is not None and (
            not isinstance(final_agent, dict)
            or final_agent.get("preconditionSource")
            != expected_precondition_source
            or not isinstance(final_agent.get("preconditionDefinition"), str)
            or not final_agent["preconditionDefinition"]
        ):
            raise RunnerError(
                f"{outcome} report lacks its audited precondition provenance"
            )
    elif outcome == "not_equivalent":
        counterexample = report.get("counterexample")
        if not isinstance(counterexample, dict):
            raise RunnerError("not_equivalent report lacks typed counterexample evidence")
        if certification is None:
            if case is None or config is None:
                raise RunnerError(
                    "direct database counterexample lacks runner-bound authority"
                )
            if proof is not None:
                validate_database_counterexample_proof_handoff(
                    proof, result, config
                )
            validate_database_counterexample(
                counterexample,
                case_dir,
                case,
                config,
                result,
                report.get("rounds"),
            )
        elif certification == "FORMAL-COUNTERMODEL":
            validate_formal_countermodel_certificate(
                report, result, case_dir, counterexample, config
            )
        else:
            raise RunnerError(
                "not_equivalent report carries an unsupported certification"
            )
    elif outcome == "equivalence_verification_incomplete":
        allowed = {
            None,
            "lowering_blocked",
            "workspace_generated",
            "proof_agent_run_completed",
            "proof_search_timed_out",
            "proof_agent_failed",
        }
        if (
            not isinstance(proof, dict)
            or certification is not None
            or backend_status not in allowed
        ):
            raise RunnerError(
                "incomplete verification report carries incoherent proof status"
            )
    elif outcome == "needs_manual_review":
        if not isinstance(proof, dict) or certification is not None:
            raise RunnerError(
                "manual-review report must carry coherent uncertified proof evidence"
            )
    else:
        raise RunnerError(
            f"completed full-pipeline report has forbidden or unknown outcome {outcome!r}"
        )


def validate_formal_countermodel_certificate(
    report: dict[str, Any],
    result: dict[str, Any],
    case_dir: Path,
    counterexample: dict[str, Any],
    config: RunConfig | None = None,
) -> None:
    proof = report.get("proof")
    workspace = proof.get("proofWorkspace") if isinstance(proof, dict) else None
    agent = proof.get("proofAgent") if isinstance(proof, dict) else None
    audit = agent.get("audit") if isinstance(agent, dict) else None
    configuration = (
        proof.get("proofAgentConfiguration") if isinstance(proof, dict) else None
    )
    context = configuration.get("context") if isinstance(configuration, dict) else None
    metrics = result.get("proofMetrics")
    rounds = proof.get("proofAgentRounds") if isinstance(proof, dict) else None
    recovery = (
        proof.get("deterministicTailRecovery") if isinstance(proof, dict) else None
    )
    recovered_countermodel = (
        isinstance(recovery, dict)
        and recovery.get("status") == "published"
        and recovery.get("claim") == "formal_countermodel"
    )
    if recovered_countermodel:
        if config is None:
            raise RunnerError(
                "recovered FORMAL-COUNTERMODEL certificate has no runner authority context"
            )
        validate_deterministic_tail_recovery(
            proof,
            rounds if isinstance(rounds, list) else [],
            case_dir,
            config,
        )
    ordinary_agent_certificate = (
        isinstance(agent, dict)
        and agent.get("success") is True
        and agent.get("candidateClaim") == "formal_countermodel"
        and agent.get("candidateProblemCompilePassed") is True
        and agent.get("candidateHasFinalTheorem") is True
        and agent.get("proofCheckExitCode") == 0
        and agent.get("proofCheckTimedOut") is False
        and isinstance(audit, dict)
        and audit.get("passed") is True
        and audit.get("findings") == []
    )
    certified_problem_sha256 = (
        recovery.get("publishedProblem", {}).get("sha256")
        if recovered_countermodel
        else (agent.get("candidateProblemSha256") if isinstance(agent, dict) else None)
    )
    certified_authority_sha256 = (
        agent.get("authorityClosureSha256") if isinstance(agent, dict) else None
    )
    countermodel_fields = (
        {
            "problemPath": counterexample.get("problemPath"),
            "goalPath": counterexample.get("goalPath"),
            "problemSha256": counterexample.get("problemSha256"),
            "contextManifestSha256": counterexample.get("contextManifestSha256"),
            "authorityClosureSha256": counterexample.get("authorityClosureSha256"),
            "trustedCheckExitCode": counterexample.get("trustedCheckExitCode"),
        }
        if recovered_countermodel
        else {
            "problemPath": counterexample.get(
                "problemPath", counterexample.get("problem_path")
            ),
            "goalPath": counterexample.get(
                "goalPath", counterexample.get("goal_path")
            ),
            "problemSha256": counterexample.get(
                "problemSha256", counterexample.get("problem_sha256")
            ),
            "contextManifestSha256": counterexample.get(
                "contextManifestSha256",
                counterexample.get("context_manifest_sha256"),
            ),
            "authorityClosureSha256": counterexample.get(
                "authorityClosureSha256",
                counterexample.get("authority_closure_sha256"),
            ),
            "trustedCheckExitCode": counterexample.get(
                "trustedCheckExitCode", counterexample.get("trusted_check_exit_code")
            ),
        }
    )
    if recovered_countermodel and any(
        key in counterexample
        for key in (
            "problem_path",
            "goal_path",
            "problem_sha256",
            "context_manifest_sha256",
            "authority_closure_sha256",
            "trusted_check_exit_code",
        )
    ):
        raise RunnerError("recovered FORMAL-COUNTERMODEL evidence is not camelCase")
    if (
        counterexample.get("kind") != "formalSqlCountermodel"
        or not isinstance(proof, dict)
        or proof.get("backendStatus") != "proof_complete"
        or proof.get("certification") != "FORMAL-COUNTERMODEL"
        or not isinstance(workspace, dict)
        or not isinstance(agent, dict)
        or not isinstance(rounds, list)
        or not rounds
        or any(not isinstance(value, dict) for value in rounds)
        or agent != rounds[-1]
        or not (ordinary_agent_certificate or recovered_countermodel)
        or counterexample.get("theorem") != "generated_verification_certificate"
        or countermodel_fields["trustedCheckExitCode"] != 0
        or countermodel_fields["problemPath"] != workspace.get("problemPath")
        or countermodel_fields["goalPath"] != workspace.get("goalPath")
        or countermodel_fields["problemSha256"]
        != certified_problem_sha256
        or countermodel_fields["contextManifestSha256"]
        != agent.get("contextManifestSha256")
        or countermodel_fields["authorityClosureSha256"]
        != certified_authority_sha256
        or not isinstance(context, dict)
        or configuration.get("enabled") is not True
        or countermodel_fields["contextManifestSha256"]
        != context.get("manifestSha256")
        or not isinstance(metrics, dict)
        or metrics.get("proofRoundCount", 0) < 1
        or metrics.get("finalProofCheckElapsedMs") is None
        or not isinstance(metrics.get("proofSource"), dict)
        or metrics["proofSource"].get("present") is not True
        or metrics["proofSource"].get("sha256")
        != countermodel_fields["problemSha256"]
    ):
        raise RunnerError(
            "FORMAL-COUNTERMODEL report lacks a fully bound trusted Rocq certificate"
        )

    resolved: dict[str, Path] = {}
    for field, workspace_field, digest_field in (
        ("problemPath", "problemPath", "problemSha256"),
        ("goalPath", "goalPath", None),
    ):
        value = countermodel_fields[field]
        if not isinstance(value, str) or value != workspace.get(workspace_field):
            raise RunnerError(f"FORMAL-COUNTERMODEL {field} binding is malformed")
        path = resolve_case_artifact(case_dir, value, f"FORMAL-COUNTERMODEL {field}")
        resolved[field] = path
        if not path.is_file() or path.is_symlink():
            raise RunnerError(f"FORMAL-COUNTERMODEL {field} is not a regular file")
        if (
            digest_field is not None
            and sha256_file(path) != countermodel_fields[digest_field]
        ):
            raise RunnerError(f"FORMAL-COUNTERMODEL {field} digest drifted")

    verification_mode = proof.get("verificationMode")
    try:
        problem_text = resolved["problemPath"].read_text(encoding="utf-8")
        goal_text = resolved["goalPath"].read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise RunnerError(
            f"FORMAL-COUNTERMODEL source is not readable UTF-8: {error}"
        ) from error
    if (
        not isinstance(verification_mode, str)
        or not problem_declares_formal_countermodel_claim(problem_text)
        or not problem_declares_final_theorem(problem_text, verification_mode)
        or not rocq_declares_direct_theorem(
            goal_text, "generated_verification_certificate"
        )
    ):
        raise RunnerError(
            "FORMAL-COUNTERMODEL source does not declare the certified claim"
        )

    bound_artifacts = (
        (
            context.get("manifestPath"),
            workspace.get("contextManifestPath"),
            countermodel_fields["contextManifestSha256"],
            "context manifest",
        ),
        (
            agent.get("authorityClosurePath"),
            None,
            countermodel_fields["authorityClosureSha256"],
            "authority closure",
        ),
    )
    for value, expected, digest, description in bound_artifacts:
        if not isinstance(value, str) or (
            expected is not None and value != expected
        ):
            raise RunnerError(
                f"FORMAL-COUNTERMODEL {description} binding is malformed"
            )
        path = resolve_case_artifact(
            case_dir, value, f"FORMAL-COUNTERMODEL {description}"
        )
        if not path.is_file() or path.is_symlink() or sha256_file(path) != digest:
            raise RunnerError(
                f"FORMAL-COUNTERMODEL {description} artifact drifted"
            )

    manifest_path = resolve_case_artifact(
        case_dir,
        context["manifestPath"],
        "FORMAL-COUNTERMODEL context manifest",
    )
    manifest = read_json_object(manifest_path, "FORMAL-COUNTERMODEL context manifest")
    goal_binding = manifest.get("goalModule")
    if (
        not isinstance(goal_binding, dict)
        or goal_binding.get("path") != "Goal.v"
        or goal_binding.get("sha256") != sha256_file(resolved["goalPath"])
        or nonnegative_integer(
            goal_binding.get("bytes"), "FORMAL-COUNTERMODEL Goal.v bytes"
        )
        != resolved["goalPath"].stat().st_size
    ):
        raise RunnerError("FORMAL-COUNTERMODEL Goal.v context binding drifted")
    checked_workspace = (
        resolve_case_artifact(
            case_dir,
            recovery["stagingWorkspace"]["path"],
            "recovered FORMAL-COUNTERMODEL staging workspace",
        )
        if recovered_countermodel
        else resolve_case_artifact(
            case_dir,
            agent["authorityClosurePath"],
            "FORMAL-COUNTERMODEL authority closure",
        ).parent
    )
    checked_problem = checked_workspace / "Problem.v"
    checked_goal = checked_workspace / "Goal.v"
    if (
        not checked_problem.is_file()
        or checked_problem.is_symlink()
        or sha256_file(checked_problem) != sha256_file(resolved["problemPath"])
        or not checked_goal.is_file()
        or checked_goal.is_symlink()
        or sha256_file(checked_goal) != sha256_file(resolved["goalPath"])
    ):
        raise RunnerError("FORMAL-COUNTERMODEL checked workspace binding drifted")


def validate_counterexample_provider_commands(report: dict[str, Any]) -> None:
    rounds = report.get("rounds")
    if not isinstance(rounds, list):
        raise RunnerError("solver report counterexample rounds are malformed")
    for index, round_record in enumerate(rounds, start=1):
        assessment = (
            round_record.get("assessment") if isinstance(round_record, dict) else None
        )
        provider = assessment.get("provider") if isinstance(assessment, dict) else None
        if provider is None:
            continue
        if not isinstance(provider, dict):
            raise RunnerError(
                f"counterexample round {index} used an overridden provider command"
            )
        session_resumed = provider.get("sessionResumed")
        session_id = provider.get("sessionId")
        command = provider.get("command")
        if session_resumed in {None, False} and command == DEFAULT_COUNTEREXAMPLE_COMMAND:
            continue
        if (
            session_resumed is True
            and isinstance(session_id, str)
            and re.fullmatch(
                r"[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}",
                session_id,
            )
            and command
            == DEFAULT_COUNTEREXAMPLE_RESUME_COMMAND.replace(
                "{session_id}", session_id
            )
        ):
            continue
        raise RunnerError(
            f"counterexample round {index} used an overridden or incoherent provider command"
        )


def append_solver_report(
    result: dict[str, Any],
    report_path: Path,
    case: BenchmarkCase,
    config: RunConfig,
) -> None:
    result["reportEvidence"] = {
        "path": workspace_display_path(report_path),
        "present": False,
        "sha256": None,
    }
    result["proofMetrics"]["proofSource"] = proof_source_evidence(report_path.parent)
    if not report_path.exists():
        result["proofMetrics"]["proofSource"] = proof_source_evidence(
            report_path.parent
        )
        recover_usage_into_result(result, report_path.parent)
        if result.get("status") == "completed":
            result["reportCoherenceError"] = "solver completed without report.json"
        return
    if not report_path.is_file() or report_path.is_symlink():
        result["reportError"] = "solver report is not a regular non-symlink file"
        recover_usage_into_result(
            result,
            report_path.parent,
            context="solver report is not a regular file",
            require_usage=True,
        )
        return
    result["reportEvidence"] = {
        "path": workspace_display_path(report_path),
        "present": True,
        "sha256": sha256_file(report_path),
    }
    try:
        report = json.loads(report_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        result["reportError"] = str(error)
        recover_usage_into_result(
            result,
            report_path.parent,
            context="solver report could not be read",
            require_usage=True,
        )
        return
    if not isinstance(report, dict):
        result["reportError"] = "solver report is not a JSON object"
        recover_usage_into_result(
            result,
            report_path.parent,
            context="solver report is not a JSON object",
            require_usage=True,
        )
        return
    try:
        validate_counterexample_provider_commands(report)
        result["proofMetrics"] = proof_metrics_from_report(
            report, case, config, report_path.parent
        )
    except RunnerError as error:
        result["reportCoherenceError"] = str(error)
    for key in ("outcome", "reason"):
        if key in report:
            result[key] = report[key]
    proof = report.get("proof")
    if isinstance(proof, dict):
        if "backendStatus" in proof:
            result["backendStatus"] = proof["backendStatus"]
        if "certification" in proof:
            result["certification"] = proof["certification"]
        usage_complete = proof.get("usageComplete")
        if isinstance(usage_complete, bool):
            result["usageComplete"] = usage_complete
    result["counterexamplePresent"] = report.get("counterexample") is not None
    if result.get("status") == "completed":
        try:
            validate_completed_report(
                report, result, report_path.parent, case, config
            )
        except RunnerError as error:
            result.setdefault("reportCoherenceError", str(error))
    try:
        result["llmUsage"] = validate_llm_usage(report.get("llmUsage"))
    except RunnerError as error:
        result["reportUsageError"] = str(error)
        recover_usage_into_result(
            result,
            report_path.parent,
            context=f"solver report usage invalid: {error}",
            require_usage=True,
        )


def recover_usage_into_result(
    result: dict[str, Any],
    case_dir: Path,
    *,
    context: str | None = None,
    require_usage: bool = False,
) -> None:
    try:
        result["llmUsage"] = recover_llm_usage(case_dir, require_usage=require_usage)
        result["usageComplete"] = True
        result.pop("usageError", None)
    except RunnerError as error:
        result.pop("llmUsage", None)
        result["usageComplete"] = False
        result["usageError"] = f"{context}; {error}" if context else str(error)


def recover_llm_usage(case_dir: Path, *, require_usage: bool = False) -> dict[str, Any]:
    """Recover completed provider turns when the solver has no terminal report.

    This never invents counts. A started round without a structured terminal
    record is an accounting error; a failure before any LLM stage is a genuine
    zero-token case.
    """
    usages: list[dict[str, Any]] = []
    counterexample_prompts = {
        path.parent for path in (case_dir / "rounds").glob("*/prompt.md")
    }
    counterexample_reports = {
        path.parent for path in (case_dir / "rounds").glob("*/round-report.json")
    }
    if counterexample_prompts - counterexample_reports:
        raise RunnerError(
            "counterexample invocation has no terminal provider usage record"
        )
    for path in sorted((case_dir / "rounds").glob("*/round-report.json")):
        report = read_json_object(path, "counterexample round report")
        assessment = report.get("assessment")
        if not isinstance(assessment, dict):
            raise RunnerError(f"{path}: assessment must be a JSON object")
        provider = assessment.get("provider")
        if provider is None:  # Reused cache: no invocation in this run.
            continue
        if not isinstance(provider, dict):
            raise RunnerError(f"{path}: assessment.provider must be a JSON object")
        if provider.get("usageError"):
            raise RunnerError(f"{path}: {provider['usageError']}")
        usages.append(validate_llm_usage(provider.get("usage")))

    proof_rounds_root = case_dir / "proof-stage/proof-agent/rounds"
    proof_round_dirs = sorted(
        (path for path in proof_rounds_root.glob("*") if path.is_dir()),
        key=round_directory_sort_key,
    )
    missing_proof_runs = [
        path for path in proof_round_dirs if not (path / "run.json").is_file()
    ]
    if missing_proof_runs:
        raise RunnerError(
            "proof-agent invocation has no terminal run.json usage record: "
            + ", ".join(str(path) for path in missing_proof_runs[:4])
        )
    proof_runs = [path / "run.json" for path in proof_round_dirs]
    proof_sessions: dict[
        str,
        list[tuple[Path, dict[str, Any], dict[str, Any] | None]],
    ] = {}
    proof_records: list[dict[str, Any]] = []
    for path in proof_runs:
        record = read_json_object(path, "proof-agent run record")
        proof_records.append(record)
        if record.get("usageError"):
            raise RunnerError(f"{path}: {record['usageError']}")
        session_id = record.get("sessionId")
        if not isinstance(session_id, str) or not session_id.strip():
            raise RunnerError(f"{path}: proof-agent sessionId must be nonempty")
        if "cumulativeUsage" in record:
            cumulative = validate_llm_usage(record.get("cumulativeUsage"))
            observed_delta = validate_llm_usage(record.get("usage"))
        else:
            # Legacy run records stored Codex's cumulative thread snapshot in
            # `usage`. New records retain that snapshot separately and expose
            # only the current resumed invocation's delta as `usage`.
            cumulative = validate_llm_usage(record.get("usage"))
            observed_delta = None
        proof_sessions.setdefault(session_id, []).append(
            (path, cumulative, observed_delta)
        )
    validate_proof_agent_session_sequence(proof_records, str(proof_rounds_root))
    for session_id, snapshots in proof_sessions.items():
        previous: tuple[Path, dict[str, Any]] | None = None
        for path, cumulative, observed_delta in snapshots:
            expected_delta = proof_usage_delta(
                cumulative,
                previous[1] if previous is not None else None,
                path,
                previous[0] if previous is not None else None,
                session_id,
            )
            if observed_delta is not None and observed_delta != expected_delta:
                raise RunnerError(
                    f"{path}: proof usage delta disagrees with cumulativeUsage"
                )
            previous = (path, cumulative)
        usages.append(snapshots[-1][1])
    if require_usage and not usages:
        raise RunnerError("no authoritative provider usage records were found")
    return sum_usage(usages)


def proof_usage_delta(
    current: dict[str, Any],
    previous: dict[str, Any] | None,
    current_path: Path,
    previous_path: Path | None,
    session_id: str,
) -> dict[str, Any]:
    counts: dict[str, int] = {}
    for key in ("inputTokens", "cachedInputTokens", "outputTokens"):
        prior = previous[key] if previous is not None else 0
        if current[key] < prior:
            raise RunnerError(
                f"{current_path}: cumulative proof usage for session {session_id} "
                f"regresses {key} below {previous_path}"
            )
        counts[key] = current[key] - prior
    return validate_llm_usage(
        {
            "model": EXPECTED_MODEL,
            **counts,
            "totalTokens": counts["inputTokens"] + counts["outputTokens"],
            "estimatedCostUsd": (
                (counts["inputTokens"] - counts["cachedInputTokens"])
                * INPUT_USD_PER_MILLION_TOKENS
                + counts["cachedInputTokens"] * CACHED_INPUT_USD_PER_MILLION_TOKENS
                + counts["outputTokens"] * OUTPUT_USD_PER_MILLION_TOKENS
            )
            / 1_000_000,
        }
    )


def round_directory_sort_key(path: Path) -> tuple[int, int | str]:
    if path.name.isdigit():
        return (0, int(path.name))
    return (1, path.name)


def read_json_object(path: Path, description: str) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RunnerError(f"cannot read {description} {path}: {error}") from error
    if not isinstance(value, dict):
        raise RunnerError(f"{description} {path} is not a JSON object")
    return value


def read_json_array(path: Path, description: str) -> list[Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RunnerError(f"cannot read {description} {path}: {error}") from error
    if not isinstance(value, list):
        raise RunnerError(f"{description} {path} is not a JSON array")
    return value


def validate_llm_usage(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise RunnerError("solver report is missing llmUsage")
    if value.get("model") != EXPECTED_MODEL:
        raise RunnerError(f"llmUsage.model must be {EXPECTED_MODEL}")

    def token(name: str) -> int:
        count = value.get(name)
        if isinstance(count, bool) or not isinstance(count, int) or count < 0:
            raise RunnerError(f"llmUsage.{name} must be a nonnegative integer")
        return count

    input_tokens = token("inputTokens")
    cached_tokens = token("cachedInputTokens")
    output_tokens = token("outputTokens")
    total_tokens = token("totalTokens")
    if cached_tokens > input_tokens:
        raise RunnerError("llmUsage.cachedInputTokens exceeds inputTokens")
    if total_tokens != input_tokens + output_tokens:
        raise RunnerError("llmUsage.totalTokens is inconsistent")
    cost = value.get("estimatedCostUsd")
    if isinstance(cost, bool) or not isinstance(cost, (int, float)) or cost < 0:
        raise RunnerError("llmUsage.estimatedCostUsd must be a nonnegative number")
    expected_cost = (
        (input_tokens - cached_tokens) * INPUT_USD_PER_MILLION_TOKENS
        + cached_tokens * CACHED_INPUT_USD_PER_MILLION_TOKENS
        + output_tokens * OUTPUT_USD_PER_MILLION_TOKENS
    ) / 1_000_000
    if abs(float(cost) - expected_cost) > 1e-10:
        raise RunnerError("llmUsage.estimatedCostUsd does not match declared pricing")
    return {
        "model": EXPECTED_MODEL,
        "inputTokens": input_tokens,
        "cachedInputTokens": cached_tokens,
        "outputTokens": output_tokens,
        "totalTokens": total_tokens,
        "estimatedCostUsd": expected_cost,
    }


def aggregate_usage(results: list[dict[str, Any]]) -> dict[str, Any]:
    return sum_usage(result["llmUsage"] for result in results if "llmUsage" in result)


def sum_usage(usages: Iterable[dict[str, Any]]) -> dict[str, Any]:
    values = list(usages)
    input_tokens = sum(value["inputTokens"] for value in values)
    cached_tokens = sum(value["cachedInputTokens"] for value in values)
    output_tokens = sum(value["outputTokens"] for value in values)
    return validate_llm_usage(
        {
            "model": EXPECTED_MODEL,
            "inputTokens": input_tokens,
            "cachedInputTokens": cached_tokens,
            "outputTokens": output_tokens,
            "totalTokens": input_tokens + output_tokens,
            "estimatedCostUsd": (
                (input_tokens - cached_tokens) * INPUT_USD_PER_MILLION_TOKENS
                + cached_tokens * CACHED_INPUT_USD_PER_MILLION_TOKENS
                + output_tokens * OUTPUT_USD_PER_MILLION_TOKENS
            )
            / 1_000_000,
        }
    )


def write_case_result(
    config: RunConfig, case: BenchmarkCase, result: dict[str, Any]
) -> None:
    case_dir = config.run_dir / "cases" / case.case_id
    path = case_dir / "runner-result.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    atomic_write_json(path, result)

    write_case_result_sidecars(case_dir, case, result)


def write_case_result_sidecars(
    case_dir: Path, case: BenchmarkCase, result: dict[str, Any]
) -> None:
    """Reconcile derived case files from the authoritative runner result.

    A hard process exit can happen between publishing runner-result.json and any
    of its convenience sidecars.  Keep those sidecars atomic and rebuild them
    whenever a terminal result is reused; none of them is semantic authority.
    """
    atomic_write_json(
        case_dir / "status.json",
        {
            "schemaVersion": 1,
            "caseId": case.case_id,
            "status": result.get("status"),
            "returnCode": result.get("returnCode"),
            "outcome": result.get("outcome"),
            "backendStatus": result.get("backendStatus"),
            "certification": result.get("certification"),
            "runnerError": result.get("runnerError"),
            "usageError": result.get("usageError"),
            "usageComplete": result.get("usageComplete", "llmUsage" in result),
        },
    )
    atomic_write_bytes(
        case_dir / "time.txt",
        f"elapsed_ms={result.get('elapsedMs', 0)}\n".encode("utf-8"),
    )
    usage_path = case_dir / "usage.json"
    if "llmUsage" in result:
        atomic_write_json(usage_path, result["llmUsage"])
    else:
        try:
            usage_path.unlink(missing_ok=True)
        except OSError as error:
            raise RunnerError(
                f"cannot remove stale derived usage sidecar {usage_path}: {error}"
            ) from error


def result_counts(results: list[dict[str, Any]], total: int) -> dict[str, int]:
    counts = {
        "selected": total,
        "pending": total - len(results),
        "completed": 0,
        "timedOut": 0,
        "failed": 0,
        "cancelled": 0,
    }
    names = {
        "completed": "completed",
        "timed_out": "timedOut",
        "failed": "failed",
        "cancelled": "cancelled",
    }
    for result in results:
        key = names.get(result.get("status"))
        if key:
            counts[key] += 1
    return counts


def terminate_process_trees(
    processes: Iterable[ManagedProcess], grace_seconds: float
) -> None:
    """Terminate through exact, unreaped namespace-supervisor authority.

    A live ``Popen`` child cannot have its PID reused before it is reaped.  The
    supervisor's ``--kill-child=SIGKILL`` contract, together with PID-namespace
    PID 1 semantics, makes its death reclaim every solver descendant even if a
    signal handler forks a new session while termination is in progress.
    """

    processes = sorted(set(processes), key=lambda process: process.pid)
    locked: list[ManagedProcess] = []
    graceful_errors: list[Exception] = []
    try:
        # Workers never reap outside this same lock.  Holding every record lock
        # until the signal phase and reap complete makes the still-unreaped
        # leader an ownership pin for its numeric PID and PGID.
        for process in processes:
            process._lock.acquire()
            locked.append(process)
        active = [
            process for process in processes if process._return_code is None
        ]
        for process in active:
            descriptor = process._pidfd
            if descriptor is None or wait_for_pidfd_exit(descriptor, 0.0):
                continue
            try:
                # start_new_session makes the still-unreaped supervisor the
                # group leader.  While that exact leader exists, its numeric
                # PGID cannot be reused by an unrelated group.  This one
                # bounded group signal gives the namespace init/solver and
                # ordinary launch descendants a graceful cleanup opportunity.
                # Never inspect or signal this bare PGID after the leader exits.
                os.killpg(process.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            except Exception as error:
                graceful_errors.append(error)

        deadline = time.monotonic() + max(0.0, grace_seconds)
        while time.monotonic() < deadline and any(
            process._pidfd is not None
            and not wait_for_pidfd_exit(process._pidfd, 0.0)
            for process in active
        ):
            time.sleep(0.05)

        for process in active:
            descriptor = process._pidfd
            if descriptor is not None and not wait_for_pidfd_exit(descriptor, 0.0):
                pidfd_send_signal(descriptor, signal.SIGKILL)
        kill_wait_seconds = max(1.0, min(max(grace_seconds, 1.0), 5.0))
        kill_deadline = time.monotonic() + kill_wait_seconds
        while time.monotonic() < kill_deadline and any(
            process._pidfd is not None
            and not wait_for_pidfd_exit(process._pidfd, 0.0)
            for process in active
        ):
            time.sleep(0.02)
        survivors = [
            process
            for process in active
            if process._pidfd is not None
            and not wait_for_pidfd_exit(process._pidfd, 0.0)
        ]
        for process in active:
            if process not in survivors:
                process._reap_locked()
        if survivors:
            raise RunnerError(
                "case process supervisor(s) survived SIGKILL: "
                + ", ".join(str(process.pid) for process in survivors)
            )
        if graceful_errors:
            raise RunnerError(
                "cannot gracefully signal case process supervisor group(s): "
                + "; ".join(str(error) for error in graceful_errors)
            )
    finally:
        for process in reversed(locked):
            process._lock.release()


def terminate_process_group(
    process: ManagedProcess, grace_seconds: float
) -> None:
    terminate_process_trees((process,), grace_seconds)


SOLVER_PROCESS_IDENTITY_KEYS = {
    "schemaVersion",
    "pid",
    "processGroupId",
    "uid",
    "bootId",
    "startTimeTicks",
    "executableDevice",
    "executableInode",
    "processIsolationPolicy",
}


def current_boot_id() -> str:
    path = Path("/proc/sys/kernel/random/boot_id")
    try:
        value = path.read_text(encoding="ascii").strip()
    except (OSError, UnicodeError) as error:
        raise RunnerError(f"cannot read host boot identity {path}: {error}") from error
    if re.fullmatch(
        r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
        value,
    ) is None:
        raise RunnerError(f"host boot identity is malformed: {path}")
    return value


def parse_proc_stat(raw: str, expected_pid: int) -> tuple[str, int, int]:
    open_parenthesis = raw.find("(")
    close_parenthesis = raw.rfind(")")
    if open_parenthesis < 1 or close_parenthesis <= open_parenthesis:
        raise RunnerError(f"malformed /proc/{expected_pid}/stat record")
    try:
        recorded_pid = int(raw[:open_parenthesis].strip())
    except ValueError as error:
        raise RunnerError(f"malformed /proc/{expected_pid}/stat pid") from error
    fields = raw[close_parenthesis + 1 :].split()
    if recorded_pid != expected_pid or len(fields) < 20 or len(fields[0]) != 1:
        raise RunnerError(f"malformed /proc/{expected_pid}/stat identity")
    try:
        process_group_id = int(fields[2])
        start_time_ticks = int(fields[19])
    except ValueError as error:
        raise RunnerError(f"malformed /proc/{expected_pid}/stat identity") from error
    if process_group_id < 1 or start_time_ticks < 1:
        raise RunnerError(f"invalid /proc/{expected_pid}/stat identity")
    return fields[0], process_group_id, start_time_ticks


def observe_solver_process_identity(
    solver_pid: int,
) -> tuple[dict[str, Any], str] | None:
    proc_dir = Path("/proc") / str(solver_pid)
    try:
        metadata = proc_dir.stat()
        raw_stat = (proc_dir / "stat").read_text(encoding="ascii")
        executable_metadata = (proc_dir / "exe").stat()
    except (FileNotFoundError, ProcessLookupError):
        return None
    except (OSError, UnicodeError) as error:
        raise RunnerError(
            f"cannot inspect solver process identity {solver_pid}: {error}"
        ) from error
    state, process_group_id, start_time_ticks = parse_proc_stat(
        raw_stat, solver_pid
    )
    return (
        {
            "schemaVersion": 2,
            "pid": solver_pid,
            "processGroupId": process_group_id,
            "uid": metadata.st_uid,
            "bootId": current_boot_id(),
            "startTimeTicks": start_time_ticks,
            "executableDevice": executable_metadata.st_dev,
            "executableInode": executable_metadata.st_ino,
            "processIsolationPolicy": CASE_PROCESS_ISOLATION_POLICY,
        },
        state,
    )


def canonical_solver_pid_marker(identity: dict[str, Any]) -> str:
    return json.dumps(identity, sort_keys=True, separators=(",", ":")) + "\n"


def validate_solver_process_identity(identity: Any, marker: Path) -> dict[str, Any]:
    if not isinstance(identity, dict) or set(identity) != SOLVER_PROCESS_IDENTITY_KEYS:
        raise RunnerError(f"malformed solver process marker: {marker}")
    integer_keys = (
        "pid",
        "processGroupId",
        "uid",
        "startTimeTicks",
        "executableDevice",
        "executableInode",
    )
    if any(
        isinstance(identity.get(key), bool) or not isinstance(identity.get(key), int)
        for key in integer_keys
    ):
        raise RunnerError(f"malformed solver process marker: {marker}")
    if (
        identity.get("schemaVersion") != 2
        or identity["pid"] < 1
        or identity["processGroupId"] != identity["pid"]
        or identity["uid"] < 0
        or identity["startTimeTicks"] < 1
        or identity["executableDevice"] < 0
        or identity["executableInode"] < 1
        or identity.get("processIsolationPolicy") != CASE_PROCESS_ISOLATION_POLICY
        or not isinstance(identity.get("bootId"), str)
        or re.fullmatch(
            r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
            identity["bootId"],
        )
        is None
    ):
        raise RunnerError(f"malformed solver process marker: {marker}")
    return identity


def write_solver_pid_marker(
    case_dir: Path,
    process: subprocess.Popen[bytes],
    expected_supervisor: Path,
) -> dict[str, Any] | None:
    solver_pid = process.pid
    marker = case_dir / SOLVER_PID_MARKER
    expected_metadata = expected_supervisor.stat()
    expected_executable = (
        expected_metadata.st_dev,
        expected_metadata.st_ino,
    )
    deadline = time.monotonic() + 5.0
    while True:
        observed = observe_solver_process_identity(solver_pid)
        if observed is None:
            return None
        identity, state = observed
        if state == "Z":
            return None
        if identity["uid"] != os.getuid() or identity["processGroupId"] != solver_pid:
            raise RunnerError(
                f"cannot record solver process identity {solver_pid}: "
                "process is not the live isolated case supervisor"
            )
        observed_executable = (
            identity["executableDevice"],
            identity["executableInode"],
        )
        if observed_executable == expected_executable:
            break
        if time.monotonic() >= deadline:
            raise RunnerError(
                f"cannot record solver process identity {solver_pid}: "
                "bootstrap did not exec the run-private case supervisor"
            )
        time.sleep(0.005)
    encoded = canonical_solver_pid_marker(identity).encode("ascii")
    try:
        descriptor = os.open(
            marker,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
        )
        with os.fdopen(descriptor, "wb") as output:
            output.write(encoded)
            output.flush()
            os.fsync(output.fileno())
    except OSError as error:
        raise RunnerError(
            f"cannot record solver process identity {solver_pid}: {error}"
        ) from error
    return identity


def read_solver_pid_marker(case_dir: Path) -> tuple[dict[str, Any] | None, Path]:
    marker = case_dir / SOLVER_PID_MARKER
    try:
        descriptor = os.open(marker, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None, marker
    except OSError as error:
        raise RunnerError(f"cannot open solver pid marker {marker}: {error}") from error
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.getuid()
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            raise RunnerError(f"invalid solver pid marker: {marker}")
        raw_identity = os.read(descriptor, 2049)
    finally:
        os.close(descriptor)
    try:
        text = raw_identity.decode("ascii")
    except UnicodeError as error:
        raise RunnerError(f"cannot decode solver process marker {marker}") from error
    if len(raw_identity) > 2048:
        raise RunnerError(f"solver process marker is too large: {marker}")
    try:
        identity = validate_solver_process_identity(json.loads(text), marker)
    except json.JSONDecodeError as error:
        raise RunnerError(f"malformed solver process marker: {marker}") from error
    if text != canonical_solver_pid_marker(identity):
        raise RunnerError(f"solver process marker is not canonical: {marker}")
    return identity, marker


def solver_process_identity_matches(identity: dict[str, Any]) -> bool:
    if identity.get("bootId") != current_boot_id():
        return False
    observed = observe_solver_process_identity(identity["pid"])
    if observed is None:
        return False
    current, state = observed
    return state != "Z" and current == identity


_LIBC = ctypes.CDLL(None, use_errno=True)


def pidfd_open(process_id: int) -> int | None:
    python_function = getattr(os, "pidfd_open", None)
    if python_function is not None:
        try:
            return python_function(process_id, 0)
        except ProcessLookupError:
            return None
        except OSError as error:
            raise RunnerError(
                f"cannot open pidfd for case process supervisor {process_id}: {error}"
            ) from error
    function = getattr(_LIBC, "pidfd_open", None)
    if function is None:
        raise RunnerError("host Python and libc do not provide pidfd_open")
    function.argtypes = (ctypes.c_int, ctypes.c_uint)
    function.restype = ctypes.c_int
    descriptor = function(process_id, 0)
    if descriptor >= 0:
        return descriptor
    error_number = ctypes.get_errno()
    if error_number == errno.ESRCH:
        return None
    raise RunnerError(
        f"cannot open pidfd for case process supervisor {process_id}: "
        f"{os.strerror(error_number)}"
    )


def pidfd_send_signal(descriptor: int, sig: signal.Signals) -> bool:
    python_function = getattr(signal, "pidfd_send_signal", None)
    if python_function is not None:
        try:
            python_function(descriptor, int(sig), None, 0)
            return True
        except ProcessLookupError:
            return False
        except OSError as error:
            raise RunnerError(
                f"cannot signal identity-bound case process supervisor: {error}"
            ) from error
    function = getattr(_LIBC, "pidfd_send_signal", None)
    if function is None:
        raise RunnerError("host Python and libc do not provide pidfd_send_signal")
    function.argtypes = (
        ctypes.c_int,
        ctypes.c_int,
        ctypes.c_void_p,
        ctypes.c_uint,
    )
    function.restype = ctypes.c_int
    if function(descriptor, int(sig), None, 0) == 0:
        return True
    error_number = ctypes.get_errno()
    if error_number == errno.ESRCH:
        return False
    raise RunnerError(
        f"cannot signal identity-bound case process supervisor: "
        f"{os.strerror(error_number)}"
    )


def wait_for_pidfd_exit(descriptor: int, timeout_seconds: float) -> bool:
    poller = select.poll()
    poller.register(descriptor, select.POLLIN | select.POLLERR | select.POLLHUP)
    deadline = time.monotonic() + max(0.0, timeout_seconds)
    while True:
        remaining_ms = max(0, int((deadline - time.monotonic()) * 1000))
        try:
            return bool(poller.poll(remaining_ms))
        except InterruptedError:
            if time.monotonic() >= deadline:
                return False


def open_identity_bound_solver_pidfd(identity: dict[str, Any]) -> int | None:
    if not solver_process_identity_matches(identity):
        return None
    descriptor = pidfd_open(identity["pid"])
    if descriptor is None:
        return None
    # A process can exit between the first observation and pidfd_open.  Recheck
    # after opening so a rapidly reused numeric PID never authorizes a signal.
    if not solver_process_identity_matches(identity):
        os.close(descriptor)
        return None
    return descriptor


def reclaim_identity_bound_solver_process_tree(
    identity: dict[str, Any], grace_seconds: float
) -> bool:
    descriptor = open_identity_bound_solver_pidfd(identity)
    if descriptor is None:
        return False
    try:
        pidfd_send_signal(descriptor, signal.SIGTERM)
        if wait_for_pidfd_exit(descriptor, grace_seconds):
            return True
        pidfd_send_signal(descriptor, signal.SIGKILL)
        kill_wait_seconds = max(1.0, min(max(grace_seconds, 1.0), 5.0))
        if not wait_for_pidfd_exit(descriptor, kill_wait_seconds):
            raise RunnerError(
                f"identity-bound case process supervisor {identity['pid']} "
                "survived SIGKILL"
            )
        return True
    finally:
        os.close(descriptor)


def diagnostic_socket_sidecars(host_tmp: Path, solver_pid: int) -> set[Path]:
    directories: set[Path] = set()
    pattern = re.compile(
        rf"^\.diagnostic-socket-{solver_pid}-(?:0[1-9]|[1-9][0-9]+)-"
        rf"(logos-pds-{solver_pid}-[A-Za-z0-9._-]+)\.json$"
    )
    host_tmp_fd = os.open(host_tmp, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        with os.scandir(host_tmp_fd) as entries:
            for entry in entries:
                match = pattern.fullmatch(entry.name)
                if match is None:
                    if entry.name.startswith(".diagnostic-socket-"):
                        raise RunnerError(
                            f"unexpected diagnostic socket sidecar name: {host_tmp / entry.name}"
                        )
                    continue
                descriptor = os.open(
                    entry.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=host_tmp_fd
                )
                try:
                    metadata = os.fstat(descriptor)
                    if (
                        not stat.S_ISREG(metadata.st_mode)
                        or metadata.st_uid != os.getuid()
                        or stat.S_IMODE(metadata.st_mode) != 0o600
                    ):
                        raise RunnerError(
                            f"invalid diagnostic socket sidecar: {host_tmp / entry.name}"
                        )
                    raw = os.read(descriptor, 4096)
                finally:
                    os.close(descriptor)
                try:
                    record = json.loads(raw.decode("utf-8"))
                except (UnicodeError, json.JSONDecodeError) as error:
                    raise RunnerError(
                        f"invalid diagnostic socket sidecar JSON: {host_tmp / entry.name}"
                    ) from error
                expected_directory = SHORT_DIAGNOSTIC_SOCKET_ROOT / match.group(1)
                if record != {
                    "schemaVersion": 1,
                    "solverPid": solver_pid,
                    "directory": str(expected_directory),
                }:
                    raise RunnerError(
                        f"diagnostic socket sidecar identity mismatch: {host_tmp / entry.name}"
                    )
                directories.add(expected_directory)
    finally:
        os.close(host_tmp_fd)
    return directories


def cleanup_short_diagnostic_socket_dirs(
    solver_pid: int, recorded_directories: set[Path]
) -> None:
    root = SHORT_DIAGNOSTIC_SOCKET_ROOT
    try:
        root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as error:
        raise RunnerError(f"cannot inspect diagnostic socket root {root}: {error}") from error
    try:
        name_pattern = re.compile(rf"^logos-pds-{solver_pid}-[A-Za-z0-9._-]+$")
        for directory in sorted(recorded_directories):
            if directory.parent != root or name_pattern.fullmatch(directory.name) is None:
                raise RunnerError(
                    f"diagnostic socket directory escaped its solver-pid namespace: {directory}"
                )
            try:
                directory_fd = os.open(
                    directory.name,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                    dir_fd=root_fd,
                )
            except FileNotFoundError:
                continue
            except OSError as error:
                raise RunnerError(
                    f"cannot open diagnostic socket directory {directory}: {error}"
                ) from error
            try:
                metadata = os.fstat(directory_fd)
                if (
                    not stat.S_ISDIR(metadata.st_mode)
                    or metadata.st_uid != os.getuid()
                    or stat.S_IMODE(metadata.st_mode) != 0o700
                ):
                    raise RunnerError(
                        f"invalid diagnostic socket directory: {directory}"
                    )
                with os.scandir(directory_fd) as children:
                    names = sorted(entry.name for entry in children)
                if names not in ([], ["socket"]):
                    raise RunnerError(
                        f"unexpected content in diagnostic socket directory {directory}: {names}"
                    )
                if names:
                    socket_metadata = os.stat(
                        "socket", dir_fd=directory_fd, follow_symlinks=False
                    )
                    if not stat.S_ISSOCK(socket_metadata.st_mode):
                        raise RunnerError(
                            f"diagnostic socket entry is not a Unix socket: {directory / 'socket'}"
                        )
                    os.unlink("socket", dir_fd=directory_fd)
            finally:
                os.close(directory_fd)
            os.rmdir(directory.name, dir_fd=root_fd)
    finally:
        os.close(root_fd)


def cleanup_case_proof_containers(
    case_dir: Path,
    *,
    termination_grace_seconds: float = DEFAULT_TERMINATION_GRACE_SECONDS,
) -> None:
    """Remove proof containers orphaned by forced solver termination.

    The normal launcher removes its cidfile and `--rm` container.  A case-level
    SIGKILL can prevent the launcher's EXIT trap from running, so the outer
    runner scans only the case-local host-temporary tree before declaring the
    case terminal.  Every path component is inspected without following
    symlinks, so cleanup cannot escape into another case or an external path.
    """
    try:
        case_metadata = case_dir.lstat()
    except FileNotFoundError:
        return
    except OSError as error:
        raise RunnerError(
            f"cannot inspect proof case directory {case_dir}: {error}"
        ) from error
    if stat.S_ISLNK(case_metadata.st_mode) or not stat.S_ISDIR(
        case_metadata.st_mode
    ):
        raise RunnerError(f"proof case path is not a real directory: {case_dir}")

    solver_identity, solver_pid_marker = read_solver_pid_marker(case_dir)
    solver_pid = solver_identity["pid"] if solver_identity is not None else None
    if solver_identity is not None:
        reclaim_identity_bound_solver_process_tree(
            solver_identity, termination_grace_seconds
        )

    current = case_dir
    for component in ("proof-stage", "proof-agent", "host-tmp"):
        current = current / component
        try:
            metadata = current.lstat()
        except FileNotFoundError:
            if solver_pid is not None:
                cleanup_short_diagnostic_socket_dirs(solver_pid, set())
                solver_pid_marker.unlink(missing_ok=True)
            return
        except OSError as error:
            raise RunnerError(
                f"cannot inspect proof-agent host temporary path {current}: {error}"
            ) from error
        if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
            raise RunnerError(
                f"proof-agent host temporary path is not a real directory: {current}"
            )
    host_tmp = current

    recorded_socket_directories = (
        diagnostic_socket_sidecars(host_tmp, solver_pid)
        if solver_pid is not None
        else set()
    )
    if solver_pid is None:
        with os.scandir(host_tmp) as entries:
            has_unbound_sidecar = any(
                entry.name.startswith(".diagnostic-socket-") for entry in entries
            )
        if has_unbound_sidecar:
            raise RunnerError(
                "diagnostic socket sidecar exists without an exact solver pid marker"
            )
    cid_paths: list[Path] = []
    identity_paths: list[Path] = []
    try:
        with os.scandir(host_tmp) as entries:
            for entry in entries:
                if entry.name.endswith(".container.identity.json"):
                    if (
                        re.fullmatch(
                            r"\.round-[A-Za-z0-9_-]+\.container\.identity\.json",
                            entry.name,
                        )
                        is None
                    ):
                        raise RunnerError(
                            f"unexpected proof-agent container identity name: {host_tmp / entry.name}"
                        )
                    metadata = entry.stat(follow_symlinks=False)
                    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(
                        metadata.st_mode
                    ):
                        raise RunnerError(
                            f"invalid proof-agent container identity: {host_tmp / entry.name}"
                        )
                    identity_paths.append(host_tmp / entry.name)
                    continue
                if not entry.name.endswith(".container.cid"):
                    continue
                if (
                    re.fullmatch(
                        r"\.round-[A-Za-z0-9_-]+\.container\.cid", entry.name
                    )
                    is None
                ):
                    raise RunnerError(
                        f"unexpected proof-agent cidfile name: {host_tmp / entry.name}"
                    )
                metadata = entry.stat(follow_symlinks=False)
                if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(
                    metadata.st_mode
                ):
                    raise RunnerError(
                        f"invalid proof-agent cidfile: {host_tmp / entry.name}"
                    )
                cid_paths.append(host_tmp / entry.name)
    except RunnerError:
        raise
    except OSError as error:
        raise RunnerError(
            f"cannot scan proof-agent host temporary directory {host_tmp}: {error}"
        ) from error

    handled_cids: set[Path] = set()
    inspect_format = (
        '{{printf "%s|%s|%s|%s" .Id .Name '
        f'(index .Config.Labels "{PROOF_CONTAINER_MANAGED_LABEL}") '
        f'(index .Config.Labels "{PROOF_CONTAINER_TOKEN_LABEL}")}}}}'
    )
    for identity_path in sorted(identity_paths):
        try:
            descriptor = os.open(identity_path, os.O_RDONLY | os.O_NOFOLLOW)
        except OSError as error:
            raise RunnerError(
                f"cannot open proof-agent container identity {identity_path}: {error}"
            ) from error
        try:
            metadata = os.fstat(descriptor)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_uid != os.getuid()
                or stat.S_IMODE(metadata.st_mode) != 0o600
                or metadata.st_size > 4096
            ):
                raise RunnerError(
                    f"invalid proof-agent container identity: {identity_path}"
                )
            raw_identity = os.read(descriptor, 4097)
        finally:
            os.close(descriptor)
        try:
            identity = json.loads(raw_identity.decode("utf-8"))
        except (UnicodeError, json.JSONDecodeError) as error:
            raise RunnerError(
                f"malformed proof-agent container identity: {identity_path}"
            ) from error
        token = identity.get("cleanupToken") if isinstance(identity, dict) else None
        name = identity.get("containerName") if isinstance(identity, dict) else None
        cid_name = identity.get("cidFile") if isinstance(identity, dict) else None
        expected_cid_name = identity_path.name.removesuffix(
            ".identity.json"
        ) + ".cid"
        expected_labels = (
            {
                PROOF_CONTAINER_MANAGED_LABEL: "true",
                PROOF_CONTAINER_TOKEN_LABEL: token,
            }
            if isinstance(token, str)
            else None
        )
        if (
            not isinstance(identity, dict)
            or set(identity)
            != {"schemaVersion", "cidFile", "containerName", "cleanupToken", "labels"}
            or identity.get("schemaVersion") != 1
            or not isinstance(token, str)
            or re.fullmatch(r"[0-9a-f]{64}", token) is None
            or name != f"logos-proof-{token}"
            or cid_name != expected_cid_name
            or identity.get("labels") != expected_labels
        ):
            raise RunnerError(
                f"invalid proof-agent container identity binding: {identity_path}"
            )
        cid_path = host_tmp / expected_cid_name
        cid_value = ""
        cid_present = False
        if cid_path.exists() or cid_path.is_symlink():
            cid_present = True
            try:
                cid_descriptor = os.open(cid_path, os.O_RDONLY | os.O_NOFOLLOW)
            except OSError as error:
                raise RunnerError(
                    f"cannot open proof-agent cidfile {cid_path}: {error}"
                ) from error
            try:
                cid_metadata = os.fstat(cid_descriptor)
                if not stat.S_ISREG(cid_metadata.st_mode):
                    raise RunnerError(f"invalid proof-agent cidfile: {cid_path}")
                raw_cid = os.read(cid_descriptor, 129)
            finally:
                os.close(cid_descriptor)
            try:
                cid_value = raw_cid.decode("ascii").strip()
            except UnicodeError as error:
                raise RunnerError(
                    f"cannot decode proof-agent cidfile {cid_path}: {error}"
                ) from error
            if cid_value and re.fullmatch(r"[0-9a-f]{64}", cid_value) is None:
                raise RunnerError(f"malformed proof-agent container id in {cid_path}")
            handled_cids.add(cid_path)
        inspect_deadline = time.monotonic() + (
            max(
                PROOF_CONTAINER_CREATE_QUIESCENCE_SECONDS,
                termination_grace_seconds,
            )
            if cid_present and not cid_value
            else 0.0
        )
        while True:
            try:
                inspected = subprocess.run(
                    ["docker", "inspect", "--format", inspect_format, name],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    timeout=30,
                    check=False,
                )
            except (OSError, subprocess.TimeoutExpired) as error:
                raise RunnerError(
                    f"cannot inspect managed proof-agent container {name}: {error}"
                ) from error
            inspect_diagnostic = inspected.stderr.decode("utf-8", errors="replace")
            not_found = inspected.returncode != 0 and (
                "No such object" in inspect_diagnostic
                or "No such container" in inspect_diagnostic
            )
            if not_found and time.monotonic() < inspect_deadline:
                time.sleep(PROOF_CONTAINER_INSPECT_RETRY_SECONDS)
                continue
            break
        if inspected.returncode != 0:
            if (
                "No such object" not in inspect_diagnostic
                and "No such container" not in inspect_diagnostic
            ):
                raise RunnerError(
                    f"cannot inspect managed proof-agent container {name}: {inspect_diagnostic.strip()}"
                )
            if cid_present and not cid_value:
                raise RunnerError(
                    "managed proof-agent container creation remained ambiguous after "
                    f"bounded exact-name inspection for {name}; preserving its empty "
                    "cidfile and identity for a later retry"
                )
        else:
            fields = inspected.stdout.decode("utf-8", errors="strict").strip().split("|")
            if (
                len(fields) != 4
                or re.fullmatch(r"[0-9a-f]{64}", fields[0]) is None
                or fields[1] != f"/{name}"
                or fields[2] != "true"
                or fields[3] != token
                or (cid_value and cid_value != fields[0])
            ):
                raise RunnerError(
                    f"managed proof-agent container identity mismatch for {name}"
                )
            try:
                completed = subprocess.run(
                    ["docker", "rm", "-f", fields[0]],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    timeout=30,
                    check=False,
                )
            except (OSError, subprocess.TimeoutExpired) as error:
                raise RunnerError(
                    f"cannot remove managed proof-agent container {fields[0]}: {error}"
                ) from error
            diagnostic = completed.stderr.decode("utf-8", errors="replace")
            if completed.returncode != 0 and "No such container" not in diagnostic:
                raise RunnerError(
                    f"cannot remove managed proof-agent container {fields[0]}: {diagnostic.strip()}"
                )
        cid_path.unlink(missing_ok=True)
        identity_path.unlink(missing_ok=True)

    unbound_cids = sorted(set(cid_paths) - handled_cids)
    if unbound_cids:
        rendered = ", ".join(str(path) for path in unbound_cids)
        raise RunnerError(
            "proof-agent cidfile has no matching managed identity; preserving "
            f"it without touching Docker: {rendered}"
        )

    if solver_pid is not None:
        cleanup_short_diagnostic_socket_dirs(solver_pid, recorded_socket_directories)

    try:
        if not shutil.rmtree.avoids_symlink_attacks:
            raise RunnerError(
                "platform does not provide symlink-safe proof-agent host cleanup"
            )
        metadata = host_tmp.lstat()
        if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
            raise RunnerError(
                f"proof-agent host temporary path changed during cleanup: {host_tmp}"
            )
        shutil.rmtree(host_tmp)
        solver_pid_marker.unlink(missing_ok=True)
    except RunnerError:
        raise
    except OSError as error:
        raise RunnerError(
            f"cannot remove proof-agent host temporary directory {host_tmp}: {error}"
        ) from error


def display_path(path: Path) -> str:
    try:
        return path.resolve().relative_to(LOGOS_ROOT).as_posix()
    except ValueError:
        return str(path.resolve())


def workspace_display_path(path: Path) -> str:
    try:
        return path.resolve().relative_to(WORKFLOW_ROOT).as_posix()
    except ValueError:
        return str(path.resolve())


def atomic_write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(
        f".{path.name}.{os.getpid()}.{threading.get_ident()}.tmp"
    )
    text = json.dumps(value, indent=2, sort_keys=False) + "\n"
    temporary.write_text(text, encoding="utf-8")
    os.replace(temporary, path)


def iso_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")


if __name__ == "__main__":
    raise SystemExit(main())
