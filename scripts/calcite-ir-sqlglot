#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Logos/FormalSQL uses PostgreSQL as its concrete semantic dialect. A T-SQL
# default silently changes observable behavior (notably ASC NULL placement),
# so non-PostgreSQL inputs must opt in explicitly with --read.
READ_DIALECT="postgres"
WRITE_DIALECT="postgres"
IDENTIFY=1
SCHEMA=""
SQL=""
NORMALIZED_OUTPUT=""
REPORT_OUTPUT=""
DEFAULT_COLLATION="unspecified"
CHARACTER_CLASSIFICATION="unspecified"
LOCALE_PROVIDER="unspecified"
SERVER_ENCODING="unspecified"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --schema)
      SCHEMA="$2"
      shift 2
      ;;
    --sql)
      SQL="$2"
      shift 2
      ;;
    --read)
      READ_DIALECT="$2"
      shift 2
      ;;
    --write)
      WRITE_DIALECT="$2"
      shift 2
      ;;
    --no-identify)
      IDENTIFY=0
      shift
      ;;
    --normalized-output)
      NORMALIZED_OUTPUT="$2"
      shift 2
      ;;
    --report)
      REPORT_OUTPUT="$2"
      shift 2
      ;;
    --default-collation)
      DEFAULT_COLLATION="$2"
      shift 2
      ;;
    --character-classification)
      CHARACTER_CLASSIFICATION="$2"
      shift 2
      ;;
    --locale-provider)
      LOCALE_PROVIDER="$2"
      shift 2
      ;;
    --server-encoding)
      SERVER_ENCODING="$2"
      shift 2
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [[ -z "$SCHEMA" || -z "$SQL" ]]; then
  echo "Usage: calcite-ir-sqlglot --schema <schema.sql> --sql <query.sql> [--read postgres] [--write postgres] [--default-collation unspecified|C] [--character-classification unspecified|C] [--locale-provider unspecified|libc] [--server-encoding unspecified|UTF8] [--no-identify] [--normalized-output out.sql] [--report report.json]" >&2
  exit 2
fi

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

NORMALIZED_SQL="$TMP_DIR/query.normalized.sql"
REPORT="$TMP_DIR/query.normalized.report.json"
NORMALIZE_ARGS=(
  --input "$SQL"
  --output "$NORMALIZED_SQL"
  --report "$REPORT"
  --read "$READ_DIALECT"
  --write "$WRITE_DIALECT"
)

if [[ "$IDENTIFY" -eq 1 ]]; then
  NORMALIZE_ARGS+=(--identify)
fi

"$ROOT_DIR/benchmarks/scripts/sqlglot-normalize" "${NORMALIZE_ARGS[@]}" >&2

if [[ -n "$NORMALIZED_OUTPUT" ]]; then
  cp "$NORMALIZED_SQL" "$NORMALIZED_OUTPUT"
fi

if [[ -n "$REPORT_OUTPUT" ]]; then
  cp "$REPORT" "$REPORT_OUTPUT"
fi

"$ROOT_DIR/scripts/calcite-ir" \
  --schema "$SCHEMA" \
  --sql "$NORMALIZED_SQL" \
  --default-collation "$DEFAULT_COLLATION" \
  --character-classification "$CHARACTER_CLASSIFICATION" \
  --locale-provider "$LOCALE_PROVIDER" \
  --server-encoding "$SERVER_ENCODING"
