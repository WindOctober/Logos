class RunnerError(RuntimeError):
    pass


@dataclasses.dataclass(frozen=True)
class RunConfig:
    input_root: Path
    run_dir: Path
    solver_bin: Path
    jobs: int
    case_timeout_seconds: float
    termination_grace_seconds: float
    proof_rocq_opam_switch: Path
    sql_time_zone: str
    sql_default_collation: str
    sql_character_classification: str
    sql_locale_provider: str
    sql_server_encoding: str
    input_manifest: dict[str, Any]
    input_files: dict[str, dict[str, Any]]
    solver_binary: dict[str, Any]
    framework_source_tree: dict[str, Any]
    frontend_stack: dict[str, Any]
    runner_binary: dict[str, Any]


class ProcessRegistry:
    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._processes: dict[int, ManagedProcess] = {}

    def register(self, process: subprocess.Popen[bytes]) -> ManagedProcess:
        managed = ManagedProcess(process)
        with self._lock:
            self._processes[process.pid] = managed
        return managed

    def unregister(self, managed: ManagedProcess) -> None:
        with self._lock:
            current = self._processes.get(managed.pid)
            if current is managed:
                self._processes.pop(managed.pid, None)
        managed.close()

    def terminate_all(self, grace_seconds: float) -> None:
        with self._lock:
            processes = list(self._processes.values())
        FULL_RUNNER["terminate_process_trees"](processes, grace_seconds)


def argument_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Generate and validate FormalSQL/Rocq proof workspaces without running "
            "counterexample or proof agents."
        )
    )
    parser.add_argument(
        "--input-root",
        default=str(DEFAULT_INPUT_ROOT),
        help="Independent Logos generated input root (default: .generated/logos).",
    )
    parser.add_argument(
        "--run-dir",
        help="Fresh output directory; defaults below var/logos-solver/transform-runs.",
    )
    parser.add_argument("--jobs", type=int, default=16)
    parser.add_argument(
        "--case-timeout",
        type=parse_duration,
        default=DEFAULT_CASE_TIMEOUT_SECONDS,
        metavar="DURATION",
    )
    parser.add_argument(
        "--termination-grace",
        type=parse_duration,
        default=DEFAULT_TERMINATION_GRACE_SECONDS,
        metavar="DURATION",
    )
    parser.add_argument("--case", action="append")
    parser.add_argument("--case-file", action="append")
    parser.add_argument("--benchmark", action="append")
    parser.add_argument("--match", action="append")
    parser.add_argument("--limit", type=int)
    parser.add_argument("--list", action="store_true")
    parser.add_argument("--solver-bin", default=str(DEFAULT_SOLVER_BIN))
    parser.add_argument("--no-build", action="store_true")
    parser.add_argument("--no-frontend-build", action="store_true")
    parser.add_argument(
        "--proof-rocq-opam-switch", default=str(DEFAULT_ROCQ_OPAM_SWITCH)
    )
    parser.add_argument("--sql-time-zone", default="UTC")
    parser.add_argument("--sql-default-collation", default="C")
    parser.add_argument("--sql-character-classification", default="C")
    parser.add_argument("--sql-locale-provider", default="libc")
    parser.add_argument("--sql-server-encoding", default="UTF8")
    return parser


def parse_duration(value: str) -> float:
    try:
        return FULL_RUNNER["parse_duration"](value)
    except (argparse.ArgumentTypeError, BaseRunnerError) as error:
        raise argparse.ArgumentTypeError(str(error)) from error


def validate_args(args: argparse.Namespace) -> None:
    if args.jobs < 1:
        raise RunnerError("--jobs must be at least 1")
    if args.case_timeout <= 0:
        raise RunnerError("--case-timeout must be positive")
    if args.termination_grace < 0:
        raise RunnerError("--termination-grace cannot be negative")
    if args.limit is not None and args.limit < 1:
        raise RunnerError("--limit must be at least 1")


def resolve_path(value: str | Path) -> Path:
    try:
        return FULL_RUNNER["resolve_path"](value)
    except BaseRunnerError as error:
        raise RunnerError(str(error)) from error


def discover_cases(input_root: Path) -> list[BenchmarkCase]:
    try:
        return FULL_RUNNER["discover_cases"](input_root)
    except BaseRunnerError as error:
        raise RunnerError(str(error)) from error


def select_cases(
    cases: list[BenchmarkCase], args: argparse.Namespace
) -> list[BenchmarkCase]:
    try:
        return FULL_RUNNER["select_cases"](cases, args)
    except BaseRunnerError as error:
        raise RunnerError(str(error)) from error


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def compact_json_sha256(value: Any) -> str:
    """Match ``serde_json::to_vec`` for JSON read from solver artifacts."""

    encoded = json.dumps(
        value, ensure_ascii=False, separators=(",", ":")
    ).encode("utf-8")
    return sha256_bytes(encoded)


def read_json_artifact(path: Path, description: str) -> Any:
    if path.is_symlink() or not path.is_file():
        raise RunnerError(f"{description} is missing, symlinked, or non-regular")
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RunnerError(f"cannot read {description}: {error}") from error


POSTGRES_SQL_WHITESPACE = " \t\n\r\f\v"


def _bare_identifier_start(value: str) -> bool:
    return value == "_" or "A" <= value <= "Z" or "a" <= value <= "z"


def _bare_identifier_part(value: str) -> bool:
    return _bare_identifier_start(value) or value.isascii() and value.isdigit() or value == "$"


def _dollar_quote_delimiter_end(sql: str, start: int) -> int | None:
    if start > 0:
        previous = sql[start - 1]
        if _bare_identifier_part(previous) or ord(previous) >= 0x80:
            return None
    index = start + 1
    if index < len(sql) and ord(sql[index]) >= 0x80:
        raise RunnerError("non-ASCII PostgreSQL dollar-quote tags are unsupported")
    if index < len(sql) and sql[index] == "$":
        return index + 1
    if index >= len(sql) or not _bare_identifier_start(sql[index]):
        return None
    index += 1
    while index < len(sql) and (
        _bare_identifier_start(sql[index])
        or sql[index].isascii() and sql[index].isdigit()
    ):
        index += 1
    if index < len(sql) and ord(sql[index]) >= 0x80:
        raise RunnerError("non-ASCII PostgreSQL dollar-quote tags are unsupported")
    return index + 1 if index < len(sql) and sql[index] == "$" else None


def _postgres_escape_string_quote(sql: str, quote_start: int) -> bool:
    if quote_start == 0 or sql[quote_start - 1] not in ("E", "e"):
        return False
    if quote_start == 1:
        return True
    previous = sql[quote_start - 2]
    return not _bare_identifier_part(previous) and ord(previous) < 0x80


def _quoted_token_end(sql: str, start: int, quote: str) -> int:
    index = start + 1
    backslash_escapes = quote == "'" and _postgres_escape_string_quote(sql, start)
    while index < len(sql):
        current = sql[index]
        index += 1
        if current == "\\" and backslash_escapes and index < len(sql):
            index += 1
        elif current == quote:
            if index < len(sql) and sql[index] == quote:
                index += 1
            else:
                return index
    raise RunnerError("unterminated quoted token in SQL query file")


def _bracket_quoted_token_end(sql: str, start: int) -> int:
    index = start + 1
    while index < len(sql):
        current = sql[index]
        index += 1
        if current == "]":
            if index < len(sql) and sql[index] == "]":
                index += 1
            else:
                return index
    raise RunnerError("unterminated bracket-quoted identifier in SQL query file")


def _skip_sql_comment(sql: str, index: int) -> int:
    if sql.startswith("--", index):
        index += 2
        while index < len(sql) and sql[index] not in ("\n", "\r"):
            index += 1
        return index
    if sql.startswith("/*", index):
        depth = 1
        index += 2
        while index < len(sql) and depth > 0:
            if sql.startswith("/*", index):
                depth += 1
                index += 2
            elif sql.startswith("*/", index):
                depth -= 1
                index += 2
            else:
                index += 1
        if depth != 0:
            raise RunnerError("unterminated block comment in SQL query file")
        return index
    return index


def _contains_sql_token(sql: str) -> bool:
    index = 0
    while index < len(sql):
        if sql[index] in POSTGRES_SQL_WHITESPACE:
            index += 1
        elif sql.startswith("--", index) or sql.startswith("/*", index):
            index = _skip_sql_comment(sql, index)
        else:
            return True
    return False


def split_calcite_query_program(sql: str) -> list[str]:
    """Port the wrapper's protected-token ``splitQueries`` contract."""

    queries = []
    start = 0
    index = 0
    while index < len(sql):
        current = sql[index]
        if sql.startswith("--", index) or sql.startswith("/*", index):
            index = _skip_sql_comment(sql, index)
            continue
        if current in ("'", '"', "`"):
            index = _quoted_token_end(sql, index, current)
            continue
        if current == "[":
            index = _bracket_quoted_token_end(sql, index)
            continue
        if current == "$":
            delimiter_end = _dollar_quote_delimiter_end(sql, index)
            if delimiter_end is not None:
                delimiter = sql[index:delimiter_end]
                close = sql.find(delimiter, delimiter_end)
                if close < 0:
                    raise RunnerError("unterminated dollar-quoted SQL string")
                index = close + len(delimiter)
                continue
        if current == ";":
            candidate = sql[start:index].strip(POSTGRES_SQL_WHITESPACE)
            if candidate and _contains_sql_token(candidate):
                queries.append(candidate)
            start = index + 1
        index += 1
    candidate = sql[start:].strip(POSTGRES_SQL_WHITESPACE)
    if candidate and _contains_sql_token(candidate):
        queries.append(candidate)
    return queries


def canonical_json_bytes(value: Any) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode(
        "utf-8"
    )


def atomic_write_json(path: Path, value: Any) -> None:
    encoded = (json.dumps(value, indent=2, ensure_ascii=True) + "\n").encode("utf-8")
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", suffix=".tmp", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(encoded)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        temporary.unlink(missing_ok=True)


def workspace_display_path(path: Path) -> str:
    try:
        return path.resolve().relative_to(WORKFLOW_ROOT).as_posix()
    except ValueError:
        return str(path.resolve())


def resolve_recorded_path(value: object, description: str) -> Path:
    if not isinstance(value, str) or not value:
        raise RunnerError(f"{description} path is missing")
    recorded = Path(value)
    if recorded.is_absolute():
        return recorded.resolve()
    return (WORKFLOW_ROOT / recorded).resolve()


def iso_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")


def executable_record(path: Path, description: str) -> dict[str, Any]:
    candidate = path.absolute()
    if candidate.is_symlink() or not candidate.is_file():
        raise RunnerError(
            f"{description} is missing, symlinked, or non-executable: {candidate}"
        )
    resolved = candidate.resolve()
    if not os.access(resolved, os.X_OK):
        raise RunnerError(
            f"{description} is missing, symlinked, or non-executable: {resolved}"
        )
    return {
        "path": workspace_display_path(resolved),
        "sha256": sha256_file(resolved),
        "bytes": resolved.stat().st_size,
    }


def regular_file_record(path: Path, description: str) -> dict[str, Any]:
    candidate = path.absolute()
    if candidate.is_symlink() or not candidate.is_file():
        raise RunnerError(
            f"{description} is missing, symlinked, or non-regular: {candidate}"
        )
    resolved = candidate.resolve()
    return {
        "path": workspace_display_path(resolved),
        "sha256": sha256_file(resolved),
        "bytes": resolved.stat().st_size,
    }


def prepare_run_dir(value: str | None) -> Path:
    if value:
        run_dir = resolve_path(value)
    else:
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        run_dir = DEFAULT_RUN_ROOT / f"run-{stamp}-{os.getpid()}"
    if run_dir.exists() and any(run_dir.iterdir()):
        raise RunnerError(f"run directory is not empty: {run_dir}")
    run_dir.mkdir(parents=True, exist_ok=True)
    return run_dir.resolve()


def build_solver() -> None:
    completed = subprocess.run(
        ["cargo", "build", "-p", "logos-solver"], cwd=LOGOS_ROOT, check=False
    )
    if completed.returncode != 0:
        raise RunnerError(f"cargo build failed with exit code {completed.returncode}")


def prepare_frontend_stack() -> None:
    try:
        FULL_RUNNER["prepare_frontend_stack"]()
    except BaseRunnerError as error:
        raise RunnerError(str(error)) from error


